      "ac_id": "AC-SPEC",
      "phase": "0",
      "kind": "gate",
      "_note": "concreteness=ready 前必跑；5clean+紅隊=定案終點（finalization_role 下放到該 component，--ready-for-5clean 只排除此 component 以破 Phase0↔5clean 循環，但仍跑 concreteness）—CF-01",
      "components": [
        {
          "name": "concreteness:",
          "qualification_command": [
            "PY",
            "tools/spec_concreteness_lint.py"
          ],
          "evidence_command": [
            "PY",
            "tools/spec_concreteness_lint.py"
          ]
        },
        {
          "name": "5clean+紅隊 ledger:",
          "finalization_role": true,
          "qualification_command": [
            "PY",
            "tools/spec_converge_gate.py",
            "--selftest"
          ],
          "evidence_command": [
            "PY",
            "tools/spec_converge_gate.py",
            "--verify-ledger"
          ]
        }
      ]
    },
    {
