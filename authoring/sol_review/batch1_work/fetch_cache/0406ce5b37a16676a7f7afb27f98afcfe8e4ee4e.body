					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Monsoon season in East Asia"}},"i":0}}]}'>Monsoon season in East Asia</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox Chinese\n","href":"./Template:Infobox_Chinese"},"params":{"pic":{"wt":"Plum rain in Shinjuku, Tokyo.jpg"},"piccap":{"wt":"Plum rain falling on two clear umbrellas, looking up toward the Tokyo Metropolitan Government Building, in June 2009"},"c":{"wt":"{{linktext|梅雨}}"},"l":{"wt":"[[Prunus mume|plum]] rain"},"order":{"wt":"st"},"p":{"wt":"méiyǔ"},"j":{"wt":"mui4 jyu5"},"poj":{"wt":"mûi-ú / bôe-í"},"h":{"wt":"mòi-yí"},"kana":{"wt":"つゆ / ばいう"},"kanji":{"wt":"梅雨"},"revhep":{"wt":"tsuyu / baiu"},"kunrei":{"wt":"tuyu / baiu"},"hanja":{"wt":"長마"},"hangul":{"wt":"장마"},"rr":{"wt":"jangma"},"mr":{"wt":"changma"},"mi":{"wt":"{{ipa|cmn|měiɥỳ|}}"},"ci":{"wt":"mu̖ːy̯jy̗ː"},"hiragana":{"wt":"つゆ / ばいう"},"katakana":{"wt":"ツユ / バイウ"},"bpmf":{"wt":"ㄇㄟˊㄩˇ"},"rus":{"wt":"Восточно-азиатский сезон дождей"},"vietnam chu han":{"wt":"季雨東亞"},"vietnam chu nom":{"wt":"务𩅹東亞"},"Vietnamname":{"wt":"Mùa mưa Đông Á"},"viet nam han viet":{"wt":"季雨東亞"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-sche