<tr id="mwBVI">
<td id="mwBVM"><span class="skin-invert" typeof="mw:File" id="mwBVQ"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_htc.svg" class="mw-file-description" id="mwBVU"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_htc.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Cjk_m_str_htc.svg/40px-Cjk_m_str_htc.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Cjk_m_str_htc.svg/60px-Cjk_m_str_htc.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwBVY"/></a></span></td>
<td id="mwBVc">横撇弯</td>
<td id="mwBVg"><b id="mwBVk">HPW</b><sup about="#mwt151" class="mw-ref reference" id="cite_ref-cjk37_4-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"cjk37"}}'><a href="#cite_note-cjk37-4" id="mwBVo"><span class="mw-reflink-text" id="mwBVs"><span class="cite-bracket" id="mwBVw">[</span>4<span class="cite-bracket" id="mwBV0">]</span></span></a></sup></td>
<td id="mwBV4">Héng Piě Wān</td>
<td id="mwBV8">It only appears in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Regular_script" title="Regular script" id="mwBWA">Regular script</a>, can be merged into stroke <b id="mwBWE">HPHP</b> in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Song_typeface" title="Song typeface" class="mw-redirect" id="mwBWI">Song typeface</a>.</td>
<td id="mwBWM">辶 过 边</td></tr>
<tr id="mwBWQ">
<td id="mwBWU"><span class="skin-invert" typeof="mw:File" id="mwBWY"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_thtj.svg" class="mw-file-description" id="mwBWc"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_thtj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Cjk_m_str_thtj.svg/40px-Cjk_m_str_thtj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Cjk_m_str_thtj.svg/60px-Cjk_m_str_thtj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwBWg"/></a></span></td>
<td id="mwBWk">竖折折弯钩</td>
<td id="mwBWo"><b id="mwBWs">SZZWG</b><sup about="#mwt152" class="mw-ref reference" id="cite_ref-cjk37_4-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"cjk37"}}'><a href="#cite_note-cjk37-4" id="mwBWw"><span class="mw-reflink-text" id="mwBW0"><span class="cite-bracket" id="mwBW4">[</span>4<span class="cite-bracket" id="mwBW8">]</span></span></a></sup></td>
<td id="mwBXA">Shù Zhé Zhé Wān Gōu</td>
<td id="mwBXE">This stroke has been merged into stroke <b id="mwBXI">SZZG</b> in Unicode.<sup about="#mwt153" class="mw-ref reference" id="cite_ref-IRGN1174_9-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"IRGN1174"}}'><a href="#cite_note-IRGN1174-9" id="mwBXM"><span class="mw-reflink-text" id="mwBXQ"><span class="cite-bracket" id="mwBXU">[</span>8<span class="cite-bracket" id="mwBXY">]</span></span></a></sup></td>
<td id="mwBXc">弓 丐</td></tr>
<tr id="mwBXg">
<td id="mwBXk"><span class="skin-invert" typeof="mw:File" id="mwBXo"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_c.svg" class="mw-file-description" id="mwBXs"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_c.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Cjk_m_str_c.svg/40px-Cjk_m_str_c.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Cjk_m_str_c.svg/60px-Cjk_m_str_c.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwBXw"/></a></span></td>
<td id="mwBX0">弯</td>
<td id="mwBX4"><b id="mwBX8">W</b><sup about="#mwt154" class="mw-ref reference" id="cite_ref-cjk37_4-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"cjk37"}}'><a href="#cite_note-cjk37-4" id="mwBYA"><span class="mw-reflink-text" id="mwBYE"><span class="cite-bracket" id="mwBYI">[</span>4<span class="cite-bracket" id="mwBYM">]</span></span></a></sup></td>
