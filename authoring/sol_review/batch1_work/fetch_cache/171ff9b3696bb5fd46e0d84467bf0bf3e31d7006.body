<span class="mw-empty-elt" about="#mwt213" typeof="mw:Transclusion" id="mwDEo" data-mw='{"parts":[{"template":{"target":{"wt":"Notelist","href":"./Template:Notelist"},"params":{},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1327269900" typeof="mw:Extension/templatestyles" about="#mwt214" data-mw='{"name":"templatestyles","attrs":{"src":"Reflist/styles.css"}}'>.mw-parser-output .reflist-columns-2{column-width:30em}.mw-parser-output .reflist-columns-3{column-width:25em}body.skin-vector-2022 .mw-parser-output .reflist-columns-2{column-width:27em}body.skin-vector-2022 .mw-parser-output .reflist-columns-3{column-width:22.5em}.mw-parser-output .references[data-mw-group=upper-alpha]{list-style-type:upper-alpha}.mw-parser-output .references[data-mw-group=upper-roman]{list-style-type:upper-roman}.mw-parser-output .references[data-mw-group=lower-alpha]{list-style-type:lower-alpha}.mw-parser-output .references[data-mw-group=lower-greek]{list-style-type:lower-greek}.mw-parser-output .references[data-mw-group=lower-roman]{list-style-type:lower-roman}.mw-parser-output div.reflist-liststyle-upper-alpha .references{list-style-type:upper-alpha}.mw-parser-output div.reflist-liststyle-upper-roman .references{list-style-type:upper-roman}.mw-parser-output div.reflist-liststyle-lower-alpha .references{list-style-type:lower-alpha}.mw-parser-output div.reflist-liststyle-lower-greek .references{list-style-type:lower-greek}.mw-parser-output div.reflist-liststyle-lower-roman .references{list-style-type:lower-roman}</style></span><div about="#mwt213" id="mwDEs">
<div class="mw-references-wrap" typeof="mw:Extension/references" about="#mwt215" id="mwDEw" data-mw='{"name":"references","attrs":{"group":"lower-alpha","responsive":"1"},"body":{"extsrc":""}}'><ol class="mw-references references" data-mw-group="lower-alpha" id="mwDE0"><li about="#cite_note-10" id="cite_note-10" data-mw-footnote-number="a"><span class="mw-cite-backlink" id="mwDE4"><a href="#cite_ref-10" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwDE8"><span class="mw-linkback-text" id="mwDFA">↑</span></a></span> <span id="mw-reference-text-cite_note-10" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Pipa</span></li>
<li about="#cite_note-11" id="cite_note-11" data-mw-footnote-number="b"><span class="mw-cite-backlink" id="mwDFE"><a href="#cite_ref-11" data-mw-group="lower-alpha" rel="mw:referencedBy" id="mwDFI"><span class="mw-linkback-text" id="mwDFM">↑</span></a></span> <span id="mw-reference-text-cite_note-11" class="mw-reference-text reference-text" data-mw-group="lower-alpha">Kolo</span></li>
</ol></div></div>

<p id="mwDFQ">Some strokes are not included in the numbering scheme, such as stroke <span class="skin-invert" typeof="mw:File" id="mwDFU"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_tj.svg" class="mw-file-description" id="mwDFY"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_tj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Cjk_m_str_tj.svg/40px-Cjk_m_str_tj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d8/Cjk_m_str_tj.svg/60px-Cjk_m_str_tj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDFc"/></a></span>, <span class="skin-invert" typeof="mw:File" id="mwDFg"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_o.svg" class="mw-file-description" id="mwDFk"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_o.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Cjk_m_str_o.svg/40px-Cjk_m_str_o.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Cjk_m_str_o.svg/60px-Cjk_m_str_o.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDFo"/></a></span>, <span class="skin-invert" typeof="mw:File" id="mwDFs"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_du.svg" class="mw-file-description" id="mwDFw"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_du.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Cjk_m_str_du.svg/40px-Cjk_m_str_du.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Cjk_m_str_du.svg/60px-Cjk_m_str_du.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDF0"/></a></span>, <span class="skin-invert" typeof="mw:File" id="mwDF4"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_ft.svg" class="mw-file-description" id="mwDF8"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_ft.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Cjk_m_str_ft.svg/40px-Cjk_m_str_ft.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Cjk_m_str_ft.svg/60px-Cjk_m_str_ft.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDGA"/></a></span>, <span class="skin-invert" typeof="mw:File" id="mwDGE"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_wd.svg" class="mw-file-description" id="mwDGI"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_wd.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Cjk_m_str_wd.svg/40px-Cjk_m_str_wd.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Cjk_m_str_wd.svg/60px-Cjk_m_str_wd.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDGM"/></a></span>, <span class="skin-invert" typeof="mw:File" id="mwDGQ"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_rsv.svg" class="mw-file-description" id="mwDGU"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_rsv.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Cjk_m_str_rsv.svg/40px-Cjk_m_str_rsv.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Cjk_m_str_rsv.svg/60px-Cjk_m_str_rsv.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDGY"/></a></span>, <span class="skin-invert" typeof="mw:File" id="mwDGc"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_thtaj.svg" class="mw-file-description" id="mwDGg"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_thtaj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Cjk_m_str_thtaj.svg/40px-Cjk_m_str_thtaj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Cjk_m_str_thtaj.svg/60px-Cjk_m_str_thtaj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDGk"/></a></span>, <span class="skin-invert" typeof="mw:File" id="mwDGo"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_vcj.svg" class="mw-file-description" id="mwDGs"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_vcj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Cjk_m_str_vcj.svg/40px-Cjk_m_str_vcj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Cjk_m_str_vcj.svg/60px-Cjk_m_str_vcj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDGw"/></a></span>, etc.</p>

<p id="mwDG0">Besides, there are ways of grouping strokes that are different from the Unicode standard.  For example, stroke <span class="skin-invert" typeof="mw:File" id="mwDG4"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_haj.svg" class="mw-file-description" id="mwDG8"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_haj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Cjk_m_str_haj.svg/40px-Cjk_m_str_haj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Cjk_m_str_haj.svg/60px-Cjk_m_str_haj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDHA"/></a></span> is merged into stroke <span class="skin-invert" typeof="mw:File" id="mwDHE"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_hpj.svg" class="mw-file-description" id="mwDHI"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_hpj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Cjk_m_str_hpj.svg/40px-Cjk_m_str_hpj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Cjk_m_str_hpj.svg/60px-Cjk_m_str_hpj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDHM"/></a></span> in Unicode system, while it is merged into <span class="skin-invert" typeof="mw:File" id="mwDHQ"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_htaj.svg" class="mw-file-description" id="mwDHU"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_htaj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Cjk_m_str_htaj.svg/40px-Cjk_m_str_htaj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/d/d9/Cjk_m_str_htaj.svg/60px-Cjk_m_str_htaj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwDHY"/></a></span> in this numbering scheme.</p>

</section></section><section data-mw-section-id="12" id="mwDHc" aria-labelledby="Number_of_strokes"><div class="mw-heading mw-heading2"><h2 id="Number_of_strokes">Number of strokes</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=12" title="Edit section: Number of strokes"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<span class="mw-empty-elt" about="#mwt216" typeof="mw:Transclusion" id="mwDHg" data-mw='{"parts":[{"template":{"target":{"wt":"Main","href":"./Template:Main"},"params":{"1":{"wt":"Stroke number"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt217" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt216" id="mwDHk">Main article: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Stroke_number" title="Stroke number">Stroke number</a></div>

<p id="mwDHo"><i id="mwDHs">Stroke number</i> or <i id="mwDHw">stroke count</i> is the number of strokes making up a character. Stroke count plays an important role in Chinese character sorting, teaching and computer information processing.<sup about="#mwt218" class="mw-ref reference" id="cite_ref-FOOTNOTESu201474–75_2-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTESu201474–75"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTESu201474–75-2"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Su"},"2":{"wt":"2014"},"pp":{"wt":"74-75"}},"i":0}}]}'><a href="#cite_note-FOOTNOTESu201474–75-2" id="mwDH0"><span class="mw-reflink-text" id="mwDH4"><span class="cite-bracket" id="mwDH8">[</span>2<span class="cite-bracket" id="mwDIA">]</span></span></a></sup> Stroke numbers vary dramatically from characters to characters, for example, characters <span lang="zh" about="#mwt221" typeof="mw:Transclusion" id="mwDIE" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"丶"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>丶</span>, <span lang="zh" about="#mwt222" typeof="mw:Transclusion" id="mwDII" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"一"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>一</span> and <span lang="zh" about="#mwt223" typeof="mw:Transclusion" id="mwDIM" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"乙"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>乙</span> have only one stroke, while the character <span lang="zh" about="#mwt224" typeof="mw:Transclusion" id="mwDIQ" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"齉"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>齉</span> has 36 strokes, and <span lang="zh" about="#mwt225" typeof="mw:Transclusion" id="mwDIU" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"龘"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>龘</span> (a composition of <span lang="zh" about="#mwt226" typeof="mw:Transclusion" id="mwDIY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"龍"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>龍</span> in triplicate) has 48. The Chinese character with the most strokes in the entire Unicode character set is <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Taito_(kanji)" title="Taito (kanji)" id="mwDIc">"taito"</a> <span lang="zh" about="#mwt227" typeof="mw:Transclusion" id="mwDIg" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"𱁬"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>𱁬</span> with 84 strokes.<sup about="#mwt230" class="mw-ref reference" id="cite_ref-14" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-14"}}'><a href="#cite_note-14" id="mwDIk"><span class="mw-reflink-text" id="mwDIo"><span class="cite-bracket" id="mwDIs">[</span>11<span class="cite-bracket" id="mwDIw">]</span></span></a></sup></p>

<section data-mw-section-id="13" id="mwDI0" aria-labelledby="Counting_strokes"><div class="mw-heading mw-heading3"><h3 id="Counting_strokes">Counting strokes</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=13" title="Edit section: Counting strokes"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDI4">There are effective methods to count the strokes of a Chinese character correctly. First of all, stroke counting is to be carried out on the standard <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Regular_script" title="Regular script" id="mwDI8">regular script</a> form of the character, and according to its <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Stroke_order" title="Stroke order" id="mwDJA">stroke order</a>. And if needed, a standard list of strokes or list of stroke orders issued by the authoritative institution should be consulted.<sup about="#mwt231" class="mw-ref reference" id="cite_ref-FOOTNOTEPRC2021_15-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEPRC2021"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEPRC2021-15"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"PRC"},"2":{"wt":"2021"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEPRC2021-15" id="mwDJE"><span class="mw-reflink-text" id="mwDJI"><span class="cite-bracket" id="mwDJM">[</span>12<span class="cite-bracket" id="mwDJQ">]</span></span></a></sup><sup about="#mwt234" class="mw-ref reference" id="cite_ref-FOOTNOTETaiwan1996_16-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTETaiwan1996"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETaiwan1996-16"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Taiwan"},"2":{"wt":"1996"}},"i":0}}]}'><a href="#cite_note-FOOTNOTETaiwan1996-16" id="mwDJU"><span class="mw-reflink-text" id="mwDJY"><span class="cite-bracket" id="mwDJc">[</span>13<span class="cite-bracket" id="mwDJg">]</span></span></a></sup></p>

<p id="mwDJk">If two strokes are connected at the endpoints, whether they are separated into two strokes or linked into one stroke can be judged by the following rules:<sup about="#mwt237" class="mw-ref reference" id="cite_ref-FOOTNOTESu201475–76_17-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTESu201475–76"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTESu201475–76-17"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Su"},"2":{"wt":"2014"},"pp":{"wt":"75-76"}},"i":0}}]}'><a href="#cite_note-FOOTNOTESu201475–76-17" id="mwDJo"><span class="mw-reflink-text" id="mwDJs"><span class="cite-bracket" id="mwDJw">[</span>14<span class="cite-bracket" id="mwDJ0">]</span></span></a></sup></p>

<ol id="mwDJ4"><li id="mwDJ8">If the two strokes are connected in the upper left corner of a character or component, then separate them into two strokes.
<dl id="mwDKA"><dd id="mwDKE">Examples:<span style="padding-left:0.5ic;" about="#mwt240" typeof="mw:Transclusion" id="mwDKI" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="zh" about="#mwt241" typeof="mw:Transclusion" id="mwDKM" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"厂"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>厂</span> (stroke order: ㇐㇓), <span lang="zh" about="#mwt242" typeof="mw:Transclusion" id="mwDKQ" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"口"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>口</span> (<b id="mwDKU">㇑㇕</b>㇐) and <span lang="zh" about="#mwt243" typeof="mw:Transclusion" id="mwDKY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"日"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>日</span> (<b id="mwDKc">㇑㇕</b>㇐㇐).</dd></dl></li>
<li id="mwDKg">If they are connected in the upper right corner, then one stroke.
<dl id="mwDKk"><dd id="mwDKo">Examples:<span style="padding-left:0.5ic;" about="#mwt244" typeof="mw:Transclusion" id="mwDKs" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="zh" about="#mwt245" typeof="mw:Transclusion" id="mwDKw" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"口"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>口</span> (㇑<b id="mwDK0">㇕</b>㇐), <span lang="zh" about="#mwt246" typeof="mw:Transclusion" id="mwDK4" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"月"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>月</span> (㇓<b id="mwDK8">㇆</b>㇐㇐), <span lang="zh" about="#mwt247" typeof="mw:Transclusion" id="mwDLA" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"句"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>句</span> (㇓<b id="mwDLE">㇆</b>㇑㇕㇐).</dd></dl></li>
<li id="mwDLI">If they are connected in the lower left corner, then if it is a fully enclosed structure, then count as two separated strokes
<dl id="mwDLM"><dd id="mwDLQ">Examples:<span style="padding-left:0.5ic;" about="#mwt248" typeof="mw:Transclusion" id="mwDLU" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="zh" about="#mwt249" typeof="mw:Transclusion" id="mwDLY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"口"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>口</span> (<b id="mwDLc">㇑</b>㇕<b id="mwDLg">㇐</b>), <span lang="zh" about="#mwt250" typeof="mw:Transclusion" id="mwDLk" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"回"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>回</span> (<b id="mwDLo">㇑</b>㇕<b id="mwDLs">㇑</b>㇕<b id="mwDLw">㇐㇐</b>), <span lang="zh" about="#mwt251" typeof="mw:Transclusion" id="mwDL0" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"田"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>田</span> (<b id="mwDL4">㇑</b>㇕㇐㇑<b id="mwDL8">㇐</b>)
<ul id="mwDMA"><li id="mwDME">Exceptions:<span style="padding-left:0.5ic;" about="#mwt252" typeof="mw:Transclusion" id="mwDMI" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="zh" about="#mwt253" typeof="mw:Transclusion" id="mwDMM" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"惯, 實, 母, 马, 鸟, 乌"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>惯, 實, 母, 马, 鸟, 乌</span></li></ul></dd></dl></li>
<li id="mwDMQ">If it is not fully enclosed, then count as one stroke.
<dl id="mwDMU"><dd id="mwDMY">Examples:<span style="padding-left:0.5ic;" about="#mwt254" typeof="mw:Transclusion" id="mwDMc" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="zh" about="#mwt255" typeof="mw:Transclusion" id="mwDMg" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"山"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>山</span> (㇑<b id="mwDMk">㇗</b>㇑), <span lang="zh" about="#mwt256" typeof="mw:Transclusion" id="mwDMo" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"区"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>区</span> (㇐㇓㇔<b id="mwDMs">㇗</b>), <span lang="zh" about="#mwt257" typeof="mw:Transclusion" id="mwDMw" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"葛"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>葛</span> (㇐㇑㇑㇑㇕㇐㇐㇓㇆㇓㇔<b id="mwDM0">㇗</b>) .
<ul id="mwDM4"><li id="mwDM8">Exceptions:<span style="padding-left:0.5ic;" about="#mwt258" typeof="mw:Transclusion" id="mwDNA" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="zh" about="#mwt259" typeof="mw:Transclusion" id="mwDNE" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"馬; 巨"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>馬; 巨</span>(Taiwan: 12511；Mainland：1515)</li></ul></dd></dl></li>
<li id="mwDNI">If they are connected in the lower right corner, then two strokes.
<dl id="mwDNM"><dd id="mwDNQ">Examples:<span style="padding-left:0.5ic;" about="#mwt260" typeof="mw:Transclusion" id="mwDNU" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="zh" about="#mwt261" typeof="mw:Transclusion" id="mwDNY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"口"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>口</span> (㇑<b id="mwDNc">㇕㇐</b>), <span lang="zh" about="#mwt262" typeof="mw:Transclusion" id="mwDNg" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"回"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>回</span> (㇑<b id="mwDNk">㇕</b>㇑<b id="mwDNo">㇕㇐㇐</b>), <span lang="zh" about="#mwt263" typeof="mw:Transclusion" id="mwDNs" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"田"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>田</span> (㇑<b id="mwDNw">㇕</b>㇐㇑<b id="mwDN0">㇐</b>).</dd></dl></li></ol>

<p id="mwDN4">An important prerequisite for connecting two strokes into one stroke is: the tail of the first stroke is connected with the head of the second stroke.</p>

</section><section data-mw-section-id="14" id="mwDN8" aria-labelledby="Distribution_of_characters"><div class="mw-heading mw-heading3"><h3 id="Distribution_of_characters">Distribution of characters</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=14" title="Edit section: Distribution of characters"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDOA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chart_of_Standard_Forms_of_Common_National_Characters" title="Chart of Standard Forms of Common National Characters" id="mwDOE">Chart of Standard Forms of Common National Characters</a> is a standard character set of 4,808 characters issued by Taiwan's Ministry of Education.
The stroke numbers of characters range from 1 to 32 strokes. The 11-stroke group has the most characters, taking 9.297% of the character set. On the average, there are 12.186 strokes per character.<sup about="#mwt264" class="mw-ref reference" id="cite_ref-FOOTNOTETaiwan1996_16-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTETaiwan1996"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTETaiwan1996-16"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Taiwan"},"2":{"wt":"1996"}},"i":0}}]}'><a href="#cite_note-FOOTNOTETaiwan1996-16" id="mwDOI"><span class="mw-reflink-text" id="mwDOM"><span class="cite-bracket" id="mwDOQ">[</span>13<span class="cite-bracket" id="mwDOU">]</span></span></a></sup><sup about="#mwt267" class="mw-ref reference" id="cite_ref-:0_18-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":0"},"body":{"id":"mw-reference-text-cite_note-:0-18"}}'><a href="#cite_note-:0-18" id="mwDOY"><span class="mw-reflink-text" id="mwDOc"><span class="cite-bracket" id="mwDOg">[</span>15<span class="cite-bracket" id="mwDOk">]</span></span></a></sup></p>

<p id="mwDOo">The <i id="mwDOs">List of Frequently Used Characters in Modern Chinese</i> (<span lang="zh-Hans" about="#mwt268" typeof="mw:Transclusion" id="mwDOw" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"s":{"wt":"现代汉语常用字表"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_simplified_Chinese-language_text"/>现代汉语常用字表</span>) is a standard character set of 3,500 characters issued by the Ministry of Education of the People's Republic of China.<sup about="#mwt273" class="mw-ref reference" id="cite_ref-19" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-19"}}'><a href="#cite_note-19" id="mwDO0"><span class="mw-reflink-text" id="mwDO4"><span class="cite-bracket" id="mwDO8">[</span>16<span class="cite-bracket" id="mwDPA">]</span></span></a></sup> The stroke numbers of characters range from 1 to 24 strokes. The 9-strokes characters are the most, taking 11.857% of the character set. On the average, there are 9.7409 strokes per character.<sup about="#mwt269" class="mw-ref reference" id="cite_ref-FOOTNOTEXing200720–21_20-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEXing200720–21"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEXing200720–21-20"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Xing"},"2":{"wt":"2007"},"pp":{"wt":"20-21"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEXing200720–21-20" id="mwDPE"><span class="mw-reflink-text" id="mwDPI"><span class="cite-bracket" id="mwDPM">[</span>17<span class="cite-bracket" id="mwDPQ">]</span></span></a></sup></p>

<p id="mwDPU">The <i id="mwDPY">Unicode Basic CJK Unified Ideographs</i> is an international standard character set issued by ISO and Unicode, the same character set of the China national standard 13000.1. There are 20,902 Chinese characters, including simplified and traditional characters from China, Japan and Korea (CJK).<sup about="#mwt276" class="mw-ref reference" id="cite_ref-unicode.org_21-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"unicode.org"},"body":{"id":"mw-reference-text-cite_note-unicode.org-21"}}'><a href="#cite_note-unicode.org-21" id="mwDPc"><span class="mw-reflink-text" id="mwDPg"><span class="cite-bracket" id="mwDPk">[</span>18<span class="cite-bracket" id="mwDPo">]</span></span></a></sup>
The stroke numbers of characters range from 1 to 48 strokes. The 12-strokes group has the most characters, taking 9.358% of the character set. On the average, there are 12.845 strokes per character.<sup about="#mwt277" class="mw-ref reference" id="cite_ref-FOOTNOTENational_Language_Commission1999_22-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTENational Language Commission1999"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTENational_Language_Commission1999-22"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"National Language Commission "},"2":{"wt":"1999"}},"i":0}}]}'><a href="#cite_note-FOOTNOTENational_Language_Commission1999-22" id="mwDPs"><span class="mw-reflink-text" id="mwDPw"><span class="cite-bracket" id="mwDP0">[</span>19<span class="cite-bracket" id="mwDP4">]</span></span></a></sup><sup about="#mwt280" class="mw-ref reference" id="cite_ref-FOOTNOTEXing200720–21_20-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEXing200720–21"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEXing200720–21-20"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Xing"},"2":{"wt":"2007"},"pp":{"wt":"20-21"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEXing200720–21-20" id="mwDP8"><span class="mw-reflink-text" id="mwDQA"><span class="cite-bracket" id="mwDQE">[</span>17<span class="cite-bracket" id="mwDQI">]</span></span></a></sup></p>

</section></section><section data-mw-section-id="15" id="mwDQM" aria-labelledby="Stroke_form"><div class="mw-heading mw-heading2"><h2 id="Stroke_form">Stroke form</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=15" title="Edit section: Stroke form"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDQQ">Stroke forms (<span lang="zh-Hans" about="#mwt283" typeof="mw:Transclusion" id="mwDQU" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"p":{"wt":"bǐxíng"},"t":{"wt":"筆形"},"s":{"wt":"笔形"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_simplified_Chinese-language_text"/>笔形</span><span about="#mwt283">; </span><span lang="zh-Hant" about="#mwt283"><link rel="mw:PageProp/Category" href="./Category:Articles_containing_traditional_Chinese-language_text"/>筆形</span><span about="#mwt283">; </span><i about="#mwt283" id="mwDQY"><span lang="zh-Latn">bǐxíng</span></i>) are the shapes of strokes. Different classification schemes have different numbers of categories by which one may classify individual strokes.<sup about="#mwt284" class="mw-ref reference" id="cite_ref-FOOTNOTEFei1997_23-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEFei1997"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEFei1997-23"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Fei"},"2":{"wt":"1997"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEFei1997-23" id="mwDQc"><span class="mw-reflink-text" id="mwDQg"><span class="cite-bracket" id="mwDQk">[</span>20<span class="cite-bracket" id="mwDQo">]</span></span></a></sup></p>

<section data-mw-section-id="16" id="mwDQs" aria-labelledby="Two_categories"><div class="mw-heading mw-heading3"><h3 id="Two_categories">Two categories</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=16" title="Edit section: Two categories"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDQw">The strokes of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Modern_Chinese_characters" title="Modern Chinese characters" id="mwDQ0">modern Chinese characters</a> can be divided into <i id="mwDQ4">plane strokes</i> (<span lang="zh" about="#mwt287" typeof="mw:Transclusion" id="mwDQ8" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"平笔"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>平笔</span>) and <i id="mwDRA">turning</i> or <i id="mwDRE">bent strokes</i> (<span lang="zh" about="#mwt288" typeof="mw:Transclusion" id="mwDRI" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"折笔"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>折笔</span>) .<sup about="#mwt289" class="mw-ref reference" id="cite_ref-FOOTNOTEPRC20211_24-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEPRC20211"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEPRC20211-24"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"PRC"},"2":{"wt":"2021"},"p":{"wt":"1"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEPRC20211-24" id="mwDRM"><span class="mw-reflink-text" id="mwDRQ"><span class="cite-bracket" id="mwDRU">[</span>21<span class="cite-bracket" id="mwDRY">]</span></span></a></sup></p>

<ul id="mwDRc"><li id="mwDRg"><b id="mwDRk">Plane</b> or <b id="mwDRo">basic strokes</b> move in only one direction, or only curve gently—usually less than 90 degrees.</li></ul>
<dl id="mwDRs"><dd id="mwDRw">Examples:<span style="padding-left:0.5ic;" about="#mwt292" typeof="mw:Transclusion" id="mwDR0" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><i id="mwDR4">heng</i> (<span lang="zh" about="#mwt293" typeof="mw:Transclusion" id="mwDR8" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"横"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>横</span>, <span lang="zh" about="#mwt294" typeof="mw:Transclusion" id="mwDSA" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"㇐"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>㇐</span>),  <i id="mwDSE">ti</i> (<span lang="zh" about="#mwt295" typeof="mw:Transclusion" id="mwDSI" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"提"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>提</span>, <span lang="zh" about="#mwt296" typeof="mw:Transclusion" id="mwDSM" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"㇀"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>㇀</span>), <i id="mwDSQ">shu</i> (<span lang="zh" about="#mwt297" typeof="mw:Transclusion" id="mwDSU" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"竖"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>竖</span>, <span lang="und-Hani" about="#mwt298" typeof="mw:Transclusion" id="mwDSY" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇑"}},"i":0}}]}'>㇑</span>), <i id="mwDSc">pie</i> (<span lang="zh" about="#mwt299" typeof="mw:Transclusion" id="mwDSg" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"撇"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>撇</span>, <span lang="und-Hani" about="#mwt300" typeof="mw:Transclusion" id="mwDSk" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇓"}},"i":0}}]}'>㇓</span>), <i id="mwDSo">dian</i> (<span lang="zh" about="#mwt301" typeof="mw:Transclusion" id="mwDSs" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"点"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>点</span>, <span lang="und-Hani" about="#mwt302" typeof="mw:Transclusion" id="mwDSw" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇔"}},"i":0}}]}'>㇔</span>),  <i id="mwDS0">na</i> (<span lang="zh" about="#mwt303" typeof="mw:Transclusion" id="mwDS4" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"捺"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>捺</span>, <span lang="und-Hani" about="#mwt304" typeof="mw:Transclusion" id="mwDS8" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇏"}},"i":0}}]}'>㇏</span>)</dd></dl>
<ul id="mwDTA"><li id="mwDTE"><b id="mwDTI">Bent strokes</b> are composed of plane strokes and turning points with sharper bends. Bent strokes also called <i id="mwDTM">derived strokes</i> (<span lang="zh" about="#mwt305" typeof="mw:Transclusion" id="mwDTQ" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"派生笔形"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>派生笔形</span>) or <i id="mwDTU">compound strokes</i> (<span lang="zh" about="#mwt306" typeof="mw:Transclusion" id="mwDTY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"复合笔形"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>复合笔形</span>).<sup about="#mwt307" class="mw-ref reference" id="cite_ref-FOOTNOTESu201478_25-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTESu201478"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTESu201478-25"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Su"},"2":{"wt":"2014"},"p":{"wt":"78"}},"i":0}}]}'><a href="#cite_note-FOOTNOTESu201478-25" id="mwDTc"><span class="mw-reflink-text" id="mwDTg"><span class="cite-bracket" id="mwDTk">[</span>22<span class="cite-bracket" id="mwDTo">]</span></span></a></sup></li></ul>
<dl id="mwDTs"><dd id="mwDTw">Examples:<span style="padding-left:0.5ic;" about="#mwt310" typeof="mw:Transclusion" id="mwDT0" data-mw='{"parts":[{"template":{"target":{"wt":"pad","href":"./Template:Pad"},"params":{"1":{"wt":"0.5ic"}},"i":0}}]}'><span typeof="mw:Entity"> </span></span><span lang="und-Hani" about="#mwt311" typeof="mw:Transclusion" id="mwDT4" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇕ ㇅ ㇎ ㇡ ㇋ ㇊ ㇍ ㇈ 乙 ㇆ ㇇ ㇌ [[File:Cjk m str hpj.svg|15px]] ㇗ ㇞ ㇉ ㄣ ㇙ ㇄ ㇟ ㇚ ㇜ ㇛  ㇃ ㇂"}},"i":0}}]}'>㇕ ㇅ ㇎ ㇡ ㇋ ㇊ ㇍ ㇈ 乙 ㇆ ㇇ ㇌ <span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_hpj.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_hpj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Cjk_m_str_hpj.svg/20px-Cjk_m_str_hpj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Cjk_m_str_hpj.svg/40px-Cjk_m_str_hpj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="15" width="15" class="mw-file-element"/></a></span> ㇗ ㇞ ㇉ ㄣ ㇙ ㇄ ㇟ ㇚ ㇜ ㇛  ㇃ ㇂</span>.</dd></dl>

</section><section data-mw-section-id="17" id="mwDT8" aria-labelledby="Five_categories"><div class="mw-heading mw-heading3"><h3 id="Five_categories">Five categories</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=17" title="Edit section: Five categories"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDUA">When the six plane strokes of <span lang="zh" about="#mwt312" typeof="mw:Transclusion" id="mwDUE" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"“heng (横, ㇐),  ti (提, ㇀), &apos;&apos;shu&apos;&apos; (竖, ㇑), &apos;&apos;pie&apos;&apos; (撇, ㇓), &apos;&apos;dian&apos;&apos; (点, ㇔),  na (捺, ㇏)”"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>“heng (横, ㇐),  ti (提, ㇀), <i>shu</i> (竖, ㇑), <i>pie</i> (撇, ㇓), <i>dian</i> (点, ㇔),  na (捺, ㇏)”</span> are classified into four categories by putting "ti" into category <i id="mwDUI">heng</i>, and <i id="mwDUM">na</i> into <i id="mwDUQ">dian</i>, then together with the bent stroke category, a five-category system is formed:<sup about="#mwt313" class="mw-ref reference" id="cite_ref-FOOTNOTESu201479_26-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTESu201479"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTESu201479-26"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Su"},"2":{"wt":"2014"},"p":{"wt":"79"}},"i":0}}]}'><a href="#cite_note-FOOTNOTESu201479-26" id="mwDUU"><span class="mw-reflink-text" id="mwDUY"><span class="cite-bracket" id="mwDUc">[</span>23<span class="cite-bracket" id="mwDUg">]</span></span></a></sup></p>
<ol id="mwDUk"><li id="mwDUo"><i id="mwDUs">heng</i> (<span lang="zh" about="#mwt316" typeof="mw:Transclusion" id="mwDUw" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"横"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>横</span>, <span lang="und-Hani" about="#mwt317" typeof="mw:Transclusion" id="mwDU0" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇐"}},"i":0}}]}'>㇐</span>),  <i id="mwDU4">ti</i> (<span lang="zh" about="#mwt318" typeof="mw:Transclusion" id="mwDU8" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"提"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>提</span>, <span lang="und-Hani" about="#mwt319" typeof="mw:Transclusion" id="mwDVA" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇀"}},"i":0}}]}'>㇀</span>).</li>
<li id="mwDVE">shu (<span lang="zh" about="#mwt320" typeof="mw:Transclusion" id="mwDVI" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"竖"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>竖</span>, <span lang="und-Hani" about="#mwt321" typeof="mw:Transclusion" id="mwDVM" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇑"}},"i":0}}]}'>㇑</span>).</li>
<li id="mwDVQ">pie (<span lang="zh" about="#mwt322" typeof="mw:Transclusion" id="mwDVU" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"撇"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>撇</span>, <span lang="und-Hani" about="#mwt323" typeof="mw:Transclusion" id="mwDVY" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇓"}},"i":0}}]}'>㇓</span>).</li>
<li id="mwDVc">dian (<span lang="zh" about="#mwt324" typeof="mw:Transclusion" id="mwDVg" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"点"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>点</span>, <span lang="und-Hani" about="#mwt325" typeof="mw:Transclusion" id="mwDVk" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇔"}},"i":0}}]}'>㇔</span>),  <i id="mwDVo">na</i> (<span lang="zh" about="#mwt326" typeof="mw:Transclusion" id="mwDVs" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"捺"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>捺</span>, <span lang="und-Hani" about="#mwt327" typeof="mw:Transclusion" id="mwDVw" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇏"}},"i":0}}]}'>㇏</span>).</li>
<li id="mwDV0">Bent strokes: <span lang="und-Hani" about="#mwt328" typeof="mw:Transclusion" id="mwDV4" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"㇕ ㇅ ㇎ ㇡ ㇋ ㇊ ㇍ ㇈ 乙 ㇆ ㇇ ㇌ 乁 ⺄ ㇗ ㇞ ㇉ ㄣ ㇙ ㇄ ㇟ ㇚ ㇜ ㇛ ㇃ ㇂"}},"i":0}}]}'>㇕ ㇅ ㇎ ㇡ ㇋ ㇊ ㇍ ㇈ 乙 ㇆ ㇇ ㇌ 乁 ⺄ ㇗ ㇞ ㇉ ㄣ ㇙ ㇄ ㇟ ㇚ ㇜ ㇛ ㇃ ㇂</span>.</li></ol>
<p id="mwDV8">Current national standards of PRC such as <i id="mwDWA">Stroke Orders of Commonly-used Standard Chinese Characters</i> and many reference works published in China adopt the five categories of strokes, and stipulate the <i id="mwDWE">heng</i>–<i id="mwDWI">shu</i>–<i id="mwDWM">pie</i>–<i id="mwDWQ">dian</i>–<i id="mwDWU">zhe</i> (<span lang="zh" about="#mwt329" typeof="mw:Transclusion" id="mwDWY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"横竖撇点折"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>横竖撇点折</span>) stroke-group order. This order is consistent with the stroke order of the character <span lang="zh" about="#mwt330" typeof="mw:Transclusion" id="mwDWc" data-mw='{"parts":[{"template":{"target":{"wt":"zhc","href":"./Template:Zhc"},"params":{"c":{"wt":"札"},"p":{"wt":"zhá"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>札</span><span about="#mwt330"> (</span><i about="#mwt330"><span lang="zh-Latn">zhá</span></i><span typeof="mw:Entity" about="#mwt330">)</span>: ㇐㇑㇓㇔㇟, and as such is called the "<span lang="zh" about="#mwt331" typeof="mw:Transclusion" id="mwDWg" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"札"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>札</span> order".<sup about="#mwt332" class="mw-ref reference" id="cite_ref-FOOTNOTEPRC2021_15-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEPRC2021"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEPRC2021-15"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"PRC"},"2":{"wt":"2021"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEPRC2021-15" id="mwDWk"><span class="mw-reflink-text" id="mwDWo"><span class="cite-bracket" id="mwDWs">[</span>12<span class="cite-bracket" id="mwDWw">]</span></span></a></sup> In Hong Kong and Taiwan among other places, people also use the group order of <i id="mwDW0">dian</i>–<i id="mwDW4">heng</i>–<i id="mwDW8">shu</i>–<i id="mwDXA">pie</i>–<i id="mwDXE">zhe</i> (<span lang="zh-Hant" about="#mwt335" typeof="mw:Transclusion" id="mwDXI" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"t":{"wt":"點橫豎撇折"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_traditional_Chinese-language_text"/>點橫豎撇折</span>)<sup about="#mwt336" class="mw-ref reference" id="cite_ref-FOOTNOTEWangZou200324_27-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEWangZou200324"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEWangZou200324-27"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Wang"},"2":{"wt":"Zou"},"3":{"wt":"2003"},"p":{"wt":"24"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEWangZou200324-27" id="mwDXM"><span class="mw-reflink-text" id="mwDXQ"><span class="cite-bracket" id="mwDXU">[</span>24<span class="cite-bracket" id="mwDXY">]</span></span></a></sup></p>

<p id="mwDXc">The five basic strokes of <i id="mwDXg">heng</i> (<span lang="und-Hani" about="#mwt339" typeof="mw:Transclusion" id="mwDXk" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"一"}},"i":0}}]}'>一</span>), <i id="mwDXo">shu</i> (<span lang="und-Hani" about="#mwt340" typeof="mw:Transclusion" id="mwDXs" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"丨"}},"i":0}}]}'>丨</span>), <i id="mwDXw">pie</i> (<span lang="und-Hani" about="#mwt341" typeof="mw:Transclusion" id="mwDX0" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"丿"}},"i":0}}]}'>丿</span>), <i id="mwDX4">dian</i> (<span lang="und-Hani" about="#mwt342" typeof="mw:Transclusion" id="mwDX8" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"丶"}},"i":0}}]}'>丶</span>), and <i id="mwDYA">zhe</i> (<span lang="und-Hani" about="#mwt343" typeof="mw:Transclusion" id="mwDYE" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"𠃍"}},"i":0}}]}'>𠃍</span>) at the beginning of each group are called main stroke shapes; and the following strokes are called subordinate stroke shapes, or secondary strokes. The name of a category is the name of the main stroke. For example, category <i id="mwDYI">heng</i> include main stroke <i id="mwDYM">heng</i> and secondary stroke <i id="mwDYQ">ti</i>.</p>

<p id="mwDYU">There are disputes over the classification of the vertical hook stroke (<span lang="und-Hani" about="#mwt344" typeof="mw:Transclusion" id="mwDYY" data-mw='{"parts":[{"template":{"target":{"wt":"hani","href":"./Template:Hani"},"params":{"1":{"wt":"亅"}},"i":0}}]}'>亅</span>) among the five types of strokes. In the currently effective national standards, <span lang="zh" about="#mwt345" typeof="mw:Transclusion" id="mwDYc" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"1":{"wt":"亅"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>亅</span> belongs to category <i id="mwDYg">shu</i>,<sup about="#mwt346" class="mw-ref reference" id="cite_ref-FOOTNOTENational_Language_Commission19992_28-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTENational Language Commission19992"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTENational_Language_Commission19992-28"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"National Language Commission "},"2":{"wt":"1999"},"p":{"wt":"2"}},"i":0}}]}'><a href="#cite_note-FOOTNOTENational_Language_Commission19992-28" id="mwDYk"><span class="mw-reflink-text" id="mwDYo"><span class="cite-bracket" id="mwDYs">[</span>25<span class="cite-bracket" id="mwDYw">]</span></span></a></sup> but some language scholars argue that it should be put in the <i id="mwDY0">zhe</i> ('bend') category.<sup about="#mwt349" class="mw-ref reference" id="cite_ref-FOOTNOTESu201478_25-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTESu201478"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTESu201478-25"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Su"},"2":{"wt":"2014"},"p":{"wt":"78"}},"i":0}}]}'><a href="#cite_note-FOOTNOTESu201478-25" id="mwDY4"><span class="mw-reflink-text" id="mwDY8"><span class="cite-bracket" id="mwDZA">[</span>22<span class="cite-bracket" id="mwDZE">]</span></span></a></sup></p>

</section><section data-mw-section-id="18" id="mwDZI" aria-labelledby="Eight_categories"><div class="mw-heading mw-heading3"><h3 id="Eight_categories">Eight categories</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=18" title="Edit section: Eight categories"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDZM">In this classification, a new category <i id="mwDZQ">gou</i> (<span lang="zh" about="#mwt352" typeof="mw:Transclusion" id="mwDZU" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"钩"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>钩</span> 'hook'), which include all the strokes with hooks, is divided out from the original bend category; then, together with the six types of plane strokes, an eight-category system is formed:<sup about="#mwt353" class="mw-ref reference" id="cite_ref-FOOTNOTESu201479_26-1" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTESu201479"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTESu201479-26"},"parts":[{"template":{"target":{"wt":"sfn","href":"./Template:Sfn"},"params":{"1":{"wt":"Su"},"2":{"wt":"2014"},"p":{"wt":"79"}},"i":0}}]}'><a href="#cite_note-FOOTNOTESu201479-26" id="mwDZY"><span class="mw-reflink-text" id="mwDZc"><span class="cite-bracket" id="mwDZg">[</span>23<span class="cite-bracket" id="mwDZk">]</span></span></a></sup></p>
<ol id="mwDZo"><li id="mwDZs"><i id="mwDZw">heng</i> (<span lang="zh" about="#mwt356" typeof="mw:Transclusion" id="mwDZ0" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"横"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>横</span>): ㇐</li>
<li id="mwDZ4"><i id="mwDZ8">ti</i> (<span lang="zh" about="#mwt357" typeof="mw:Transclusion" id="mwDaA" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"提"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>提</span>): ㇀</li>
<li id="mwDaE"><i id="mwDaI">shu</i> (<span lang="zh" about="#mwt358" typeof="mw:Transclusion" id="mwDaM" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"竖"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>竖</span>): ㇑</li>
<li id="mwDaQ"><i id="mwDaU">pie</i> (<span lang="zh" about="#mwt359" typeof="mw:Transclusion" id="mwDaY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"撇"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>撇</span>): ㇓</li>
<li id="mwDac"><i id="mwDag">dian</i> (<span lang="zh" about="#mwt360" typeof="mw:Transclusion" id="mwDak" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"点"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>点</span>): ㇔</li>
<li id="mwDao"><i id="mwDas">na</i> (<span lang="zh" about="#mwt361" typeof="mw:Transclusion" id="mwDaw" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"捺"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>捺</span>): ㇏</li>
<li id="mwDa0"><i id="mwDa4">zhe</i> (<span lang="zh" about="#mwt362" typeof="mw:Transclusion" id="mwDa8" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"折"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>折</span> 'bend'): ㇕ ㇅ ㇎ ㇋ ㇊ ㇍ ㇇ ㇗ ㇞ ㄣ ㇙ ㇄ ㇜ ㇛</li>
<li id="mwDbA"><i id="mwDbE">gou</i> (<span lang="zh" about="#mwt363" typeof="mw:Transclusion" id="mwDbI" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"钩"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>钩</span>, 'hook'): ㇡ ㇈ 乙 ㇆ ㇌ ㇤ ㇉ ㇟ ㇚ ㇃ ㇂</li></ol>
<p id="mwDbM">Because the character <span lang="zh" about="#mwt364" typeof="mw:Transclusion" id="mwDbQ" data-mw='{"parts":[{"template":{"target":{"wt":"zhc","href":"./Template:Zhc"},"params":{"c":{"wt":"永"},"p":{"wt":"yǒng"},"l":{"wt":"forever"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>永</span><span about="#mwt364"> (</span><i about="#mwt364"><span lang="zh-Latn">yǒng</span></i><span about="#mwt364">; </span><span typeof="mw:Entity" about="#mwt364">'</span><span about="#mwt364">forever</span><span typeof="mw:Entity" about="#mwt364">'</span><span typeof="mw:Entity" about="#mwt364">)</span> happens to contain strokes similar to each of these eight types, this classification is also called the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eight_Principles_of_Yong" title="Eight Principles of Yong" id="mwDbU">Eight Principles of Yong</a>.</p>

</section><section data-mw-section-id="19" id="mwDbY" aria-labelledby="CJK_strokes"><div class="mw-heading mw-heading3"><h3 id="CJK_strokes">CJK strokes</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=19" title="Edit section: CJK strokes"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDbc">The stroke forms of a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Standard_Chinese" title="Standard Chinese" id="mwDbg">standard Chinese</a> character set can be classified into a more detailed stroke table (or stroke list), for instance, the Unicode CJK strokes list has 36 types of stroke:</p>
<table class="wikitable nounderlines" style="border-collapse:collapse;background:var(--background-color-base,#fff);color:inherit;font-size:large;text-align:center" about="#mwt365" typeof="mw:Transclusion" id="mwDbk" data-mw='{"parts":[{"template":{"target":{"wt":"Unicode chart CJK Strokes","href":"./Template:Unicode_chart_CJK_Strokes"},"params":{},"i":0}}]}'>
<tbody><tr><td colspan="17" style="background:var(--background-color-neutral-subtle,#f8f9fa);color:inherit;font-size:small"><b><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/CJK_Strokes_(Unicode_block)" title="CJK Strokes (Unicode block)">CJK Strokes</a></b><style data-mw-deduplicate="TemplateStyles:r1041539562" typeof="mw:Extension/templatestyles" about="#mwt366" data-mw='{"name":"templatestyles","attrs":{"src":"Citation/styles.css"}}'>.mw-parser-output .citation{word-wrap:break-word}.mw-parser-output .citation:target{background-color:rgba(0,127,255,0.133)}</style><sup class="citation nobold" id="ref_U31C0_as_of_Unicode_version"><a rel="mw:WikiLink" href="#endnote_U31C0_as_of_Unicode_version" class="mw-selflink-fragment">[1]</a></sup><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1041539562" about="#mwt367" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Citation/styles.css"}}'/><sup class="citation nobold" id="ref_U31C0_grey"><a rel="mw:WikiLink" href="#endnote_U31C0_grey" class="mw-selflink-fragment">[2]</a></sup><br/><a rel="mw:ExtLink nofollow" href="https://www.unicode.org/charts/PDF/U31C0.pdf" class="external text">Official Unicode Consortium code chart</a> (PDF)</td></tr>
<tr style="background:var(--background-color-neutral-subtle,#f8f9fa);color:inherit;font-size:small">
<td style="width:45pt"><span typeof="mw:Entity"> </span></td><td style="width:20pt">0</td><td style="width:20pt">1</td><td style="width:20pt">2</td><td style="width:20pt">3</td><td style="width:20pt">4</td><td style="width:20pt">5</td><td style="width:20pt">6</td><td style="width:20pt">7</td><td style="width:20pt">8</td><td style="width:20pt">9</td><td style="width:20pt">A</td><td style="width:20pt">B</td><td style="width:20pt">C</td><td style="width:20pt">D</td><td style="width:20pt">E</td><td style="width:20pt">F</td></tr>
