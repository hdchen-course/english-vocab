<td id="mwBP0">(1) <span title="Chinese-language text" about="#mwt144" typeof="mw:Transclusion" id="mwBP4" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"{{linktext|乀|}}"}},"i":0}}]}'><span lang="zh"><a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/乀" title="wikt:乀" class="extiw">乀</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt144" id="mwBP8"/> <i id="mwBQA">fú</i>, "stretch".  (2) <span title="Chinese-language text" about="#mwt145" typeof="mw:Transclusion" id="mwBQE" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"{{linktext|乁|}}"}},"i":0}}]}'><span lang="zh"><a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/乁" title="wikt:乁" class="extiw">乁</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt145" id="mwBQI"/> <i id="mwBQM">yí</i>, "to move" (archaic).</td>
<td id="mwBQQ">尐 之 道 八 入 廻</td>
<td id="mwBQU">U+31DD (㇝)</td></tr>
<tr id="mwBQY">
<td id="mwBQc"><span class="skin-invert" typeof="mw:File" id="mwBQg"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_pj.svg" class="mw-file-description" id="mwBQk"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_pj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Cjk_m_str_pj.svg/40px-Cjk_m_str_pj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/67/Cjk_m_str_pj.svg/60px-Cjk_m_str_pj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwBQo"/></a></span></td>
