<td id="mwBQ4">Xié Gōu</td>
<td id="mwBQ8"><span typeof="mw:Entity" id="mwBRA"> </span></td>
<td id="mwBRE">戈 弋 戰 我</td>
<td id="mwBRI">U+31C2 (㇂)</td></tr>
<tr id="mwBRM">
