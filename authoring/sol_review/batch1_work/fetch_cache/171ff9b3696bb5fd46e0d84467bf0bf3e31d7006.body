<tr id="mwyg">
<td id="mwyw">Vertical</td><td id="mwzA"><i id="mwzQ">Shù</i>, <span title="Chinese-language text" about="#mwt26" typeof="mw:Transclusion" id="mwzg" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hans"},"2":{"wt":"竖"}},"i":0}}]}'><span lang="zh-Hans">竖</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt26" id="mwzw"/></td><td id="mw0A"><i id="mw0Q">Shù</i>, <span title="Chinese-language text" about="#mwt27" typeof="mw:Transclusion" id="mw0g" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"豎"}},"i":0}}]}'><span lang="zh-Hant">豎</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt27" id="mw0w"/></td><td id="mw1A"><i id="mw1Q">Tate</i>, <span title="Japanese-language text" about="#mwt28" typeof="mw:Transclusion" id="mw1g" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"豎"}},"i":0}}]}'><span lang="ja">豎</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt28" id="mw1w"/></td>
