<tr id="mwtQ">
<td id="mwtg">Horizontal</td><td id="mwtw"><i id="mwuA">Héng</i>, <span title="Chinese-language text" about="#mwt23" typeof="mw:Transclusion" id="mwuQ" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hans"},"2":{"wt":"横"}},"i":0}}]}'><span lang="zh-Hans">横</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt23" id="mwug"/></td><td id="mwuw"><i id="mwvA">Héng</i>, <span title="Chinese-language text" about="#mwt24" typeof="mw:Transclusion" id="mwvQ" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"橫"}},"i":0}}]}'><span lang="zh-Hant">橫</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt24" id="mwvg"/></td><td id="mwvw"><i id="mwwA">Yoko</i>, <span title="Japanese-language text" about="#mwt25" typeof="mw:Transclusion" id="mwwQ" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"横"}},"i":0}}]}'><span lang="ja">横</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt25" id="mwwg"/></td>
