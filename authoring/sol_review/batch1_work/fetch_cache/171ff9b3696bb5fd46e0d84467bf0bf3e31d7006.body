</section><section data-mw-section-id="36" id="mwEZ8" aria-labelledby="Notes"><div class="mw-heading mw-heading2"><h2 id="Notes">Notes</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=36" title="Edit section: Notes"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<span class="mw-empty-elt" about="#mwt671" typeof="mw:Transclusion" id="mwEaA" data-mw='{"parts":[{"template":{"target":{"wt":"Notelist","href":"./Template:Notelist"},"params":{},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1327269900" about="#mwt672" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Reflist/styles.css"}}'/></span><div about="#mwt671" id="mwEaE">
</div>
<span class="mw-empty-elt" about="#mwt674" typeof="mw:Transclusion" id="mwEaI" data-mw='{"parts":[{"template":{"target":{"wt":"notelist-ua","href":"./Template:Notelist-ua"},"params":{},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1327269900" about="#mwt675" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Reflist/styles.css"}}'/></span><div about="#mwt674" id="mwEaM">
<div class="mw-references-wrap" typeof="mw:Extension/references" about="#mwt676" id="mwEaQ" data-mw='{"name":"references","attrs":{"group":"upper-alpha","responsive":"1"},"body":{"extsrc":""}}'><ol class="mw-references references" data-mw-group="upper-alpha" id="mwEaU"><li about="#cite_note-37strokes-5" id="cite_note-37strokes-5" data-mw-footnote-number="A"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwEaY"><a href="#cite_ref-37strokes_5-0" data-mw-group="upper-alpha" id="mwEac"><span class="mw-linkback-text" id="mwEag">1</span></a> <a href="#cite_ref-37strokes_5-1" data-mw-group="upper-alpha" id="mwEak"><span class="mw-linkback-text" id="mwEao">2</span></a></span> <span id="mw-reference-text-cite_note-37strokes-5" class="mw-reference-text reference-text" data-mw-group="upper-alpha">The extended CJK(V) set of strokes has 29 strokes. These most common 29 used strokes can be reduced to combinations of 8 basic strokes, for a total of 37 strokes. The subset of 8 is found in the character "eternity" 永, hence the name of this set. But other sets of CJK(V) strokes can be found.</span></li>
</ol></div></div>

</section><section data-mw-section-id="37" id="mwEas" aria-labelledby="References"><div class="mw-heading mw-heading2"><h2 id="References">References</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=37" title="Edit section: References"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<span class="mw-empty-elt" about="#mwt677" typeof="mw:Transclusion" id="mwEaw" data-mw='{"parts":[{"template":{"target":{"wt":"reflist","href":"./Template:Reflist"},"params":{"group":{"wt":"upper-roman"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1327269900" about="#mwt678" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Reflist/styles.css"}}'/></span><div about="#mwt677" id="mwEa0">
</div>
