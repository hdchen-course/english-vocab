<tr id="mwBYc">
<td id="mwBYg"><span class="skin-invert" typeof="mw:File" id="mwBYk"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_-aj.svg" class="mw-file-description" id="mwBYo"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_-aj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f1/Cjk_m_str_-aj.svg/40px-Cjk_m_str_-aj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f1/Cjk_m_str_-aj.svg/60px-Cjk_m_str_-aj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwBYs"/></a></span></td>
