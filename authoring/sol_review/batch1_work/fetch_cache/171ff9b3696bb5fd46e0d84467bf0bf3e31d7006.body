<tr id="mw9Q">
<td id="mw9g">Press</td><td id="mw9w"><i id="mw-A">Nà</i>, <span title="Chinese-language text" about="#mwt32" typeof="mw:Transclusion" id="mw-Q" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"捺"}},"i":0}}]}'><span lang="zh">捺</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt32" id="mw-g"/></td><td id="mw-w"><i id="mw_A">Nà</i>, <span title="Chinese-language text" about="#mwt33" typeof="mw:Transclusion" id="mw_Q" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"捺"}},"i":0}}]}'><span lang="zh">捺</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt33" id="mw_g"/></td><td id="mw_w"><i id="mwAQA">(Migi) Harai</i>, <span title="Japanese-language text" about="#mwt34" typeof="mw:Transclusion" id="mwAQE" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"(右)払"}},"i":0}}]}'><span lang="ja">(右)払</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt34" id="mwAQI"/></td>
<td id="mwAQM">Mác 莫</td><td id="mwAQQ"><span class="skin-invert" typeof="mw:File" id="mwAQU"><a href="https://en.wikipedia.org/wiki/File:N_black.png" class="mw-file-description" id="mwAQY"><img resource="https://en.wikipedia.org/wiki/File:N_black.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/3/33/N_black.png/40px-N_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/3/33/N_black.png/60px-N_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="300" data-file-height="300" data-file-type="bitmap" height="25" width="25" class="mw-file-element" id="mwAQc"/></a></span></td><td id="mwAQg">"Press down"<br id="mwAQk"/>("(Right) Sweep")</td><td id="mwAQo">Falling rightwards (fattening at the bottom).</td></tr>
<tr id="mwAQs">
<td id="mwAQw">Throw</td><td id="mwAQ0"><i id="mwAQ4">Piě</i>, <span title="Chinese-language text" about="#mwt35" typeof="mw:Transclusion" id="mwAQ8" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hani"},"2":{"wt":"撇"}},"i":0}}]}'><span lang="zh-Hani">撇</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt35" id="mwARA"/></td><td id="mwARE"><i id="mwARI">Piě</i>, <span title="Chinese-language text" about="#mwt36" typeof="mw:Transclusion" id="mwARM" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hani"},"2":{"wt":"撇"}},"i":0}}]}'><span lang="zh-Hani">撇</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt36" id="mwARQ"/></td><td id="mwARU"><i id="mwARY">(Hidari) Harai</i>, <span title="Japanese-language text" about="#mwt37" typeof="mw:Transclusion" id="mwARc" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"(左)払"}},"i":0}}]}'><span lang="ja">(左)払</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt37" id="mwARg"/></td>
<td id="mwARk">Phẩy 𢵪</td><td id="mwARo"><span class="skin-invert" typeof="mw:File" id="mwARs"><a href="https://en.wikipedia.org/wiki/File:P_black.png" class="mw-file-description" id="mwARw"><img resource="https://en.wikipedia.org/wiki/File:P_black.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/P_black.png/40px-P_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/P_black.png/60px-P_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="300" data-file-height="300" data-file-type="bitmap" height="25" width="25" class="mw-file-element" id="mwAR0"/></a></span></td><td id="mwAR4">"Throw away"<br id="mwAR8"/>("(Left) Sweep")</td><td id="mwASA">Falling leftwards (with slight curve).</td></tr>
<tr id="mwASE">
<td colspan="8" id="mwASI"><b id="mwASM">Combining strokes</b></td></tr>
<tr id="mwASQ">
<td id="mwASU">Bend</td><td id="mwASY"><i id="mwASc">Zhé</i>, <span title="Chinese-language text" about="#mwt38" typeof="mw:Transclusion" id="mwASg" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hani"},"2":{"wt":"折"}},"i":0}}]}'><span lang="zh-Hani">折</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt38" id="mwASk"/></td><td id="mwASo"><i id="mwASs">Zhé</i>, <span title="Chinese-language text" about="#mwt39" typeof="mw:Transclusion" id="mwASw" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hani"},"2":{"wt":"折"}},"i":0}}]}'><span lang="zh-Hani">折</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt39" id="mwAS0"/></td><td id="mwAS4"><i id="mwAS8">Ore</i>, <span title="Japanese-language text" about="#mwt40" typeof="mw:Transclusion" id="mwATA" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"折"}},"i":0}}]}'><span lang="ja">折</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt40" id="mwATE"/></td>
<td id="mwATI">Gập 岋</td><td id="mwATM"><span class="skin-invert" typeof="mw:File" id="mwATQ"><a href="https://en.wikipedia.org/wiki/File:Cjk_turn.png" class="mw-file-description" id="mwATU"><img resource="https://en.wikipedia.org/wiki/File:Cjk_turn.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Cjk_turn.png/40px-Cjk_turn.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Cjk_turn.png/60px-Cjk_turn.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="25" width="25" class="mw-file-element" id="mwATY"/></a></span></td><td id="mwATc">"Bend, fold"</td><td id="mwATg">Indicates change in stroke direction, usually 90° turn, going down or going right only.</td></tr>
<tr id="mwATk">
<td id="mwATo">Hook</td><td id="mwATs"><i id="mwATw">Gōu</i>, <span title="Chinese-language text" about="#mwt41" typeof="mw:Transclusion" id="mwAT0" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hans"},"2":{"wt":"钩"}},"i":0}}]}'><span lang="zh-Hans">钩</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt41" id="mwAT4"/></td><td id="mwAT8"><i id="mwAUA">Gōu</i>, <span title="Chinese-language text" about="#mwt42" typeof="mw:Transclusion" id="mwAUE" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"鈎(鉤)"}},"i":0}}]}'><span lang="zh-Hant">鈎(鉤)</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt42" id="mwAUI"/></td><td id="mwAUM"><i id="mwAUQ">Kagi</i>, <span title="Japanese-language text" about="#mwt43" typeof="mw:Transclusion" id="mwAUU" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"鉤"}},"i":0}}]}'><span lang="ja">鉤</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt43" id="mwAUY"/></td>
<td id="mwAUc">Móc 鈢</td><td id="mwAUg"><span class="skin-invert" typeof="mw:File" id="mwAUk"><a href="https://en.wikipedia.org/wiki/File:G_black.png" class="mw-file-description" id="mwAUo"><img resource="https://en.wikipedia.org/wiki/File:G_black.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/G_black.png/40px-G_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/G_black.png/60px-G_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="300" data-file-height="300" data-file-type="bitmap" height="25" width="25" class="mw-file-element" id="mwAUs"/></a></span></td><td id="mwAUw">"Hook"</td><td id="mwAU0">Appended to other strokes, suddenly sharp turning before crash stopping.</td></tr>
<tr id="mwAU4">
<td id="mwAU8">Clockwise curve</td><td id="mwAVA"><i id="mwAVE">Wān</i>, <span title="Chinese-language text" about="#mwt44" typeof="mw:Transclusion" id="mwAVI" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hans"},"2":{"wt":"弯"}},"i":0}}]}'><span lang="zh-Hans">弯</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt44" id="mwAVM"/></td><td id="mwAVQ"><i id="mwAVU">Wān</i>, <span title="Chinese-language text" about="#mwt45" typeof="mw:Transclusion" id="mwAVY" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"彎"}},"i":0}}]}'><span lang="zh-Hant">彎</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt45" id="mwAVc"/></td><td id="mwAVg"><i id="mwAVk">(Hidari) Sori</i>, <span title="Japanese-language text" about="#mwt46" typeof="mw:Transclusion" id="mwAVo" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"(左)反"}},"i":0}}]}'><span lang="ja">(左)反</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt46" id="mwAVs"/></td>
<td id="mwAVw">Cong 𢏣</td><td id="mwAV0"><span class="skin-invert" typeof="mw:File" id="mwAV4"><a href="https://en.wikipedia.org/wiki/File:W_black.png" class="mw-file-description" id="mwAV8"><img resource="https://en.wikipedia.org/wiki/File:W_black.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/W_black.png/40px-W_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/W_black.png/60px-W_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="300" data-file-height="300" data-file-type="bitmap" height="25" width="25" class="mw-file-element" id="mwAWA"/></a></span></td><td id="mwAWE">"Curve"</td><td id="mwAWI">Tapering curved line, usually concave left (convex outward right).</td></tr>
<tr id="mwAWM">
<td id="mwAWQ">Anticlockwise curve</td><td id="mwAWU"><i id="mwAWY">Wān</i>, <span title="Chinese-language text" about="#mwt47" typeof="mw:Transclusion" id="mwAWc" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hans"},"2":{"wt":"弯"}},"i":0}}]}'><span lang="zh-Hans">弯</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt47" id="mwAWg"/>; <i id="mwAWk">Xié</i>, <span title="Chinese-language text" about="#mwt48" typeof="mw:Transclusion" id="mwAWo" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hans"},"2":{"wt":"斜"}},"i":0}}]}'><span lang="zh-Hans">斜</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt48" id="mwAWs"/></td><td id="mwAWw"><i id="mwAW0">Qū</i>, <span title="Chinese-language text" about="#mwt49" typeof="mw:Transclusion" id="mwAW4" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"曲"}},"i":0}}]}'><span lang="zh-Hant">曲</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt49" id="mwAW8"/></td><td id="mwAXA"><i id="mwAXE">(Migi) Sori</i>, <span title="Japanese-language text" about="#mwt50" typeof="mw:Transclusion" id="mwAXI" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ja"},"2":{"wt":"(右)反"}},"i":0}}]}'><span lang="ja">(右)反</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Japanese-language_text" about="#mwt50" id="mwAXM"/></td>
<td id="mwAXQ">Nghiêng 迎</td><td id="mwAXU">㇄; <span class="skin-invert" typeof="mw:File" id="mwAXY"><a href="https://en.wikipedia.org/wiki/File:X_black.png" class="mw-file-description" id="mwAXc"><img resource="https://en.wikipedia.org/wiki/File:X_black.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/X_black.png/40px-X_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/X_black.png/60px-X_black.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="300" data-file-height="300" data-file-type="bitmap" height="25" width="25" class="mw-file-element" id="mwAXg"/></a></span></td><td id="mwAXk">"(Right) curve"; "Slant"</td><td id="mwAXo">Curved line, usually concave right (convex outward left).</td></tr>
<tr class="mw-empty-elt" id="mwAXs"></tr>
</tbody></table>
<p id="mwAXw">Note, the basic stroke <i id="mwAX0">Diǎn</i> "Dot" is rarely a real <a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/dot" title="wikt:dot" class="extiw" id="mwAX4">dot</a>. Instead it usually takes the shape of a very small line pointing in one of several directions, and may be long enough to be confused with other strokes.</p>

</section><section data-mw-section-id="7" id="mwAX8" aria-labelledby="Compound_strokes"><div class="mw-heading mw-heading3"><h3 id="Compound_strokes">Compound strokes</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=7" title="Edit section: Compound strokes"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwAYA"><a href="https://en.wikipedia.org/wiki/File:CJK_37_Strokes_(8+29).png" class="mw-file-description" id="mwAYE"><img resource="https://en.wikipedia.org/wiki/File:CJK_37_Strokes_(8+29).png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/CJK_37_Strokes_%288%2B29%29.png/250px-CJK_37_Strokes_%288%2B29%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/CJK_37_Strokes_%288%2B29%29.png/500px-CJK_37_Strokes_%288%2B29%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1403" data-file-height="1936" data-file-type="bitmap" height="345" width="250" class="mw-file-element" id="mwAYI"/></a><figcaption id="mwAYM">Another classification using 37 strokes: 8 basic strokes, and 29 complex strokes<sup about="#mwt53" class="mw-ref reference" id="cite_ref-cjk37_4-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"cjk37"},"body":{"id":"mw-reference-text-cite_note-cjk37-4"}}'><a href="#cite_note-cjk37-4" id="mwAYQ"><span class="mw-reflink-text" id="mwAYU"><span class="cite-bracket" id="mwAYY">[</span>4<span class="cite-bracket" id="mwAYc">]</span></span></a></sup></figcaption></figure>
<p id="mwAYg">A compound stroke (also called a complex stroke) is produced when two or more basic strokes are combined in a single stroke written without lifting the writing instrument from the writing surface. The character <style data-mw-deduplicate="TemplateStyles:r1351297085" typeof="mw:Extension/templatestyles mw:Transclusion" about="#mwt54" id="mwAYk" data-mw='{"name":"templatestyles","attrs":{"src":"Script/styles.css"},"parts":[{"template":{"target":{"wt":"script","href":"./Template:Script"},"params":{"1":{"wt":"Hani"},"2":{"wt":"{{linktext|永}}"}},"i":0}}]}'>.mw-parser-output .script-Cprt{font-size:1.25em;font-family:"Segoe UI Historic","Noto Sans Cypriot",Code2001}.mw-parser-output .script-Hano{font-size:125%;font-family:"Noto Sans Hanunoo",FreeSerif,Quivira}.mw-parser-output .script-Latf,.mw-parser-output .script-de-Latf{font-size:1.25em;font-family:"Breitkopf Fraktur",UnifrakturCook,UniFrakturMaguntia,MarsFraktur,"MarsFraktur OT",KochFraktur,"KochFraktur OT",OffenbacherSchwabOT,"LOB.AlteSchwabacher","LOV.AlteSchwabacher","LOB.AtlantisFraktur","LOV.AtlantisFraktur","LOB.BreitkopfFraktur","LOV.BreitkopfFraktur","LOB.FetteFraktur","LOV.FetteFraktur","LOB.Fraktur3","LOV.Fraktur3","LOB.RochFraktur","LOV.RochFraktur","LOB.PostFraktur","LOV.PostFraktur","LOB.RuelhscheFraktur","LOV.RuelhscheFraktur","LOB.RungholtFraktur","LOV.RungholtFraktur","LOB.TheuerbankFraktur","LOV.TheuerbankFraktur","LOB.VinetaFraktur","LOV.VinetaFraktur","LOB.WalbaumFraktur","LOV.WalbaumFraktur","LOB.WeberMainzerFraktur","LOV.WeberMainzerFraktur","LOB.WieynckFraktur","LOV.WieynckFraktur","LOB.ZentenarFraktur","LOV.ZentenarFraktur"}.mw-parser-output .script-en-Latf{font-size:1.25em;font-family:Cankama,"Old English Text MT","Textura Libera","Textura Libera Tenuis",London}.mw-parser-output .script-it-Latf{font-size:1.25em;font-family:"Rotunda Pommerania",Rotunda,"Typographer Rotunda"}.mw-parser-output .script-Lina{font-size:1.25em;font-family:"Noto Sans Linear A"}.mw-parser-output .script-Linb{font-size:1.25em;font-family:"Noto Sans Linear B"}.mw-parser-output .script-Ugar{font-size:1.25em;font-family:"Segoe UI Historic","Noto Sans Ugaritic",Aegean}.mw-parser-output .script-Xpeo{font-size:1.25em;font-family:"Segoe UI Historic","Noto Sans Old Persian",Artaxerxes,Xerxes,Aegean}</style><span class="Unicode" about="#mwt54" id="mwAYo"><a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/永" title="wikt:永" class="extiw">永</a></span> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pinyin" title="Pinyin" id="mwAYs">pinyin</a>: <span title="Chinese-language text" about="#mwt56" typeof="mw:Transclusion" id="mwAYw" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Latn-pinyin"},"2":{"wt":"yǒng"}},"i":0}}]}'><i lang="zh-Latn-pinyin">yǒng</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt56" id="mwAY0"/>) "eternity", described in more detail in <a rel="mw:WikiLink" href="#Eight_Principles_of_Yong" about="#mwt57" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwAY4" data-mw='{"parts":[{"template":{"target":{"wt":"section link","href":"./Template:Section_link"},"params":{"1":{"wt":""},"2":{"wt":"Eight Principles of Yong"}},"i":0}}]}'>§<span typeof="mw:Entity"> </span>Eight Principles of Yong</a>, demonstrates one of these compound strokes. The centre line is a compound stroke that combines three stroke shapes in a single stroke.</p>

<dl id="mwAY8"><dt id="mwAZA">Basics for making compound strokes<sup about="#mwt58" class="mw-ref reference" id="cite_ref-37strokes_5-0" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"37strokes","group":"upper-alpha"},"body":{"html":""},"parts":[{"template":{"target":{"wt":"Efn-ua","href":"./Template:Efn-ua"},"params":{"name":{"wt":"\"37strokes\""}},"i":0}}]}'><a href="#cite_note-37strokes-5" data-mw-group="upper-alpha" id="mwAZE"><span class="mw-reflink-text" id="mwAZI"><span class="cite-bracket" id="mwAZM">[</span>A<span class="cite-bracket" id="mwAZQ">]</span></span></a></sup></dt></dl>
<p id="mwAZU">In most cases, concatenating basic strokes together form a compound stroke. For example, Vertical / <i id="mwAZY">Shù</i> combined with Hook / <i id="mwAZc">Gōu</i> produce <span class="skin-invert" typeof="mw:File" id="mwAZg"><a href="https://en.wikipedia.org/wiki/File:Cjk_k_str_vj.svg" class="mw-file-description" id="mwAZk"><img resource="https://en.wikipedia.org/wiki/File:Cjk_k_str_vj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Cjk_k_str_vj.svg/40px-Cjk_k_str_vj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Cjk_k_str_vj.svg/60px-Cjk_k_str_vj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwAZo"/></a></span> (Vertical–Hook / <i id="mwAZs">Shù Gōu</i>). A stroke naming convention sums the names of the basic strokes, in the writing order.</p>

<p id="mwAZw">An exception to this applies when a stroke makes a strictly right-angle turn in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Simplified_Chinese_characters" title="Simplified Chinese characters" id="mwAZ0">Simplified Chinese</a> names. Horizontal <span class="skin-invert" typeof="mw:File" id="mwAZ4"><a href="https://en.wikipedia.org/wiki/File:Cjk_k_str_h.svg" class="mw-file-description" id="mwAZ8"><img resource="https://en.wikipedia.org/wiki/File:Cjk_k_str_h.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Cjk_k_str_h.svg/40px-Cjk_k_str_h.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Cjk_k_str_h.svg/60px-Cjk_k_str_h.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwAaA"/></a></span> (<i id="mwAaE">Héng</i>) and Vertical <span class="skin-invert" typeof="mw:File" id="mwAaI"><a href="https://en.wikipedia.org/wiki/File:Cjk_k_str_v.svg" class="mw-file-description" id="mwAaM"><img resource="https://en.wikipedia.org/wiki/File:Cjk_k_str_v.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Cjk_k_str_v.svg/40px-Cjk_k_str_v.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Cjk_k_str_v.svg/60px-Cjk_k_str_v.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwAaQ"/></a></span> (Shù) strokes are identified only once when they appear as the first stroke of a compound; any single stroke with successive 90° turns down or to the right are indicated by a Bend 折 (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pinyin" title="Pinyin" id="mwAaU">pinyin</a>: <i id="mwAaY">zhé</i>). For example, an initial <i id="mwAac">Shù</i> followed by an abrupt turn right produces <span class="skin-invert" typeof="mw:File" id="mwAag"><a href="https://en.wikipedia.org/wiki/File:Cjk_k_str_vh.svg" class="mw-file-description" id="mwAak"><img resource="https://en.wikipedia.org/wiki/File:Cjk_k_str_vh.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/Cjk_k_str_vh.svg/40px-Cjk_k_str_vh.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/Cjk_k_str_vh.svg/60px-Cjk_k_str_vh.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwAao"/></a></span> (<i id="mwAas">Shù Zhé</i>). In the same way, an initial <i id="mwAaw">Shù</i> followed by an abrupt turn right followed by a second turn down produces <span class="skin-invert" typeof="mw:File" id="mwAa0"><a href="https://en.wikipedia.org/wiki/File:Cjk_k_str_vhv.svg" class="mw-file-description" id="mwAa4"><img resource="https://en.wikipedia.org/wiki/File:Cjk_k_str_vhv.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Cjk_k_str_vhv.svg/40px-Cjk_k_str_vhv.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Cjk_k_str_vhv.svg/60px-Cjk_k_str_vhv.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="25" width="25" class="mw-file-element" id="mwAa8"/></a></span> (<i id="mwAbA">Shù Zhé Zhé</i>). However, their inherited names are "Vertical–Horizontal" and "Vertical–Horizontal–Vertical".  We need not to use "Bend" in the inherited names.</p>

<p id="mwAbE">Nearly all complex strokes can be named using this scheme.</p>

</section></section><section data-mw-section-id="8" id="mwAbI" aria-labelledby="Nomenclature"><div class="mw-heading mw-heading2"><h2 id="Nomenclature">Nomenclature</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=8" title="Edit section: Nomenclature"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwAbM">Organization systems used to describe and differentiate strokes may include the use of roman letters, Chinese characters, numbers, or a combination of these devices. Two methods of organizing CJK strokes are by:</p>

<ul id="mwAbQ"><li id="mwAbU"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Classification_scheme" title="Classification scheme" class="mw-redirect" id="mwAbY">Classification schemes</a> that describe strokes by a naming convention or by conformity to a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Taxonomy_(general)" title="Taxonomy (general)" class="mw-redirect" id="mwAbc">taxonomy</a>; and</li>
<li id="mwAbg"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Categorization" title="Categorization" class="mw-redirect" id="mwAbk">Categorization schemes</a> that differentiate strokes by numeric or topical grouping.</li></ul>

<p id="mwAbo">In classification schemes, stroke forms are described, assigned a representative character or <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Letterform" title="Letterform" id="mwAbs">letterform</a>, and may be arranged in a hierarchy. In categorization schemes, stroke forms are differentiated, sorted and grouped into like categories; categories may be topical, or assigned by a numeric or alpha-numeric <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nominal_number" title="Nominal number" id="mwAbw">nominal number</a> according to a designed <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Numbering_scheme" title="Numbering scheme" id="mwAb0">numbering scheme</a>.</p>

<section data-mw-section-id="9" id="mwAb4" aria-labelledby="Pinyin_naming_convention_in_Unicode_standard"><div class="mw-heading mw-heading3"><h3 id="Pinyin_naming_convention_in_Unicode_standard">Pinyin naming convention in Unicode standard</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Chinese_character_strokes&amp;action=edit&amp;section=9" title="Edit section: Pinyin naming convention in Unicode standard"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwAb8">A naming convention is a classification scheme where a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Controlled_vocabulary" title="Controlled vocabulary" id="mwAcA">controlled vocabulary</a> is used systematically to describe the characteristics of an item. The naming convention for a CJK stroke is derived from the path mark left by the writing instrument. In this instance, the first letter of each stroke component - transliterated with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pinyin" title="Pinyin" id="mwAcE">pinyin</a> pronunciation - are concatenated to form a stroke name with the sequence of letters indicating the basic strokes or stroke components used to create the CJK stroke. This system is used in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Unicode" title="Unicode" id="mwAcI">Unicode</a> standard when encoding CJK stroke characters. In a basic stroke example, H represents the stroke <span class="skin-invert" typeof="mw:File" id="mwAcM"><a href="https://en.wikipedia.org/wiki/File:Cjk_k_str_h.svg" class="mw-file-description" id="mwAcQ"><img resource="https://en.wikipedia.org/wiki/File:Cjk_k_str_h.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Cjk_k_str_h.svg/40px-Cjk_k_str_h.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Cjk_k_str_h.svg/60px-Cjk_k_str_h.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwAcU"/></a></span> named <span lang="zh" about="#mwt61" typeof="mw:Transclusion" id="mwAcY" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"横"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>横</span> (<span title="Chinese-language romanization" about="#mwt62" typeof="mw:Transclusion" id="mwAcc" data-mw='{"parts":[{"template":{"target":{"wt":"transliteration","href":"./Template:Transliteration"},"params":{"1":{"wt":"zh"},"2":{"wt":"Héng"}},"i":0}}]}'><i lang="zh-Latn">Héng</i></span>); in a compound example, <code class="mw-highlight mw-highlight-lang-text mw-content-ltr" style="" dir="ltr" typeof="mw:Extension/syntaxhighlight mw:Transclusion" about="#mwt63" id="mwAcg" data-mw='{"name":"syntaxhighlight","attrs":{"lang":"text","class":"","style":"","inline":"1"},"body":{"extsrc":"HZT"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"1":{"wt":"HZT"}},"i":0}}]}'>HZT</code> represents <span lang="zh" about="#mwt65" typeof="mw:Transclusion" id="mwAck" data-mw='{"parts":[{"template":{"target":{"wt":"zhi","href":"./Template:Zhi"},"params":{"c":{"wt":"横折提"}},"i":0}}]}'><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text"/>横折提</span> (<span title="Chinese-language romanization" about="#mwt66" typeof="mw:Transclusion" id="mwAco" data-mw='{"parts":[{"template":{"target":{"wt":"transliteration","href":"./Template:Transliteration"},"params":{"1":{"wt":"zh"},"2":{"wt":"Héng zhé tí"}},"i":0}}]}'><i lang="zh-Latn">Héng zhé tí</i></span>).</p>

<p id="mwAcs">While no consensus exists, there are up to 12 distinct basic strokes that are identified by a unique radical.</p>

<table class="wikitable" id="mwAcw">
<caption id="mwAc0">Letters commonly used in CJK stroke naming conventions (12 items)<sup about="#mwt71" class="mw-ref reference" id="cite_ref-irg_6-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"irg"},"body":{"id":"mw-reference-text-cite_note-irg-6"}}'><a href="#cite_note-irg-6" id="mwAc4"><span class="mw-reflink-text" id="mwAc8"><span class="cite-bracket" id="mwAdA">[</span>5<span class="cite-bracket" id="mwAdE">]</span></span></a></sup></caption>
<tbody id="mwAdI"><tr id="mwAdM">
<th id="mwAdQ">Letter</th><th id="mwAdU">B</th><th id="mwAdY">D</th><th id="mwAdc">G</th><th id="mwAdg">H</th><th id="mwAdk">N</th><th id="mwAdo">P</th><th id="mwAds">Q</th><th id="mwAdw">S</th><th id="mwAd0">T</th><th id="mwAd4">W</th><th id="mwAd8">X</th><th id="mwAeA">Z</th></tr>
<tr id="mwAeE">
<th id="mwAeI">Stroke direction</th>
<td id="mwAeM"><span class="skin-invert" typeof="mw:File" id="mwAeQ"><a href="https://en.wikipedia.org/wiki/File:Cjk_bian.png" class="mw-file-description" id="mwAeU"><img resource="https://en.wikipedia.org/wiki/File:Cjk_bian.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Cjk_bian.png/60px-Cjk_bian.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Cjk_bian.png/120px-Cjk_bian.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAeY"/></a></span></td>
<td id="mwAec"><span class="skin-invert" typeof="mw:File" id="mwAeg"><a href="https://en.wikipedia.org/wiki/File:Cjk_dian.png" class="mw-file-description" id="mwAek"><img resource="https://en.wikipedia.org/wiki/File:Cjk_dian.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Cjk_dian.png/60px-Cjk_dian.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Cjk_dian.png/120px-Cjk_dian.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAeo"/></a></span></td>
<td id="mwAes"><span class="skin-invert" typeof="mw:File" id="mwAew"><a href="https://en.wikipedia.org/wiki/File:Cjk_gou.png" class="mw-file-description" id="mwAe0"><img resource="https://en.wikipedia.org/wiki/File:Cjk_gou.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Cjk_gou.png/60px-Cjk_gou.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Cjk_gou.png/120px-Cjk_gou.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAe4"/></a></span></td>
<td id="mwAe8"><span class="skin-invert" typeof="mw:File" id="mwAfA"><a href="https://en.wikipedia.org/wiki/File:Cjk_heng.png" class="mw-file-description" id="mwAfE"><img resource="https://en.wikipedia.org/wiki/File:Cjk_heng.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Cjk_heng.png/60px-Cjk_heng.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Cjk_heng.png/120px-Cjk_heng.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAfI"/></a></span></td>
<td id="mwAfM"><span class="skin-invert" typeof="mw:File" id="mwAfQ"><a href="https://en.wikipedia.org/wiki/File:Cjk_na.png" class="mw-file-description" id="mwAfU"><img resource="https://en.wikipedia.org/wiki/File:Cjk_na.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Cjk_na.png/60px-Cjk_na.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Cjk_na.png/120px-Cjk_na.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAfY"/></a></span></td>
<td id="mwAfc"><span class="skin-invert" typeof="mw:File" id="mwAfg"><a href="https://en.wikipedia.org/wiki/File:Cjk_pie.png" class="mw-file-description" id="mwAfk"><img resource="https://en.wikipedia.org/wiki/File:Cjk_pie.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Cjk_pie.png/60px-Cjk_pie.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Cjk_pie.png/120px-Cjk_pie.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAfo"/></a></span></td>
<td id="mwAfs"><span class="skin-invert" typeof="mw:File" id="mwAfw"><a href="https://en.wikipedia.org/wiki/File:Cjk_quan.png" class="mw-file-description" id="mwAf0"><img resource="https://en.wikipedia.org/wiki/File:Cjk_quan.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Cjk_quan.png/60px-Cjk_quan.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Cjk_quan.png/120px-Cjk_quan.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAf4"/></a></span></td>
<td id="mwAf8"><span class="skin-invert" typeof="mw:File" id="mwAgA"><a href="https://en.wikipedia.org/wiki/File:Cjk_shu.png" class="mw-file-description" id="mwAgE"><img resource="https://en.wikipedia.org/wiki/File:Cjk_shu.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/4/48/Cjk_shu.png/60px-Cjk_shu.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/4/48/Cjk_shu.png/120px-Cjk_shu.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAgI"/></a></span></td>
<td id="mwAgM"><span class="skin-invert" typeof="mw:File" id="mwAgQ"><a href="https://en.wikipedia.org/wiki/File:Cjk_ti.png" class="mw-file-description" id="mwAgU"><img resource="https://en.wikipedia.org/wiki/File:Cjk_ti.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/77/Cjk_ti.png/60px-Cjk_ti.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/77/Cjk_ti.png/120px-Cjk_ti.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAgY"/></a></span></td>
<td id="mwAgc"><span class="skin-invert" typeof="mw:File" id="mwAgg"><a href="https://en.wikipedia.org/wiki/File:Cjk_wan.png" class="mw-file-description" id="mwAgk"><img resource="https://en.wikipedia.org/wiki/File:Cjk_wan.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Cjk_wan.png/60px-Cjk_wan.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Cjk_wan.png/120px-Cjk_wan.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAgo"/></a></span></td>
<td id="mwAgs"><span class="skin-invert" typeof="mw:File" id="mwAgw"><a href="https://en.wikipedia.org/wiki/File:Cjk_xie.png" class="mw-file-description" id="mwAg0"><img resource="https://en.wikipedia.org/wiki/File:Cjk_xie.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Cjk_xie.png/60px-Cjk_xie.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Cjk_xie.png/120px-Cjk_xie.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="302" data-file-height="302" data-file-type="bitmap" height="45" width="45" class="mw-file-element" id="mwAg4"/></a></span></td>
