<td id="mwBRg">扁斜钩</td>
<td id="mwBRk"><b id="mwBRo">BXG</b></td>
<td id="mwBRs">Biǎn Xié Gōu</td>
<td id="mwBRw"><span typeof="mw:Entity" id="mwBR0"> </span></td>
<td id="mwBR4">心 必 沁 惢 蕊</td>
<td id="mwBR8">U+31C3 (㇃)</td></tr>
<tr id="mwBSA">
<td id="mwBSE"><span class="skin-invert" typeof="mw:File" id="mwBSI"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_cj.svg" class="mw-file-description" id="mwBSM"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_cj.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/8/80/Cjk_m_str_cj.svg/40px-Cjk_m_str_cj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/8/80/Cjk_m_str_cj.svg/60px-Cjk_m_str_cj.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwBSQ"/></a></span></td>
<td id="mwBSU">弯钩</td>
<td id="mwBSY"><b id="mwBSc">WG</b></td>
<td id="mwBSg">Wān Gōu</td>
<td id="mwBSk"><span typeof="mw:Entity" id="mwBSo"> </span></td>
<td id="mwBSs">狐 狱 豹 家 啄 嶽 貓 家 逐</td>
<td id="mwBSw">U+31C1 (㇁)</td></tr>
<tr id="mwBS0">
