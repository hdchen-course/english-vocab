[</span>b<span class="cite-bracket" id="mwBTg">]</span></span></a></sup></td>
<td id="mwBTk">圈</td>
<td id="mwBTo"><b id="mwBTs">Q</b></td>
<td id="mwBTw">Quān</td>
<td id="mwBT0"><span title="Chinese-language text" about="#mwt149" typeof="mw:Transclusion" id="mwBT4" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"{{linktext|〇|}}"}},"i":0}}]}'><span lang="zh"><a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/〇" title="wikt:〇" class="extiw">〇</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt149" id="mwBT8"/> <i id="mwBUA">líng</i>, "zero"; also read as <span title="Chinese-language text" about="#mwt150" typeof="mw:Transclusion" id="mwBUE" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"{{linktext|圈|}}"}},"i":0}}]}'><span lang="zh"><a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/圈" title="wikt:圈" class="extiw">圈</a></span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt150" id="mwBUI"/> <i id="mwBUM">quān</i>, "circle". Rare.</td>
<td id="mwBUQ">〇 㔔 㪳 㫈</td>
<td id="mwBUU">U+31E3 (㇣)</td></tr>
