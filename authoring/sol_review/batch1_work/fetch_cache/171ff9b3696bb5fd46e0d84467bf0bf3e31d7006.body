<td id="mwBZw"><b id="mwBZ0">DN</b><sup about="#mwt156" class="mw-ref reference" id="cite_ref-bishop_7-11" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"bishop"}}'><a href="#cite_note-bishop-7" id="mwBZ4"><span class="mw-reflink-text" id="mwBZ8"><span class="cite-bracket" id="mwBaA">[</span>6<span class="cite-bracket" id="mwBaE">]</span></span></a></sup></td>
<td id="mwBaI">Diǎn Nà</td>
<td id="mwBaM">This stroke has been merged into stroke <b id="mwBaQ">N</b> in Unicode.<sup about="#mwt157" class="mw-ref reference" id="cite_ref-IRGN1174_9-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"IRGN1174"}}'><a href="#cite_note-IRGN1174-9" id="mwBaU"><span class="mw-reflink-text" id="mwBaY"><span class="cite-bracket" id="mwBac">[</span>8<span class="cite-bracket" id="mwBag">]</span></span></a></sup></td>
<td id="mwBak">內 全 廴</td></tr>
<tr id="mwBao">
<td id="mwBas"><span class="skin-invert" typeof="mw:File" id="mwBaw"><a href="https://en.wikipedia.org/wiki/File:Cjk_m_str_fp.svg" class="mw-file-description" id="mwBa0"><img resource="https://en.wikipedia.org/wiki/File:Cjk_m_str_fp.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Cjk_m_str_fp.svg/40px-Cjk_m_str_fp.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Cjk_m_str_fp.svg/60px-Cjk_m_str_fp.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="512" data-file-type="drawing" height="30" width="30" class="mw-file-element" id="mwBa4"/></a></span></td>
