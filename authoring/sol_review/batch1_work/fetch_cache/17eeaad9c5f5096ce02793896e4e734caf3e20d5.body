<script type="text/javascript" src="./assets/owlcarousel/owl.carousel.min.js"></script>

		<script type="text/javascript"> 

			var monthNames = ["January", "February", "March", "April", "May", "June",	  "July", "August", "September", "October", "November", "December"	];
  
			var dt = new Date();
			var Month="June 28, 2016 ".substring(0,3);

			Month=monthNames[dt.getMonth()].substring(0,3); 
			
			var PMAM="AM";
			var hour = dt.getHours();
			if(hour >= 12)
			{
				PMAM="PM";
				hour=hour-12;
			}
			
			var Minutes = dt.getMinutes();
			document.getElementById("infoDate").innerHTML=Month+" <span>" + dt.getDate() + "</span>";
			document.getElementById("infoTime").innerHTML="Taiwan<span>" + right('0'+hour,2) + ":" + right('0'+Minutes,2) + "</span>" + PMAM;
			
			function right(str, num)
			{
				return str.substring(str.length-num,str.length)
			}
		</script>
	 
<script type="text/javascript" src="./assets/owlcarousel/owl.carousel.min.js"></script>

<script type="text/javascript">
	var monthNames = ["January", "February", "March", "April", "May", "June",
	  "July", "August", "September", "October", "November", "December"
	];

	var dt = new Date();
	var Month=monthNames[dt.getMonth()].substring(0,3);

	var PMAM="AM";
	var hour = dt.getHours();
	if(hour >= 12)
	{
		PMAM="PM";
		hour=hour-12;
	}

	var Minutes = dt.getMinutes();

	$("footer.footer_v2 .datetime-b").html(Month + " " + dt.getDate() + " Taiwan " +  right('0'+hour,2) + ":" + right('0'+Minutes,2) + " " + PMAM);
	


	function right(str, num)
	{
		return str.substring(str.length-num,str.length)
	}
</script>

