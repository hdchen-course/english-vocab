                        window.CHTChatOptions.recmdId = '';
                        window.CHTChatOptions.ciRecommend = '';
                        window.CHTChatOptions.memberSn = '';
                        window.CHTChatOptions.token = '';

                        //要讓花寶機器人自己算打開視窗的高度，就要讓embed.js最後載入，所以調整成document載入後才引用embed.js
                        $.getJS = function (href) {
                            var $d = $.Deferred();
                            var $script = $('<script/>', {
                                src: href
                            }).appendTo('body');
                            $d.resolve($script);
                            return $d.promise();
                        };
                        $(function () {
                            $.getJS('https://www.cht.com.tw/home/eshop/register/otpw_cors.js?20240328');
                        });
                    </script>
                    <style>
                        #online-cs #prime {
                            transition: all .4s;
                        }

                        #btn-scroll-top.scrolling-down ~ #online-cs #prime {
                            bottom: 86px;
                            transition: all .4s;
                        }

                        .cookie-wrap.fixed-action-area.always-on, .fixed-block{
                            z-index: 15000;
                        }
                        /*220510 增修 :  因使用舊有go-top 按鈕 class (原效果往上會消失)，加入顯示效果使機器人往上 scroll 也能顯示
                        */
                        .btn-scroll-top {
                            visibility: visible;
                            opacity: 1;
                        }
                    </style>
                    <script>
                        /*220510 增修 :  本身機器人按鈕，並無js 自動加入scroll top and down 效果，因此加入 舊有 go-top 的btn-scroll-top class 引用scroll top,down 效果，可以向下滑動至底
                       */
                        window.onload = function () {
                            $('#prime').addClass('btn-scroll-top');
                        };
                    </script>
