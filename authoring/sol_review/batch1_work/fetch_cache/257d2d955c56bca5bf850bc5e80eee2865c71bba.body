                <!--Begin Content-->
                <h1>Heavenly Stems and Earthly Branches</h1>
                <div class="border_blank">
                    <!--Content Start-->

							<!--Social Network -->



    <!-- End Social Network -->

    <div>



    <p class="self_align_left">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Heavenly stems and earthly branches are collectively known as Stem-Branch or Gan-Zhi.&nbsp; The 10 heavenly stems are Jia, Yi, Bing, Ding, Wu, Ji, Geng, Xin, Ren and Gui.&nbsp; The 12 earthly branches are Zi, Chou, Yin, Mao, Chen, Si, Wu, Wei, Shen, You, Xu and Hai.&nbsp; Each heavenly stem is paired with an earthly branch to form the Gan-Zhi sexagenary cycle that starts with Jia-Zi (Table 2).&nbsp; </p>

