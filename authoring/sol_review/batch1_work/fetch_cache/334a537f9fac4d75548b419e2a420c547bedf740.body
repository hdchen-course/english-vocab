	    <script src="/js/bootstrap.bundle.min.js" type="text/javascript" nonce="HvLGrv0+Tk2Lj7vceNn7dA=="></script>
        <script src="/js/jquery.cookie.js" type="text/javascript" nonce="HvLGrv0+Tk2Lj7vceNn7dA=="></script>
        <script src="/js/app.js" type="text/javascript" nonce="HvLGrv0+Tk2Lj7vceNn7dA=="></script>
        <script nonce="HvLGrv0+Tk2Lj7vceNn7dA==">
            $(function () {

                // === 統一綁定 GA 追蹤事件 ===
                $('.ga-track-link').on('click keypress', function (e) {
                    // 如果是鍵盤事件，確認是按下 Enter 鍵 (keyCode 13) 才觸發
                    if (e.type === 'keypress' && e.which !== 13) {
                        return;
                    }

                    var category = $(this).data('ga-category');
                    var action = $(this).data('ga-action');

                    // 呼叫原本的 GA 追蹤函數
                    if (typeof GoogleAnanlytice === "function") {
                        GoogleAnanlytice(category, action, '', '');
                    }
                });

                // 綁定登出確認視窗
                $('.logout-link').on('click', function () {
                    if (!confirm('確定登出？')) {
                        return false; // 若使用者按取消，則不執行跳轉
                    }
                });

                var b = 'ONEBAR';
                $("#btnSubscribe,#btnUnsubscribe").on("click", function (event) {
                    //var email = $.trim($("#txtEMail").val());
                    //if (email == "") {
                    //    event.preventDefault();
                    //    alert('請您輸入電子郵件地址。');
                    //    $("#txtEMail").focus();
                    //}
                    //else if (false == IsEMail(email)) {
                    //    event.preventDefault();
                    //    alert('請您輸入正確電子郵件地址。');
                    //    $("#txtEMail").focus();
                    //}
                    //else {
                    //    GoogleAnanlytice('中文', '訂閱電子報', '', '');
                    //}
                    var email = $.trim($("#txtEMail").val());
                    //if (!validateEmail(email)) {
                    //    alert('請您輸入正確電子郵件地址。');
                    //    return false;
                    //}

                });
                $('#btnQall').on("click", function () {
                    if ($.trim($("#keyword").val()) == "") {
                        alert("請輸入關鍵字"); return false;
                    }
                    else {
                        GoogleAnanlytice("中文", "整合查詢-首頁", "", "");
                        return true;
                    }
                });
                $('#btnDeepSearch').on("click", function () {
                    var keyword = '';

                    //20210315 加上判斷，取QueryString(KW)，若輸入關鍵字已搜尋過，則跳出提示訊息，避免重複搜尋
                    Request = GetRequest();
                    if ($.trim($("#keyword").val()) == "") {
                        alert("請輸入關鍵字"); return false;
                    }
                    else if (keyword.indexOf($.trim($("#keyword").val())) >= 0) {
                        alert("此關鍵字已包含至檢索字詞中，請重新輸入");
                        return false;
                    }
                    else {
                        GoogleAnanlytice("中文", "整合查詢-首頁", "", "");
                        return true;
                    }
                });
                $('#btnMsQall').on("click", function () {
                    if ($.trim($("#msKeyword").val()) == "") {
                        alert("請輸入關鍵字"); return false;
                    } else {
                        GoogleAnanlytice("中文", "整合查詢-首頁", "", "");
                        return true;
                    }
                });
                $('#btnMsDeepSearch').on("click", function () {
                    var keyword = '';

                    //20210315 加上判斷，取QueryString(KW)，若輸入關鍵字已搜尋過，則跳出提示訊息，避免重複搜尋
                    Request = GetRequest();
                    if ($.trim($("#msKeyword").val()) == "") {
                        alert("請輸入關鍵字"); return false;
                    } else if (keyword.indexOf($.trim($("#msKeyword").val())) >= 0) {
                        alert("此關鍵字已包含至檢索字詞中，請重新輸入");
                        return false;
                    }
                    else {
                        GoogleAnanlytice("中文", "整合查詢-首頁", "", "");
                        return true;
                    }
                });
                //20210217 再檢索收合、展開功能
                $("#btnOpen").click(function () {
                    if ($('#ulDeepSearch').hasClass('overflow-hidden')) {
                        $(this).html("收合");
                        $(this).prop('title', '隱藏部分「再檢索」篩選條件，僅顯示一行');
                        $("#ulDeepSearch").removeClass("overflow-hidden").addClass("overflow-inherit");
                    }
                    else {
                        $(this).html("展開");
                        $(this).prop('title', '顯示所有目前「再檢索」篩選條件');
                        $("#ulDeepSearch").removeClass("overflow-inherit").addClass("overflow-hidden");
                    }
                });
                $("#btnHelp").click(function () {
                    OpenKeyWordHelp();
                    return false;
                });
                // 綁定整合查詢的 Enter 鍵事件
                $('#keyword').keypress(function (e) {
                    if (e.which == 13) {
                        e.preventDefault();
                        $('#btnQall').click();
                    }
                });
                // --- 新增：綁定整合查詢的 Enter 鍵事件 (行動版) ---
                $('#msKeyword').keypress(function (e) {
                    if (e.which == 13) {
                        e.preventDefault();
                        $('#btnMsQall').click();
                    }
                });

                $('#dropdownMenu').attr('data-bs-toggle', 'dropdown');
                $('#unitlist').on("click", "a", function (e) {
                    e.preventDefault();
                    var $this = $(this).parent();
                    var a = $(this).html();
                    b = $this.data("value");
                    $this.addClass("select").siblings().removeClass("select");
                    $("#dropdownMenu").html(a);
                    $('#hidVal').val(b);
                });
                //$('#keyword').on('input propertychange paste keypress', function () {
                //    BindAutocomplete('#keyword', b);
                //});
                BindAutocompletes('#keyword', b);
                function BindAutocompletes(orl, stype) {
                   
                    $(orl).autocomplete({
                        source: function (request, response) {
                            $.ajax({
                                url: "../controls/GetTermList.ashx",
                                type: 'post',
                                dataType: "json",
                                data: {
                                    term: request.term, type: stype
                                },
                                success: function (data) {
                                    response(data);
                                }
                            });
                        },
                        minLength: 1, //至少輸入幾個字元才開始給提示
                        focus: function (event, ui) {
                            return false;
                        },
                        select: function (event, ui) {
                            if ($.trim(ui.item.PCODE).length == 0)
                                $(this).val(ui.item.TERM);
                            else
                                location.href = "../Hot/AddHotLaw.ashx?pcode=" + encodeURIComponent(ui.item.PCODE);

                            return false;
                        },
                        messages: { noResults: '', results: function () { } }//不顯示結果文字
                    }).data("ui-autocomplete")._renderItem = function (ul, item) {
                        if ($.trim(item.PCODE) != "")
                            return $("<li class='line'>")
                                .append("<span class='label label-info'>直接連結</span><a>" + item.TERM + "</a>")
                                .appendTo(ul);
                        else {
                            if (ul.find(".label-usual").length == 0)
                                return $("<li>")
                                    .append("<span class='label label-info label-usual'>常用詞彙</span><a>" + item.TERM + "</a>")
                                    .appendTo(ul);
                            else
                                return $("<li>")
                                    .append("<a>" + item.TERM + "</a>")
                                    .appendTo(ul);
                        }
                    };
                }
            });
            function validateEmail(email) {
                if (email.includes("%")) {
                    return false;
                }
                return true;
            }
            function OpenKeyWordHelp() {
                var a = "/Service/KeyWordHelp.aspx";
                TINY.box.show({ iframe: a, width: 810, height: 680 });
                //return false;
            }
            function GetRequest() {
                var url = location.search;
                var theRequest = new Object();
                if (url.indexOf("?") != -1) {
                    var str = url.substr(1);
                    strs = str.split("&");
                    for (var i = 0; i < strs.length; i++) {
                        theRequest[strs[i].split("=")[0]] = decodeURI(strs[i].split("=")[1]);
                    }
                }
                return theRequest;
            }

            //20210218 再檢索-收合/展開 按鈕判斷顯示時機(若檢索字詞有多行，才要顯示收合/展開，需依照版面尺寸更換條件)
            var urlParams = GetRequest();
            //var keyword = '';
            var keyword = urlParams["kw"] ? urlParams["kw"] : "";

            if (document.body.clientWidth + 17 > 1200) {
                if (keyword != null && keyword.length > 26) {
                    $("#btnOpen").removeClass("display-none");
                }
            } else {
                if (keyword != null && keyword.length > 19) {
                    $("#btnOpen").removeClass("display-none");
                }
            }

        </script>
        
    <script nonce="HvLGrv0+Tk2Lj7vceNn7dA=="  src="/js/jquery.fancybox.min.js" type="text/javascript"></script>
    <script nonce="HvLGrv0+Tk2Lj7vceNn7dA==" >
        $(function () {
            $('[data-fancybox]').fancybox({
                toolbar: false,
                smallBtn: true,
                iframe: {
                    css: {
                        width: '400px',
                        height: '170px'
                    }
                }
            });

            // 精準鎖定法規沿革、條文內容、要旨等存放文字的容器
            $('.text-pre, .col-data, .law-reg-content').each(function () {
                var $this = $(this);
                var text = $.trim($this.text());

                if (text.length === 0) return;

                // 正則表達式判斷：完全不含中文，且含有英文字母
                var hasChinese = /[\u4e00-\u9fa5]/.test(text);
                var hasEnglish = /[a-zA-Z]/.test(text);

                if (!hasChinese && hasEnglish) {
                    $this.attr('lang', 'en');
                }
            });
        });
    </script>

    </form>
</body>
