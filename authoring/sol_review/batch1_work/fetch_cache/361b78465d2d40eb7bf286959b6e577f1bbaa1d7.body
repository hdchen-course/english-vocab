g"/></div></button></div></div><div class="topbar-mobile-search-wrapper" style="--toolbar-mobile-search-wrapper-height:5.3rem"><hr class="topbar-hr" style="--toolbar-hr-height:0.1rem"/><div class="topbar-mobile-search-container" style="--mobile-search-container-margin:1rem;--toolbar-search-input-mobile-height:3.2rem;--max-nav-width:128rem;--page-padding-desktop:3.2rem;--page-padding-mobile:1.6rem"><button data-testid="close-search-results" class="toolbar-plain-button topbar-search-results-text-button topbar-close-search-results-text-button" style="--toolbar-icon-color:#5e6062;--toolbar-icon-darker-color:#424242;--button-min-width:45px"><div class="topbar-inner-text">Close</div></button><form action="#" data-testid="mobile-search" data-experiment="true" class="topbar-search-input-wrapper" style="--toolbar-icon-color:#5e6062;--light-blue-color:#0dc0dc;--search-button-bg-color:transparent;--search-icon-color:#5e6062;--button-min-width:45px"><input type="search" data-testid="mobile-search-input" value="" aria-label="Search this book" placeholder="Search this book" class="topbar-search-input" style="--toolbar-search-input-height:3.2rem"/><button data-experiment="true" aria-label="Search" class="toolbar-plain-button topbar-search-button desktop" style="--toolbar-icon-color:#5e6062;--toolbar-icon-darker-color:#424242;--button-min-width:45px;--search-button-bg-color:transparent;--search-button-transition:none;--search-icon-color:#5e6062"><svg width="18px" height="18px" viewBox="0 0 18 18" version="1.1" aria-hidden="true" role="img"><title>Search</title><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><g transform="translate(-938.000000, -206.000000)" fill="currentColor" fill-rule="nonzero"><path d="M945,206 C948.865993,206 952,209.134007 952,213 C952,214.662837 951.420201,216.190255 950.45174,217.391118 L955.03033,221.96967 C955.323223,222.262563 955.323223,222.737437 955.03033,223.03033 C954.764064,223.296597 954.3474,223.320803 954.053788,223.102948 L953.96967,223.03033 L949.391118,218.45174 C948.190255,219.420201 946.662837,220 945,220 C941.134007,220 938,216.865993 938,213 C938,209.134007 941.134007,206 945,206 Z M945,207.5 C941.962434,207.5 939.5,209.962434 939.5,213 C939.5,216.037566 941.962434,218.5 945,218.5 C948.037566,218.5 950.5,216.037566 950.5,213 C950.5,209.962434 948.037566,207.5 945,207.5 Z"></path></g></g></svg></button></form><div class="dropdown-wrapper topbar-text-resizer-dropdown mobile-variant mobile-toolbar-closed" data-testid="mobile-text-resizer"><button data-analytics-label="Change text size" aria-label="Change text size" aria-expanded="false" aria-controls="text-resizer-menu" class="plain-button filters-toggle dropdown-toggle"><div tabindex="-1"><img aria-hidden="true" alt="" src="/rex/releases/v4/d46cf7a/static/media/text-size.3058fef1.svg"/></div></button></div></div></div></div><div class="content-notifications-wrapper" style="--content-notifications-z-index:20;--content-notifications-top-desktop:12rem;--content-notifications-top-mobile:11.3rem"></div><div class="min-page-height" style="--min-desktop-content-size:33.1rem;--min-mobile-content-size:28rem"><div aria-live="polite" class="page-toast-container" style="--toast-z-index-desktop:19;--toast-z-index-mobile:21;--desktop-search-failure-top:12rem;--mobile-search-failure-top:11.3rem;--content-wrapper-max-width:128rem;--vertical-navbar-max-width:8rem"></div><div class="redo-padding" style="--layout-padding-desktop:3.2rem;--layout-padding-mobile:1.6rem"><main class="page-content" style="--content-text-width:82.5rem;--page-margin-top-desktop:3.2rem;--page-margin-top-mobile:1.6rem;--highlight-purple-text:var(--color-text-white);--highlight-pink-text:var(--color-text-white)" tabindex="-1"><div data-dynamic-style="true" id="main-content" tabindex="-1" class="main-content-styles" style="--content-text-scale:1"><div data-type="page" id="page_23d8c448-dbf4-40db-8db7-19055bb6f66a" class="chapter-content-module" data-book-content="true"><h2 data-type="document-title" id="page_23d8c448-dbf4-40db-8db7-19055bb6f66a_titlecreatedbycookbook" data-rex-keep="true"><span class="os-number">3.1</span>
<span class="os-divider"> </span>
<span data-type="" itemprop="" class="os-text">Functional Groups</span>
</h2><p class="folio-module">
  3.1 • Functional Groups
</p>
    
    <p id="para-00001">The structural features that make it possible to classify compounds into families are called <em data-effect="italics">functional groups.</em> A <span data-type="term" id="term-00001" group-by="f">functional group</span> is a group of atoms within a molecule that has a characteristic chemical behavior. Chemically, a given functional group behaves in nearly the same way in every molecule it’s a part of. For example, compare ethylene, a plant hormone that causes fruit to ripen, with menthene, a much more complicated molecule found in peppermint oil. Both substances contain a carbon–carbon double-bond functional group, and both therefore react with Br<sub>2</sub> in the same way to give a product in which a Br atom has added to each of the double-bond carbons (<a href="3-1-functional-groups#fig-00001" class="autogenerated-content figure-target-label" aria-label="View Figure 3.2">Figure 3.2</a>). This example is typical: <em data-effect="italics">the chemistry of every organic molecule, regardless of size and complexity, is determined by the functional groups it contains.</em></p>
    
    <div class="os-figure" id="fig-00001"><figure data-id="fig-00001" class="ui-has-child-figcaption">
    <span data-type="media" data-alt="Ethylene and menthene undergo a chemical reaction with bromine, forming their respective products">
    <button type="button" aria-label="Click to enlarge image of Ethylene and menthene undergo a chemical reaction with bromine, forming their respective products" class="image-button-wrapper"><img src="/apps/image-cdn/v1/f=webp/apps/archive/20260604.144757/resources/74436e0f7ecac44734c72f1b8be0eee11b926578" data-media-type="image/jpeg" alt="Ethylene and menthene undergo a chemical reaction with bromine, forming their respective products" width="1230" height="690" loading="lazy" data-original-src="/apps/archive/20260604.144757/resources/74436e0f7ecac44734c72f1b8be0eee11b926578"></button>
    </span>
    
    <figcaption class="os-caption-container">
  <span class="os-title-label">Figure </span>
<span class="os-number">3.2</span>



  <span class="os-divider"> </span>
  <span class="os-caption"><strong>The reactions of ethylene and menthene with</strong> bromine. In both molecules, the carbon–carbon double-bond functional group has a similar polarity pattern, so both molecules react with Br<sub>2</sub> in the same way. The size and complexity of the molecules are not important.</span>
</figcaption></figure></div>
    
    <p id="para-00002">Look at <a href="3-1-functional-groups#table-00001" class="autogenerated-content table-target-label" aria-label="View Table 3.1">Table 3.1</a>, which lists many of the common functional groups and gives simple examples of their occurrence. Some functional groups have only carbon–carbon double or triple bonds; others have halogen atoms; and still others contain oxygen, nitrogen, or sulfur. Much of the chemistry you’ll be studying is the chemistry of these functional groups.</p>
    
    <section data-depth="1" id="sect-00001"><h3 data-type="title">Functional Groups with Carbon–Carbon Multiple Bonds</h3>
    <p id="para-00003">Alkenes, alkynes, and arenes (aromatic compounds) all contain carbon–carbon multiple bonds. <em data-effect="italics">Alkenes</em> have a double bond, <em data-effect="italics">alkynes</em> have a triple bond, and <em data-effect="italics">arenes</em> have alternating double and single bonds in a six-membered ring of carbon atoms. They look different, but because of their structural similarities, they also have chemical similarities.</p>
    <div class="os-figure" id="fig-00002"><figure class="unnumbered scaled-down" data-id="fig-00002">
    <span data-type="media" data-alt="The ball and stick models and general structure of alkene, alkyne and arene, respectively.">
    <button type="button" aria-label="Click to enlarge image of The ball and stick models and general structure of alkene, alkyne and arene, respectively." class="image-button-wrapper"><img src="/apps/image-cdn/v1/f=webp/apps/archive/20260604.144757/resources/639a5ec8d13166734f947c4159a5f54987eeedb1" data-media-type="image/jpeg" alt="The ball and stick models and general structure of alkene, alkyne and arene, respectively." width="889" height="525" loading="lazy" data-original-src="/apps/archive/20260604.144757/resources/639a5ec8d13166734f947c4159a5f54987eeedb1"></button>
    </span>
    </figure></div>
    <div class="os-table"><div class="os-caption-container">
  <span class="os-title-label">Table </span>
  <span class="os-number">3.1</span>
  <span class="os-divider"> </span>
<span class="os-title" data-type="title">Structures of Some Common Functional Groups</span>

  <span class="os-divider"> </span>
</div>
<table id="table-00001" data-summary="An illustration shows a table with structures of functional groups and their details in the form of a table. The four columns comprise “name structure* name ending” and “example.” The first row shows an “alkene (double bond)” having a carbon double bonded to another carbon each carbon has open bonds; the double bond is shown in pink; name ending is “-ene”; example is ethene shown as methylene double bonded to another methylene group. The second group is an “alkyne (triple bond)” shown as a carbon triple bonded to another carbon and each carbon has an open bond; the name ending is “-yne” and example shown is ethyne having a methine group triple bonded to methine group; triple bond is shown in pink. The third group is an “arene (aromatic ring)” having a benzene whose each position shows an open bond; the name ending is shown as “none” and example is benzene a cyclohexane containing three double bonds; the entire structure is pink. The fourth structure is a halide shown as a carbon having an open bond an open wedge double bond an open dashed bond and a bond with “X” where “(X = F Cl Br I); name ending is “none” and example is chloromethane shown as methyl group bonded to chlorine. The fifth group is an alcohol shown as a carbon having an open single bond an open wedge double bond and an open dashed bond and a bond with the hydroxyl group; the name ending is “-ol” and example shown is methanol having methyl group bonded to a hydroxyl group written in pink color. The sixth group is an ether shown as a centrally located oxygen bonded to carbon atoms on both the sides each carbon further shows an open single bond an open wedge double bond and an open dashed bond; the name ends with “ether” and example shown is Dimethyl ether having a centrally located oxygen surrounded by two methyl groups. The seventh group is monophosphate shows a centrally located oxygen bonded to carbon on the left side which further shows three open bonds comprising of a single bond a wedge double bond and a dashed bond; the oxygen on the right side shows a bond to phosphorous having an upward double bond with oxygen a downward bond and a side bond with two oxygen anions; the name ends with “phosphate” having a methyl group bonded to phosphate anion shown as OPO3 to the power two minus; the phosphate group is colored pink. The eighth group diphosphate shows a carbon having three open bonds comprising of an open wedge double bond an open single bond and an open dashed bond; the carbon is bonded to two consecutive groups; the phosphate comprises of a centrally located phosphorous having an upward double bond with oxygen and two side bonds with oxygen and a downward bond with oxygen anion; the name ends with “diphosphate” and example is methyl diphosphate showing a methyl group bonded to a diphosphate group shown as OP2O6 to the power three minus. The ninth group is an amine shown as a carbon having an open single bond an open wedge double bond and an open dashed bond; the carbon is further bonded to a nitrogen having a pair of electrons and an open wedge double bond and an open dashed bond. The name ends with “-amine” and example is methylamine shown as methyl CH3 bonded to an amine NH2 group. The tenth group shown an imine (Schiff base) having a centrally located carbon having an upward double bond with nitrogen with a pair of electrons and an open bond; to the left as well as right side the carbon bonds with another carbon having an open single bond an open wedge double bond and an open dashed bond; the name ends with “none” and example is acetone imine having a centrally located carbon with an upward double bond to nitrogen monohydride in pink and either sides carbon bonds with methyl groups. The eleventh group is nitrile shown as a carbon with an open bond on the left side triple bonded to nitrogen; the name ends with “-nitrile” and example is ethanenitrile shown as methyl group bonded to carbon having a triple bond with nitrogen which are shown in pink. The twelfth group is a thiol having a carbon with an open single bond an open wedge double bond and an open dashed bond the fourth bond is with SH shown in pink; the name ends with “-thiol” and example is methanethiol shown as methyl group bonded to SH shown as pink. The thirteenth group is a sulfide having a centrally located pink sulfur bonded to carbon on both the sides wherein each carbon shows an open single bond a wedge double bond and an open dashed bond; the name ends with “sulfide” and example is Dimethyl sulfide shown as a centrally located pink carbon bonded to methyl groups on both the sides. The fourteenth group is a disulfide shown as two centrally located pink sulfur atoms bonded to each other; each sulfur is bonded to carbon having an open single bond a wedge double bond and an open dashed bond; the name ends with disulfide and example is dimethyl disulfide having two centrally located pink sulfurs bonded to methyl groups on both the sides. The fifteenth group is a sulfoxide shows as a centrally located pink sulfur cation having an upward bond with a pink oxygen anion and on either sides sulfur is shown bonded to carbon atoms that have an open single bond an open wedge double bond and an open dashed double bond; the name ends with sulfoxide and the example is dimethyl sulfoxide shown as a centrally located pink sulfur cation having an upward bond with pink oxygen anion and one either sides are shown methyl groups. The sixteenth group is an aldehyde having a centrally placed pink carbonyl group wherein the carbon shows an open bond on the left side and a bond with pink hydrogen on the right side; the name ends with “-al” and the example is ethanol comprising of a methyl group bonded to a pink carbonyl group whose carbon further shows a bond with hydrogen. The seventeenth group is a ketone having a centrally located pink carbonyl group on either sides the carbon is shown further bonded to carbon atom having an open single bond an open wedge double bond and an open dashed bond; the name ends with “-one” and example is propanone shown as a centrally located carbonyl group that is bonded to methyl groups on both the sides. The eighteenth group is a carboxylic acid having a centrally located pink carbonyl group bonded to a carbon on the left side having an open single bond an open wedge double bond and an open dashed bond; the carbon of carbonyl group on the right shows a bond with a pink hydroxyl group; the name ends with “-oic acid” and example is ethanoic acid shown as a methyl group bonded to a pink carbonyl group whose carbon is bonded to a hydroxyl group. The nineteenth group is an ester shown as a centrally located pink carbonyl group bonded to a carbon having an open single bond an open wedge bond and an open dashed bond on the left side; on its right side the carbon of carbonyl group is shown bonded to a pink oxygen that is bonded to a pink carbon having an open wedge double bond an open dashed bond and an open single bond; the name ends with “-oate” and example is methyl ethanoate shows a methyl bonded to a pink carbonyl group whose carbon bonds to a pink oxygen further bonded to a pink methyl group. The twentieth group is a thioester shown as a centrally located pink carbonyl group bonded to a carbon having an open single bond an open wedge bond and an open dashed bond on the left side; on its right side the carbon of carbonyl group is shown bonded to a pink sulfur that is bonded to a pink carbon having an open wedge double bond an open dashed bond and an open single bond; the name ends with “-thioate” and the example methyl ethanethioate is shown as a methyl bonded to a pink carbonyl group whose carbon bonds to a pink sulfur further bonded to a pink methyl group. The twenty-first group is an amide shows as a centrally located pink carbonyl group whose carbon is bonded to another carbon having an open single bond an open wedge double bond and an open dashed bond; the carbon on its right side is bonded to pink nitrogen with a pair of electrons showing two pink open bonds; the name ends with “-amid” and the example is ethanamide shown as a centrally located pink carbonyl group whose carbon is bonded to a methyl group at the left side and its right side is bonded to a pink amine on the right side. The twenty-second group acid chloride shows a centrally located pink carbonyl group whose carbon on the left side shows a bond to another carbon having an open single bond an open wedge double bond and an open dashed bond on the right side it is bonded to a pink chlorine; the name ends in “-oyl chloride” and the example is ethanoyl chloride shown as a methyl group bonded to a pink carbonyl group whose carbon is shown bonded to a pink chlorine. The twenty-third group is carboxylic acid anhydride shown as centrally located pink oxygen bonded to pink carbonyl groups on either sides; the carbon of each carbonyl group is further bonded to a carbon on each side wherein each carbon shows an open single bond an open wedge double bond and an open dashed bond."><thead>
    <tr>
    <th data-valign="top" data-align="left" scope="col">Name</th>
    <th data-valign="top" data-align="left" scope="col">Structure*</th>
    <th data-valign="top" data-align="left" scope="col">Name ending</th>
    <th data-valign="top" data-align="left" scope="col">Example</th>
    </tr>
    </thead><tbody>
    <tr>
    <td data-valign="top" data-align="left">Alkene (double bond)</td>
    <td data-valign="top" data-align="left">
    <span data-type="media" data-alt="The general structure of alkene.">
    <button type="button" aria-label="Click to enlarge image of The general structure of alkene." class="image-button-wrapper"><img src="/apps/image-cdn/v1/f=webp/apps/archive/20260604.144757/resources/ee92af2d5981f58aff4ce6e9f5f5d201b8ce710a" data-media-type="image/jpeg" alt="The general structure of alkene." class="scaled-down" width="83" height="78" loading="lazy" data-original-src="/apps/archive/20260604.144757/resources/ee92af2d5981f58aff4ce6e9f5f5d201b8ce710a"></button>
    </span>
    </td>
    <td data-valign="top" data-align="left">-<em data-effect="italics">ene</em></td>
    <td data-valign="top" data-align="left"><math display="inline"><semantics><mrow><mrow><msub><mrow><mtext>H</mtext></mrow><mn>2</mn></msub><mrow><mtext>C</mtext><mtext style="color: #E00087">═</mtext></mrow><msub><mrow><mtext>CH</mtext></mrow><mn>2</mn></msub></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><msub><mrow><mtext>H</mtext></mrow><mn>2</mn></msub><mrow><mtext>C</mtext><mtext style="color: #E00087">═</mtext></mrow><msub><mrow><mtext>CH</mtext></mrow><mn>2</mn></msub></mrow></annotation-xml></semantics></math> <span data-type="newline"><br></span>Ethene</td>
    </tr>
    <tr>
    <td data-valign="top" data-align="left">Alkyne (triple bond)</td>
    <td data-valign="top" data-align="left"><math display="inline"><semantics><mrow><mrow><mtext>–</mtext><mtext>C</mtext><mtext style="color: #E00087">≡</mtext><mtext>C</mtext><mtext>–</mtext></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mtext>–</mtext><mtext>C</mtext><mtext style="color: #E00087">≡</mtext><mtext>C</mtext><mtext>–</mtext></mrow></annotation-xml></semantics></math></td>
    <td data-valign="top" data-align="left">-<em data-effect="italics">yne</em></td>
    <td data-valign="top" data-align="left"><math display="inline"><semantics><mrow><mrow><mtext>HC</mtext><mtext style="color: #E00087">≡</mtext><mtext>CH</mtext></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mtext>HC</mtext><mtext style="color: #E00087">≡</mtext><mtext>CH</mtext></mrow></annotation-xml></semantics></math> <span data-type="newline"><br></span>Ethyne</td>
    </tr>
    <tr>
    <td data-valign="top" data-align="left">Arene (aromatic ring)</td>
    <td data-valign="top" data-align="left">
    <span data-type="media" data-alt="The general structure of arene.">
    <button type="button" aria-label="Click to enlarge image of The general structure of arene." class="image-button-wrapper"><img src="/apps/image-cdn/v1/f=webp/apps/archive/20260604.144757/resources/b5bbf069c0a95f887627a6d0ad7c8deef9f370e9" data-media-type="image/jpeg" alt="The general structure of arene." class="scaled-down" width="178" height="155" loading="lazy" data-original-src="/apps/archive/20260604.144757/resources/b5bbf069c0a95f887627a6d0ad7c8deef9f370e9"></button>
    </span>
    </td>
    <td data-valign="top" data-align="left">None</td>
    <td data-valign="top" data-align="left">
    <span data-type="media" data-alt="The general structure of benzene.">
    <button type="button" aria-label="Click to enlarge image of The general structure of benzene." class="image-button-wrapper"><img src="/apps/image-cdn/v1/f=webp/apps/archive/20260604.144757/resources/7c031283e02b4d880d86c0013dd5625669f715ad" data-media-type="image/jpeg" alt="The general structure of benzene." class="scaled-down" width="91" height="119" loading="lazy" data-original-src="/apps/archive/20260604.144757/resources/7c031283e02b4d880d86c0013dd5625669f715ad"></button>
    </span>
    </td>
    </tr>
    <tr>
