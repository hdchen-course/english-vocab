<li about="#cite_note-79" id="cite_note-79" data-mw-footnote-number="78"><span class="mw-cite-backlink" id="mwD2g"><a href="#cite_ref-79" rel="mw:referencedBy" id="mwD2k"><span class="mw-linkback-text" id="mwD2o">↑</span></a></span> <span id="mw-reference-text-cite_note-79" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt274" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwD2s" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"date":{"wt":"27 September 2022"},"title":{"wt":"The World Won&apos;t Listen: The Mande \"Hunters&apos; Oath\" and Human Rights in Translation"},"url":{"wt":"https://humanityjournal.org/issue13-2/the-world-wont-listen-the-mande-hunters-oath-and-human-rights-in-translation/"},"access-date":{"wt":"22 October 2024"},"website":{"wt":"Humanity Journal"},"language":{"wt":"en-US"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt274" id="mwD2w"><a rel="mw:ExtLink nofollow" href="https://humanityjournal.org/issue13-2/the-world-wont-listen-the-mande-hunters-oath-and-human-rights-in-translation/" class="external text" id="mwD20">"The World Won't Listen: The Mande "Hunters' Oath" and Human Rights in Translation"</a>. <i id="mwD24">Humanity Journal</i>. 27 September 2022<span class="reference-accessdate" id="mwD28">. Retrieved <span class="nowrap" id="mwD3A">22 October</span> 2024</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Humanity+Journal&amp;rft.atitle=The+World+Won%27t+Listen%3A+The+Mande+%22Hunters%27+Oath%22+and+Human+Rights+in+Translation&amp;rft.date=2022-09-27&amp;rft_id=https%3A%2F%2Fhumanityjournal.org%2Fissue13-2%2Fthe-world-wont-listen-the-mande-hunters-oath-and-human-rights-in-translation%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt274" id="mwD3E"></span></span></li>
<li about="#cite_note-80" id="cite_note-80" data-mw-footnote-number="79"><span class="mw-cite-backlink" id="mwD3I"><a href="#cite_ref-80" rel="mw:referencedBy" id="mwD3M"><span class="mw-linkback-text" id="mwD3Q">↑</span></a></span> <span id="mw-reference-text-cite_note-80" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt277" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwD3U" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"title":{"wt":"Magna Carta: an introduction"},"url":{"wt":"http://www.bl.uk/magna-carta/articles/magna-carta-an-introduction"},"publisher":{"wt":"The British Library"},"access-date":{"wt":"28 January 2015"},"quote":{"wt":"Magna Carta is sometimes regarded as the foundation of democracy in England. ...Revised versions of Magna Carta were issued by King Henry III (in 1216, 1217 and 1225), and the text of the 1225 version was entered into the statute roll in 1297. ...The 1225 version of Magna Carta had been granted explicitly in return for a payment of tax by the whole kingdom, and this paved the way for the first summons of Parliament in 1265, to approve the granting of taxation."},"archive-date":{"wt":"23 April 2021"},"archive-url":{"wt":"https://web.archive.org/web/20210423002539/https://www.bl.uk/magna-carta/articles/magna-carta-an-introduction"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt277" id="mwD3Y"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20210423002539/https://www.bl.uk/magna-carta/articles/magna-carta-an-introduction" class="external text" id="mwD3c">"Magna Carta: an introduction"</a>. The British Library. Archived from <a rel="mw:ExtLink nofollow" href="http://www.bl.uk/magna-carta/articles/magna-carta-an-introduction" class="external text" id="mwD3g">the original</a> on 23 April 2021<span class="reference-accessdate" id="mwD3k">. Retrieved <span class="nowrap" id="mwD3o">28 January</span> 2015</span>. <q id="mwD3s">Magna Carta is sometimes regarded as the foundation of democracy in England. ...Revised versions of Magna Carta were issued by King Henry III (in 1216, 1217 and 1225), and the text of the 1225 version was entered into the statute roll in 1297. ...The 1225 version of Magna Carta had been granted explicitly in return for a payment of tax by the whole kingdom, and this paved the way for the first summons of Parliament in 1265, to approve the granting of taxation.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Magna+Carta%3A+an+introduction&amp;rft.pub=The+British+Library&amp;rft_id=http%3A%2F%2Fwww.bl.uk%2Fmagna-carta%2Farticles%2Fmagna-carta-an-introduction&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt277" id="mwD3w"></span></span></li>
<li about="#cite_note-81" id="cite_note-81" data-mw-footnote-number="80"><span class="mw-cite-backlink" id="mwD30"><a href="#cite_ref-81" rel="mw:referencedBy" id="mwD34"><span class="mw-linkback-text" id="mwD38">↑</span></a></span> <span id="mw-reference-text-cite_note-81" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt280" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwD4A" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.nationalarchives.gov.uk/pathways/citizenship/citizen_subject/making_history_citizen.htm"},"title":{"wt":"Citizen or Subject?"},"publisher":{"wt":"The National Archives"},"access-date":{"wt":"17 November 2013"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt280" id="mwD4E"><a rel="mw:ExtLink nofollow" href="http://www.nationalarchives.gov.uk/pathways/citizenship/citizen_subject/making_history_citizen.htm" class="external text" id="mwD4I">"Citizen or Subject?"</a>. The National Archives<span class="reference-accessdate" id="mwD4M">. Retrieved <span class="nowrap" id="mwD4Q">17 November</span> 2013</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Citizen+or+Subject%3F&amp;rft.pub=The+National+Archives&amp;rft_id=http%3A%2F%2Fwww.nationalarchives.gov.uk%2Fpathways%2Fcitizenship%2Fcitizen_subject%2Fmaking_history_citizen.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt280" id="mwD4U"></span></span></li>
