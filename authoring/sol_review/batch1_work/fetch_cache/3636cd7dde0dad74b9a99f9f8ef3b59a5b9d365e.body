<li class="portalbox-entry"><span class="portalbox-image"><span class="mw-image-border noviewer" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:A_coloured_voting_box.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:A_coloured_voting_box.svg" src="//thumb.wikimedia.org/wikipedia/en/thumb/0/01/A_coloured_voting_box.svg/40px-A_coloured_voting_box.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/en/thumb/0/01/A_coloured_voting_box.svg/60px-A_coloured_voting_box.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="icon" data-file-width="160" data-file-height="160" data-file-type="drawing" height="28" width="28" class="mw-file-element"/></a></span></span><span class="portalbox-link"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Portal:Politics" title="Portal:Politics">Politics portal</a></span></li><li class="portalbox-entry"><span class="portalbox-image"><span class="skin-invert-image noviewer" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Social_sciences.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Social_sciences.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Social_sciences.svg/40px-Social_sciences.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Social_sciences.svg/120px-Social_sciences.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="icon" data-file-width="139" data-file-height="122" data-file-type="drawing" height="28" width="32" class="mw-file-element"/></a></span></span><span class="portalbox-link"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Portal:Society" title="Portal:Society">Society portal</a></span></li></ul>
