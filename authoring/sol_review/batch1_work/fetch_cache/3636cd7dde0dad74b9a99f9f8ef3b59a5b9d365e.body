<li about="#cite_note-300" id="cite_note-300" data-mw-footnote-number="297"><span class="mw-cite-backlink" id="mwGLo"><a href="#cite_ref-300" rel="mw:referencedBy" id="mwGLs"><span class="mw-linkback-text" id="mwGLw">↑</span></a></span> <span id="mw-reference-text-cite_note-300" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1064" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwGL0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Glaeser"},"first1":{"wt":"E."},"last2":{"wt":"Ponzetto"},"first2":{"wt":"G."},"last3":{"wt":"Shleifer"},"first3":{"wt":"A."},"year":{"wt":"2007"},"title":{"wt":"Why does democracy need education?"},"url":{"wt":"http://nrs.harvard.edu/urn-3:HUL.InstRepos:27867132"},"journal":{"wt":"Journal of Economic Growth"},"volume":{"wt":"12"},"issue":{"wt":"2"},"pages":{"wt":"77–99"},"doi":{"wt":"10.1007/s10887-007-9015-1"},"access-date":{"wt":"3 July 2017"}},"i":0}}]}'/><cite id="CITEREFGlaeserPonzettoShleifer2007" class="citation journal cs1" about="#mwt1064">Glaeser, E.; Ponzetto, G.; Shleifer, A. (2007). <a rel="mw:ExtLink nofollow" href="http://nrs.harvard.edu/urn-3:HUL.InstRepos:27867132" class="external text" id="mwGL4">"Why does democracy need education?"</a>. <i id="mwGL8">Journal of Economic Growth</i>. <b id="mwGMA">12</b> (2): <span class="nowrap" id="mwGME">77–</span>99. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwGMI">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1007%2Fs10887-007-9015-1" class="external text" id="mwGMM">10.1007/s10887-007-9015-1</a><span class="reference-accessdate" id="mwGMQ">. Retrieved <span class="nowrap" id="mwGMU">3 July</span> 2017</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Journal+of+Economic+Growth&amp;rft.atitle=Why+does+democracy+need+education%3F&amp;rft.volume=12&amp;rft.issue=2&amp;rft.pages=77-99&amp;rft.date=2007&amp;rft_id=info%3Adoi%2F10.1007%2Fs10887-007-9015-1&amp;rft.aulast=Glaeser&amp;rft.aufirst=E.&amp;rft.au=Ponzetto%2C+G.&amp;rft.au=Shleifer%2C+A.&amp;rft_id=http%3A%2F%2Fnrs.harvard.edu%2Furn-3%3AHUL.InstRepos%3A27867132&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt1064" id="mwGMY"></span></span></li>
<li about="#cite_note-301" id="cite_note-301" data-mw-footnote-number="298"><span class="mw-cite-backlink" id="mwGMc"><a href="#cite_ref-301" rel="mw:referencedBy" id="mwGMg"><span class="mw-linkback-text" id="mwGMk">↑</span></a></span> <span id="mw-reference-text-cite_note-301" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1067" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwGMo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Deary"},"first1":{"wt":"I.J."},"last2":{"wt":"Batty"},"first2":{"wt":"G.D."},"last3":{"wt":"Gale"},"first3":{"wt":"C.R."},"year":{"wt":"2008"},"title":{"wt":"Bright children become enlightened adults"},"url":{"wt":"https://www.pure.ed.ac.uk/ws/files/8896064/bright_children_become_enlightened_adults.pdf"},"journal":{"wt":"Psychological Science"},"volume":{"wt":"19"},"issue":{"wt":"1"},"pages":{"wt":"1–6"},"doi":{"wt":"10.1111/j.1467-9280.2008.02036.x"},"pmid":{"wt":"18181782"},"s2cid":{"wt":"21297949"},"hdl":{"wt":"20.500.11820/a86dbef4-60eb-44fa-add3-513841cdf81b"},"hdl-access":{"wt":"free"}},"i":0}}]}'/><cite id="CITEREFDearyBattyGale2008" class="citation journal cs1" about="#mwt1067">Deary, I.J.; Batty, G.D.; Gale, C.R. (2008). <a rel="mw:ExtLink nofollow" href="https://www.pure.ed.ac.uk/ws/files/8896064/bright_children_become_enlightened_adults.pdf" class="external text" id="mwGMs">"Bright children become enlightened adults"</a> <span class="cs1-format" id="mwGMw">(PDF)</span>. <i id="mwGM0">Psychological Science</i>. <b id="mwGM4">19</b> (1): <span class="nowrap" id="mwGM8">1–</span>6. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwGNA">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1111%2Fj.1467-9280.2008.02036.x" class="external text" id="mwGNE">10.1111/j.1467-9280.2008.02036.x</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hdl_(identifier)" title="Hdl (identifier)" class="mw-redirect" id="mwGNI">hdl</a>:<span class="id-lock-free" title="Freely accessible" id="mwGNM"><a rel="mw:ExtLink nofollow" href="https://hdl.handle.net/20.500.11820%2Fa86dbef4-60eb-44fa-add3-513841cdf81b" class="external text" id="mwGNQ">20.500.11820/a86dbef4-60eb-44fa-add3-513841cdf81b</a></span>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwGNU">PMID</a><span typeof="mw:Entity" id="mwGNY"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/18181782" class="external text" id="mwGNc">18181782</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwGNg">S2CID</a><span typeof="mw:Entity" id="mwGNk"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:21297949" class="external text" id="mwGNo">21297949</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Psychological+Science&amp;rft.atitle=Bright+children+become+enlightened+adults&amp;rft.volume=19&amp;rft.issue=1&amp;rft.pages=1-6&amp;rft.date=2008&amp;rft_id=info%3Ahdl%2F20.500.11820%2Fa86dbef4-60eb-44fa-add3-513841cdf81b&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A21297949%23id-name%3DS2CID&amp;rft_id=info%3Apmid%2F18181782&amp;rft_id=info%3Adoi%2F10.1111%2Fj.1467-9280.2008.02036.x&amp;rft.aulast=Deary&amp;rft.aufirst=I.J.&amp;rft.au=Batty%2C+G.D.&amp;rft.au=Gale%2C+C.R.&amp;rft_id=https%3A%2F%2Fwww.pure.ed.ac.uk%2Fws%2Ffiles%2F8896064%2Fbright_children_become_enlightened_adults.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt1067" id="mwGNs"></span></span></li>
<li about="#cite_note-302" id="cite_note-302" data-mw-footnote-number="299"><span class="mw-cite-backlink" id="mwGNw"><a href="#cite_ref-302" rel="mw:referencedBy" id="mwGN0"><span class="mw-linkback-text" id="mwGN4">↑</span></a></span> <span id="mw-reference-text-cite_note-302" class="mw-reference-text reference-text">Compare: <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1070" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwGN8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Rindermann"},"first1":{"wt":"H"},"year":{"wt":"2008"},"title":{"wt":"Relevance of education and intelligence for the political development of nations: Democracy, rule of law and political liberty"},"journal":{"wt":"Intelligence"},"volume":{"wt":"36"},"issue":{"wt":"4"},"pages":{"wt":"306–22"},"doi":{"wt":"10.1016/j.intell.2007.09.003"},"quote":{"wt":"Political theory has described a positive linkage between education, cognitive ability and democracy. This assumption is confirmed by positive correlations between education, cognitive ability, and positively valued political conditions (N = 183–130). [...] It is shown that in the second half of the 20th century, education and intelligence had a strong positive impact on democracy, rule of law and political liberty independent from wealth (GDP) and chosen country sample. One possible mediator of these relationships is the attainment of higher stages of moral judgment fostered by cognitive ability, which is necessary for the function of democratic rules in society. The other mediators for citizens as well as for leaders could be the increased competence and willingness to process and seek information necessary for political decisions due to greater cognitive ability. There are also weaker and less stable reverse effects of the rule of law and political freedom on cognitive ability."}},"i":0}}]}'/><cite id="CITEREFRindermann2008" class="citation journal cs1" about="#mwt1070">Rindermann, H (2008). "Relevance of education and intelligence for the political development of nations: Democracy, rule of law and political liberty". <i id="mwGOA">Intelligence</i>. <b id="mwGOE">36</b> (4): <span class="nowrap" id="mwGOI">306–</span>22. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwGOM">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1016%2Fj.intell.2007.09.003" class="external text" id="mwGOQ">10.1016/j.intell.2007.09.003</a>. <q id="mwGOU">Political theory has described a positive linkage between education, cognitive ability and democracy. This assumption is confirmed by positive correlations between education, cognitive ability, and positively valued political conditions (N = 183–130). [...] It is shown that in the second half of the 20th century, education and intelligence had a strong positive impact on democracy, rule of law and political liberty independent from wealth (GDP) and chosen country sample. One possible mediator of these relationships is the attainment of higher stages of moral judgment fostered by cognitive ability, which is necessary for the function of democratic rules in society. The other mediators for citizens as well as for leaders could be the increased competence and willingness to process and seek information necessary for political decisions due to greater cognitive ability. There are also weaker and less stable reverse effects of the rule of law and political freedom on cognitive ability.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Intelligence&amp;rft.atitle=Relevance+of+education+and+intelligence+for+the+political+development+of+nations%3A+Democracy%2C+rule+of+law+and+political+liberty&amp;rft.volume=36&amp;rft.issue=4&amp;rft.pages=306-22&amp;rft.date=2008&amp;rft_id=info%3Adoi%2F10.1016%2Fj.intell.2007.09.003&amp;rft.aulast=Rindermann&amp;rft.aufirst=H&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt1070" id="mwGOY"></span></span></li>
<li about="#cite_note-303" id="cite_note-303" data-mw-footnote-number="300"><span class="mw-cite-backlink" id="mwGOc"><a href="#cite_ref-303" rel="mw:referencedBy" id="mwGOg"><span class="mw-linkback-text" id="mwGOk">↑</span></a></span> <span id="mw-reference-text-cite_note-303" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1073" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwGOo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Albertus"},"first1":{"wt":"Michael"},"first2":{"wt":"Victor"},"last2":{"wt":"Menaldo"},"s2cid":{"wt":"153949862"},"title":{"wt":"Coercive Capacity and the Prospects for Democratisation"},"journal":{"wt":"Comparative Politics"},"volume":{"wt":"44"},"issue":{"wt":"2"},"year":{"wt":"2012"},"pages":{"wt":"151–69"},"doi":{"wt":"10.5129/001041512798838003"},"url":{"wt":"https://papers.ssrn.com/sol3/Delivery.cfm/SSRN_ID1694364_code1402071.pdf?abstractid=1618909&amp;mirid=1"}},"i":0}}]}'/><cite id="CITEREFAlbertusMenaldo2012" class="citation journal cs1" about="#mwt1073">Albertus, Michael; Menaldo, Victor (2012). <a rel="mw:ExtLink nofollow" href="https://papers.ssrn.com/sol3/Delivery.cfm/SSRN_ID1694364_code1402071.pdf?abstractid=1618909&amp;mirid=1" class="external text" id="mwGOs">"Coercive Capacity and the Prospects for Democratisation"</a> <span class="cs1-format" id="mwGOw">(PDF)</span>. <i id="mwGO0">Comparative Politics</i>. <b id="mwGO4">44</b> (2): <span class="nowrap" id="mwGO8">151–</span>69. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwGPA">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.5129%2F001041512798838003" class="external text" id="mwGPE">10.5129/001041512798838003</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwGPI">S2CID</a><span typeof="mw:Entity" id="mwGPM"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:153949862" class="external text" id="mwGPQ">153949862</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Comparative+Politics&amp;rft.atitle=Coercive+Capacity+and+the+Prospects+for+Democratisation&amp;rft.volume=44&amp;rft.issue=2&amp;rft.pages=151-69&amp;rft.date=2012&amp;rft_id=info%3Adoi%2F10.5129%2F001041512798838003&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A153949862%23id-name%3DS2CID&amp;rft.aulast=Albertus&amp;rft.aufirst=Michael&amp;rft.au=Menaldo%2C+Victor&amp;rft_id=https%3A%2F%2Fpapers.ssrn.com%2Fsol3%2FDelivery.cfm%2FSSRN_ID1694364_code1402071.pdf%3Fabstractid%3D1618909%26mirid%3D1&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt1073" id="mwGPU"></span></span></li>
<li about="#cite_note-Paglayan_179–198-304" id="cite_note-Paglayan_179–198-304" data-mw-footnote-number="301"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwGPY"><a href="#cite_ref-Paglayan_179–198_304-0" id="mwGPc"><span class="mw-linkback-text" id="mwGPg">1</span></a> <a href="#cite_ref-Paglayan_179–198_304-1" id="mwGPk"><span class="mw-linkback-text" id="mwGPo">2</span></a></span> <span id="mw-reference-text-cite_note-Paglayan_179–198-304" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1076" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwGPs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal","href":"./Template:Cite_journal"},"params":{"last":{"wt":"Paglayan"},"first":{"wt":"Agustina S."},"date":{"wt":"February 2021"},"title":{"wt":"The Non-Democratic Roots of Mass Education: Evidence from 200 Years"},"journal":{"wt":"American Political Science Review"},"volume":{"wt":"115"},"issue":{"wt":"1"},"pages":{"wt":"179–198"},"doi":{"wt":"10.1017/S0003055420000647"},"issn":{"wt":"0003-0554"},"doi-access":{"wt":"free"}},"i":0}}]}'/><cite id="CITEREFPaglayan2021" class="citation journal cs1" about="#mwt1076">Paglayan, Agustina S. (February 2021). <a rel="mw:ExtLink nofollow" href="https://doi.org/10.1017%2FS0003055420000647" class="external text" id="mwGPw">"The Non-Democratic Roots of Mass Education: Evidence from 200 Years"</a>. <i id="mwGP0">American Political Science Review</i>. <b id="mwGP4">115</b> (1): <span class="nowrap" id="mwGP8">179–</span>198. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwGQA">doi</a>:<span class="id-lock-free" title="Freely accessible" id="mwGQE"><a rel="mw:ExtLink nofollow" href="https://doi.org/10.1017%2FS0003055420000647" class="external text" id="mwGQI">10.1017/S0003055420000647</a></span>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwGQM">ISSN</a><span typeof="mw:Entity" id="mwGQQ"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/0003-0554" class="external text" id="mwGQU">0003-0554</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=American+Political+Science+Review&amp;rft.atitle=The+Non-Democratic+Roots+of+Mass+Education%3A+Evidence+from+200+Years&amp;rft.volume=115&amp;rft.issue=1&amp;rft.pages=179-198&amp;rft.date=2021-02&amp;rft_id=info%3Adoi%2F10.1017%2FS0003055420000647&amp;rft.issn=0003-0554&amp;rft.aulast=Paglayan&amp;rft.aufirst=Agustina+S.&amp;rft_id=https%3A%2F%2Fdoi.org%2F10.1017%252FS0003055420000647&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt1076" id="mwGQY"></span></span></li>
<li about="#cite_note-305" id="cite_note-305" data-mw-footnote-number="302"><span class="mw-cite-backlink" id="mwGQc"><a href="#cite_ref-305" rel="mw:referencedBy" id="mwGQg"><span class="mw-linkback-text" id="mwGQk">↑</span></a></span> <span id="mw-reference-text-cite_note-305" class="mw-reference-text reference-text">Squicciarini, Mara and Voigtländer, Nico, Knowledge Elites and Modernization: Evidence from Revolutionary France (October 2016). NBER Working Paper No. w22779, Available at SSRN: <a rel="mw:ExtLink nofollow" href="https://ssrn.com/abstract=2861711" class="external free" id="mwGQo">https://ssrn.com/abstract=2861711</a></span></li>
