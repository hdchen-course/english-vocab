%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=The+Society+of+Antiquaries+of+London&amp;rft.atitle=Magna+Carta%3A+Magna+Carta+in+the+17th+Century&amp;rft_id=https%3A%2F%2Fwww.sal.org.uk%2Fevents%2F2015%2F06%2Fmagna-carta-magna-carta-in-the-17th-century%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt312" id="mwEAk"></span></span></li>
<li about="#cite_note-91" id="cite_note-91" data-mw-footnote-number="90"><span class="mw-cite-backlink" id="mwEAo"><a href="#cite_ref-91" rel="mw:referencedBy" id="mwEAs"><span class="mw-linkback-text" id="mwEAw">↑</span></a></span> <span id="mw-reference-text-cite_note-91" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt316" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEA0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"title":{"wt":"Rise of Parliament"},"url":{"wt":"http://www.nationalarchives.gov.uk/pathways/citizenship/rise_parliament/citizenship2.htm"},"publisher":{"wt":"The National Archives"},"access-date":{"wt":"7 April 2015"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt316" id="mwEA4"><a rel="mw:ExtLink nofollow" href="http://www.nationalarchives.gov.uk/pathways/citizenship/rise_parliament/citizenship2.htm" class="external text" id="mwEA8">"Rise of Parliament"</a>. The National Archives<span class="reference-accessdate" id="mwEBA">. Retrieved <span class="nowrap" id="mwEBE">7 April</span> 2015</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Rise+of+Parliament&amp;rft.pub=The+National+Archives&amp;rft_id=http%3A%2F%2Fwww.nationalarchives.gov.uk%2Fpathways%2Fcitizenship%2Frise_parliament%2Fcitizenship2.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt316" id="mwEBI"></span></span></li>
<li about="#cite_note-92" id="cite_note-92" data-mw-footnote-number="91"><span class="mw-cite-backlink" id="mwEBM"><a href="#cite_ref-92" rel="mw:referencedBy" id="mwEBQ"><span class="mw-linkback-text" id="mwEBU">↑</span></a></span> <span id="mw-reference-text-cite_note-92" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt319" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEBY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"title":{"wt":"Putney debates"},"url":{"wt":"https://www.bl.uk/taking-liberties/articles/putney-debates"},"publisher":{"wt":"The British Library"},"access-date":{"wt":"22 December 2016"},"archive-date":{"wt":"22 December 2016"},"archive-url":{"wt":"https://web.archive.org/web/20161222223321/https://www.bl.uk/taking-liberties/articles/putney-debates"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt319" id="mwEBc"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20161222223321/https://www.bl.uk/taking-liberties/articles/putney-debates" class="external text" id="mwEBg">"Putney debates"</a>. The British Library. Archived from <a rel="mw:ExtLink nofollow" href="https://www.bl.uk/taking-liberties/articles/putney-debates" class="external text" id="mwEBk">the original</a> on 22 December 2016<span class="reference-accessdate" id="mwEBo">. Retrieved <span class="nowrap" id="mwEBs">22 December</span> 2016</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Putney+debates&amp;rft.pub=The+British+Library&amp;rft_id=https%3A%2F%2Fwww.bl.uk%2Ftaking-liberties%2Farticles%2Fputney-debates&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt319" id="mwEBw"></span></span></li>
<li about="#cite_note-refNARoP-93" id="cite_note-refNARoP-93" data-mw-footnote-number="92"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwEB0"><a href="#cite_ref-refNARoP_93-0" id="mwEB4"><span class="mw-linkback-text" id="mwEB8">1</span></a> <a href="#cite_ref-refNARoP_93-1" id="mwECA"><span class="mw-linkback-text" id="mwECE">2</span></a></span> <span id="mw-reference-text-cite_note-refNARoP-93" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1374" typeof="mw:Extension/templatestyles" id="mwECI" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite class="citation web cs1" id="mwECM"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20151208232341/http://www.bl.uk/magna-carta/articles/britains-unwritten-constitution" class="external text" id="mwECQ">"Britain's unwritten constitution"</a>. British Library. Archived from <a rel="mw:ExtLink nofollow" href="http://www.bl.uk/magna-carta/articles/britains-unwritten-constitution" class="external text" id="mwECU">the original</a> on 8 December 2015<span class="reference-accessdate" id="mwECY">. Retrieved <span class="nowrap" id="mwECc">27 November</span> 2015</span>. <q id="mwECg">The key landmark is the Bill of Rights (1689), which established the supremacy of Parliament over the Crown.... The Bill of Rights (1689) then settled the primacy of Parliament over the monarch's prerogatives, providing for the regular meeting of Parliament, free elections to the Commons, free speech in parliamentary debates, and some basic human rights, most famously freedom from 'cruel or unusual punishment'.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Britain%27s+unwritten+constitution&amp;rft.pub=British+Library&amp;rft_id=http%3A%2F%2Fwww.bl.uk%2Fmagna-carta%2Farticles%2Fbritains-unwritten-constitution&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" id="mwECk"></span></span></li>
<li about="#cite_note-94" id="cite_note-94" data-mw-footnote-number="93"><span class="mw-cite-backlink" id="mwECo"><a href="#cite_ref-94" rel="mw:referencedBy" id="mwECs"><span class="mw-linkback-text" id="mwECw">↑</span></a></span> <span id="mw-reference-text-cite_note-94" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt323" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEC0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"title":{"wt":"Constitutionalism: America &amp; Beyond"},"url":{"wt":"http://www.ait.org.tw/infousa/zhtw/DOCS/Demopaper/dmpaper2.html"},"publisher":{"wt":"Bureau of International Information Programs (IIP), U.S. Department of State"},"access-date":{"wt":"30 October 2014"},"quote":{"wt":"The earliest, and perhaps greatest, victory for liberalism was achieved in England. The rising commercial class that had supported the Tudor monarchy in the 16th century led the revolutionary battle in the 17th and succeeded in establishing the supremacy of Parliament and, eventually, of the House of Commons. What emerged as the distinctive feature of modern constitutionalism was not the insistence on the idea that the king is subject to law (although this concept is an essential attribute of all constitutionalism). This notion was already well established in the Middle Ages. What was distinctive was the establishment of effective means of political control whereby the rule of law might be enforced. Modern constitutionalism was born with the political requirement that representative government depended upon the consent of citizen subjects... However, as can be seen through provisions in the 1689 Bill of Rights, the English Revolution was fought not just to protect the rights of property (in the narrow sense) but to establish those liberties which liberals believed essential to human dignity and moral worth. The \"rights of man\" enumerated in the English Bill of Rights gradually were proclaimed beyond the boundaries of England, notably in the American Declaration of Independence of 1776 and in the French Declaration of the Rights of Man in 1789."},"archive-url":{"wt":"https://web.archive.org/web/20141024130317/http://www.ait.org.tw/infousa/zhtw/DOCS/Demopaper/dmpaper2.html"},"archive-date":{"wt":"24 October 2014"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt323" id="mwEC4"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20141024130317/http://www.ait.org.tw/infousa/zhtw/DOCS/Demopaper/dmpaper2.html" class="external text" id="mwEC8">"Constitutionalism: America &amp; Beyond"</a>. Bureau of International Information Programs (IIP), U.S. Department of State. Archived from <a rel="mw:ExtLink nofollow" href="http://www.ait.org.tw/infousa/zhtw/DOCS/Demopaper/dmpaper2.html" class="external text" id="mwEDA">the original</a> on 24 October 2014<span class="reference-accessdate" id="mwEDE">. Retrieved <span class="nowrap" id="mwEDI">30 October</span> 2014</span>. <q id="mwEDM">The earliest, and perhaps greatest, victory for liberalism was achieved in England. The rising commercial class that had supported the Tudor monarchy in the 16th century led the revolutionary battle in the 17th and succeeded in establishing the supremacy of Parliament and, eventually, of the House of Commons. What emerged as the distinctive feature of modern constitutionalism was not the insistence on the idea that the king is subject to law (although this concept is an essential attribute of all constitutionalism). This notion was already well established in the Middle Ages. What was distinctive was the establishment of effective means of political control whereby the rule of law might be enforced. Modern constitutionalism was born with the political requirement that representative government depended upon the consent of citizen subjects... However, as can be seen through provisions in the 1689 Bill of Rights, the English Revolution was fought not just to protect the rights of property (in the narrow sense) but to establish those liberties which liberals believed essential to human dignity and moral worth. The "rights of man" enumerated in the English Bill of Rights gradually were proclaimed beyond the boundaries of England, notably in the American Declaration of Independence of 1776 and in the French Declaration of the Rights of Man in 1789.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Constitutionalism%3A+America+%26+Beyond&amp;rft.pub=Bureau+of+International+Information+Programs+%28IIP%29%2C+U.S.+Department+of+State&amp;rft_id=http%3A%2F%2Fwww.ait.org.tw%2Finfousa%2Fzhtw%2FDOCS%2FDemopaper%2Fdmpaper2.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt323" id="mwEDQ"></span></span></li>
<li about="#cite_note-95" id="cite_note-95" data-mw-footnote-number="94"><span class="mw-cite-backlink" id="mwEDU"><a href="#cite_ref-95" rel="mw:referencedBy" id="mwEDY"><span class="mw-linkback-text" id="mwEDc">↑</span></a></span> <span id="mw-reference-text-cite_note-95" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt326" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEDg" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"North"},"first1":{"wt":"Douglass C."},"last2":{"wt":"Weingast"},"first2":{"wt":"Barry R."},"date":{"wt":"1989"},"title":{"wt":"Constitutions and Commitment: The Evolution of Institutions Governing Public Choice in Seventeenth-Century England"},"journal":{"wt":"The Journal of Economic History"},"volume":{"wt":"49"},"issue":{"wt":"4"},"pages":{"wt":"803–832"},"doi":{"wt":"10.1017/S0022050700009451"},"s2cid":{"wt":"3198200"},"issn":{"wt":"1471-6372"}},"i":0}}]}'/><cite id="CITEREFNorthWeingast1989" class="citation journal cs1" about="#mwt326">North, Douglass C.; Weingast, Barry R. (1989). "Constitutions and Commitment: The Evolution of Institutions Governing Public Choice in Seventeenth-Century England". <i id="mwEDk">The Journal of Economic History</i>. <b id="mwEDo">49</b> (4): <span class="nowrap" id="mwEDs">803–</span>832. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwEDw">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1017%2FS0022050700009451" class="external text" id="mwED0">10.1017/S0022050700009451</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwED4">ISSN</a><span typeof="mw:Entity" id="mwED8"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/1471-6372" class="external text" id="mwEEA">1471-6372</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwEEE">S2CID</a><span typeof="mw:Entity" id="mwEEI"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:3198200" class="external text" id="mwEEM">3198200</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+Journal+of+Economic+History&amp;rft.atitle=Constitutions+and+Commitment%3A+The+Evolution+of+Institutions+Governing+Public+Choice+in+Seventeenth-Century+England&amp;rft.volume=49&amp;rft.issue=4&amp;rft.pages=803-832&amp;rft.date=1989&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A3198200%23id-name%3DS2CID&amp;rft.issn=1471-6372&amp;rft_id=info%3Adoi%2F10.1017%2FS0022050700009451&amp;rft.aulast=North&amp;rft.aufirst=Douglass+C.&amp;rft.au=Weingast%2C+Barry+R.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt326" id="mwEEQ"></span></span></li>
<li about="#cite_note-Locke-Laslett1988-96" id="cite_note-Locke-Laslett1988-96" data-mw-footnote-number="95"><span class="mw-cite-backlink" id="mwEEU"><a href="#cite_ref-Locke-Laslett1988_96-0" rel="mw:referencedBy" id="mwEEY"><span class="mw-linkback-text" id="mwEEc">↑</span></a></span> <span id="mw-reference-text-cite_note-Locke-Laslett1988-96" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt329" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEEg" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book","href":"./Template:Cite_book"},"params":{"title":{"wt":"Two Treatises of Government"},"publisher":{"wt":"Cambridge University Press"},"location":{"wt":"Cambridge, NY"},"first":{"wt":"John"},"last":{"wt":"Locke"},"author-link":{"wt":"John Locke"},"editor-first":{"wt":"Peter"},"editor-last":{"wt":"Laslett"},"at":{"wt":"[https://archive.org/details/twotreatisesofgo00john/page/ Sec. 87, 123, 209, 222]"},"year":{"wt":"1988"},"orig-date":{"wt":"1689"},"isbn":{"wt":"978-0-521-35448-6"},"url":{"wt":"https://archive.org/details/twotreatisesofgo00john/page/"}},"i":0}}]}'/><cite id="CITEREFLocke1988" class="citation book cs1" about="#mwt329"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/John_Locke" title="John Locke" id="mwEEk">Locke, John</a> (1988) [1689]. Laslett, Peter (ed.). <a rel="mw:ExtLink nofollow" href="https://archive.org/details/twotreatisesofgo00john/page/" class="external text" id="mwEEo"><i id="mwEEs">Two Treatises of Government</i></a>. Cambridge, NY: Cambridge University Press. <a rel="mw:ExtLink nofollow" href="https://archive.org/details/twotreatisesofgo00john/page/" class="external text" id="mwEEw">Sec. 87, 123, 209, 222</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwEE0">ISBN</a><span typeof="mw:Entity" id="mwEE4"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-521-35448-6" title="Special:BookSources/978-0-521-35448-6" id="mwEE8"><bdi id="mwEFA">978-0-521-35448-6</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Two+Treatises+of+Government&amp;rft.place=Cambridge%2C+NY&amp;rft.pages=Sec.+87%2C+123%2C+209%2C+222&amp;rft.pub=Cambridge+University+Press&amp;rft.date=1988&amp;rft.isbn=978-0-521-35448-6&amp;rft.aulast=Locke&amp;rft.aufirst=John&amp;rft_id=https%3A%2F%2Farchive.org%2Fdetails%2Ftwotreatisesofgo00john%2Fpage%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt329" id="mwEFE"></span></span></li>
