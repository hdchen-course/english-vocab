<li about="#cite_note-90" id="cite_note-90" data-mw-footnote-number="89"><span class="mw-cite-backlink" id="mwD_c"><a href="#cite_ref-90" rel="mw:referencedBy" id="mwD_g"><span class="mw-linkback-text" id="mwD_k">↑</span></a></span> <span id="mw-reference-text-cite_note-90" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt310" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwD_o" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.bl.uk/magna-carta/videos/from-legal-document-to-public-myth-magna-carta-in-the-17th-century"},"title":{"wt":"From legal document to public myth: Magna Carta in the 17th century"},"website":{"wt":"The British Library"},"access-date":{"wt":"16 October 2017"},"postscript":{"wt":"none"},"archive-date":{"wt":"18 October 2017"},"archive-url":{"wt":"https://web.archive.org/web/20171018101349/https://www.bl.uk/magna-carta/videos/from-legal-document-to-public-myth-magna-carta-in-the-17th-century"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt310" id="mwD_s"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20171018101349/https://www.bl.uk/magna-carta/videos/from-legal-document-to-public-myth-magna-carta-in-the-17th-century" class="external text" id="mwD_w">"From legal document to public myth: Magna Carta in the 17th century"</a>. <i id="mwD_0">The British Library</i>. Archived from <a rel="mw:ExtLink nofollow" href="https://www.bl.uk/magna-carta/videos/from-legal-document-to-public-myth-magna-carta-in-the-17th-century" class="external text" id="mwD_4">the original</a> on 18 October 2017<span class="reference-accessdate" id="mwD_8">. Retrieved <span class="nowrap" id="mwEAA">16 October</span> 2017</span></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2