jstor.org/stable/10.7591/j.ctt7z647" class="external text" id="mwDQU">10.7591/j.ctt7z647</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=The+Pseudo-Democrat%27s+Dilemma%3A+Why+Election+Observation+Became+an+International+Norm&amp;rft.pub=Cornell+University+Press&amp;rft.date=2011&amp;rft_id=https%3A%2F%2Fwww.jstor.org%2Fstable%2F10.7591%2Fj.ctt7z647%23id-name%3DJSTOR&amp;rft.isbn=978-0-8014-6125-5&amp;rft.aulast=Hyde&amp;rft.aufirst=Susan+D.&amp;rft_id=https%3A%2F%2Fwww.jstor.org%2Fstable%2F10.7591%2Fj.ctt7z647&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt88" id="mwDQY"></span></span></li>
<li about="#cite_note-17" id="cite_note-17" data-mw-footnote-number="16"><span class="mw-cite-backlink" id="mwDQc"><a href="#cite_ref-17" rel="mw:referencedBy" id="mwDQg"><span class="mw-linkback-text" id="mwDQk">↑</span></a></span> <span id="mw-reference-text-cite_note-17" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt91" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDQo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last1":{"wt":"Guriev"},"first1":{"wt":"Sergei"},"url":{"wt":"https://books.google.com/books?id=4ThCEAAAQBAJ&amp;pg=PR9"},"title":{"wt":"Spin Dictators: The Changing Face of Tyranny in the 21st Century"},"last2":{"wt":"Treisman"},"first2":{"wt":"Daniel"},"date":{"wt":"2022"},"publisher":{"wt":"Princeton University Press"},"isbn":{"wt":"978-0-691-22446-6"},"language":{"wt":"en"}},"i":0}}]}'/><cite id="CITEREFGurievTreisman2022" class="citation book cs1" about="#mwt91">Guriev, Sergei; Treisman, Daniel (2022). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=4ThCEAAAQBAJ&amp;pg=PR9" class="external text" id="mwDQs"><i id="mwDQw">Spin Dictators: The Changing Face of Tyranny in the 21st Century</i></a>. Princeton University Press. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDQ0">ISBN</a><span typeof="mw:Entity" id="mwDQ4"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-691-22446-6" title="Special:BookSources/978-0-691-22446-6" id="mwDQ8"><bdi id="mwDRA">978-0-691-22446-6</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Spin+Dictators%3A+The+Changing+Face+of+Tyranny+in+the+21st+Century&amp;rft.pub=Princeton+University+Press&amp;rft.date=2022&amp;rft.isbn=978-0-691-22446-6&amp;rft.aulast=Guriev&amp;rft.aufirst=Sergei&amp;rft.au=Treisman%2C+Daniel&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3D4ThCEAAAQBAJ%26pg%3DPR9&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt91" id="mwDRE"></span></span></li>
<li about="#cite_note-18" id="cite_note-18" data-mw-footnote-number="17"><span class="mw-cite-backlink" id="mwDRI"><a href="#cite_ref-18" rel="mw:referencedBy" id="mwDRM"><span class="mw-linkback-text" id="mwDRQ">↑</span></a></span> <span id="mw-reference-text-cite_note-18" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt94" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDRU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"last":{"wt":"Tudor"},"first":{"wt":"Maya"},"date":{"wt":"2025"},"title":{"wt":"What Democracy Does … And Does Not Do"},"url":{"wt":"https://muse.jhu.edu/pub/1/article/970345"},"journal":{"wt":"Journal of Democracy"},"volume":{"wt":"36"},"issue":{"wt":"4"},"pages":{"wt":"5–19"},"doi":{"wt":"10.1353/jod.2025.a970345"},"issn":{"wt":"1086-3214"},"url-access":{"wt":"subscription"}},"i":0}}]}'/><cite id="CITEREFTudor2025" class="citation journal cs1" about="#mwt94">Tudor, Maya (2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwDRY"><a rel="mw:ExtLink nofollow" href="https://muse.jhu.edu/pub/1/article/970345" class="external text" id="mwDRc">"What Democracy Does … And Does Not Do"</a></span>. <i id="mwDRg">Journal of Democracy</i>. <b id="mwDRk">36</b> (4): <span class="nowrap" id="mwDRo">5–</span>19. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDRs">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1353%2Fjod.2025.a970345" class="external text" id="mwDRw">10.1353/jod.2025.a970345</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwDR0">ISSN</a><span typeof="mw:Entity" id="mwDR4"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/1086-3214" class="external text" id="mwDR8">1086-3214</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Journal+of+Democracy&amp;rft.atitle=What+Democracy+Does+%E2%80%A6+And+Does+Not+Do&amp;rft.volume=36&amp;rft.issue=4&amp;rft.pages=5-19&amp;rft.date=2025&amp;rft_id=info%3Adoi%2F10.1353%2Fjod.2025.a970345&amp;rft.issn=1086-3214&amp;rft.aulast=Tudor&amp;rft.aufirst=Maya&amp;rft_id=https%3A%2F%2Fmuse.jhu.edu%2Fpub%2F1%2Farticle%2F970345&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt94" id="mwDSA"></span></span></li>
<li about="#cite_note-V-dem-19" id="cite_note-V-dem-19" data-mw-footnote-number="18"><span class="mw-cite-backlink" id="mwDSE"><a href="#cite_ref-V-dem_19-0" rel="mw:referencedBy" id="mwDSI"><span class="mw-linkback-text" id="mwDSM">↑</span></a></span> <span id="mw-reference-text-cite_note-V-dem-19" class="mw-reference-text reference-text"><a rel="mw:ExtLink nofollow" href="https://www.v-dem.net/documents/19/dr_2022_ipyOpLP.pdf" class="external text" id="mwDSQ">V-Dem Institute DEMOCRACY REPORT 2022: Autocratization Changing Nature?</a> pp. 6, 13, 18: "Dictatorships are on the rise and harbor 70% of the world population – 5.4 billion people."</span></li>
<li about="#cite_note-20" id="cite_note-20" data-mw-footnote-number="19"><span class="mw-cite-backlink" id="mwDSU"><a href="#cite_ref-20" rel="mw:referencedBy" id="mwDSY"><span class="mw-linkback-text" id="mwDSc">↑</span></a></span> <span id="mw-reference-text-cite_note-20" class="mw-reference-text reference-text">Economic Intelligence Unit Democracy Index, 2022, p. 4: "According to our measure of democracy, less than half (45.7%) of the world's population now live in a democracy of some sort, a significant decline from 2020 (49.4%)."</span></li>
<li about="#cite_note-21" id="cite_note-21" data-mw-footnote-number="20"><span class="mw-cite-backlink" id="mwDSg"><a href="#cite_ref-21" rel="mw:referencedBy" id="mwDSk"><span class="mw-linkback-text" id="mwDSo">↑</span></a></span> <span id="mw-reference-text-cite_note-21" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt99" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDSs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"author1":{"wt":"Richard Wike"},"author2":{"wt":"Janell Fetterolf"},"author3":{"wt":"Jonathan Schulman"},"date":{"wt":"30 June 2025"},"title":{"wt":"Dissatisfaction with democracy remains widespread in many nations"},"url":{"wt":"https://www.pewresearch.org/short-reads/2025/06/30/dissatisfaction-with-democracy-remains-widespread-in-many-nations/"},"access-date":{"wt":"14 December 2025"},"website":{"wt":"Pew Research Center"},"language":{"wt":"en-US"}},"i":0}}]}'/><cite id="CITEREFRichard_WikeJanell_FetterolfJonathan_Schulman2025" class="citation web cs1" about="#mwt99">Richard Wike; Janell Fetterolf; Jonathan Schulman (30 June 2025). <a rel="mw:ExtLink nofollow" href="https://www.pewresearch.org/short-reads/2025/06/30/dissatisfaction-with-democracy-remains-widespread-in-many-nations/" class="external text" id="mwDSw">"Dissatisfaction with democracy remains widespread in many nations"</a>. <i id="mwDS0">Pew Research Center</i><span class="reference-accessdate" id="mwDS4">. Retrieved <span class="nowrap" id="mwDS8">14 December</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Pew+Research+Center&amp;rft.atitle=Dissatisfaction+with+democracy+remains+widespread+in+many+nations&amp;rft.date=2025-06-30&amp;rft.au=Richard+Wike&amp;rft.au=Janell+Fetterolf&amp;rft.au=Jonathan+Schulman&amp;rft_id=https%3A%2F%2Fwww.pewresearch.org%2Fshort-reads%2F2025%2F06%2F30%2Fdissatisfaction-with-democracy-remains-widespread-in-many-nations%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt99" id="mwDTA"></span></span></li>
<li about="#cite_note-22" id="cite_note-22" data-mw-footnote-number="21"><span class="mw-cite-backlink" id="mwDTE"><a href="#cite_ref-22" rel="mw:referencedBy" id="mwDTI"><span class="mw-linkback-text" id="mwDTM">↑</span></a></span> <span id="mw-reference-text-cite_note-22" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt102" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDTQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"author1":{"wt":"Richard Wike"},"author2":{"wt":"Laura Silver"},"author3":{"wt":"Alexandra Castillo"},"date":{"wt":"29 April 2019"},"title":{"wt":"Dissatisfaction with performance of democracy is common in many nations"},"url":{"wt":"https://www.pewresearch.org/global/2019/04/29/dissatisfaction-with-performance-of-democracy-is-common-in-many-nations/"},"access-date":{"wt":"14 December 2025"},"website":{"wt":"Pew Research Center"},"language":{"wt":"en-US"}},"i":0}}]}'/><cite id="CITEREFRichard_WikeLaura_SilverAlexandra_Castillo2019" class="citation web cs1" about="#mwt102">Richard Wike; Laura Silver; Alexandra Castillo (29 April 2019). <a rel="mw:ExtLink nofollow" href="https://www.pewresearch.org/global/2019/04/29/dissatisfaction-with-performance-of-democracy-is-common-in-many-nations/" class="external text" id="mwDTU">"Dissatisfaction with performance of democracy is common in many nations"</a>. <i id="mwDTY">Pew Research Center</i><span class="reference-accessdate" id="mwDTc">. Retrieved <span class="nowrap" id="mwDTg">14 December</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Pew+Research+Center&amp;rft.atitle=Dissatisfaction+with+performance+of+democracy+is+common+in+many+nations&amp;rft.date=2019-04-29&amp;rft.au=Richard+Wike&amp;rft.au=Laura+Silver&amp;rft.au=Alexandra+Castillo&amp;rft_id=https%3A%2F%2Fwww.pewresearch.org%2Fglobal%2F2019%2F04%2F29%2Fdissatisfaction-with-performance-of-democracy-is-common-in-many-nations%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt102" id="mwDTk"></span></span></li>
<li about="#cite_note-economist2007-23" id="cite_note-economist2007-23" data-mw-footnote-number="22"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwDTo"><a href="#cite_ref-economist2007_23-0" id="mwDTs"><span class="mw-linkback-text" id="mwDTw">1</span></a> <a href="#cite_ref-economist2007_23-1" id="mwDT0"><span class="mw-linkback-text" id="mwDT4">2</span></a></span> <span id="mw-reference-text-cite_note-economist2007-23" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt134" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDT8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite news","href":"./Template:Cite_news"},"params":{"last":{"wt":"Staff writer"},"url":{"wt":"http://www.economist.com/markets/rankings/displaystory.cfm?story_id=8908438"},"title":{"wt":"Liberty and justice for some"},"newspaper":{"wt":"[[The Economist]]"},"publisher":{"wt":"[[Economist Group]]"},"date":{"wt":"22 August 2007"},"quote":{"wt":"Democracy can be seen as a set of practices and principles that institutionalise and thus ultimately protect freedom. Even if a consensus on precise definitions has proved elusive, most observers today would agree that, at a minimum, the fundamental features of democracy include a government based on majority rule and the consent of the governed, the existence of free and fair elections, the protection of minorities and respect for basic human rights. Democracy presupposes equality before the law, due process and political pluralism."}},"i":0}}]}'/><cite id="CITEREFStaff_writer2007" class="citation news cs1" about="#mwt134">Staff writer (22 August 2007). <a rel="mw:ExtLink nofollow" href="http://www.economist.com/markets/rankings/displaystory.cfm?story_id=8908438" class="external text" id="mwDUA">"Liberty and justice for some"</a>. <i id="mwDUE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_Economist" title="The Economist" id="mwDUI">The Economist</a></i>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Economist_Group" title="Economist Group" class="mw-redirect" id="mwDUM">Economist Group</a>. <q id="mwDUQ">Democracy can be seen as a set of practices and principles that institutionalise and thus ultimately protect freedom. Even if a consensus on precise definitions has proved elusive, most observers today would agree that, at a minimum, the fundamental features of democracy include a government based on majority rule and the consent of the governed, the existence of free and fair elections, the protection of minorities and respect for basic human rights. Democracy presupposes equality before the law, due process and political pluralism.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+Economist&amp;rft.atitle=Liberty+and+justice+for+some&amp;rft.date=2007-08-22&amp;rft.au=Staff+writer&amp;rft_id=http%3A%2F%2Fwww.economist.com%2Fmarkets%2Frankings%2Fdisplaystory.cfm%3Fstory_id%3D8908438&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt134" id="mwDUU"></span></span></li>
<li about="#cite_note-24" id="cite_note-24" data-mw-footnote-number="23"><span class="mw-cite-backlink" id="mwDUY"><a href="#cite_ref-24" rel="mw:referencedBy" id="mwDUc"><span class="mw-linkback-text" id="mwDUg">↑</span></a></span> <span id="mw-reference-text-cite_note-24" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt111" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDUk" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal","href":"./Template:Cite_journal"},"params":{"last":{"wt":"Gagnon"},"first":{"wt":"Jean-Paul"},"date":{"wt":"1 June 2018"},"title":{"wt":"2,234 Descriptions of Democracy"},"url":{"wt":"http://berghahnjournals.com/view/journals/democratic-theory/5/1/dt050107.xml"},"journal":{"wt":"Democratic Theory"},"volume":{"wt":"5"},"issue":{"wt":"1"},"pages":{"wt":"92–113"},"doi":{"wt":"10.3167/dt.2018.050107"},"s2cid":{"wt":"149825810"},"issn":{"wt":"2332-8894"},"url-access":{"wt":"subscription"}},"i":0}}]}'/><cite id="CITEREFGagnon2018" class="citation journal cs1" about="#mwt111">Gagnon, Jean-Paul (1 June 2018). <span class="id-lock-subscription" title="Paid subscription required" id="mwDUo"><a rel="mw:ExtLink nofollow" href="http://berghahnjournals.com/view/journals/democratic-theory/5/1/dt050107.xml" class="external text" id="mwDUs">"2,234 Descriptions of Democracy"</a></span>. <i id="mwDUw">Democratic Theory</i>. <b id="mwDU0">5</b> (1): <span class="nowrap" id="mwDU4">92–</span>113. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDU8">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.3167%2Fdt.2018.050107" class="external text" id="mwDVA">10.3167/dt.2018.050107</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwDVE">ISSN</a><span typeof="mw:Entity" id="mwDVI"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/2332-8894" class="external text" id="mwDVM">2332-8894</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwDVQ">S2CID</a><span typeof="mw:Entity" id="mwDVU"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:149825810" class="external text" id="mwDVY">149825810</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Democratic+Theory&amp;rft.atitle=2%2C234+Descriptions+of+Democracy&amp;rft.volume=5&amp;rft.issue=1&amp;rft.pages=92-113&amp;rft.date=2018-06-01&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A149825810%23id-name%3DS2CID&amp;rft.issn=2332-8894&amp;rft_id=info%3Adoi%2F10.3167%2Fdt.2018.050107&amp;rft.aulast=Gagnon&amp;rft.aufirst=Jean-Paul&amp;rft_id=http%3A%2F%2Fberghahnjournals.com%2Fview%2Fjournals%2Fdemocratic-theory%2F5%2F1%2Fdt050107.xml&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ADemocracy" class="Z3988" about="#mwt111" id="mwDVc"></span></span></li>
