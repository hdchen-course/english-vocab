<li about="#cite_note-TOI-410" id="cite_note-TOI-410" data-mw-footnote-number="403"><span class="mw-cite-backlink" id="mwJ4c"><a href="#cite_ref-TOI_410-0" rel="mw:referencedBy" id="mwJ4g"><span class="mw-linkback-text" id="mwJ4k">↑</span></a></span> <span id="mw-reference-text-cite_note-TOI-410" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1155" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJ4o" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite news ","href":"./Template:Cite_news"},"params":{"date":{"wt":"2 January 2012"},"title":{"wt":"Proving their mettle in metal craft"},"work":{"wt":"The Times of India"},"url":{"wt":"https://timesofindia.indiatimes.com/city/hyderabad/Proving-their-mettle-in-metal-craft/articleshow/11332582.cms"},"url-status":{"wt":"live"},"access-date":{"wt":"2 January 2012"},"archive-url":{"wt":"https://web.archive.org/web/20130508043800/http://articles.timesofindia.indiatimes.com/2012-01-02/hyderabad/30580986_1_bidriware-hyderabad-bidar"},"archive-date":{"wt":"8 May 2013"}},"i":0}}]}'/><cite class="citation news cs1" about="#mwt1155" id="mwJ4s"><a rel="mw:ExtLink nofollow" href="https://timesofindia.indiatimes.com/city/hyderabad/Proving-their-mettle-in-metal-craft/articleshow/11332582.cms" class="external text" id="mwJ4w">"Proving their mettle in metal craft"</a>. <i id="mwJ40">The Times of India</i>. 2 January 2012. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20130508043800/http://articles.timesofindia.indiatimes.com/2012-01-02/hyderabad/30580986_1_bidriware-hyderabad-bidar" class="external text" id="mwJ44">Archived</a> from the original on 8 May 2013<span class="reference-accessdate" id="mwJ48">. Retrieved <span class="nowrap" id="mwJ5A">2 January</span> 2012</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+Times+of+India&amp;rft.atitle=Proving+their+mettle+in+metal+craft&amp;rft.date=2012-01-02&amp;rft_id=https%3A%2F%2Ftimesofindia.indiatimes.com%2Fcity%2Fhyderabad%2FProving-their-mettle-in-metal-craft%2Farticleshow%2F11332582.cms&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1155" id="mwJ5E"></span></span></li>
<li about="#cite_note-:11-411" id="cite_note-:11-411" data-mw-footnote-number="404"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwJ5I"><a href="#cite_ref-:11_411-0" id="mwJ5M"><span class="mw-linkback-text" id="mwJ5Q">1</span></a> <a href="#cite_ref-:11_411-1" id="mwJ5U"><span class="mw-linkback-text" id="mwJ5Y">2</span></a> <a href="#cite_ref-:11_411-2" id="mwJ5c"><span class="mw-linkback-text" id="mwJ5g">3</span></a> <a href="#cite_ref-:11_411-3" id="mwJ5k"><span class="mw-linkback-text" id="mwJ5o">4</span></a></span> <span id="mw-reference-text-cite_note-:11-411" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1158" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJ5s" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"Gun Timeline {{!}} History Detectives"},"url":{"wt":"https://www.pbs.org/opb/historydetectives/technique/gun-timeline/"},"access-date":{"wt":"2025-08-05"},"website":{"wt":"PBS"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt1158" id="mwJ5w"><a rel="mw:ExtLink nofollow" href="https://www.pbs.org/opb/historydetectives/technique/gun-timeline/" class="external text" id="mwJ50">"Gun Timeline | History Detectives"</a>. <i id="mwJ54">PBS</i><span class="reference-accessdate" id="mwJ58">. Retrieved <span class="nowrap" id="mwJ6A">5 August</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=PBS&amp;rft.atitle=Gun+Timeline+%7C+History+Detectives&amp;rft_id=https%3A%2F%2Fwww.pbs.org%2Fopb%2Fhistorydetectives%2Ftechnique%2Fgun-timeline%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1158" id="mwJ6E"></span></span></li>
<li about="#cite_note-412" id="cite_note-412" data-mw-footnote-number="405"><span class="mw-cite-backlink" id="mwJ6I"><a href="#cite_ref-412" rel="mw:referencedBy" id="mwJ6M"><span class="mw-linkback-text" id="mwJ6Q">↑</span></a></span> <span id="mw-reference-text-cite_note-412" class="mw-reference-text reference-text">See <a rel="mw:ExtLink nofollow" href="http://rhsweb.org/library/1000PeopleMillennium.htm" class="external text" id="mwJ6U">People of the Millennium</a> for an overview of the wide acclaim. In 1999, the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/A&amp;E_Network" title="A&amp;E Network" class="mw-redirect" id="mwJ6Y">A&amp;E Network</a> ranked <a rel="mw:ExtLink nofollow" href="http://www.wmich.edu/mus-gened/mus170/biography100" class="external text" id="mwJ6c">Gutenberg no. 1 on their "People of the Millennium" countdown</a>. In 1997, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Time–Life" title="Time–Life" class="mw-redirect" id="mwJ6g">Time–Life</a> magazine picked <a rel="mw:ExtLink nofollow" href="http://www.mainz.de/gutenberg/g2000.htm" class="external text" id="mwJ6k">Gutenberg's invention as the most important of the second millennium</a> <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20100310192514/http://www.mainz.de/gutenberg/g2000.htm" about="#mwt1161" typeof="mw:Transclusion" class="external text" id="mwJ6o" data-mw='{"parts":[{"template":{"target":{"wt":"webarchive","href":"./Template:Webarchive"},"params":{"url":{"wt":"https://web.archive.org/web/20100310192514/http://www.mainz.de/gutenberg/g2000.htm"},"date":{"wt":"10 March 2010"}},"i":0}}]}'>Archived</a><span about="#mwt1161" id="mwJ6s"> 10 March 2010 at the </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wayback_Machine" title="Wayback Machine" about="#mwt1161" id="mwJ6w">Wayback Machine</a><link rel="mw:PageProp/Category" href="./Category:Webarchive_template_wayback_links" about="#mwt1161" id="mwJ60"/>; the same did four prominent US journalists in their 1998 resume <a rel="mw:ExtLink nofollow" href="http://rhsweb.org/library/1000PeopleMillennium.htm" class="external text" id="mwJ64">1,000 Years, 1,000 People: Ranking The Men and Women Who Shaped The Millennium</a>. The <a rel="mw:ExtLink nofollow" href="https://www.newadvent.org/cathen/07090a.htm" class="external text" id="mwJ68">Johann Gutenberg</a> entry of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Catholic_Encyclopedia" title="Catholic Encyclopedia" id="mwJ7A">Catholic Encyclopedia</a> describes his invention as having made a practically unparalleled cultural impact in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Christian_era" title="Christian era" class="mw-redirect" id="mwJ7E">Christian era</a>.</span></li>
<li about="#cite_note-White1966-413" id="cite_note-White1966-413" data-mw-footnote-number="406"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwJ7I"><a href="#cite_ref-White1966_413-0" id="mwJ7M"><span class="mw-linkback-text" id="mwJ7Q">1</span></a> <a href="#cite_ref-White1966_413-1" id="mwJ7U"><span class="mw-linkback-text" id="mwJ7Y">2</span></a></span> <span id="mw-reference-text-cite_note-White1966-413" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1165" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJ7c" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book\n","href":"./Template:Cite_book"},"params":{"last":{"wt":"White"},"first":{"wt":"Lynn Jr."},"title":{"wt":"Medieval Technology and Social Change"},"publisher":{"wt":"Oxford Univ. Press"},"year":{"wt":"1966"},"location":{"wt":"New York"},"isbn":{"wt":"0-19-500266-0"},"url":{"wt":"https://archive.org/details/medievaltechnolo00whit"}},"i":0}}]}'/><cite id="CITEREFWhite1966" class="citation book cs1" about="#mwt1165">White, Lynn Jr. (1966). <a rel="mw:ExtLink nofollow" href="https://archive.org/details/medievaltechnolo00whit" class="external text" id="mwJ7g"><i id="mwJ7k">Medieval Technology and Social Change</i></a>. New York: Oxford Univ. Press. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwJ7o">ISBN</a><span typeof="mw:Entity" id="mwJ7s"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/0-19-500266-0" title="Special:BookSources/0-19-500266-0" id="mwJ7w"><bdi id="mwJ70">0-19-500266-0</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Medieval+Technology+and+Social+Change&amp;rft.place=New+York&amp;rft.pu