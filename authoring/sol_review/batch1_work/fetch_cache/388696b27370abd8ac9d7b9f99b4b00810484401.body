<li about="#cite_note-Perri2021-82" id="cite_note-Perri2021-82" data-mw-footnote-number="81"><span class="mw-cite-backlink" id="mwGww"><a href="#cite_ref-Perri2021_82-0" rel="mw:referencedBy" id="mwGw0"><span class="mw-linkback-text" id="mwGw4">↑</span></a></span> <span id="mw-reference-text-cite_note-Perri2021-82" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt251" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwGw8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal","href":"./Template:Cite_journal"},"params":{"doi":{"wt":"10.1073/pnas.2010083118"},"title":{"wt":"Dog domestication and the dual dispersal of people and dogs into the Americas"},"year":{"wt":"2021"},"last1":{"wt":"Perri"},"first1":{"wt":"Angela R."},"last2":{"wt":"Feuerborn"},"first2":{"wt":"Tatiana R."},"last3":{"wt":"Frantz"},"first3":{"wt":"Laurent A. F."},"last4":{"wt":"Larson"},"first4":{"wt":"Greger"},"last5":{"wt":"Malhi"},"first5":{"wt":"Ripan S."},"last6":{"wt":"Meltzer"},"first6":{"wt":"David J."},"last7":{"wt":"Witt"},"first7":{"wt":"Kelsey E."},"journal":{"wt":"[[Proceedings of the National Academy of Sciences]]"},"volume":{"wt":"118"},"issue":{"wt":"6"},"article-number":{"wt":"e2010083118"},"pmid":{"wt":"33495362"},"pmc":{"wt":"8017920"},"bibcode":{"wt":"2021PNAS..11810083P"},"url":{"wt":"https://ora.ox.ac.uk/objects/uuid:e31cc7b2-7912-47ac-89f5-ebc883f31160"},"quote":{"wt":"Advances in the isolation and sequencing of ancient DNA [... suggest] that dogs were domesticated in Siberia by ~23,000 y ago, possibly while both people and wolves were isolated during the harsh climate of the Last Glacial Maximum."},"doi-access":{"wt":"free"}},"i":0}}]}'/><cite id="CITEREFPerriFeuerbornFrantzLarson2021" class="citation journal cs1" about="#mwt251">Perri, Angela R.; Feuerborn, Tatiana R.; Frantz, Laur