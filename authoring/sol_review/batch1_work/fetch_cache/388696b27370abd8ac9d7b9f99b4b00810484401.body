<li about="#cite_note-591" id="cite_note-591" data-mw-footnote-number="584"><span class="mw-cite-backlink" id="mwLxk"><a href="#cite_ref-591" rel="mw:referencedBy" id="mwLxo"><span class="mw-linkback-text" id="mwLxs">↑</span></a></span> <span id="mw-reference-text-cite_note-591" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1681" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwLxw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Gilbert"},"first1":{"wt":"Walter"},"last2":{"wt":"Maxam"},"first2":{"wt":"Allan"},"date":{"wt":"February 1977"},"title":{"wt":"A new method for sequencing DNA"},"journal":{"wt":"Proceedings of the National Academy of Sciences of the United States of America"},"volume":{"wt":"74"},"issue":{"wt":"2"},"pages":{"wt":"560–566"},"doi":{"wt":"10.1073/pnas.74.2.560"},"pmid":{"wt":"265521"},"pmc":{"wt":"392330"},"bibcode":{"wt":"1977PNAS...74..560M"},"doi-access":{"wt":"free"}},"i":0}}]}'/><cite id="CITEREFGilbertMaxam1977" class="citation journal cs1" about="#mwt1681">Gilbert, Walter; Maxam, Allan (February 1977). <a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC392330" class="external text" id="mwLx0">"A new method for sequencing DNA"</a>. <i id="mwLx4">Proceedings of the National Academy of Sciences of the United States of America</i>. <b id="mwLx8">74</b> (2): <span class="nowrap" id="mwLyA">560–</span>566. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bibcode_(identifier)" title="Bibcode (identifier)" class="mw-redirect" id="mwLyE">Bibcode</a>:<a rel="mw:ExtLink nofollow" href="https://ui.adsabs.harvard.edu/abs/1977PNAS...74..560M" class="external text" id="mwLyI">1977PNAS...74..560M</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wi