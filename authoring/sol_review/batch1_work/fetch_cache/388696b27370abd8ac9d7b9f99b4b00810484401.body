ifier)" class="mw-redirect" id="mwMBQ">doi</a>:<span class="id-lock-free" title="Freely accessible" id="mwMBU"><a rel="mw:ExtLink nofollow" href="https://doi.org/10.1073%2Fpnas.0603953103" class="external text" id="mwMBY">10.1073/pnas.0603953103</a></span>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwMBc">ISSN</a><span typeof="mw:Entity" id="mwMBg"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/0027-8424" class="external text" id="mwMBk">0027-8424</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PMC_(identifier)" title="PMC (identifier)" class="mw-redirect" id="mwMBo">PMC</a><span typeof="mw:Entity" id="mwMBs"> </span><span class="id-lock-free" title="Freely accessible" id="mwMBw"><a rel="mw:ExtLink nofollow" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC1482540" class="external text" id="mwMB0">1482540</a></span>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PMID_(identifier)" title="PMID (identifier)" class="mw-redirect" id="mwMB4">PMID</a><span typeof="mw:Entity" id="mwMB8"> </span><a rel="mw:ExtLink nofollow" href="https://pubmed.ncbi.nlm.nih.gov/16754883" class="external text" id="mwMCA">16754883</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Proceedings+of+the+National+Academy+of+Sciences+of+the+United+States+of+America&amp;rft.atitle=Profile+of+Alec+J.+Jeffreys&amp;rft.volume=103&amp;rft.issue=24&amp;rft.pages=8918-8920&amp;rft.date=2006-06-13&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC1482540%23id-name%3DPMC&amp;rft_id=info%3Abibcode%2F2006PNAS..103.8918Z&amp;rft_id=info%3Apmid%2F16754883&amp;rft_id=info%3Adoi%2F10.1073%2Fpnas.0603953103&amp;rft.issn=0027-8424&amp;rft.aulast=Zagorski&amp;rft.aufirst=Nick&amp;rft_id=https%3A%2F%2Fwww.ncbi.nlm.nih.gov%2Fpmc%2Farticles%2FPMC1482540&amp;rfr_id=info%3Asid%2Fen.