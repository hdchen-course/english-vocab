<li about="#cite_note-374" id="cite_note-374" data-mw-footnote-number="367"><span class="mw-cite-backlink" id="mwJmA"><a href="#cite_ref-374" rel="mw:referencedBy" id="mwJmE"><span class="mw-linkback-text" id="mwJmI">↑</span></a></span> <span id="mw-reference-text-cite_note-374" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFNeedham1954" about="#mwt1073" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwJmM" data-mw='{"parts":[{"template":{"target":{"wt":"Harvnb","href":"./Template:Harvnb"},"params":{"1":{"wt":"Needham"},"2":{"wt":"1954"},"pp":{"wt":"[https://archive.org/stream/ScienceAndCivilisationInChina/Science_and_Civilisation_in_China_Vol_1_Introductory_Orientations#page/n177/mode/2up 131–132]"}},"i":0}}]}'>Needham 1954</a><span about="#mwt1073" id="mwJmQ">, pp.</span><span typeof="mw:Entity" about="#mwt1073" id="mwJmU"> </span><a rel="mw:ExtLink nofollow" href="https://archive.org/stream/ScienceAndCivilisationInChina/Science_and_Civilisation_in_China_Vol_1_Introductory_Orientations#page/n177/mode/2up" about="#mwt1073" class="external text" id="mwJmY">131–132</a>.</span></li>
<li about="#cite_note-wilkinson-375" id="cite_note-wilkinson-375" data-mw-footnote-number="368"><span class="mw-cite-backlink" id="mwJmc"><a href="#cite_ref-wilkinson_375-0" rel="mw:referencedBy" id="mwJmg"><span class="mw-linkback-text" id="mwJmk">↑</span></a></span> <span id="mw-reference-text-cite_note-wilkinson-375" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1075" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJmo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal","href":"./Template:Cite_journal"},"params":{"last":{"wt":"Wilkinson"},"first":{"wt":"W.H."},"title":{"wt":"Chinese Origin of Playing Cards"},"journal":{"wt":"[[American Anthropologist]]"},"volume":{"wt":"VIII"},"issue":{"wt":"1"},"year":{"wt":"1895"},"pages":{"wt":"61–78"},"doi":{"wt":"10.1525/aa.1895.8.1.02a00070"},"url":{"wt":"https://zenodo.org/record/1448960"},"doi-access":{"wt":"free"}},"i":0}}]}'/><cite id="CITEREFWilkinson1895" class="citation journal cs1" about="#mwt1075">Wilkinson, W.H. (1895). <a rel="mw:ExtLink nofollow" href="https://zenodo.org/record/1448960" class="external text" id="mwJms">"Chinese Origin of Playing Cards"</a>. <i id="mwJmw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/American_Anthropologist" title="American Anthropologist" id="mwJm0">American Anthropologist</a></i>. <b id="mwJm4">VIII</b> (1): <span class="nowrap" id="mwJm8">61–</span>78. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwJnA">doi</a>:<span class="id-lock-free" title="Freely accessible" id="mwJnE"><a rel="mw:ExtLink nofollow" href="https://doi.org/10.1525%2Faa.1895.8.1.02a00070" class="external text" id="mwJnI">10.1525/aa.1895.8.1.02a00070</a></span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=American+Anthropologist&amp;rft.atitle=Chinese+Origin+of+Playing+Cards&amp;rft.volume=VIII&amp;rft.issue=1&amp;rft.pages=61-78&amp;rft.date=1895&amp;rft_id=info%3Adoi%2F10.1525%2Faa.1895.8.1.02a00070&amp;rft.aulast=Wilkinson&amp;rft.aufirst=W.H.&amp;rft_id=https%3A%2F%2Fzenodo.org%2Frecord%2F1448960&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1075" id="mwJnM"></span></span></li>
<li about="#cite_note-lo_2000_390-376" id="cite_note-lo_2000_390-376" data-mw-footnote-number="369"><span class="mw-cite-backlink" id="mwJnQ"><a href="#cite_ref-lo_2000_390_376-0" rel="mw:referencedBy" id="mwJnU"><span class="mw-linkback-text" id="mwJnY">↑</span></a></span> <span id="mw-reference-text-cite_note-lo_2000_390-376" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1078" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJnc" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"doi":{"wt":"10.1017/S0041977X00008466"},"title":{"wt":"The game of leaves: An inquiry into the origin of Chinese playing cards"},"journal":{"wt":"Bulletin of the School of Oriental and African Studies"},"volume":{"wt":"63"},"issue":{"wt":"3"},"pages":{"wt":"389–406"},"year":{"wt":"2009"},"last1":{"wt":"Lo"},"first1":{"wt":"A."},"s2cid":{"wt":"159872810"}},"i":0}}]}'/><cite id="CITEREFLo2009" class="citation journal cs1" about="#mwt1078">Lo, A. (2009). "The game of leaves: An inquiry into the origin of Chinese playing cards". <i id="mwJng">Bulletin of the School of Oriental and African Studies</i>. <b id="mwJnk">63</b> (3): <span class="nowrap" id="mwJno">389–</span>406. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwJns">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1017%2FS0041977X00008466" class="external text" id="mwJnw">10.1017/S0041977X00008466</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwJn0">S2CID</a><span typeof="mw:Entity" id="mwJn4"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:159872810" class="external text" id="mwJn8">159872810</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Bulletin+of+the+School+of+Oriental+and+African+Studies&amp;rft.atitle=The+game+of+leaves%3A+An+inquiry+into+the+origin+of+Chinese+playing+cards&amp;rft.volume=63&amp;rft.issue=3&amp;rft.pages=389-406&amp;rft.date=2009&amp;rft_id=info%3Adoi%2F10.1017%2FS0041977X00008466&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A159872810%23id-name%3DS2CID&amp;rft.aulast=Lo&amp;rft.aufirst=A.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1078" id="mwJoA"></span></span></li>
<li about="#cite_note-377" id="cite_note-377" data-mw-footnote-number="370"><span class="mw-cite-backlink" id="mwJoE"><a href="#cite_ref-377" rel="mw:referencedBy" id="mwJoI"><span class="mw-linkback-text" id="mwJoM">↑</span></a></span> <span id="mw-reference-text-cite_note-377" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFNeedham2004" about="#mwt1081" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwJoQ" data-mw='{"parts":[{"template":{"target":{"wt":"Harvnb","href":"./Template:Harvnb"},"params":{"1":{"wt":"Needham"},"2":{"wt":"2004"},"p":{"wt":"[https://archive.org/stream/ScienceAndCivilisationInChina/Science_and_Civilisation_in_China_Vol_4-1_Physics_and_Physical_Technology_Physics#page/n379/mode/2up/search/dominoes 328]"}},"i":0}}]}'>Needham 2004</a><span about="#mwt1081" id="mwJoU">, p.</span><span typeof="mw:Entity" about="#mwt1081" id="mwJoY"> </span><a rel="mw:ExtLink nofollow" href="https://archive.org/stream/ScienceAndCivilisationInChina/Science_and_Civilisation_in_China_Vol_4-1_Physics_and_Physical_Technology_Physics#page/n379/mode/2up/search/dominoes" about="#mwt1081" class="external text" id="mwJoc">328</a> "it is also now rather well-established that dominoes and playing-cards were originally Chinese developments from dice."</span></li>
<li about="#cite_note-378" id="cite_note-378" data-mw-footnote-number="371"><span class="mw-cite-backlink" id="mwJog"><a href="#cite_ref-378" rel="mw:referencedBy" id="mwJok"><span class="mw-linkback-text" id="mwJoo">↑</span></a></span> <span id="mw-reference-text-cite_note-378" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFNeedham2004" about="#mwt1083" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwJos" data-mw='{"parts":[{"template":{"target":{"wt":"Harvnb","href":"./Template:Harvnb"},"params":{"1":{"wt":"Needham"},"2":{"wt":"2004"},"p":{"wt":"[https://archive.org/stream/ScienceAndCivilisationInChina/Science_and_Civilisation_in_China_Vol_4-1_Physics_and_Physical_Technology_Physics#page/n383/mode/2up 332]"}},"i":0}}]}'>Needham 2004</a><span about="#mwt1083" id="mwJow">, p.</span><span typeof="mw:Entity" about="#mwt1083" id="mwJo0"> </span><a rel="mw:ExtLink nofollow" href="https://archive.org/stream/ScienceAndCivilisationInChina/Science_and_Civilisation_in_China_Vol_4-1_Physics_and_Physical_Technology_Physics#page/n383/mode/2up" about="#mwt1083" class="external text" id="mwJo4">332</a> "Numbered dice, anciently widespread, were on a related line of development which gave rise to dominoes and playing-cards (+9th-century China)."</span></li>
<li about="#cite_note-379" id="cite_note-379" data-mw-footnote-number="372"><span class="mw-cite-backlink" id="mwJo8"><a href="#cite_ref-379" rel="mw:referencedBy" id="mwJpA"><span class="mw-linkback-text" id="mwJpE">↑</span></a></span> <span id="mw-reference-text-cite_note-379" class="mw-reference-text reference-text">Needham (1986), Volume 5, Part 7, 224–225, 232–233, 241–244.</span></li>
<li about="#cite_note-Helaine-380" id="cite_note-Helaine-380" data-mw-footnote-number="373"><span class="mw-cite-backlink" id="mwJpI"><a href="#cite_ref-Helaine_380-0" rel="mw:referencedBy" id="mwJpM"><span class="mw-linkback-text" id="mwJpQ">↑</span></a></span> <span id="mw-reference-text-cite_note-Helaine-380" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1088" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJpU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book","href":"./Template:Cite_book"},"params":{"author":{"wt":"Helaine Selin"},"title":{"wt":"Encyclopaedia of the History of Science, Technology, and Medicine in Non-Western Cultures"},"url":{"wt":"https://books.google.com/books?id=raKRY3KQspsC&amp;pg=PA389"},"access-date":{"wt":"30 July 2013"},"date":{"wt":"1 January 1997"},"publisher":{"wt":"Springer"},"isbn":{"wt":"978-0-7923-4066-9"},"page":{"wt":"389"}},"i":0}}]}'/><cite id="CITEREFHelaine_Selin1997" class="citation book cs1" about="#mwt1088">Helaine Selin (1 January 1997). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=raKRY3KQspsC&amp;pg=PA389" class="external text" id="mwJpY"><i id="mwJpc">Encyclopaedia of the History of Science, Technology, and Medicine in Non-Western Cultures</i></a>. Springer. p.<span typeof="mw:Entity" id="mwJpg"> </span>389. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwJpk">ISBN</a><span typeof="mw:Entity" id="mwJpo"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-7923-4066-9" title="Special:BookSources/978-0-7923-4066-9" id="mwJps"><bdi id="mwJpw">978-0-7923-4066-9</bdi></a><span class="reference-accessdate" id="mwJp0">. Retrieved <span class="nowrap" id="mwJp4">30 July</span> 2013</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Encyclopaedia+of+the+History+of+Science%2C+Technology%2C+and+Medicine+in+Non-Western+Cultures&amp;rft.pages=389&amp;rft.pub=Springer&amp;rft.date=1997-01-01&amp;rft.isbn=978-0-7923-4066-9&amp;rft.au=Helaine+Selin&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3DraKRY3KQspsC%26pg%3DPA389&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1088" id="mwJp8"></span></span></li>
<li about="#cite_note-381" id="cite_note-381" data-mw-footnote-number="374"><span class="mw-cite-backlink" id="mwJqA"><a href="#cite_ref-381" rel="mw:referencedBy" id="mwJqE"><span class="mw-linkback-text" id="mwJqI">↑</span></a></span> <span id="mw-reference-text-cite_note-381" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1091" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJqM" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Citation ","href":"./Template:Citation"},"params":{"last":{"wt":"Crosby"},"first":{"wt":"Alfred W."},"title":{"wt":"Throwing Fire: Projectile Technology Through History"},"year":{"wt":"2002"},"publisher":{"wt":"Cambridge University Press"},"isbn":{"wt":"0-521-79158-8"}},"i":0}}]}'/><cite id="CITEREFCrosby2002" class="citation cs2" about="#mwt1091">Crosby, Alfred W. (2002), <i id="mwJqQ">Throwing Fire: Projectile Technology Through History</i>, Cambridge University Press, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwJqU">ISBN</a><span typeof="mw:Entity" id="mwJqY"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/0-521-79158-8" title="Special:BookSources/0-521-79158-8" id="mwJqc"><bdi id="mwJqg">0-521-79158-8</bdi></a></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Throwing+Fire%3A+Projectile+Technology+Through+History&amp;rft.pub=Cambridge+University+Press&amp;rft.date=2002&amp;rft.isbn=0-521-79158-8&amp;rft.aulast=Crosby&amp;rft.aufirst=Alfred+W.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1091" id="mwJqk"></span></span></li>
<li about="#cite_note-382" id="cite_note-382" data-mw-footnote-number="375"><span class="mw-cite-backlink" id="mwJqo"><a href="#cite_ref-382" rel="mw:referencedBy" id="mwJqs"><span class="mw-linkback-text" id="mwJqw">↑</span></a></span> <span id="mw-reference-text-cite_note-382" class="mw-reference-text reference-text">Gernet (1962), 186.</span></li>
<li about="#cite_note-383" id="cite_note-383" data-mw-footnote-number="376"><span class="mw-cite-backlink" id="mwJq0"><a href="#cite_ref-383" rel="mw:referencedBy" id="mwJq4"><span class="mw-linkback-text" id="mwJq8">↑</span></a></span> <span id="mw-reference-text-cite_note-383" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1095" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwJrA" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal","href":"./Template:Cite_journal"},"params":{"journal":{"wt":"[[Journal of Semitic Studies]]"},"volume":{"wt":"26"},"issue":{"wt":"1"},"year":{"wt":"1981"},"pages":{"wt":"229–234"},"title":{"wt":"A Mediaeval Islamic Prototype of the Fountain Pen?"},"first":{"wt":"C. E."},"last":{"wt":"Bosworth"},"quote":{"wt":"...not more than a few days passed before the craftsman, to whom the construction of this contrivance had been described, brought in the pen, fashioned from gold. He then filled it with ink and wrote with it, and it really did write. The pen released a little more ink than was necessary. Hence al-Mu&apos;izz ordered that it should be adjusted slightly, and he did this. He brought forward the pen and behold, it turned out to be a pen which can be turned upside down in the hand and tipped from side to side, and no trace of ink appears from it. When a secretary takes up the pen and writes with it, he is able to write in the most elegant script that could possibly be desired; then, when he lifts the pen off the sheet of writing material, it holds in the ink. I observed that it was a wonderful piece of work, the like of which I had never imagined I would ever see."},"doi":{"wt":"10.1093/jss/26.2.229"}},"i":0}}]}'/><cite id="CITEREFBosworth1981" class="citation journal cs1" about="#mwt1095">Bosworth, C. E. (1981). "A Mediaeval Islamic Prototype of the Fountain Pen?". <i id="mwJrE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Journal_of_Semitic_Studies" title="Journal of Semitic Studies" id="mwJrI">Journal of Semitic Studies</a></i>. <b id="mwJrM">26</b> (1): <span class="nowrap" id="mwJrQ">229–</span>234. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwJrU">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1093%2Fjss%2F26.2.229" class="external text" id="mwJrY">10.1093/jss/26.2.229</a>. <q id="mwJrc">...not more than a few days passed before the craftsman, to whom the construction of this contrivance had been described, brought in the pen, fashioned from gold. He then filled it with ink and wrote with it, and it really did write. The pen released a little more ink than was necessary. Hence al-Mu'izz ordered that it should be adjusted slightly, and he did this. He brought forward the pen and behold, it turned out to be a pen which can be turned upside down in the hand and tipped from side to side, and no trace of ink appears from it. When a secretary takes up the pen and writes with it, he is able to write in the most elegant script that could possibly be desired; then, when he lifts the pen off the sheet of writing material, it holds in the ink. I observed that it was a wonderful piece of work, the like of which I had never imagined I would ever see.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Journal+of+Semitic+Studies&amp;rft.atitle=A+Mediaeval+Islamic+Prototype+of+the+Fountain+Pen%3F&amp;rft.volume=26&amp;rft.issue=1&amp;rft.pages=229-234&amp;rft.date=1981&amp;rft_id=info%3Adoi%2F10.1093%2Fjss%2F26.2.229&amp;rft.aulast=Bosworth&amp;rft.aufirst=C.+E.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1095" id="mwJrg"></span></span></li>
<li about="#cite_note-needham_volume_4_111-384" id="cite_note-needham_volume_4_111-384" data-mw-footnote-number="377"><span class="mw-cite-backlink" id="mwJrk"><a href="#cite_ref-needham_volume_4_111_384-0" rel="mw:referencedBy" id="mwJro"><span class="mw-linkback-text" id="mwJrs">↑</span></a></span> <span id="mw-reference-text-cite_note-needham_volume_4_111-384" class="mw-reference-text reference-text">Needham, Volume 4, Part 2, 111.</span></li>
<li about="#cite_note-eb-calico2-385" id="cite_note-eb-calico2-385" data-mw-footnote-number="378"><span class="mw-cite-backlink" id="mwJrw"><a href="#cite_ref-eb-calico2_385-0" rel="mw:referencedBy" id="mwJr0"><span class="mw-linkback-text" id="mwJr4">↑</span></a></span> <span id="mw-reference-text-cite_note-eb-calico2-385" class="mw-reference-text reference-text"><i id="mwJr8">Encyclopædia Britannica</i> (2008). <a rel="mw:ExtLink nofollow" href="https://www.britannica.com/topic/calico-textile" class="external text" id="mwJsA">"calico"</a>.</span></li>
<li about="#cite_note-386" id="cite_note-386" data-mw-footnote-number="379"><span class="mw-cite-backlink" id="mwJsE"><a href="#cite_ref-386" rel="mw:referencedBy" id="mwJsI"><span class="mw-linkback-text" id="mwJsM">↑</span></a></span> <span id="mw-reference-text-cite_note-386" class="mw-reference-text reference-text">Needham, Volume 5, Part 1, 201–202.</span></li>
<li about="#cite_note-gernet_1996_335-387" id="cite_note-gernet_1996_335-387" data-mw-footnote-number="380"><span class="mw-cite-backlink" id="mwJsQ"><a href="#cite_ref-gernet_1996_335_387-0" rel="mw:referencedBy" id="mwJsU"><span class="mw-linkback-text" id="mwJsY">↑</span></a></span> <span id="mw-reference-text-cite_note-gernet_1996_335-387" class="mw-reference-text reference-text">Gernet (1996), 335.</span></li>
