<li about="#cite_note-225" id="cite_note-225" data-mw-footnote-number="221"><span class="mw-cite-backlink" id="mwIac"><a href="#cite_ref-225" rel="mw:referencedBy" id="mwIag"><span class="mw-linkback-text" id="mwIak">↑</span></a></span> <span id="mw-reference-text-cite_note-225" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt706" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwIao" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"last1":{"wt":"Lienhard"},"first1":{"wt":"John H."},"title":{"wt":"No. 993: SUNDIALS"},"url":{"wt":"https://www.uh.edu/engines/epi993.htm"},"website":{"wt":"The Engines of Our Ingenuity"},"publisher":{"wt":"Huston Public Media"},"access-date":{"wt":"1 March 2022"}},"i":0}}]}'/><cite id="CITEREFLienhard" class="citation web cs1" about="#mwt706">Lienhard, John H. <a rel="mw:ExtLink nofollow" href="https://www.uh.edu/engines/epi993.htm" class="external text" id="mwIas">"No. 993: SUNDIALS"</a>. <i id="mwIaw">The Engines of Our Ingenuity</i>. Huston Public Media<span class="reference-accessdate" id="mwIa0">. Retrieved <span class="nowrap" id="mwIa4">1 March</span> 2022</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=The+Engines+of+Our+Ingenuity&amp;rft.atitle=No.+993%3A+SUNDIALS&amp;rft.aulast=Lienhard&amp;rft.aufirst=John+H.&amp;rft_id=https%3A%2F%2Fwww.uh.edu%2Fengines%2Fepi993.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt706" id="mwIa8"></span></span></li>
