<li about="#cite_note-550" id="cite_note-550" data-mw-footnote-number="543"><span class="mw-cite-backlink" id="mwLQk"><a href="#cite_ref-550" rel="mw:referencedBy" id="mwLQo"><span class="mw-linkback-text" id="mwLQs">↑</span></a></span> <span id="mw-reference-text-cite_note-550" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1556" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwLQw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"publisher":{"wt":"Springer"},"location":{"wt":"Berlin, Heidelberg"},"chapter-url":{"wt":"https://link.springer.com/chapter/10.1007%2F978-3-642-55764-4_8"},"title":{"wt":"Nuclides.net"},"doi":{"wt":"10.1007/978-3-642-55764-4_8"},"isbn":{"wt":"978-3-642-62817-7"},"chapter":{"wt":"Fission Products and Yields ϒ"},"date":{"wt":"2003"},"last1":{"wt":"Magill"},"first1":{"wt":"Joseph"},"pages":{"wt":"187–196"}},"i":0}}]}'/><cite id="CITEREFMagill2003" class="citation book cs1" about="#mwt1556">Magill, Joseph (2003). <a rel="mw:ExtLink nofollow" href="https://link.springer.com/chapter/10.1007%2F978-3-642-55764-4_8" class="external text" id="mwLQ0">"Fission Products and Yields ϒ"</a>. <i id="mwLQ4">Nuclides.net</i>. Berlin, Heidelberg: Springer. pp.<span typeof="mw:Entity" id="mwLQ8"> </span><span class="nowrap" id="mwLRA">187–</span>196. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwLRE">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1007%2F978-3-642-55764-4_8" class="external text" id="mwLRI">10.1007/978-3-642-55764-4_8</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwLRM">ISBN</a><span typeof="mw:Entity" id="mwLRQ"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-3-642-62817-7" title="Special:BookSources/978-3-642-62817-7" id="mwLRU"><bdi id="mwLRY">978-3-642-62817-7</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=Fission+Products+and+Yields+%CF%92&amp;rft.btitle=Nuclides.net&amp;rft.place=Berlin%2C+Heidelberg&amp;rft.pages=187-196&amp;rft.pub=Springer&amp;rft.date=2003&amp;rft_id=info%3Adoi%2F10.1007%2F978-3-642-55764-4_8&amp;rft.isbn=978-3-642-62817-7&amp;rft.aulast=Magill&amp;rft.aufirst=Joseph&amp;rft_id=https%3A%2F%2Flink.springer.com%2Fchapter%2F10.1007%252F978-3-642-55764-4_8&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATimeline+of+historic+inventions" class="Z3988" about="#mwt1556" id="mwLRc"></span></span></li>
