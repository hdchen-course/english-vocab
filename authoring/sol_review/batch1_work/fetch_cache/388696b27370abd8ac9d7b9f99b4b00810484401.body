<div class="mw-references-wrap mw-references-columns" typeof="mw:Extension/references" about="#mwt1917" id="mwFpc" data-mw='{"name":"references","attrs":{"group":"","responsive":"1"},"body":{"extsrc":""}}'><ol class="mw-references references" id="mwFpg"><li about="#cite_note-de_Heinzelin-2" id="cite_note-de_Heinzelin-2" data-mw-footnote-number="1"><span class="mw-cite-backlink" id="mwFpk"><a href="#cite_ref-de_Heinzelin_2-0" rel="mw:referencedBy" id="mwFpo"><span class="mw-linkback-text" id="mwFps">↑</span></a></span> <span id="mw-reference-text-cite_note-de_Heinzelin-2" class="mw-reference-text reference-text"><style data-mw-deduplicate="TemplateStyles:r1333433106" typeof="mw:Extension/templatestyles mw:Transclusion" about="#mwt15" id="mwFpw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal ","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"De Heinzelin"},"first1":{"wt":"J"},"last2":{"wt":"Clark"},"first2":{"wt":"JD"},"last3":{"wt":"White"},"first3":{"wt":"T"},"last4":{"wt":"Hart"},"first4":{"wt":"W"},"last5":{"wt":"Renne"},"first5":{"wt":"P"},"last6":{"wt":"Woldegabriel"},"first6":{"wt":"G"},"last7":{"wt":"Beyene"},"first7":{"wt":"Y"},"last8":{"wt":"Vrba"},"first8":{"wt":"E"},"title":{"wt":"Environment and behavior of 2.5-million-year-old Bouri hominids"},"journal":{"wt":"Science"},"volume":{"wt":"284"},"issue":{"wt":"5414"},"pages":{"wt":"625–9"},"year":{"wt":"1999"},"pmid":{"wt":"10213682"},"doi":{"wt":"10.1126/science.284.5414.625"},"bibcode":{"wt":"1999Sci...284..625D"}},"i":0}}]}'>.mw-parser-output cite.citation{font-style:inherit;word-wrap:break-word}.mw-parser-output .citation q{quotes:"\"""\"""'""'"}.mw-parser-output .citation:target{background-color:rgba(0,127,255,0.133)}.mw-parser-output .id-lock-free.id-lock-free a{background:url("//upload.wikimedia.org/wikipedia/commons/6/65/Lock-green.svg")right 0.1em center/9px no-repeat}.mw-parser-outp