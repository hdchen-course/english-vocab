		<script type="text/javascript">

	$(document).ready(function() {

		var scroll_width = $(".home_v2-news_wrapper .news-block .news-item .more-news-link-b .item-b").width();
		var l = $(".home_v2-news_wrapper .news-block .news-item .more-news-link-b .item-b a").length;

		var item_total_width = 0;
		var items = $(".home_v2-news_wrapper .news-block .news-item .more-news-link-b .item-b a");

		var first_children = 0;
		var last_children = 0;

		var page = 1;

		for(i=0;i<l;i++){
			if(scroll_width > item_total_width+ items.eq(i).width() + 20 && i == l - 1 && first_children == 0) {

			} else if(scroll_width < item_total_width + items.eq(i).width() + 20 + 26) {

				// console.log(i);
				// console.log(scroll_width);
				// console.log(item_total_width);
				// console.log(items.eq(i).width());

				page = page + 1;

				var next_btn = $('<a href="javascript:void(0);" class="prepage" style="margin-left: 4px;" data-next_id="'+i+'" data-pre_first_id="'+first_children+'" data-page="'+page+'">...</a>');
				var add_html = items.eq(i - 1).after(next_btn);

				if(next_btn.data("page") > 2) {
					next_btn.hide();
				}

				item_total_width = 26;

				first_children = i;

				item_total_width = item_total_width + items.eq(i).width() + 20;
				items.eq(i).data("page", page);

				if(items.eq(i).data("page") > 1){
					items.eq(i).hide();
				}
				

				next_btn.click(function(){
					items.hide();
					var this_page =  $(this).data("page");
					var prepage = this_page - 1;
					var nextpage = this_page + 1;

					if($(this).hasClass("prepage")) {

						$(this).removeClass("prepage");
						$(this).addClass("nextpage");

						for(j=$(this).data("next_id");j<l;j++){
							if(items.eq(j).data("page") == this_page) {
								items.eq(j).css("display", "inline-block");
							}
						}
						$(this).parent().find("[data-page='"+prepage+"']").hide();
						$(this).parent().find("[data-page='"+nextpage+"']").css("display", "inline-block");
					}else if($(this).hasClass("nextpage")){
						$(this).addClass("prepage");
						$(this).removeClass("nextpage");

						for(j=$(this).data("pre_first_id");j<$(this).data("next_id");j++){
							items.eq(j).css("display", "inline-block");
						}
						$(this).parent().find("[data-page='"+prepage+"']").css("display", "inline-block");
						$(this).parent().find("[data-page='"+nextpage+"']").hide();
					}
				});
			} else {
				item_total_width = item_total_width + items.eq(i).width() + 20;
				items.eq(i).data("page", page);

				if(items.eq(i).data("page") > 1){
					items.eq(i).hide();
				}
			}
		}
	});
</script>

		<script type="text/javascript">
		//top menu
		$(function(){
			$(window).load(function(){
				$(window).bind('scroll resize', function(){
					var $this = $(this);
					var $this_Top=$this.scrollTop();
					
					//當高度小於100時，關閉區塊	
					if($this_Top > 130){
						$('.navbar-fixed-top').stop().animate({top:"0px"},100);
						}
					if($this_Top < 130){
						$('.navbar-fixed-top').stop().animate({top:"50px"},100);
					}
				}).scroll();
			});
		});
		//背景圖
		jQuery(function($){
	
			$.supersized({
			
				// Functionality
				slide_interval          :   10000,	// Length between transitions
				transition              :   1, 			// 0-None, 1-Fade, 2-Slide Top, 3-Slide Right, 4-Slide Bottom, 5-Slide Left, 6-Carousel Right, 7-Carousel Left
				transition_speed		:	700,		// Speed of transition
														   
				// Components							
				slide_links				:	'blank',	// Individual links for each slide (Options: false, 'num', 'name', 'blank')
				slides 					:  	[			// Slideshow Images
				{image : 'https://image.taiwantoday.tw/images/img_bp/img20260422154151526.webp', title : ''},								//{image : 'img_bp/img20160628141750456.jpg', title : 'Photo by Harry Huang'},
				//{image : 'img_bp/img20160628141839534.jpg', title : 'Photo by Yeh Jui-tsung'},
				//{image : 'img_bp/img20160628141912612.jpg', title : 'Photo by Harry Huang'},
				//{image : 'img_bp/img20160628141935564.jpg', title : ''},
			
													
												
											]
			});
		});

