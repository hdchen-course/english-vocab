<li about="#cite_note-46" id="cite_note-46" data-mw-footnote-number="43"><span class="mw-cite-backlink" id="mwBco"><a href="#cite_ref-46" rel="mw:referencedBy" id="mwBcs"><span class="mw-linkback-text" id="mwBcw">↑</span></a></span> <span id="mw-reference-text-cite_note-46" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt178" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBc0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite news ","href":"./Template:Cite_news"},"params":{"url":{"wt":"http://www.telegraph-office.com/pages/telegram.html#Punctuation"},"title":{"wt":"How to Write Telegrams Properly"},"first":{"wt":"Nelson"},"last":{"wt":"Ross"},"work":{"wt":"The Telegraph Office"},"date":{"wt":"1928"},"access-date":{"wt":"11 June 2018"},"archive-date":{"wt":"31 January 2013"},"archive-url":{"wt":"https://web.archive.org/web/20130131104336/http://www.telegraph-office.com/pages/telegram.html#Punctuation"},"url-status":{"wt":"dead"}},"i":0}}]}'/><cite id="CITEREFRoss1928" class="citation news cs1" about="#mwt178">Ross, Nelson (1928). <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20130131104336/http://www.telegraph-office.com/pages/telegram.html#Punctuation" class="external text" id="mwBc4">"How to Write Telegrams Properly"</a>. <i id="mwBc8">The Telegraph Office</i>. Archived from <a rel="mw:ExtLink nofollow" href="http://www.telegraph-office.com/pages/telegram.html#Punctuation" class="external text" id="mwBdA">the original</a> on 2013-01-31<span class="reference-accessdate" id="mwBdE">. Retrieved <span class="nowrap" id="mwBdI">2018-06-11</span></span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+Telegraph+Office&amp;rft.atitle=How+to+Write+Telegrams+Properly&amp;rft.date=1928&amp;rft.aulast=Ross&amp;rft.aufirst=Nelson&amp;rft_id=http%3A%2F%2Fwww.telegraph-office.com%2Fpages%2Ftelegram.html%23Punctuation&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" about="#mwt178" id="mwBdM"></span></span></li>
<li about="#cite_note-APA-47" id="cite_note-APA-47" data-mw-footnote-number="44"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwBdQ"><a href="#cite_ref-APA_47-0" id="mwBdU"><span class="mw-linkback-text" id="mwBdY">1</span></a> <a href="#cite_ref-APA_47-1" id="mwBdc"><span class="mw-linkback-text" id="mwBdg">2</span></a></span> <span id="mw-reference-text-cite_note-APA-47" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt183" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBdk" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://blog.apastyle.org/apastyle/2011/08/punctuating-around-quotation-marks.html"},"first":{"wt":"Chelsea"},"last":{"wt":"Lee"},"title":{"wt":"Punctuating Around Quotation Marks"},"work":{"wt":"Style Guide of the American Psychological Association"},"date":{"wt":"2011"},"archive-date":{"wt":"22 March 2017"},"archive-url":{"wt":"https://web.archive.org/web/20170322162100/http://blog.apastyle.org/apastyle/2011/08/punctuating-around-quotation-marks.html"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFLee2011" class="citation web cs1" about="#mwt183">Lee, Chelsea (2011). <a rel="mw:ExtLink nofollow" href="http://blog.apastyle.org/apastyle/2011/08/punctuating-around-quotation-marks.html" class="external text" id="mwBdo">"Punctuating Around Quotation Marks"</a>. <i id="mwBds">Style Guide of the American Psychological Association</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20170322162100/http://blog.apastyle.org/apastyle/2011/08/punctuating-around-quotation-marks.html" class="external text" id="mwBdw">Archived</a> from the original on 2017-03-22.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Style+Guide+of+the+American+Psychological+Association&amp;rft.atitle=Punctuating+Around+Quotation+Marks&amp;rft.date=2011&amp;rft.aulast=Lee&amp;rft.aufirst=Chelsea&amp;rft_id=http%3A%2F%2Fblog.apastyle.org%2Fapastyle%2F2011%2F08%2Fpunctuating-around-quotation-marks.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" about="#mwt183" id="mwBd0"></span></span></li>
<li about="#cite_note-JISS-48" id="cite_note-JISS-48" data-mw-footnote-number="45"><span class="mw-cite-backlink" id="mwBd4"><a href="#cite_ref-JISS_48-0" rel="mw:referencedBy" id="mwBd8"><span class="mw-linkback-text" id="mwBeA">↑</span></a></span> <span id="mw-reference-text-cite_note-JISS-48" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt186" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBeE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.abdn.ac.uk/riiss/Documents/JISS%20Style%20Guide%20revised%20FV.pdf"},"archive-url":{"wt":"https://web.archive.org/web/20110410233640/http://www.abdn.ac.uk/riiss/Documents/JISS%20Style%20Guide%20revised%20FV.pdf"},"archive-date":{"wt":"10 April 2011"},"url-status":{"wt":"dead"},"author":{"wt":"&lt;!--Staff writer(s); no by-line.-->"},"title":{"wt":"Style Guide"},"work":{"wt":"Journal of Irish and Scottish Studies"},"publisher":{"wt":"Research Institute of Irish and Scottish Studies, [[University of Aberdeen]]"},"date":{"wt":"2008"},"quote":{"wt":"Punctuation marks are placed inside the quotation marks only if the sense of the punctuation is part of the quotation; this system is referred to as logical quotation."},"access-date":{"wt":"15 September 2015"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt186" id="mwBeI"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20110410233640/http://www.abdn.ac.uk/riiss/Documents/JISS%20Style%20Guide%20revised%20FV.pdf" class="external text" id="mwBeM">"Style Guide"</a> <span class="cs1-format" id="mwBeQ">(PDF)</span>. <i id="mwBeU">Journal of Irish and Scottish Studies</i>. Research Institute of Irish and Scottish Studies, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/University_of_Aberdeen" title="University of Aberdeen" id="mwBeY">University of Aberdeen</a>. 2008. Archived from <a rel="mw:ExtLink nofollow" href="http://www.abdn.ac.uk/riiss/Documents/JISS%20Style%20Guide%20revised%20FV.pdf" class="external text" id="mwBec">the original</a> <span class="cs1-format" id="mwBeg">(PDF)</span> on 2011-04-10<span class="reference-accessdate" id="mwBek">. Retrieved <span class="nowrap" id="mwBeo">2015-09-15</span></span>. <q id="mwBes">Punctuation marks are placed inside the quotation marks only if the sense of the punctuation is part of the quotation; this system is referred to as logical quotation.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Journal+of+Irish+and+Scottish+Studies&amp;rft.atitle=Style+Guide&amp;rft.date=2008&amp;rft_id=http%3A%2F%2Fwww.abdn.ac.uk%2Friiss%2FDocuments%2FJISS%2520Style%2520Guide%2520revised%2520FV.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" about="#mwt186" id="mwBew"></span></span></li>
<li about="#cite_note-49" id="cite_note-49" data-mw-footnote-number="46"><span class="mw-cite-backlink" id="mwBe0"><a href="#cite_ref-49" rel="mw:referencedBy" id="mwBe4"><span class="mw-linkback-text" id="mwBe8">↑</span></a></span> <span id="mw-reference-text-cite_note-49" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt190" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBfA" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book ","href":"./Template:Cite_book"},"params":{"url":{"wt":"https://books.google.com/books?id=PoFJ-OhE63UC&amp;q=%22quotation+marks%22+%22according+to+sense%22+British&amp;pg=PA180"},"author":{"wt":"&lt;!--Staff writer(s); no by-line.-->"},"title":{"wt":"Scientific Style and Format: The CBE Manual for Authors, Editors and Publishers"},"publisher":{"wt":"Cambridge University Press"},"date":{"wt":"2002"},"quote":{"wt":"In the British style (OUP 1983), all signs of punctuation used with words and quotation marks must be placed &apos;&apos;according to the sense&apos;&apos;."},"access-date":{"wt":"4 September 2015"},"isbn":{"wt":"9780521471541"}},"i":0}}]}'/><cite class="citation book cs1" about="#mwt190" id="mwBfE"><a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=PoFJ-OhE63UC&amp;q=%22quotation+marks%22+%22according+to+sense%22+British&amp;pg=PA180" class="external text" id="mwBfI"><i id="mwBfM">Scientific Style and Format: The CBE Manual for Authors, Editors and Publishers</i></a>. Cambridge University Press. 2002. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBfQ">ISBN</a><span typeof="mw:Entity" id="mwBfU"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9780521471541" title="Special:BookSources/9780521471541" id="mwBfY"><bdi id="mwBfc">9780521471541</bdi></a><span class="reference-accessdate" id="mwBfg">. Retrieved <span class="nowrap" id="mwBfk">2015-09-04</span></span>. <q id="mwBfo">In the British style (OUP 1983), all signs of punctuation used with words and quotation marks must be placed <i id="mwBfs">according to the sense</i>.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Scientific+Style+and+Format%3A+The+CBE+Manual+for+Authors%2C+Editors+and+Publishers&amp;rft.pub=Cambridge+University+Press&amp;rft.date=2002&amp;rft.isbn=9780521471541&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3DPoFJ-OhE63UC%26q%3D%2522quotation%2Bmarks%2522%2B%2522according%2Bto%2Bsense%2522%2BBritish%26pg%3DPA180&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" about="#mwt190" id="mwBfw"></span></span></li>
<li about="#cite_note-50" id="cite_note-50" data-mw-footnote-number="47"><span class="mw-cite-backlink" id="mwBf0"><a href="#cite_ref-50" rel="mw:referencedBy" id="mwBf4"><span class="mw-linkback-text" id="mwBf8">↑</span></a></span> <span id="mw-reference-text-cite_note-50" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt193" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBgA" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last1":{"wt":"Butcher"},"first1":{"wt":"Judith"},"last2":{"wt":"Drake"},"first2":{"wt":"Caroline"},"last3":{"wt":"Leach"},"first3":{"wt":"Maureen"},"title":{"wt":"Butcher&apos;s Copy-editing: The Cambridge Handbook for Editors, Copy-editors and Proofreaders"},"publisher":{"wt":"Cambridge University Press"},"date":{"wt":"2006"},"page":{"wt":"273"},"isbn":{"wt":"978-0-521-84713-1"}},"i":0}}]}'/><cite id="CITEREFButcherDrakeLeach2006" class="citation book cs1" about="#mwt193">Butcher, Judith; Drake, Caroline; Leach, Maureen (2006). <i id="mwBgE">Butcher's Copy-editing: The Cambridge Handbook for Editors, Copy-editors and Proofreaders</i>. Cambridge University Press. p.<span typeof="mw:Entity" id="mwBgI"> </span>273. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBgM">ISBN</a><span typeof="mw:Entity" id="mwBgQ"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-521-84713-1" title="Special:BookSources/978-0-521-84713-1" id="mwBgU"><bdi id="mwBgY">978-0-521-84713-1</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Butcher%27s+Copy-editing%3A+The+Cambridge+Handbook+for+Editors%2C+Copy-editors+and+Proofreaders&amp;rft.pages=273&amp;rft.pub=Cambridge+University+Press&amp;rft.date=2006&amp;rft.isbn=978-0-521-84713-1&amp;rft.aulast=Butcher&amp;rft.aufirst=Judith&amp;rft.au=Drake%2C+Caroline&amp;rft.au=Leach%2C+Maureen&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" about="#mwt193" id="mwBgc"></span></span></li>
<li about="#cite_note-51" id="cite_note-51" data-mw-footnote-number="48"><span class="mw-cite-backlink" id="mwBgg"><a href="#cite_ref-51" rel="mw:referencedBy" id="mwBgk"><span class="mw-linkback-text" id="mwBgo">↑</span></a></span> <span id="mw-reference-text-cite_note-51" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt196" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBgs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.wilbers.com/FAQPunctuation.htm"},"first":{"wt":"Stephen"},"last":{"wt":"Wilbers"},"title":{"wt":"Frequently Asked Questions Concerning Punctuation"},"quote":{"wt":"The British style is strongly advocated by some American language experts. In defense of nearly a century and a half of the American style, however, it may be said that it seems to have been working fairly well and has not resulted in serious miscommunication. Whereas there clearly is some risk with question marks and exclamation points, there seems little likelihood that readers will be misled concerning the period or comma. There may be some risk in such specialized material as textual criticism, but in that case author and editors may take care to avoid the danger by alternative phrasing or by employing, in this exacting field, the exacting British system. In linguistic and philosophical works, specialized terms are regularly punctuated the British way, along with the use of single quotation marks. [quote attributed to Chicago Manual of style, 14th ed.]"},"access-date":{"wt":"10 September 2015"},"archive-date":{"wt":"13 June 2018"},"archive-url":{"wt":"https://web.archive.org/web/20180613040839/http://www.wilbers.com/FAQPunctuation.htm"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFWilbers" class="citation web cs1" about="#mwt196">Wilbers, Stephen. <a rel="mw:ExtLink nofollow" href="http://www.wilbers.com/FAQPunctuation.htm" class="external text" id="mwBgw">"Frequently Asked Questions Concerning Punctuation"</a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20180613040839/http://www.wilbers.com/FAQPunctuation.htm" class="external text" id="mwBg0">Archived</a> from the original on 2018-06-13<span class="reference-accessdate" id="mwBg4">. Retrieved <span class="nowrap" id="mwBg8">2015-09-10</span></span>. <q id="mwBhA">The British style is strongly advocated by some American language experts. In defense of nearly a century and a half of the American style, however, it may be said that it seems to have been working fairly well and has not resulted in serious miscommunication. Whereas there clearly is some risk with question marks and exclamation points, there seems little likelihood that readers will be misled concerning the period or comma. There may be some risk in such specialized material as textual criticism, but in that case author and editors may take care to avoid the danger by alternative phrasing or by employing, in this exacting field, the exacting British system. In linguistic and philosophical works, specialized terms are regularly punctuated the British way, along with the use of single quotation marks. [quote attributed to Chicago Manual of style, 14th ed.]</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Frequently+Asked+Questions+Concerning+Punctuation&amp;rft.aulast=Wilbers&amp;rft.aufirst=Stephen&amp;rft_id=http%3A%2F%2Fwww.wilbers.com%2FFAQPunctuation.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" about="#mwt196" id="mwBhE"></span></span></li>
<li about="#cite_note-52" id="cite_note-52" data-mw-footnote-number="49"><span class="mw-cite-backlink" id="mwBhI"><a href="#cite_ref-52" rel="mw:referencedBy" id="mwBhM"><span class="mw-linkback-text" id="mwBhQ">↑</span></a></span> <span id="mw-reference-text-cite_note-52" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt199" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBhU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book ","href":"./Template:Cite_book"},"params":{"title":{"wt":"Chicago Manual of Style"},"publisher":{"wt":"University of Chicago Press"},"edition":{"wt":"15th"},"date":{"wt":"2003"},"pages":{"wt":"[https://archive.org/details/chicagomanualofs00univ_0/page/6 6.8&amp;nbsp;– 6.10]"},"isbn":{"wt":"0-226-10403-6"},"quote":{"wt":"\"According to what is sometimes called the British style (set forth in The Oxford Guide to Style [the successor to Hart&apos;s Rules]; see bibliog. 1.1.]), a style also followed in other English-speaking countries, only those punctuation points that appeared in the original material should be included within the quotation marks; all others follow the closing quotation marks.&amp;nbsp;... In the kind of textual studies where retaining the original placement of a comma in relation to closing quotation marks is essential to the author&apos;s argument and scholarly integrity, the alternative system described in 6.10 [&apos;the British style&apos;] could be used, or rephrasing might avoid the problem.\""},"url":{"wt":"https://archive.org/details/chicagomanualofs00univ_0/page/6"}},"i":0}}]}'/><cite class="citation book cs1" about="#mwt199" id="mwBhY"><a rel="mw:ExtLink nofollow" href="https://archive.org/details/chicagomanualofs00univ_0/page/6" class="external text" id="mwBhc"><i id="mwBhg">Chicago Manual of Style</i></a> (15th<span typeof="mw:Entity" id="mwBhk"> </span>ed.). University of Chicago Press. 2003. pp.<span typeof="mw:Entity" id="mwBho"> </span><a rel="mw:ExtLink nofollow" href="https://archive.org/details/chicagomanualofs00univ_0/page/6" class="external text" id="mwBhs">6.8 – 6.10</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBhw">ISBN</a><span typeof="mw:Entity" id="mwBh0"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/0-226-10403-6" title="Special:BookSources/0-226-10403-6" id="mwBh4"><bdi id="mwBh8">0-226-10403-6</bdi></a>. <q id="mwBiA">According to what is sometimes called the British style (set forth in The Oxford Guide to Style [the successor to Hart's Rules]; see bibliog. 1.1.]), a style also followed in other English-speaking countries, only those punctuation points that appeared in the original material should be included within the quotation marks; all others follow the closing quotation marks.<span typeof="mw:Entity" id="mwBiE"> </span>... In the kind of textual studies where retaining the original placement of a comma in relation to closing quotation marks is essential to the author's argument and scholarly integrity, the alternative system described in 6.10 ['the British style'] could be used, or rephrasing might avoid the problem.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Chicago+Manual+of+Style&amp;rft.pages=6.8+-+6.10&amp;rft.edition=15th&amp;rft.pub=University+of+Chicago+Press&amp;rft.date=2003&amp;rft.isbn=0-226-10403-6&amp;rft_id=https%3A%2F%2Farchive.org%2Fdetails%2Fchicagomanualofs00univ_0%2Fpage%2F6&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" about="#mwt199" id="mwBiI"></span></span></li>
<li about="#cite_note-53" id="cite_note-53" data-mw-footnote-number="50"><span class="mw-cite-backlink" id="mwBiM"><a href="#cite_ref-53" rel="mw:referencedBy" id="mwBiQ"><span class="mw-linkback-text" id="mwBiU">↑</span></a></span> <span id="mw-reference-text-cite_note-53" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt202" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBiY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book ","href":"./Template:Cite_book"},"params":{"last1":{"wt":"Weiss"},"first1":{"wt":"Edmond H."},"title":{"wt":"The Elements of International English Style: A Guide to Writing Correspondence, Reports, Technical Documents Internet Pages For a Global Audience"},"date":{"wt":"2015"},"publisher":{"wt":"M. E. Sharpe"},"isbn":{"wt":"978-0-7656-2830-5"},"page":{"wt":"75"},"url":{"wt":"https://books.google.com/books?id=pMmfyHYCt6cC&amp;q=closed+logical+convention&amp;pg=PA75"},"access-date":{"wt":"24 January 2016"}},"i":0}}]}'/><cite id="CITEREFWeiss2015" class="citation book cs1" about="#mwt202">Weiss, Edmond H. (2015). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=pMmfyHYCt6cC&amp;q=closed+logical+convention&amp;pg=PA75" class="external text" id="mwBic"><i id="mwBig">The Elements of International English Style: A Guide to Writing Correspondence, Reports, Technical Documents Internet Pages For a Global Audience</i></a>. M. E. Sharpe. p.<span typeof="mw:Entity" id="mwBik"> </span>75. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBio">ISBN</a><span typeof="mw:Entity" id="mwBis"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-7656-2830-5" title="Special:BookSources/978-0-7656-2830-5" id="mwBiw"><bdi id="mwBi0">978-