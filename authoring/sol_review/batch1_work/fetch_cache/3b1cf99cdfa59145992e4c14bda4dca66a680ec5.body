<li about="#cite_note-Barden_2007-21" id="cite_note-Barden_2007-21" data-mw-footnote-number="18"><span class="mw-cite-backlink" id="mwBKM"><a href="#cite_ref-Barden_2007_21-0" rel="mw:referencedBy" id="mwBKQ"><span class="mw-linkback-text" id="mwBKU">↑</span></a></span> <span id="mw-reference-text-cite_note-Barden_2007-21" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt415" typeof="mw:Extension/templatestyles" id="mwBKY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFBarden2007" class="citation book cs1">Barden, Cindy (2007). <i id="mwBKc">Grammar Grades</i>. Vol.<span typeof="mw:Entity" id="mwBKg"> </span><span class="nowrap" id="mwBKk">4–</span>5. p.<span typeof="mw:Entity" id="mwBKo"> </span>9. <q id="mwBKs">Use a period after a person's initials. Examples: A. A. Milne<span typeof="mw:Entity" id="mwBKw"> </span>... L.B.Peep W157<span typeof="mw:Entity" id="mwBK0"> </span>... Use Periods With Initials Name. Initials are abbreviations for parts of a person's name.<span typeof="mw:Entity" id="mwBK4"> </span>... Date: Add periods at the ends of sentences, after abbreviations, and after initials</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Grammar+Grades&amp;rft.pages=9&amp;rft.date=2007&amp;rft.aulast=Barden&amp;rft.aufirst=Cindy&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBK8"></span></span></li>
<li about="#cite_note-Blakesley-Hoogeveen_2007-22" id="cite_note-Blakesley-Hoogeveen_2007-22" data-mw-footnote-number="19"><span class="mw-cite-backlink" id="mwBLA"><a href="#cite_ref-Blakesley-Hoogeveen_2007_22-0" rel="mw:referencedBy" id="mwBLE"><span class="mw-linkback-text" id="mwBLI">↑</span></a></span> <span id="mw-reference-text-cite_note-Blakesley-Hoogeveen_2007-22" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt420" typeof="mw:Extension/templatestyles" id="mwBLM" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFBlakesleyHoogeveen2007" class="citation book cs1">Blakesley, David; Hoogeveen, Jeffrey Laurence (2007). <i id="mwBLQ">The Brief Thomson Handbook</i>. p.<span typeof="mw:Entity" id="mwBLU"> </span>477. <q id="mwBLY">Use periods with initials: George W. Bush<span typeof="mw:Entity" id="mwBLc"> </span>... Carolyn B. Maloney</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=The+Brief+Thomson+Handbook&amp;rft.pages=477&amp;rft.date=2007&amp;rft.aulast=Blakesley&amp;rft.aufirst=David&amp;rft.au=Hoogeveen%2C+Jeffrey+Laurence&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBLg"></span></span></li>
<li about="#cite_note-SCS-23" id="cite_note-SCS-23" data-mw-footnote-number="20"><span class="mw-cite-backlink" id="mwBLk"><a href="#cite_ref-SCS_23-0" rel="mw:referencedBy" id="mwBLo"><span class="mw-linkback-text" id="mwBLs">↑</span></a></span> <span id="mw-reference-text-cite_note-SCS-23" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt425" typeof="mw:Extension/templatestyles" id="mwBLw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite class="citation web cs1" id="mwBL0"><a rel="mw:ExtLink nofollow" href="https://www.arts.gla.ac.uk/STELLA/LILT/fullstop.htm" class="external text" id="mwBL4">"Full stop"</a>. School of critical studies, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/University_of_Glasgow" title="University of Glasgow" id="mwBL8">University of Glasgow</a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20200731223635/https://www.arts.gla.ac.uk/STELLA/LILT/fullstop.htm" class="external text" id="mwBMA">Archived</a> from the original on 2020-07-31.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Full+stop&amp;rft.pub=School+of+critical+studies%2C+University+of+Glasgow&amp;rft_id=https%3A%2F%2Fwww.arts.gla.ac.uk%2FSTELLA%2FLILT%2Ffullstop.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBME"></span></span></li>
<li about="#cite_note-ELJ_2014-24" id="cite_note-ELJ_2014-24" data-mw-footnote-number="21"><span class="mw-cite-backlink" id="mwBMI"><a href="#cite_ref-ELJ_2014_24-0" rel="mw:referencedBy" id="mwBMM"><span class="mw-linkback-text" id="mwBMQ">↑</span></a></span> <span id="mw-reference-text-cite_note-ELJ_2014-24" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt430" typeof="mw:Extension/templatestyles" id="mwBMU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite class="citation web cs1" id="mwBMY"><a rel="mw:ExtLink nofollow" href="https://www.cambridge.org/core/journals/ecclesiastical-law-journal/information/instructions-contributors" class="external text" id="mwBMc">"Instructions for authors"</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ecclesiastical_Law_Journal" title="Ecclesiastical Law Journal" class="mw-redirect" id="mwBMg">Ecclesiastical Law Journal</a>. 2014-09-04. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20220410183721/https://www.cambridge.org/core/journals/ecclesiastical-law-journal/information/instructions-contributors" class="external text" id="mwBMk">Archived</a> from the original on 2022-04-10.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Instructions+for+authors&amp;rft.pub=Ecclesiastical+Law+Journal&amp;rft.date=2014-09-04&amp;rft_id=https%3A%2F%2Fwww.cambridge.org%2Fcore%2Fjournals%2Fecclesiastical-law-journal%2Finformation%2Finstructions-contributors&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBMo"></span></span></li>
<li about="#cite_note-ThirdText-25" id="cite_note-ThirdText-25" data-mw-footnote-number="22"><span class="mw-cite-backlink" id="mwBMs"><a href="#cite_ref-ThirdText_25-0" rel="mw:referencedBy" id="mwBMw"><span class="mw-linkback-text" id="mwBM0">↑</span></a></span> <span id="mw-reference-text-cite_note-ThirdText-25" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt435" typeof="mw:Extension/templatestyles" id="mwBM4" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite class="citation web cs1" id="mwBM8"><a rel="mw:ExtLink nofollow" href="http://thirdtext.org/authors-guidelines" class="external text" id="mwBNA">"Authors Guide-lines for Electronic Submission of MSS to Third Text"</a>. Third Text: Critical perspectives on contemporary art and culture. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20200801000325/http://thirdtext.org/authors-guidelines" class="external text" id="mwBNE">Archived</a> from the original on 2020-08-01<span class="reference-accessdate" id="mwBNI">. Retrieved <span class="nowrap" id="mwBNM">2020-05-02</span></span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Authors+Guide-lines+for+Electronic+Submission+of+MSS+to+Third+Text&amp;rft.pub=Third+Text%3A+Critical+perspectives+on+contemporary+art+and+culture&amp;rft_id=http%3A%2F%2Fthirdtext.org%2Fauthors-guidelines&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBNQ"></span></span></li>
<li about="#cite_note-Knuth_2016-26" id="cite_note-Knuth_2016-26" data-mw-footnote-number="23"><span class="mw-cite-backlink" id="mwBNU"><a href="#cite_ref-Knuth_2016_26-0" rel="mw:referencedBy" id="mwBNY"><span class="mw-linkback-text" id="mwBNc">↑</span></a></span> <span id="mw-reference-text-cite_note-Knuth_2016-26" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt440" typeof="mw:Extension/templatestyles" id="mwBNg" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFKnuth2016" class="citation web cs1"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Donald_Ervin_Knuth" title="Donald Ervin Knuth" class="mw-redirect" id="mwBNk">Knuth, Donald Ervin</a> (2016). <a rel="mw:ExtLink nofollow" href="https://cs.stanford.edu/~knuth/news16.html" class="external text" id="mwBNo">"Let's celebrate everybody's full names"</a>. <i id="mwBNs">Recent News</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20180122165200/https://www.cs.stanford.edu/~knuth/news16.html" class="external text" id="mwBNw">Archived</a> from the original on 2018-01-22<span class="reference-accessdate" id="mwBN0">. Retrieved <span class="nowrap" id="mwBN4">2020-07-30</span></span>. <q id="mwBN8">One of the delights of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia" title="Wikipedia" id="mwBOA">Wikipedia</a> is that its biographies generally reveal a person's full and complete name, including the correct way to spell it in different alphabets and scripts.<span typeof="mw:Entity" id="mwBOE"> </span>... When I prepared the index<span typeof="mw:Entity" id="mwBOI"> </span>... of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_Art_of_Computer_Programming" title="The Art of Computer Programming" id="mwBOM">The Art of Computer Programming</a>, I wanted to make it as useful as possible, so I spent six weeks compiling all of the entries. In order to relieve the tedium of index preparation, and to underscore the fact that my index was trying to be complete, I decided to include the full name of every author who was cited, whenever possible.<span typeof="mw:Entity" id="mwBOQ"> </span>... Over the years, many people have told me how they've greatly appreciated this feature of my books. It has turned out to be a beautiful way to relish the fact that computer science is the result of thousands of individual contributions from people with a huge variety of cultural backgrounds.<span typeof="mw:Entity" id="mwBOU"> </span>... The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/American_Mathematical_Society" title="American Mathematical Society" id="mwBOY">American Mathematical Society</a> has just launched a great initiative by which all authors can now fully identify themselves<span typeof="mw:Entity" id="mwBOc"> </span>... I strongly encourage everybody to document their full names</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Recent+News&amp;rft.atitle=Let%27s+celebrate+everybody%27s+full+names&amp;rft.date=2016&amp;rft.aulast=Knuth&amp;rft.aufirst=Donald+Ervin&amp;rft_id=https%3A%2F%2Fcs.stanford.edu%2F~knuth%2Fnews16.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBOg"></span></span></li>
<li about="#cite_note-Dunne_2015_1-27" id="cite_note-Dunne_2015_1-27" data-mw-footnote-number="24"><span class="mw-cite-backlink" id="mwBOk"><a href="#cite_ref-Dunne_2015_1_27-0" rel="mw:referencedBy" id="mwBOo"><span class="mw-linkback-text" id="mwBOs">↑</span></a></span> <span id="mw-reference-text-cite_note-Dunne_2015_1-27" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt445" typeof="mw:Extension/templatestyles" id="mwBOw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFDunne2015" class="citation web cs1">Dunne, Edward "Ed" (2015-09-14). <a rel="mw:ExtLink nofollow" href="https://blogs.ams.org/beyondreviews/2015/09/14/who-wrote-that/" class="external text" id="mwBO0">"Who wrote that?"</a>. <i id="mwBO4">AMS Blogs</i>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/American_Mathematical_Society" title="American Mathematical Society" id="mwBO8">American Mathematical Society</a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20200524082631/https://blogs.ams.org/beyondreviews/2015/09/14/who-wrote-that/" class="external text" id="mwBPA">Archived</a> from the original on 2020-05-24<span class="reference-accessdate" id="mwBPE">. Retrieved <span class="nowrap" id="mwBPI">2020-07-30</span></span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=AMS+Blogs&amp;rft.atitle=Who+wrote+that%3F&amp;rft.date=2015-09-14&amp;rft.aulast=Dunne&amp;rft.aufirst=Edward+%22Ed%22&amp;rft_id=https%3A%2F%2Fblogs.ams.org%2Fbeyondreviews%2F2015%2F09%2F14%2Fwho-wrote-that%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBPM"></span></span></li>
<li about="#cite_note-Dunne_2015_2-28" id="cite_note-Dunne_2015_2-28" data-mw-footnote-number="25"><span class="mw-cite-backlink" id="mwBPQ"><a href="#cite_ref-Dunne_2015_2_28-0" rel="mw:referencedBy" id="mwBPU"><span class="mw-linkback-text" id="mwBPY">↑</span></a></span> <span id="mw-reference-text-cite_note-Dunne_2015_2-28" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt450" typeof="mw:Extension/templatestyles" id="mwBPc" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="mwBPg" class="citation web cs1" data-x-id="CITEREFDunne2015">Dunne, Edward "Ed" (2015-11-16). <a rel="mw:ExtLink nofollow" href="https://blogs.ams.org/beyondreviews/2015/11/16/personalizing-your-author-profile/" class="external text" id="mwBPk">"Personalizing your author profile"</a>. <i id="mwBPo">AMS Blogs</i>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/American_Mathematical_Society" title="American Mathematical Society" id="mwBPs">American Mathematical Society</a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20200504071218/https://blogs.ams.org/beyondreviews/2015/11/16/personalizing-your-author-profile/" class="external text" id="mwBPw">Archived</a> from the original on 2020-05-04<span class="reference-accessdate" id="mwBP0">. Retrieved <span class="nowrap" id="mwBP4">2020-07-30</span></span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=AMS+Blogs&amp;rft.atitle=Personalizing+your+author+profile&amp;rft.date=2015-11-16&amp;rft.aulast=Dunne&amp;rft.aufirst=Edward+%22Ed%22&amp;rft_id=https%3A%2F%2Fblogs.ams.org%2Fbeyondreviews%2F2015%2F11%2F16%2Fpersonalizing-your-author-profile%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class="Z3988" id="mwBP8"></span></span></li>
<li about="#cite_note-29" id="cite_note-29" data-mw-footnote-number="26"><span class="mw-cite-backlink" id="mwBQA"><a href="#cite_ref-29" rel="mw:referencedBy" id="mwBQE"><span class="mw-linkback-text" id="mwBQI">↑</span></a></span> <span id="mw-reference-text-cite_note-29" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt113" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBQM" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book ","href":"./Template:Cite_book"},"params":{"title":{"wt":"New Hart&apos;s Rules: The Handbook of Style for Writers and Editors"},"publisher":{"wt":"Oxford University Press"},"isbn":{"wt":"0-19-861041-6"},"url":{"wt":"https://archive.org/details/newhartsrules00rmri"},"date":{"wt":"2005"}},"i":0}}]}'/><cite class="citation book cs1" about="#mwt113" id="mwBQQ"><a rel="mw:ExtLink nofollow" href="https://archive.org/details/newhartsrules00rmri" class="external text" id="mwBQU"><i id="mwBQY">New Hart's Rules: The Handbook of Style for Writers and Editors</i></a>. Oxford University Press. 2005. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBQc">ISBN</a><span typeof="mw:Entity" id="mwBQg"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/0-19-861041-6" title="Special:BookSources/0-19-861041-6" id="mwBQk"><bdi id="mwBQo">0-19-861041-6</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=New+Hart%27s+Rules%3A+The+Handbook+of+Style+for+Writers+and+Editors&amp;rft.pub=Oxford+University+Press&amp;rft.date=2005&amp;rft.isbn=0-19-861041-6&amp;rft_id=https%3A%2F%2Farchive.org%2Fdetails%2Fnewhartsrules00rmri&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AFull+stop" class=