<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kluang_Mandarin?action=edit&amp;redlink=1" title="Kluang Mandarin (page does not exist)" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Kluang Mandarin"]}}'>Kluang</a><span class="noprint" style="font-size:85%; font-style: normal; "><span typeof="mw:Entity"> </span><span typeof="mw:Entity">[</span><a rel="mw:WikiLink/Interwiki" href="https://zh.wikipedia.org/wiki/居銮华语" title="zh:居銮华语" class="extiw">zh</a><span typeof="mw:Entity">]</span></span></li></ul></li></ul></li>
