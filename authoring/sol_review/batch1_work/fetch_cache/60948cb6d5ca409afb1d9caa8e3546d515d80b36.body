<style type="text/css">@font-face {font-family:'Inter';font-style:normal;font-weight:100 900;src:url(/cf-fonts/v/inter/5.2.8/latin-ext/wght/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:100 900;src:url(/cf-fonts/v/inter/5.2.8/vietnamese/wght/normal.woff2);unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:100 900;src:url(/cf-fonts/v/inter/5.2.8/cyrillic-ext/wght/normal.woff2);unicode-range:U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:100 900;src:url(/cf-fonts/v/inter/5.2.8/latin/wght/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:100 900;src:url(/cf-fonts/v/inter/5.2.8/cyrillic/wght/normal.woff2);unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:100 900;src:url(/cf-fonts/v/inter/5.2.8/greek/wght/normal.woff2);unicode-range:U+0370-0377,U+037A-037F,U+0384-038A,U+038C,U+038E-03A1,U+03A3-03FF;font-display:swap;}@font-face {font-family:'Inter';font-style:normal;font-weight:100 900;src:url(/cf-fonts/v/inter/5.2.8/greek-ext/wght/normal.woff2);unicode-range:U+1F00-1FFF;font-display:swap;}</style><noscript><style>.eg-share-chip{display:none!important}</style></noscript>
<style id="egsb-css">.egsb-wrap{font-family:inherit;max-width:100%;position:relative;isolation:isolate;margin:0}.egsb-wrap,.egsb-wrap *{box-sizing:border-box}.egsb-wrap .screen-reader-text{border:0;clip:rect(1px,1px,1px,1px);clip-path:inset(50%);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;word-wrap:normal!important}.egsb-followers-row{display:grid;grid-template-columns:minmax(0,1fr);gap:3px;align-items:stretch;width:100%;max-width:100%}.egsb-followers{container-type:inline-size}.egsb-followers-row--2,.egsb-followers-row--4{grid-template-columns:repeat(2,minmax(0,1fr))}.egsb-followers-row--3{grid-template-columns:repeat(3,minmax(0,1fr))}@container (max-width:440px){.egsb-followers-row--3 a.egsb-followers-item{flex-direction:column;justify-content:center;gap:6px;padding:10px 6px}.egsb-followers-row--3 .egsb-followers-item__count{font-size:15px;text-align:center}}a.egsb-followers-item{display:flex;align-items:center;justify-content:space-between;gap:12px;min-width:0;max-width:100%;width:100%;padding:11px 18px;border:1px solid #ececec;border-radius:0;background:#f3f3f3;text-decoration:none!important;color:#9b9b9b!important;line-height:1.1;min-height:52px;cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease;box-shadow:none}a.egsb-followers-item:hover,a.egsb-followers-item:focus,a.egsb-followers-item:active{background:#f5f5f5;border-color:#e6e6e6;color:#969696!important;text-decoration:none!important;outline:none;box-shadow:none}.egsb-followers-item__left{display:inline-flex;align-items:center;gap:0;min-width:0;flex:0 0 auto}.egsb-followers-item__icon{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;color:#9e9e9e;flex:0 0 auto}.egsb-network-facebook .egsb-followers-item__icon svg{display:block;width:25px;height:25px}.egsb-network-x .egsb-followers-item__icon svg{display:block;width:23px;height:23px}.egsb-network-pinterest .egsb-followers-item__icon svg{display:block;width:24px;height:24px}.egsb-followers-item__label{font-size:13px;font-weight:600;color:#7f7f7f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-left:10px}.egsb-followers-item__count{font-size:18px;font-weight:700;line-height:1;color:#989898;letter-spacing:0;white-space:nowrap;text-align:right;flex:0 0 auto}.egsb-share-buttons{--egsb-share-bg:#f4f4f4;--egsb-share-hover-bg:#fff;--egsb-share-border:#dcdcdc;--egsb-share-text:#333;--egsb-share-gap:10px;--egsb-share-radius:0px;--egsb-share-border-width:1px;--egsb-share-pad-y:10px;--egsb-share-pad-x:14px;--egsb-share-font-size:14px;--egsb-share-icon-size:22px;--egsb-share-min-width:110px}.egsb-share-buttons{container-type:inline-size}.egsb-share-list{display:flex;flex-wrap:wrap;gap:var(--egsb-share-gap);align-items:stretch;width:100%;max-width:100%}@container (max-width:780px){.egsb-share-buttons:not(.egsb-share-buttons--mobile-full) .egsb-share-list{gap:min(var(--egsb-share-gap),8px)}.egsb-share-buttons:not(.egsb-share-buttons--mobile-full) a.egsb-share-button{min-width:0;padding-left:min(var(--egsb-share-pad-x),12px);padding-right:min(var(--egsb-share-pad-x),12px)}}.egsb-share-buttons--align-left .egsb-share-list{justify-content:flex-start}.egsb-share-buttons--align-center .egsb-share-list{justify-content:center}.egsb-share-buttons--align-right .egsb-share-list{justify-content:flex-end}.egsb-share-buttons--align-stretch .egsb-share-list{justify-content:stretch}.egsb-share-buttons--align-stretch .egsb-share-button{flex:1 1 0;justify-content:center}a.egsb-share-button{display:inline-flex;align-items:center;justify-content:center;gap:.5em;min-width:var(--egsb-share-min-width);max-width:100%;min-height:40px;padding:var(--egsb-share-pad-y) var(--egsb-share-pad-x);border:var(--egsb-share-border-width) solid var(--egsb-share-border);border-radius:var(--egsb-share-radius);background:var(--egsb-share-bg);color:var(--egsb-share-text)!important;text-decoration:none!important;line-height:1;box-shadow:none;cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease,opacity .15s ease}a.egsb-share-button:hover,a.egsb-share-button:focus,a.egsb-share-button:active{background:var(--egsb-share-hover-bg);text-decoration:none!important;outline:none;box-shadow:none}.egsb-share-buttons--network-colors.egsb-share-buttons--style-outline a.egsb-share-button,.egsb-share-buttons--network-colors.egsb-share-buttons--style-minimal a.egsb-share-button{color:var(--egsb-network-color)!important}.egsb-share-buttons--style-solid a.egsb-share-button{background:var(--egsb-network-color);border-color:var(--egsb-network-color);color:#fff!important}.egsb-share-buttons--style-solid a.egsb-share-button:hover,.egsb-share-buttons--style-solid a.egsb-share-button:focus{opacity:.88;background:var(--egsb-network-color);color:#fff!important}.egsb-share-buttons--style-minimal a.egsb-share-button{background:transparent;border-color:transparent}.egsb-share-buttons--uppercase .egsb-share-button__label{text-transform:uppercase;letter-spacing:.01em}.egsb-share-button__icon{display:inline-flex;align-items:center;justify-content:center;width:var(--egsb-share-icon-size);height:var(--egsb-share-icon-size);flex:0 0 auto;color:currentColor}.egsb-share-button__icon svg{display:block;width:100%;height:100%}.egsb-share-button__label{font-size:var(--egsb-share-font-size);font-weight:600;white-space:nowrap;color:currentColor}.egsb-share-buttons--icons-only a.egsb-share-button{min-width:0}.egsb-share-buttons--icons-only .egsb-share-button__icon{margin:0}.egsb-share-buttons--size-small{--egsb-share-pad-y:7px;--egsb-share-pad-x:10px;--egsb-share-font-size:12px;--egsb-share-icon-size:18px;--egsb-share-min-width:92px}.egsb-share-buttons--size-large{--egsb-share-pad-y:13px;--egsb-share-pad-x:18px;--egsb-share-font-size:16px;--egsb-share-icon-size:26px;--egsb-share-min-width:132px}@media (max-width:600px){.egsb-share-buttons--mobile-full .egsb-share-button{flex:1 1 100%;width:100%;justify-content:center}.egsb-share-buttons--align-right .egsb-share-list{justify-content:flex-start}.egsb-share-buttons--mobile-icons a.egsb-share-button{flex:1 1 0;min-width:0;padding-left:var(--egsb-share-pad-y);padding-right:var(--egsb-share-pad-y)}.egsb-share-buttons--mobile-icons .egsb-share-button__label{border:0;clip:rect(1px,1px,1px,1px);clip-path:inset(50%);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px}}@media (max-width:359px){.egsb-followers-row--2{grid-template-columns:minmax(0,1fr)}.egsb-share-button{flex:1 1 100%;width:100%}}</style>
