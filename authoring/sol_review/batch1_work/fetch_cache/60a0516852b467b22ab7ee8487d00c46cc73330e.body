<li><span class="ilh-all" data-orig-title="朝鮮舊曆" data-lang-code="en" data-lang-name="英语" data-foreign-title="Korean calendar"><span class="ilh-page"><a href="/w/index.php?title=%E6%9C%9D%E9%AE%AE%E8%88%8A%E6%9B%86&amp;action=edit&amp;redlink=1" class="new" title="朝鮮舊曆（頁面不存在）">朝鮮舊曆</a></span><span class="noprint ilh-comment"><span class="ilh-paren">（</span><span class="ilh-lang">英語</span><span class="ilh-colon">：</span><span class="ilh-link"><a href="https://en.wikipedia.org/wiki/Korean_calendar" class="extiw" title="en:Korean calendar"><span lang="en" dir="auto">Korean calendar</span></a></span><span class="ilh-paren">）</span></span></span></li>
