ges=1-9&amp;rft.date=2006&amp;rft.aulast=Rambaldi&amp;rft.aufirst=G.&amp;rft.au=Kwaku+Kyem%2C+A.+P.&amp;rft.au=Mbile%2C+P.&amp;rft.au=McCall%2C+M.&amp;rft.au=Weiner%2C+D.&amp;rft_id=http%3A%2F%2Fwww.ejisdc.org%2Fojs%2Finclude%2Fgetdoc.php%3Fid%3D246%26article%3D263%26mode%3Dpdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AParticipatory+GIS" class="Z3988" about="#mwt60"></span><link rel="mw:PageProp/Category" href="./Category:CS1:_unfit_URL" about="#mwt60" id="mwAb4"/></li>
