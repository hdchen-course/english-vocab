-static.grammarly.com\u002Fblog\u002Fwp-content\u002Fuploads\u002F2023\u002F09\u002FParts_of_Speech_-By-235x124.png\",\"width\":235,\"height\":124},\"medium\":{\"url\":\"https:\u002F\u002Fcontenthub-static.grammarly.com\u002Fblog\u002Fwp-content\u002Fuploads\u002F2023\u002F09\u002FParts_of_Speech_-By-437x230.png\",\"width\":437,\"height\":230},\"medium_large\":{\"url\":\"https:\u002F\u002Fcontenthub-static.grammarly.com\u002Fblog\u002Fwp-content\u002Fuploads\u002F2023\u002F09\u002FParts_of_Speech_-By-768x404.png\",\"width\":768,\"height\":404},\"large\":{\"url\":\"https:\u002F\u002Fcontenthub-static.grammarly.com\u002Fblog\u002Fwp-content\u002Fuploads\u002F2023\u002F09\u002FParts_of_Speech_-By-760x400.png\",\"width\":760,\"height\":400},\"full\":{\"url\":\"https:\u002F\u002Fcontenthub-static.grammarly.com\u002Fblog\u002Fwp-content\u002Fuploads\u002F2023\u002F09\u002FParts_of_Speech_-By.png\",\"width\":1520,\"height\":800}},\"link\":\"https:\u002F\u002Fwww.grammarly.com\u002Fblog\u002Fparts-of-speech\u002Fby-part-of-speech\u002F\"}"],"posts":[],"post":"{\"id\":29893,\"author\":{\"id\":1001147,\"name\":\"Matt Ellis\",\"slug\":\"mattellis\",\"link\":\"https:\u002F\u002Fwww.grammarly.com\u002Fblog\u002Fauthor\u002Fmattellis\u002F\",\"avatar\":\"https:\u002F\u002Fsecure.gravatar.com\u002Favatar\u002Fe4bbec0e59fd23e2b7f324030367afb7?s=96&d=wp_user_avatar&r=g\"},\"categories\":[{\"id\":2956,\"link\":\"https:\u002F\u002Fwww.grammarly.com\u002Fblog\u002Fparts-of-speech\u002F\",\"name\":\"Parts of Speech\",\"slug\":\"parts-of-speech\",\"taxonomy\":\"category\",\"_links\":{\"self\":[{\"href\":\"https:\u002F\u002Fcontenthub-private.grammarly.com\u002Fblog\u002Fwp-json\u002Fwp\u002Fv2\u002Fcategories\u002F2956\"}],\"collection\":[{\"href\":\"https:\u002F\u002Fcontenthub-private.grammarly.com\u002Fblog\u002Fwp-json\u002Fwp\u002Fv2\u002Fcategories\"}],\"about\":[{\"href\":\"https:\u002F\u002Fcontenthub-private.grammarly.com\u002Fblog\u002Fwp-json\u002Fwp\u002Fv2\u002Ftaxonomies\u0