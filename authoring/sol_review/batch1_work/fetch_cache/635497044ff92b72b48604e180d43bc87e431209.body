        <script>window.__INITIAL_STATE__ = {"meta":{"title":"Plural Nouns: Rules and Examples | Grammarly","unmanagedHead":"\n&lt;!-- This site is optimized with the Yoast SEO plugin v12.0 - https:&#x2F;&#x2F;yoast.com&#x2F;wordpress&#x2F;plugins&#x2F;seo&#x2F; --&gt;\n&lt;meta name=&quot;description&quot; content=&quot;Learn what plural nouns are with these helpful rules and examples. Explore the difference between plural nouns and singular nouns and mistakes to avoid.&quot;&#x2F;&gt;\n&lt;link rel=&quot;canonical&quot; href=&quot;https:&#x2F;&#x2F;www.grammarly.com&#x2F;blog&#x2F;parts-of-speech&#x2F;plural-nouns&#x2F;&quot; &#x2F;&gt;\n&lt;!-- &#x2F; Yoast SEO plugin. --&gt;\n\n&lt;&#x2F;script&gt;\n&lt;&#x2F;script&gt;\n\t\t&lt;meta property=&quot;fb:pages&quot; content=&quot;139729956046003&quot; &#x2F;&gt;\n\t\t\n&lt;!-- Schema &amp; Structured Data For WP v1.9.85 - --&gt;\n&lt;script type=&quot;application&#x2F;ld+json&quot; class=&quot;saswp-schema-markup-output&quot;&gt;\n[{&quot;@context&quot;:&quot;https:\\&#x2F;\\&#x2F;schema.org&quot;,&quot;@type&quot;:&quot;FAQPage&quot;,&quot;@id&quot;:&quot;https:\\&#x2F;\\&#x2F;www.grammarly.com\\&#x2F;blog\\&#x2F;parts-of-speech\\&#x2F;plural-nouns\\&#x2F;#FAQPage&quot;,&quot;headline&quot;:&quot;Plural Nouns: Rules and Examples&quot;,&quot;keywords&quot;:&quot;Awareness, FAQ, Grammarly Free, Make Progress,&quot;,&quot;datePublished&quot;:&quot;2022-10-19T00:00:00Z&quot;,&quot;dateModified&quot;:&quot;2022-10-18T00:00:00Z&quot;,&quot;dateCreated&quot;:&quot;2022-10-19T00:00:00Z&quot;,&quot;author&quot;:{&quot;@type&quot;:&quot;Person&quot;,&quot;name&quot;:&quot;Marika Wegerbauer&quot;},&quot;mainEntity&quot;:[{&quot;@type&quot;:&quot;Question&quot;,&quot;name&quot;:&quot;What is a plural noun?&quot;,&quot;acceptedAnswer&quot;:{&quot;@type&quot;:&quot;Answer&quot;,&quot;text&quot;:&quot;A plural noun is the form of a noun used to show there is more than one person, place, thing, or idea. Most nouns simply add -s or -es to the end to become plural.\\u00a0&quot;}},{&quot;@type&quot;:&quot;Question&quot;,&quot;name&quot;:&quot;What is an example of a plural noun?&quot;,&quot;acceptedAnswer&quot;:{&quot;@type&quot;:&quot;Answer&quot;,&quot;text&quot;:&quot;Kids is the plural noun form of kid. Some nouns have an irregular plural form; for instance, the plural noun of child is children, not childs.&quot;}},{&quot;@type&quot;:&quot;Question&quot;,&quot;name&quot;:&quot;What is the difference between singular and plural nouns?&quot;,&quot;acceptedAnswer&quot;:{&quot;@type&quot;:&quot;Answer&quot;,&quot;text&quot;:&quot;Singular nouns represent only one thing, but plural nouns represent more than one. If someone stands alone, we call them a person (singular), but if there\\u2019s more than one person, we call them people (plural).&quot;}}],&quot;image&quot;:[{&quot;@type&quot;:&quot;ImageObject&quot;,&quot;@id&quot;:&quot;https:\\&#x2F;\\&#x2F;www.grammarly.com\\&#x2F;blog\\&#x2F;parts-of-speech\\&#x2F;plural-nouns\\&#x2F;#primaryimage&quot;,&quot;url&quot;:&quot;https:\\&#x2F;\\&#x2F;contenthub-static.grammarly.com\\&#x2F;blog\\&#x2F;wp-content\\&#x2F;uploads\\&#x2F;2022\\&#x2F;10\\&#x2F;Plural-nouns.png&quot;,&quot;width&quot;:&quot;1520&quot;,&quot;height&quot;:&quot;800&quot;},{&quot;@type&quot;:&quot;ImageObject&quot;,&quot;url&quot;:&quot;https:\\&#x2F;\\&#x2F;contenthub-static.grammarly.com\\&#x2F;blog\\&#x2F;wp-content\\&#x2F;uploads\\&#x2F;2022\\&#x2F;10\\&#x2F;Plural-nouns.png&quot;,&quot;width&quot;:&quot;1200&quot;,&quot;height&quot;:&quot;900&quot;},{&quot;@type&quot;:&quot;ImageObject&quot;,&quot;url&quot;:&quot;https:\\&#x2F;\\&#x2F;contenthub-static.grammarly.com\\&#x2F;blog\\&#x2F;wp-content\\&#x2F;uploads\\&#x2F;2022\\&#x2F;10\\&#x2F;Plural-nouns.png&quot;,&quot;width&quot;:&quot;1200&quot;,&quot;height&quot;:&quot;675&quot;},{&quot;@type&quot;:&quot;ImageObject&quot;,&quot;url&quot;:&quot;https:\\&#x2F;\\&#x2F;contenthub-static.grammarly.com\\&#x2F;blog\\&#x2F;wp-co