<style nonce="D8Xv7r8RgMNB9CHX4woesJG2">
    tr td:first-child {
        width: 0;
    }

    /* 以下原本都是 inline style（CSP 不允許） */

    /* 會被 JS 顯示／隱藏的（小鍵盤、切換鍵盤的按鈕）：不加 !important，否則 jQuery .show()／.hide() 用 CSSOM 設的值贏不過，
       改用重複 class 提高權重。#btnOpenBopomo 顯示前會先拿掉這個 class，見 OpenPinyin() */
    .keyboard-hidden.keyboard-hidden {
        display: none;
    }

    /* 原本的 width: 450px 沒帶 !important，會輸給 pdx.css 的 .keyboardmain{width:100% !important} 等規則；
       這裡也不加，只重複 class 贏過 style.css 的 .keyboardmain{width:98%}（Home/EmbedSearch 沒載 pdx.css） */
    .keyboard-w450.keyboard-w450 {
        width: 450px;
    }

    .keyboard-max-w100 {
        max-width: 100% !important;
    }

    .keyboard-w100 {
        width: 100% !important;
    }

    .keyboard-w40 {
        width: 40px !important;
    }

    /* UpdatePhonetic() 用 HTML 字串產生的注音預覽表格也用這個 */
    .keyboard-fs-large {
        font-size: large !important;
    }
</style>

