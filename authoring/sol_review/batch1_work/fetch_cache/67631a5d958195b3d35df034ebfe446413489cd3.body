<script type="text/javascript" nonce="D8Xv7r8RgMNB9CHX4woesJG2">

    $(function () {

        const copyUrl = $("#shareEntryUrl").val();
        const $copyResult = $(".js-share-copy-result");

        function showCopyResult(message) {
            $copyResult.text(message);
        }

        // 沒有 Clipboard API（http 的非 localhost、很舊的瀏覽器）就退回選取文字再 execCommand
        function copyFallback() {
            const input = document.getElementById("shareEntryUrl");
            input.focus();
            input.select();
            input.setSelectionRange(0, 99999);

            try {
                return document.execCommand("copy");
            } catch (e) {
                return false;
            }
        }

        $(".js-share-copy").on("click", function () {
            eduBehavior.log("B081");

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(copyUrl).then(function () {
                    showCopyResult("已複製連結");
                }, function () {
                    showCopyResult(copyFallback() ? "已複製連結" : "無法自動複製，請自行選取上面的連結");
                });
            } else {
                showCopyResult(copyFallback() ? "已複製連結" : "無法自動複製，請自行選取上面的連結");
            }
        });

        $("#shareEntryUrl").on("focus", function () {
            this.select();
        });

        // 上一次的「已複製連結」不要留到下一次打開
        $("#shareEntryModal").on("hidden.bs.modal", function () {
            showCopyResult("");
        });
    });

</script>



