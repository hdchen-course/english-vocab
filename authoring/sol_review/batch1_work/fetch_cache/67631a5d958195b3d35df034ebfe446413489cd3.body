                                <input value="ü" type="button" class="keyboarditem1" realvalue="ㄩ" />
                                <input value="üan" type="button" class="keyboarditem1" realvalue="ㄩㄢ" />
                                <input value="üe" type="button" class="keyboarditem1" realvalue="ㄩㄝ" />
