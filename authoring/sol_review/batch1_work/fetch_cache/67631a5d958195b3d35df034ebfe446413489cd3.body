<div id="assistantModal" class="frame-assistant" data-frameAssistant role="dialog" aria-modal="true" aria-label="貓頭鷹博士對話窗">
    <div class="assistant-container">
        <div class="fn-bar">
            <div class="left"></div>
            <div class="right">
                <button type="button" class="btn-close" data-closeAssistant aria-label="關閉「貓頭鷹博士」對話窗">
                    <i class="icon icon-12" aria-hidden="true"></i>
