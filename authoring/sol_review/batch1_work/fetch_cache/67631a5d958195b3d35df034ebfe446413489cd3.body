<style nonce="D8Xv7r8RgMNB9CHX4woesJG2">
    /* 以下原本都是 inline style（CSP 不允許） */

    /* 原本的 background: white 沒帶 !important，手機版會輸給 pdx.css 的
       .search-input-rounded-corners-small{background-color:rgba(0,0,0,0) !important}；這裡也不加，只重複 class 贏過一般規則 */
    .search-input-small-bg-white.search-input-small-bg-white.search-input-small-bg-white {
        background: white;
    }

    /* 輸入框：原本只有 font-family 帶 !important（要贏過 pdx.css 的 .search-input-rounded-corners-small input{font-family:… !important}）。
       其餘沒帶的照舊輸給 pdx.css 手機版那幾條 !important（width、margin、padding、font-size），只靠重複 class 贏過一般規則 */
    .search-input-small-input.search-input-small-input.search-input-small-input {
        font-family: 'Times New Roman', '微軟正黑體', '正黑體' !important;
        font-size: medium;
        width: 80%;
        border: 0px solid #aaa;
        border-radius: 4px;
        outline: none;
        margin: 3px;
        padding: 4px;
        box-sizing: border-box;
        transition: 0.3s;
    }

    /* 三顆圖示原本是 right: Npx !important（inline 的 !important 贏過所有樣式表），
       要贏過 pdx.css 的 .search-input-rounded-corners-small a+a+a{right:80px !important} 等規則，所以帶 id 並重複 class */
    #linkOpenSearchSpeech.search-input-small-right-80.search-input-small-right-80.search-input-small-right-80 {
        right: 80px !important;
    }

    #linkOpenSearchImage.search-input-small-right-40.search-input-small-right-40.search-input-small-right-40 {
        right: 40px !important;
    }

    #keyboard-pop-a.search-input-small-right-0.search-input-small-right-0.search-input-small-right-0 {
        right: 0 !important;
    }

    .search-input-small-btn-purple {
        background-color: #6233C4 !important;
        border-color: #501EB7 !important;
    }
</style>

