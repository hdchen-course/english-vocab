<script type="text/javascript" nonce="D8Xv7r8RgMNB9CHX4woesJG2">

    function AnalysisTab(label) {
        ga('send', {
            hitType: 'event',
            eventCategory: 'WordSource',
            eventAction: 'Click',
            eventLabel: label
        });
    }

    $(function () {

        // 原本是 li 上的 onclick。li 的 class 會被下方 .prop("class", ...) 整個換掉，所以用 data 屬性選
        $('#tab_menu li[data-analysis-tab]').on('click', function () {
            AnalysisTab(this.getAttribute('data-analysis-tab'));
        });

        // 原本是 img 上的 onmouseover／onmouseout
        $('.js-wiki-play-img').on('mouseover', function () {
            this.src = '/Content/img/play_hover.png';
        }).on('mouseout', function () {
            this.src = '/Content/img/play.png';
        });




        /************************
        *  先自動點選第一個 Tab */
        /***********************/

        $("ul#tab_menu li").first().prop("class", "bgGrey rounded-corners-top-5 mr5 active");
        $("div.tab-content div").first().prop("class", "tab-pane fade in active");

        /*****************
        * Tab 相關設定   */
        /****************/

        $('#tab_menu a').click(function (e) {
            e.preventDefault();
            $(this).tab('show');
            eduBehavior.log("B017", { content: $(this).text() });
        });

        //手機的選單
        $('#tab_menu_mobile a').click(function (e) {
            var $this = $(this);
            $this.parent().parent().find("li").removeClass("active");
            e.preventDefault();
            $this.tab('show');
        });
    });

</script>

