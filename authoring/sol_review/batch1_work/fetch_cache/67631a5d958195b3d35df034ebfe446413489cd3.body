<script type="text/javascript" nonce="D8Xv7r8RgMNB9CHX4woesJG2">

    (function () {
        var storageKey = "eduSurveyDismissed";
        var hideDays = 30;
        var showAfterMs = 5000;

        // localStorage 在無痕視窗或被封鎖時會丟例外，讀不到就當成沒關過
        function getDismissedAt() {
            try {
                return parseInt(localStorage.getItem(storageKey), 10) || 0;
            } catch (e) {
                return 0;
            }
        }

        function markDismissed() {
            try {
                localStorage.setItem(storageKey, String(Date.now()));
            } catch (e) {
                // 存不進去就下次再問
            }
        }

        if (Date.now() - getDismissedAt() < hideDays * 24 * 60 * 60 * 1000) {
            return;
        }

        var $modal = $("#surveyEntryModal");

        function show() {
            // 分享詞條這類彈窗開著的時候不要疊上去，等一下再試（詞條頁的 Bootstrap 是 4，開著的彈窗是 .show 不是 3 的 .in）
            if ($(".modal.show").length) {
                setTimeout(show, 5000);
                return;
            }

            $modal.modal("show");
        }

        $modal.on("hidden.bs.modal", markDismissed);
        $modal.find(".survey-entry-links a").on("click", markDismissed);

        setTimeout(show, showAfterMs);
    })();

</script>

<script type="text/javascript" nonce="D8Xv7r8RgMNB9CHX4woesJG2">

    // PartialDetialForWordFuncs 的「友善列印」也會讀它，要宣告在 $(function () {}) 外面才看得到。
    // 原本宣告在裡面，列印對話框關掉之後那支 handler 讀到就 ReferenceError，後面的還原顯示與
    // return false 都不會執行——被藏起來的按鈕不會回來，網址還會多一個 #
    var share_relate_confirm = 0;

    $(function () {

        $('.zoom-help').on('click',
            function () {
                $('.entry-body').toggleClass('zoom');
                return false
            });

        if ($("#share_collect").hasClass("primary")) {
            $("#share_collect i").removeClass("icon-2").addClass("icon-1");
            $("#share_collect span").text("取消收藏");
        }

        //關閉收藏部分
        $("#share_collect").click(function() {
                
                    handleUnLogin();
                    return false;
                

            var $this = $(this);

            if ($this.hasClass("primary")) {
                $.ajax({
                    url: "/api/BookmarkApi",
                    data: "=74527",
                    type: "DELETE",
                    dataType: 'text',
                    success: function(msg) {
                        if ("4001" === msg) {
                            $("#share_collect i").removeClass("icon-1").addClass("icon-2");
                            $("#share_collect span").text("列入收藏");
                            $this.removeClass("primary").addClass("default");
                            eduBehavior.log("B018");
                        } else if ("1103" === msg) {
                            handleUnLogin();
                            //alert("請先登入!");
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {

                    }
                });
                //開啟收藏部分
            } else {
                $.ajax({
                    url: "/api/BookmarkApi",
                    data: "=74527",
                    type: "POST",
                    dataType: 'text',
                    success: function(msg) {
                        if ("3001" === msg) {
                            $("#share_collect i").removeClass("icon-2").addClass("icon-1");
                            $("#share_collect span").text("取消收藏");
                            $this.removeClass("default").addClass("primary");
                            alert("『已加入收藏』『可以在右上角「會員個人頁」檢視收藏的詞條』");

                            eduBehavior.log("B019");
                        } else if ("1103" === msg) {
                            handleUnLogin();
                            //alert("請先登入!");
                        }
                    },
                    error: function(xhr, ajaxOptions, thrownError) {

                    }
                });
            }

            return false;
        });

        /*********************
        *    顯示關聯詞條    */
        /********************/

        //顯示關聯詞條
        $("#share_relate").click(function() {
            share_relate_confirm = 1;

            $._mask.mask("顯示關聯詞條中...");

            setTimeout(function() {
                    $("span.withoutRefLink").hide();
                    $("span.withRefLink").show();
                    $("#share_relate").hide();
                    $("#share_relate_on").show();
                    $._mask.unmask();
                },
                1000);

            return false;
        });

        //關閉關聯詞條
        $("#share_relate_on").click(function() {
            $("span.withoutRefLink").show();
            $("span.withRefLink").hide();
            $("#share_relate").show();
            $("#share_relate_on").hide();

            return false;
        });


        // 從分享連結連進來的記一筆「分享連入」（B083，內容是 utm_source），只認 ShareLinkUtil 列的來源；
        // 記完把 utm 參數從網址列拿掉：重新整理、加書籤不會重複計，使用者再從網址列複製出去的也是乾淨網址。
        // 用 JS 記而不是伺服器端記：分享到 Facebook、LINE 時平台的爬蟲會先抓網址做預覽卡片，伺服器端會把每一次分享都多算一次連入
        (function () {
            var knownSources = ["copy","qrcode"];
            var params = new URLSearchParams(window.location.search);
            var source = (params.get("utm_source") || "").toLowerCase();

            if (params.get("utm_medium") !== "share" || knownSources.indexOf(source) < 0) {
                return;
            }

            eduBehavior.log("B083", { content: source });

            if (!window.history || !history.replaceState) {
                return;
            }

            Array.from(params.keys()).forEach(function (key) {
                if (key.toLowerCase().indexOf("utm_") === 0 || key.toLowerCase() === "fbclid") {
                    params.delete(key);
                }
            });

            var query = params.toString();

            history.replaceState(null, "", window.location.pathname + (query ? "?" + query : "") + window.location.hash);
        })();

        $("#share_entry").click(function () {
            $("#shareEntryModal").modal("show");

            return false;
        });


            
        
        eduBeacon.send("/api/WordTitleReviewCountApi?token=" + encodeURIComponent("f5a986c9917342c08a80722be036eabd"));
            
        $("#btn_teach").on("click", function () {

             $("body").addClass("teaching-mode");
             return false;
         });
         $("#btn_teach_close").on("click", function () {

             $("body").removeClass("teaching-mode");
             return false;
         });
        $(".zoom-text-large").on("click", function () {
            $(this).addClass("--active").siblings().removeClass("--active");
            $(".entry-body").removeClass("text-middle").addClass("text-large");
            return false;
        });

        $(".zoom-text-normal").on("click", function () {
            $(this).addClass("--active").siblings().removeClass("--active");
            $(".entry-body").removeClass("text-middle text-large");
            return false;
        });

        $(".zoom-text-middle").on("click", function () {
            $(this).addClass("--active").siblings().removeClass("--active");
            $(".entry-body").removeClass("text-large").addClass("text-middle");
            return false;
        });

    });

</script>

