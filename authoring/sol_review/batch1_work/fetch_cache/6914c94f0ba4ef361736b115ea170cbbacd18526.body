						<div id="contentSub" lang="zh-Hant" dir="ltr"><div id="mw-content-subtitle" lang="zh-Hant" dir="ltr"><div class="subpages">&lt; <bdi dir="ltr"><a href="/wiki/%E9%9F%93%E9%9D%9E%E5%AD%90" title="韓非子">韓非子</a></bdi></div></div></div>
						
