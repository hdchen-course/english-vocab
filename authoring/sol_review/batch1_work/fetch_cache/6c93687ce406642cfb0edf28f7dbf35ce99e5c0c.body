<li about="#cite_note-15" id="cite_note-15" data-mw-footnote-number="15"><span class="mw-cite-backlink" id="mwBAA"><a href="#cite_ref-15" rel="mw:referencedBy" id="mwBAE"><span class="mw-linkback-text" id="mwBAI">↑</span></a></span> <span id="mw-reference-text-cite_note-15" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt68" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBAM" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal ","href":"./Template:Cite_journal"},"params":{"first":{"wt":"Franz"},"last":{"wt":"Wirl"},"date":{"wt":"July 1998"},"title":{"wt":"Socio-economic typologies of bureaucratic corruption and implications"},"journal":{"wt":"Journal of Evolutionary Economics"},"volume":{"wt":"8"},"issue":{"wt":"2"},"pages":{"wt":"199–220"},"publisher":{"wt":"Springer-Verlag"},"doi":{"wt":"10.1007/s001910050062"},"s2cid":{"wt":"154833892"}},"i":0}}]}'/><cite id="CITEREFWirl1998" class="citation journal cs1" about="#mwt68">Wirl, Franz (July 1998). "Socio-economic typologies of bureaucratic corruption and implications". <i id="mwBAQ">Journal of Evolutionary Economics</i>. <b id="mwBAU">8</b> (2). Springer-Verlag: <span class="nowrap" id="mwBAY">199–</span>220. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwBAc">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1007%2Fs001910050062" class="external text" id="mwBAg">10.1007/s001910050062</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwBAk">S2CID</a><span typeof="mw:Entity" id="mwBAo"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:154833892" class="external text" id="mwBAs">154833892</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Journal+of+Evolutionary+Economics&amp;rft.atitle=Socio-economic+typologies+of+bureaucratic+corruption+and+implications&amp;rft.volume=8&amp;rft.issue=2&amp;rft.pages=199-220&amp;rft.date=1998-07&amp;rft_id=info%3Adoi%2F10.1007%2Fs001910050062&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A154833892%23id-name%3DS2CID&amp;rft.aulast=Wirl&amp;rft.aufirst=Franz&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt68" id="mwBAw"></span></span></li>
<li about="#cite_note-16" id="cite_note-16" data-mw-footnote-number="16"><span class="mw-cite-backlink" id="mwBA0"><a href="#cite_ref-16" rel="mw:referencedBy" id="mwBA4"><span class="mw-linkback-text" id="mwBA8">↑</span></a></span> <span id="mw-reference-text-cite_note-16" class="mw-reference-text reference-text">
<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt71" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBBA" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last1":{"wt":"BARNETT"},"first1":{"wt":"Michael"},"title":{"wt":"Rules for the World: International Organizations in Global Politics"},"last2":{"wt":"FINNEMORE"},"first2":{"wt":"Marftha"},"date":{"wt":"2004"},"publisher":{"wt":"Cornell University Press"},"isbn":{"wt":"978-0-8014-4090-8"},"pages":{"wt":"17–18"},"jstor":{"wt":"10.7591/j.ctt7z7mx"}},"i":0}}]}'/><cite id="CITEREFBARNETTFINNEMORE2004" class="citation book cs1" about="#mwt71">BARNETT, Michael; FINNEMORE, Marftha (2004). <i id="mwBBE">Rules for the World: International Organizations in Global Politics</i>. Cornell University Press. pp.<span typeof="mw:Entity" id="mwBBI"> </span><span class="nowrap" id="mwBBM">17–</span>18. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBBQ">ISBN</a><span typeof="mw:Entity" id="mwBBU"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-8014-4090-8" title="Special:BookSources/978-0-8014-4090-8" id="mwBBY"><bdi id="mwBBc">978-0-8014-4090-8</bdi></a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/JSTOR_(identifier)" title="JSTOR (identifier)" class="mw-redirect" id="mwBBg">JSTOR</a><span typeof="mw:Entity" id="mwBBk"> </span><a rel="mw:ExtLink nofollow" href="https://www.jstor.org/stable/10.7591/j.ctt7z7mx" class="external text" id="mwBBo">10.7591/j.ctt7z7mx</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Rules+for+the+World%3A+International+Organizations+in+Global+Politics&amp;rft.pages=17-18&amp;rft.pub=Cornell+University+Press&amp;rft.date=2004&amp;rft_id=https%3A%2F%2Fwww.jstor.org%2Fstable%2F10.7591%2Fj.ctt7z7mx%23id-name%3DJSTOR&amp;rft.isbn=978-0-8014-4090-8&amp;rft.aulast=BARNETT&amp;rft.aufirst=Michael&amp;rft.au=FINNEMORE%2C+Marftha&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt71" id="mwBBs"></span>
</span></li>
<li about="#cite_note-Scribes-17" id="cite_note-Scribes-17" data-mw-footnote-number="17"><span class="mw-cite-backlink" id="mwBBw"><a href="#cite_ref-Scribes_17-0" rel="mw:referencedBy" id="mwBB0"><span class="mw-linkback-text" id="mwBB4">↑</span></a></span> <span id="mw-reference-text-cite_note-Scribes-17" class="mw-reference-text reference-text">Compare: <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt75" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBB8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book","href":"./Template:Cite_book"},"params":{"title":{"wt":"Civilizations of the Ancient Near East"},"editor":{"wt":"Jack M. Sasson"},"year":{"wt":"1995"},"publisher":{"wt":"Macmillan Library Reference"},"chapter":{"wt":"The Scribes and Scholars of Ancient Mesopotamia"},"author":{"wt":"Laurie E. Pearce"},"pages":{"wt":"2265–2278"},"chapter-url":{"wt":"https://www.academia.edu/562267"},"access-date":{"wt":"12 March 2014"},"quote":{"wt":"Palace scribes recorded the activities of kings and the affairs of kingdoms in ancient Mesopotamia. Scribes served a variety of administrative functions, including arrangement and storage of texts [...], collection of taxes and supervision of workers, and supervision of public buildings such as granaries. [...] Scribes associated with the temple were not officiants in the temple cult. They functioned largely in administrative and bureaucratic roles. They received incoming staples for the temple, including commodities such as grain, fish, wool, and silver. They traveled to various cities to fulfill official duties, such as the purchase of grain for the temple complex."}},"i":0}}]}'/><cite id="CITEREFLaurie_E._Pearce1995" class="citation book cs1" about="#mwt75">Laurie E. Pearce (1995). <a rel="mw:ExtLink nofollow" href="https://www.academia.edu/562267" class="external text" id="mwBCA">"The Scribes and Scholars of Ancient Mesopotamia"</a>. In Jack M. Sasson (ed.). <i id="mwBCE">Civilizations of the Ancient Near East</i>. Macmillan Library Reference. pp.<span typeof="mw:Entity" id="mwBCI"> </span><span class="nowrap" id="mwBCM">2265–</span>2278<span class="reference-accessdate" id="mwBCQ">. Retrieved <span class="nowrap" id="mwBCU">12 March</span> 2014</span>. <q id="mwBCY">Palace scribes recorded the activities of kings and the affairs of kingdoms in ancient Mesopotamia. Scribes served a variety of administrative functions, including arrangement and storage of texts [...], collection of taxes and supervision of workers, and supervision of public buildings such as granaries. [...] Scribes associated with the temple were not officiants in the temple cult. They functioned largely in administrative and bureaucratic roles. They received incoming staples for the temple, including commodities such as grain, fish, wool, and silver. They traveled to various cities to fulfill official duties, such as the purchase of grain for the temple complex.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=The+Scribes+and+Scholars+of+Ancient+Mesopotamia&amp;rft.btitle=Civilizations+of+the+Ancient+Near+East&amp;rft.pages=2265-2278&amp;rft.pub=Macmillan+Library+Reference&amp;rft.date=1995&amp;rft.au=Laurie+E.+Pearce&amp;rft_id=https%3A%2F%2Fwww.academia.edu%2F562267&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt75" id="mwBCc"></span></span></li>
<li about="#cite_note-Scribal_training-18" id="cite_note-Scribal_training-18" data-mw-footnote-number="18"><span class="mw-cite-backlink" id="mwBCg"><a href="#cite_ref-Scribal_training_18-0" rel="mw:referencedBy" id="mwBCk"><span class="mw-linkback-text" id="mwBCo">↑</span></a></span> <span id="mw-reference-text-cite_note-Scribal_training-18" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt78" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBCs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal","href":"./Template:Cite_journal"},"params":{"title":{"wt":"Scribal Training in Ancient Egypt"},"journal":{"wt":"Journal of the American Oriental Society"},"volume":{"wt":"92"},"pages":{"wt":"214–221"},"number":{"wt":"2"},"year":{"wt":"1972"},"author":{"wt":"Ronald J. Williams"},"jstor":{"wt":"600648"},"doi":{"wt":"10.2307/600648"}},"i":0}}]}'/><cite id="CITEREFRonald_J._Williams1972" class="citation journal cs1" about="#mwt78">Ronald J. Williams (1972). "Scribal Training in Ancient Egypt". <i id="mwBCw">Journal of the American Oriental Society</i>. <b id="mwBC0">92</b> (2): <span class="nowrap" id="mwBC4">214–</span>221. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwBC8">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.2307%2F600648" class="external text" id="mwBDA">10.2307/600648</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/JSTOR_(identifier)" title="JSTOR (identifier)" class="mw-redirect" id="mwBDE">JSTOR</a><span typeof="mw:Entity" id="mwBDI"> </span><a rel="mw:ExtLink nofollow" href="https://www.jstor.org/stable/600648" class="external text" id="mwBDM">600648</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Journal+of+the+American+Oriental+Society&amp;rft.atitle=Scribal+Training+in+Ancient+Egypt&amp;rft.volume=92&amp;rft.issue=2&amp;rft.pages=214-221&amp;rft.date=1972&amp;rft_id=info%3Adoi%2F10.2307%2F600648&amp;rft_id=https%3A%2F%2Fwww.jstor.org%2Fstable%2F600648%23id-name%3DJSTOR&amp;rft.au=Ronald+J.+Williams&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt78" id="mwBDQ"></span></span></li>
<li about="#cite_note-:0-19" id="cite_note-:0-19" data-mw-footnote-number="19"><span class="mw-cite-backlink" id="mwBDU"><a href="#cite_ref-:0_19-0" rel="mw:referencedBy" id="mwBDY"><span class="mw-linkback-text" id="mwBDc">↑</span></a></span> <span id="mw-reference-text-cite_note-:0-19" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt81" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBDg" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.historytoday.com/michael-loewe/china%E2%80%99s-first-empire"},"title":{"wt":"China&apos;s First Empire {{!}} History Today"},"website":{"wt":"www.historytoday.com"},"access-date":{"wt":"17 April 2017"},"url-status":{"wt":"live"},"archive-url":{"wt":"https://web.archive.org/web/20170417235658/http://www.historytoday.com/michael-loewe/china%E2%80%99s-first-empire"},"archive-date":{"wt":"17 April 2017"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt81" id="mwBDk"><a rel="mw:ExtLink nofollow" href="http://www.historytoday.com/michael-loewe/china%E2%80%99s-first-empire" class="external text" id="mwBDo">"China's First Empire | History Today"</a>. <i id="mwBDs">www.historytoday.com</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20170417235658/http://www.historytoday.com/michael-loewe/china%E2%80%99s-first-empire" class="external text" id="mwBDw">Archived</a> from the original on 17 April 2017<span class="reference-accessdate" id="mwBD0">. Retrieved <span class="nowrap" id="mwBD4">17 April</span> 2017</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=www.historytoday.com&amp;rft.atitle=China%27s+First+Empire+%7C+History+Today&amp;rft_id=http%3A%2F%2Fwww.historyto