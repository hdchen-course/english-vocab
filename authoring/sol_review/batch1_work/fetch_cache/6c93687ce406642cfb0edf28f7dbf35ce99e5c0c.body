<li about="#cite_note-53" id="cite_note-53" data-mw-footnote-number="53"><span class="mw-cite-backlink" id="mwBZI"><a href="#cite_ref-53" rel="mw:referencedBy" id="mwBZM"><span class="mw-linkback-text" id="mwBZQ">↑</span></a></span> <span id="mw-reference-text-cite_note-53" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt185" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBZU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book\n ","href":"./Template:Cite_book"},"params":{"last1":{"wt":"Raadschelders"},"first1":{"wt":"Jos C. N."},"author-link1":{"wt":"Jos C.N. Raadschelders"},"editor-last1":{"wt":"Ladner"},"editor-first1":{"wt":"Andreas"},"editor-last2":{"wt":"Sager"},"editor-first2":{"wt":"Fritz"},"date":{"wt":"13 October 2022"},"chapter":{"wt":"The evolution of bureaucracy as a political actor: from instrument for power, via iron cage, to container and guardian of democracy"},"title":{"wt":"Handbook on the Politics of Public Administration"},"url":{"wt":"https://books.google.com/books?id=wW-VEAAAQBAJ"},"series":{"wt":"Elgar Handbooks in Public Administration and Management"},"publication-place":{"wt":"Cheltenham"},"publisher":{"wt":"Edward Elgar Publishing"},"page":{"wt":"14"},"isbn":{"wt":"9781839109447"},"access-date":{"wt":"16 October 2025"},"quote":{"wt":"[...] for most of history bureaucracies were found pretty much only in government. In the past 200 years, however, bureaucracy has become the standard organizational structure for any public, nonprofit, and private organization that is larger than a mom-and-pop store and/or larger than {{--}} give or take {{--}} 30 to 50 employees."},"archive-date":{"wt":"7 November 2025"},"archive-url":{"wt":"https://web.archive.org/web/20251107051208/https://books.google.com/books?id=wW-VEAAAQBAJ"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFRaadschelders2022" class="citation book cs1" about="#mwt185"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jos_C.N._Raadschelders" title="Jos C.N. Raadschelders" id="mwBZY">Raadschelders, Jos C. N.</a> (13 October 2022). "The evolution of bureaucracy as a political actor: from instrument for power, via iron cage, to container and guardian of democracy". In Ladner, Andreas; Sager, Fritz (eds.). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=wW-VEAAAQBAJ" class="external text" id="mwBZc"><i id="mwBZg">Handbook on the Politics of Public Administration</i></a>. Elgar Handbooks in Public Administration and Management. Cheltenham: Edward Elgar Publishing. p.<span typeof="mw:Entity" id="mwBZk"> </span>14. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBZo">ISBN</a><span typeof="mw:Entity" id="mwBZs"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9781839109447" title="Special:BookSources/9781839109447" id="mwBZw"><bdi id="mwBZ0">9781839109447</bdi></a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20251107051208/https://books.google.com/books?id=wW-VEAAAQBAJ" class="external text" id="mwBZ4">Archived</a> from the original on 7 November 2025<span class="reference-accessdate" id="mwBZ8">. Retrieved <span class="nowrap" id="mwBaA">16 October</span> 2025</span>. <q id="mwBaE">[...] for most of history bureaucracies were found pretty much only in government. In the past 200 years, however, bureaucracy has become the standard organizational structure for any public, nonprofit, and private organization that is larger than a mom-and-pop store and/or larger than — give or take — 30 to 50 employees.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=The+evolution+of+bureaucracy+as+a+political+actor%3A+from+instrument+for+power%2C+via+iron+cage%2C+to+container+and+guardian+of+democracy&amp;rft.btitle=Handbook+on+the+Politics+of+Public+Administration&amp;rft.place=Cheltenham&amp;rft.series=Elgar+Handbooks+in+Public+Administration+and+Management&amp;rft.pages=14&amp;rft.pub=Edward+Elgar+Publishing&amp;rft.date=2022-10-13&amp;rft.isbn=9781839109447&amp;rft.aulast=Raadschelders&amp;rft.aufirst=Jos+C.+N.&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3DwW-VEAAAQBAJ&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt185" id="mwBaI"></span></span></li>
<li about="#cite_note-54" id="cite_note-54" data-mw-footnote-number="54"><span class="mw-cite-backlink" id="mwBaM"><a href="#cite_ref-54" rel="mw:referencedBy" id="mwBaQ"><span class="mw-linkback-text" id="mwBaU">↑</span></a></span> <span id="mw-reference-text-cite_note-54" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt188" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBaY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book\n ","href":"./Template:Cite_book"},"params":{"author1":{"wt":"European Commission. Enterprise DG."},"year":{"wt":"2000"},"title":{"wt":"European Competitiveness Report 2000: Working Document of the Services of the European Commission"},"url":{"wt":"https://books.google.com/books?id=wLEPASuZtOMC"},"publisher":{"wt":"Office for Official Publications of the European Communities"},"page":{"wt":"71"},"isbn":{"wt":"9789282905234"},"access-date":{"wt":"16 October 2025"},"quote":{"wt":"As historical data have demonstrated, &apos;&apos;tertiarisation&apos;&apos; is a tremendously powerful process of structural change, characterised by the shift of economic activities away from such traditional areas as agriculture and manufacturing towards the tertiary sector."},"archive-date":{"wt":"7 November 2025"},"archive-url":{"wt":"https://web.archive.org/web/20251107051204/https://books.google.com/books?id=wLEPASuZtOMC"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFEuropean_Commission._Enterprise_DG.2000" class="citation book cs1" about="#mwt188">European Commission. Enterprise DG. (2000). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=wLEPASuZtOMC" class="external text" id="mwBac"><i id="mwBag">European Competitiveness Report 2000: Working Document of the Services of the European Commission</i></a>. Office for Official Publications of the European Communities. p.<span typeof="mw:Entity" id="mwBak"> </span>71. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwBao">ISBN</a><span typeof="mw:Entity" id="mwBas"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9789282905234" title="Special:BookSources/9789282905234" id="mwBaw"><bdi id="mwBa0">9789282905234</bdi></a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20251107051204/https://books.google.com/books?id=wLEPASuZtOMC" class="external text" id="mwBa4">Archived</a> from the original on 7 November 2025<span class="reference-accessdate" id="mwBa8">. Retrieved <span class="nowrap" id="mwBbA">16 October</span> 2025</span>. <q id="mwBbE">As historical data have demonstrated, <i id="mwBbI">tertiarisation</i> is a tremendously powerful process of structural change, characterised by the shift of economic activities away from such traditional areas as agriculture and manufacturing towards the tertiary sector.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=European+Competitiveness+Report+2000%3A+Working+Document+of+the+Services+of+the+European+Commission&amp;rft.pages=71&amp;rft.pub=Office+for+Official+Publications+of+the+European+Communities&amp;rft.date=2000&amp;rft.isbn=9789282905234&amp;rft.au=European+Commission.+Enterprise+DG.&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3DwLEPASuZtOMC&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt188" id="mwBbM"></span></span></li>
