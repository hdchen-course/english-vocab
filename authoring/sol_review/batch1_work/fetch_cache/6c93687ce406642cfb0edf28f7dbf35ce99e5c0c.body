<li about="#cite_note-35" id="cite_note-35" data-mw-footnote-number="35"><span class="mw-cite-backlink" id="mwBMw"><a href="#cite_ref-35" rel="mw:referencedBy" id="mwBM0"><span class="mw-linkback-text" id="mwBM4">↑</span></a></span> <span id="mw-reference-text-cite_note-35" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt124" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBM8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"The Tsarist regime, Background, The Russian Revolution, SOSE: History Year 9, NSW {{!}} Online Education Home Schooling Skwirk Australia"},"url":{"wt":"http://www.skwirk.com/p-c_s-14_u-427_t-1083_c-4185/the-tsarist-regime/nsw/history/the-russian-revolution/background"},"accessdate":{"wt":"2016-12-29"},"website":{"wt":"www.skwirk.com"},"publisher":{"wt":"Red Apple Education Ltd."},"quote":{"wt":"As many countries in Europe industrialised their economy and liberalised their political structure, Russia was bound by the conservative nature of the Tsarist regime. The economic, social and political tensions that emerged in the late 19th century led to revolution in the 20th century."},"archive-date":{"wt":"13 October 2018"},"archive-url":{"wt":"https://web.archive.org/web/20181013022719/http://www.skwirk.com/p-c_s-14_u-427_t-1083_c-4185/the-tsarist-regime/nsw/history/the-russian-revolution/background"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt124" id="mwBNA"><a rel="mw:ExtLink nofollow" href="http://www.skwirk.com/p-c_s-14_u-427_t-1083_c-4185/the-tsarist-regime/nsw/history/the-russian-revolution/background" class="external text" id="mwBNE">"The Tsarist regime, Background, The Russian Revolution, SOSE: History Year 9, NSW | Online Education Home Schooling Skwirk Australia"</a>. <i id="mwBNI">www.skwirk.com</i>. Red Apple Education Ltd. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20181013022719/http://www.skwirk.com/p-c_s-14_u-427_t-1083_c-4185/the-tsarist-regime/nsw/history/the-russian-revolution/background" class="external text" id="mwBNM">Archived</a> from the original on 13 October 2018<span class="reference-accessdate" id="mwBNQ">. Retrieved <span class="nowrap" id="mwBNU">29 December</span> 2016</span>. <q id="mwBNY">As many countries in Europe industrialised their economy and liberalised their political structure, Russia was bound by the conservative nature of the Tsarist regime. The economic, social and political tensions that emerged in the late 19th century led to revolution in the 20th century.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=www.skwirk.com&amp;rft.atitle=The+Tsarist+regime%2C+Background%2C+The+Russian+Revolution%2C+SOSE%3A+History+Year+9%2C+NSW+%7C+Online+Education+Home+Schooling+Skwirk+Australia&amp;rft_id=http%3A%2F%2Fwww.skwirk.com%2Fp-c_s-14_u-427_t-1083_c-4185%2Fthe-tsarist-regime%2Fnsw%2Fhistory%2Fthe-russian-revolution%2Fbackground&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt124" id="mwBNc"></span></span></li>
