<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt191" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBbc" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"oed ","href":"./Template:Oed"},"params":{"1":{"wt":" white collar"}},"i":0}}]}'/><cite id="CITEREFReference-OED-_white_collar" class="citation encyclopaedia cs1" about="#mwt191"><span class="id-lock-subscription" title="Paid subscription required" id="mwBbg"><a rel="mw:ExtLink nofollow" href="https://www.oed.com/search/dictionary/?q=white+collar" class="external text" id="mwBbk">"white collar"</a></span>. <i id="mwBbo"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Oxford_English_Dictionary" title="Oxford English Dictionary" id="mwBbs">Oxford English Dictionary</a></i> (online<span typeof="mw:Entity" id="mwBbw"> </span>ed.). Oxford University Press.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=white+collar&amp;rft.btitle=Oxford+English+Dictionary&amp;rft.edition=online&amp;rft.pub=Oxford+University+Press&amp;rft_id=https%3A%2F%2Fwww.oed.com%2Fsearch%2Fdictionary%2F%3Fq%3Dwhite%2Bcollar&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ABureaucracy" class="Z3988" about="#mwt191" id="mwBb0"></span><span typeof="mw:Entity" about="#mwt191" id="mwBb4"> </span><span style="font-size:0.95em; font-size:95%; color: var( --color-subtle, #555 )" about="#mwt191" id="mwBb8">(Subscription or <a rel="mw:ExtLink nofollow" href="https://www.oed.com/public/login/loggingin#withyourlibrary" class="external text" id="mwBcA">participating institution membership</a> required.)</span>
