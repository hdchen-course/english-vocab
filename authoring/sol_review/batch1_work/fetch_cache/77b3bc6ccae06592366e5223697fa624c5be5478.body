  <script type="text/javascript" nonce="v2Ogu21zNBE=">
function changeTopCat(code) {
	var checkbox = $('input[type="checkbox"][name="q_topCat"]');
	if(checkbox.length >= 1) {
		checkbox.each(function() {
			if($(this).val() != code)
			    $(this).prop('checked', false);
			else
				$(this).prop('checked', true);
		});
	} else {
		document.contentSearchForm.q_topCat.value = code;
	}
}
function listChangePage(nowPage, pageSize) {
    $('#listNowPage').val(nowPage);
    $('#listPageSize').val(pageSize);
    $('#contentSearchForm').submit();
}
$(document).ready(function () {
    $('.calendar').each(function() {
        if($(this).attr('data-type') && $(this).attr('data-type') == 'time') {
            var inputData = $(this).parent().find('#'+$(this).prop('id'));
            var realData = $(this).parent().find('.calendarHidden');
            addDhtmlCalTimeJq($(realData), $(inputData), $(this), '/');
        } else {
            var inputData = $(this).parent().find('#'+$(this).prop('id'));
            var realData = $(this).parent().find('.calendarHidden');
            addDhtmlCalJq($(realData), $(inputData), $(this), '/');
        }
    });
    $('select').each(function() {
        if($(this).attr('refcolumn') && $(this).attr('refcolumn') != '') {
            var refColumnName = $(this).attr('refcolumn');
            var obj = $(this);
            $('#q_'+refColumnName).on('change', function() {
                $(obj).empty();
                $(obj).append('<option value="">請選擇</option>');
                var selectVal = $('#q_'+refColumnName+' :selected').val();
                var selectText = $('#q_'+refColumnName+' :selected').text();
                if(selectVal != '') {
                    $('#'+$(obj).prop('id')+'_full > option').each(function() {
                        if($(this).text().startsWith(selectText+'－')) {
                            $(obj).append('<option value="'+$(this).val()+'">'+$(this).text().replace(selectText+'－','')+'</option>');
                        }
                    });
                }
            });
            var selectVal = $('#q_'+refColumnName+' :selected').val();
            var selectText = $('#q_'+refColumnName+' :selected').text();
            if(selectVal != '') {
                $('#'+$(obj).prop('id')+' > option').each(function() {
                    if($(this).text().startsWith(selectText+'－')) {
                        $(this).text($(this).text().replace(selectText+'－',''));
                    } else if($(this).val() != '') {
                        $(this).remove();
                    }
                });
            } else {
                $(obj).empty();
                $(obj).append('<option value="">請選擇</option>');
            }
            $(this).attr('refcolumn', '');
        }
    });
    if(typeof initPageForm == 'function') {
        initPageForm();
    }
});
function forwardMail(href) {
    location.href=href+'?xdUrl=ForwardMail';
}
</script>
