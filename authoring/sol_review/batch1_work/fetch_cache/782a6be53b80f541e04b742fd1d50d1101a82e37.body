<td id="mwAxM"><span class="mw-empty-elt" about="#mwt452" typeof="mw:Transclusion" id="mwAxQ" data-mw='{"parts":[{"template":{"target":{"wt":"plainlist","href":"./Template:Plainlist"},"params":{"1":{"wt":"\n* {{wikt-lang|da|citationstegn}} (citation marks)\n* {{wikt-lang|da|anførselstegn}} (indication marks)\n* {{wikt-lang|da|gåseøjne}} (goose eyes)\n"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1126788409" about="#mwt453" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"}}'/></span><div class="plainlist " about="#mwt452" id="mwAxU">
