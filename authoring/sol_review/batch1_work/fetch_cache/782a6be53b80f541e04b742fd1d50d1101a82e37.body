<li about="#cite_note-49" id="cite_note-49" data-mw-footnote-number="41"><span class="mw-cite-backlink" id="mwEqE"><a href="#cite_ref-49" rel="mw:referencedBy" id="mwEqI"><span class="mw-linkback-text" id="mwEqM">↑</span></a></span> <span id="mw-reference-text-cite_note-49" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt480" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEqQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"Punctuation in direct speech"},"work":{"wt":"Oxford Dictionaries: Language Matters"},"publisher":{"wt":"Oxford University Press"},"url":{"wt":"http://www.oxforddictionaries.com/words/punctuation-in-direct-speech"},"archive-url":{"wt":"https://web.archive.org/web/20120106011904/http://oxforddictionaries.com/words/punctuation-in-direct-speech"},"url-status":{"wt":"dead"},"archive-date":{"wt":"6 January 2012"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt480" id="mwEqU"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20120106011904/http://oxforddictionaries.com/words/punctuation-in-direct-speech" class="external text" id="mwEqY">"Punctuation in direct speech"</a>. <i id="mwEqc">Oxford Dictionaries: Language Matters</i>. Oxford University Press. Archived from <a rel="mw:ExtLink nofollow" href="http://www.oxforddictionaries.com/words/punctuation-in-direct-speech" class="external text" id="mwEqg">the original</a> on 6 January 2012.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Oxford+Dictionaries%3A+Language+Matters&amp;rft.atitle=Punctuation+in+direct+speech&amp;rft_id=http%3A%2F%2Fwww.oxforddictionaries.com%2Fwords%2Fpunctuation-in-direct-speech&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AQuotation+mark" class="Z3988" about="#mwt480" id="mwEqk"></span></span></li>
<li about="#cite_note-51" id="cite_note-51" data-mw-footnote-number="42"><span class="mw-cite-backlink" id="mwEqo"><a href="#cite_ref-51" rel="mw:referencedBy" id="mwEqs"><span class="mw-linkback-text" id="mwEqw">↑</span></a></span> <span id="mw-reference-text-cite_note-51" class="mw-reference-text reference-text">The usage of single or double marks  historically (and still) has been subject to varying standards dependent on individual or institution, though the older usage is double marking. Due to global influence, it has been popularly observed that double markings are more commonly employed in both formal and informal writing.<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt487" typeof="mw:Transclusion" id="mwEq0" data-mw='{"parts":[{"template":{"target":{"wt":"Citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"September 2025"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_September_2025" about="#mwt487" id="mwEq4"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt487" id="mwEq8"><span typeof="mw:Entity" id="mwErA">[</span><i id="mwErE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed" id="mwErI"><span title="This claim needs references to reliable sources. (September 2025)" id="mwErM">citation needed</span></a></i><span typeof="mw:Entity" id="mwErQ">]</span></sup></span></li>
<li about="#cite_note-fil-53" id="cite_note-fil-53" data-mw-footnote-number="43"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwErU"><a href="#cite_ref-fil_53-0" id="mwErY"><span class="mw-linkback-text" id="mwErc">1</span></a> <a href="#cite_ref-fil_53-1" id="mwErg"><span class="mw-linkback-text" id="mwErk">2</span></a></span> <span id="mw-reference-text-cite_note-fil-53" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt525" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEro" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book ","href":"./Template:Cite_book"},"params":{"date":{"wt":"2009"},"author":{"wt":"[[Commission on the Filipino Language]]"},"title":{"wt":"Gabay sa Ortograpiyang Filipino"},"publisher":{"wt":"Commission on the Filipino Language"},"location":{"wt":"Manila"},"language":{"wt":"fil"},"isbn":{"wt":"9789718705971"}},"i":0}}]}'/><cite id="CITEREFCommission_on_the_Filipino_Language2009" class="citation book cs1 cs1-prop-foreign-lang-source-2" about="#mwt525"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Commission_on_the_Filipino_Language" title="Commission on the Filipino Language" id="mwErs">Commission on the Filipino Language</a> (2009). <i id="mwErw">Gabay sa Ortograpiyang Filipino</i> (in Filipino). Manila: Commission on the Filipino Language. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwEr0">ISBN</a><span typeof="mw:Entity" id="mwEr4"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9789718705971" title="Special:BookSources/9789718705971" id="mwEr8"><bdi id="mwEsA">9789718705971</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Gabay+sa+Ortograpiyang+Filipino&amp;rft.place=Manila&amp;rft.pub=Commission+on+the+Filipino+Language&amp;rft.date=2009&amp;rft.isbn=9789718705971&amp;rft.au=Commission+on+the+Filipino+Language&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AQuotation+mark" class="Z3988" about="#mwt525" id="mwEsE"></span><link rel="mw:PageProp/Category" href="./Category:CS1_foreign_language_sources_(ISO_639-2)#fil" about="#mwt525" id="mwEsI"/></span></li>
<li about="#cite_note-fi-54" id="cite_note-fi-54" data-mw-footnote-number="44"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwEsM"><a href="#cite_ref-fi_54-0" id="mwEsQ"><span class="mw-linkback-text" id="mwEsU">1</span></a> <a href="#cite_ref-fi_54-1" id="mwEsY"><span class="mw-linkback-text" id="mwEsc">2</span></a></span> <span id="mw-reference-text-cite_note-fi-54" class="mw-reference-text reference-text">Regulated by the standard SFS 4175:2006, “Typing of numbers, marks and signs." Released by the National standards organization of Finland.</span></li>
<li about="#cite_note-58" id="cite_note-58" data-mw-footnote-number="45"><span class="mw-cite-backlink" id="mwEsg"><a href="#cite_ref-58" rel="mw:referencedBy" id="mwEsk"><span class="mw-linkback-text" id="mwEso">↑</span></a></span> <span id="mw-reference-text-cite_note-58" class="mw-reference-text reference-text">
