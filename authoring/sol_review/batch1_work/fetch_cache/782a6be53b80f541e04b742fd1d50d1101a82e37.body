<tr id="mwDBA">
<td id="mwDBE"><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1500" typeof="mw:Transclusion" id="mwDBI" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"{{huge|‚{{color|silver|A}}’}}"}},"i":0}}]}'><span style="vertical-align:sub;"><span style="vertical-align:sub;line-height:180%"><span style="font-size:180%; vertical-align:sub;">‚<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt1501" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver">A</span>’</span></span></span></span></td>
<td id="mwDBM"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1367478826" about="#mwt1502" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDBQ" data-mw='{"name":"templatestyles","attrs":{"src":"Comma-separated list/styles.css"},"parts":[{"template":{"target":{"wt":"cslist","href":"./Template:Cslist"},"params":{"1":{"wt":"U+201A (8218)"},"2":{"wt":"U+2019 (8217)"}},"i":0}}]}'/><ul class="cslist" about="#mwt1502" id="mwDBU"><li>U+201A (8218)</li><li>U+2019 (8217)</li></ul></td>
<td id="mwDBY"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1367478826" about="#mwt1504" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDBc" data-mw='{"name":"templatestyles","attrs":{"src":"Comma-separated list/styles.css"},"parts":[{"template":{"target":{"wt":"cslist","href":"./Template:Cslist"},"params":{"1":{"wt":"&amp;amp;sbquo;"},"2":{"wt":"&amp;amp;rsquo;"}},"i":0}}]}'/><ul class="cslist" about="#mwt1504" id="mwDBg"><li><span typeof="mw:Entity">&amp;</span>sbquo;</li><li><span typeof="mw:Entity">&amp;</span>rsquo;</li></ul></td>
<td id="mwDBk">Polish single quotes (left and right)</td></tr>
<tr id="mwDBo">
<td id="mwDBs"><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1506" typeof="mw:Transclusion" id="mwDBw" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"{{huge|„{{color|silver|A}}”}}"}},"i":0}}]}'><span style="vertical-align:sub;"><span style="vertical-align:sub;line-height:180%"><span style="font-size:180%; vertical-align:sub;">„<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt1507" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver">A</span>”</span></span></span></span></td>
<td id="mwDB0"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1367478826" about="#mwt1508" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDB4" data-mw='{"name":"templatestyles","attrs":{"src":"Comma-separated list/styles.css"},"parts":[{"template":{"target":{"wt":"cslist","href":"./Template:Cslist"},"params":{"1":{"wt":"U+201E (8222)"},"2":{"wt":"U+201D (8221)"}},"i":0}}]}'/><ul class="cslist" about="#mwt1508" id="mwDB8"><li>U+201E (8222)</li><li>U+201D (8221)</li></ul></td>
<td id="mwDCA"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1367478826" about="#mwt1510" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDCE" data-mw='{"name":"templatestyles","attrs":{"src":"Comma-separated list/styles.css"},"parts":[{"template":{"target":{"wt":"cslist","href":"./Template:Cslist"},"params":{"1":{"wt":"&amp;amp;bdquo;"},"2":{"wt":"&amp;amp;rdquo;"}},"i":0}}]}'/><ul class="cslist" about="#mwt1510" id="mwDCI"><li><span typeof="mw:Entity">&amp;</span>bdquo;</li><li><span typeof="mw:Entity">&amp;</span>rdquo;</li></ul></td>
<td id="mwDCM">Polish double quotes (left and right)</td></tr>
<tr id="mwDCQ">
<td id="mwDCU"><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1512" typeof="mw:Transclusion" id="mwDCY" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"{{huge|—&amp;nbsp;{{color|silver|A}}}}"}},"i":0}}]}'><span style="vertical-align:sub;"><span style="vertical-align:sub;line-height:180%"><span style="font-size:180%; vertical-align:sub;">—<span typeof="mw:Entity"> </span><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt1513" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver">A</span></span></span></span></span></td>
<td id="mwDCc">U+2014 (8212)</td>
<td id="mwDCg"><span typeof="mw:Entity" id="mwDCk">&amp;</span>mdash;</td>
<td id="mwDCo">Polish direct quotation <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Em-dash" title="Em-dash" class="mw-redirect" id="mwDCs">em-dash</a></td></tr>
<tr id="mwDCw">
<td id="mwDC0"><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1514" typeof="mw:Transclusion" id="mwDC4" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"{{huge|–&amp;nbsp;{{color|silver|A}}}}"}},"i":0}}]}'><span style="vertical-align:sub;"><span style="vertical-align:sub;line-height:180%"><span style="font-size:180%; vertical-align:sub;">–<span typeof="mw:Entity"> </span><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt1515" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver">A</span></span></span></span></span></td>
<td id="mwDC8">U+2013 (8211)</td>
<td id="mwDDA"><span typeof="mw:Entity" id="mwDDE">&amp;</span>ndash;</td>
<td id="mwDDI">Polish direct quotation <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/En-dash" title="En-dash" class="mw-redirect" id="mwDDM">en-dash</a></td></tr>
</tbody></table>

</section><section data-mw-section-id="16" id="mwDDQ" aria-labelledby="Portuguese"><div class="mw-heading mw-heading3"><h3 id="Portuguese">Portuguese</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Quotation_mark&amp;action=edit&amp;section=16" title="Edit section: Portuguese"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<p id="mwDDU">Neither the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Academia_das_Ciências_de_Lisboa,_Classe_de_Letras" title="Academia das Ciências de Lisboa, Classe de Letras" class="mw-redirect" id="mwDDY">Portuguese</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Language_regulator" title="Language regulator" class="mw-redirect" id="mwDDc">language regulator</a> nor the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Academia_Brasileira_de_Letras" title="Academia Brasileira de Letras" class="mw-redirect" id="mwDDg">Brazilian</a> prescribe a particular shape for quotation marks<!--&#x2D;&#x2D;As far as I know; if anyone has different sources, please, help me.&#x2D;&#x2D;-->, they only prescribe when and how they should be used.</p>

<p id="mwDDk">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Portugal" title="Portugal" id="mwDDo">Portugal</a>, angular quotation marks<sup about="#mwt1517" class="mw-ref reference" id="cite_ref-pt-aspas_90-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"pt-aspas"}}'><a href="#cite_note-pt-aspas-90" id="mwDDs"><span class="mw-reflink-text" id="mwDDw"><span class="cite-bracket" id="mwDD0">[</span>70<span class="cite-bracket" id="mwDD4">]</span></span></a></sup><sup about="#mwt1518" class="mw-ref reference" id="cite_ref-pt-Prontuário_Ortográfico_95-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"pt-Prontuário Ortográfico"}}'><a href="#cite_note-pt-Prontuário_Ortográfico-95" id="mwDD8"><span class="mw-reflink-text" id="mwDEA"><span class="cite-bracket" id="mwDEE">[</span>75<span class="cite-bracket" id="mwDEI">]</span></span></a></sup> (ex. <span about="#mwt1516" typeof="mw:Transclusion" id="mwDEM" data-mw='{"parts":[{"template":{"target":{"wt":"Not a typo","href":"./Template:Not_a_typo"},"params":{"1":{"wt":"«quote»"}},"i":0}}]}'>«quote»</span>) are traditionally used. They are the Latin tradition quotation marks, normally used by typographers, and are also the usual style in reference sources,<sup about="#mwt1521" class="mw-ref reference" id="cite_ref-infopedia_94-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"infopedia"},"body":{"id":"mw-reference-text-cite_note-infopedia-94"}}'><a href="#cite_note-infopedia-94" id="mwDEQ"><span class="mw-reflink-text" id="mwDEU"><span class="cite-bracket" id="mwDEY">[</span>74<span class="cite-bracket" id="mwDEc">]</span></span></a></sup><sup about="#mwt1522" class="mw-ref reference" id="cite_ref-114" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-114"}}'><a href="#cite_note-114" id="mwDEg"><span class="mw-reflink-text" id="mwDEk"><span class="cite-bracket" id="mwDEo">[</span>92<span class="cite-bracket" id="mwDEs">]</span></span></a></sup><sup about="#mwt1523" class="mw-ref reference" id="cite_ref-Cunha_115-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Cunha"},"body":{"id":"mw-reference-text-cite_note-Cunha-115"}}'><a href="#cite_note-Cunha-115" id="mwDEw"><span class="mw-reflink-text" id="mwDE0"><span class="cite-bracket" id="mwDE4">[</span>93<span class="cite-bracket" id="mwDE8">]</span></span></a></sup> as well as on some websites dedicated to the Portuguese language.<sup about="#mwt1526" class="mw-ref reference" id="cite_ref-116" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-116"}}'><a href="#cite_note-116" id="mwDFA"><span class="mw-reflink-text" id="mwDFE"><span class="cite-bracket" id="mwDFI">[</span>94<span class="cite-bracket" id="mwDFM">]</span></span></a></sup></p>

<p id="mwDFQ">The <i id="mwDFU">Código de Redação</i><sup about="#mwt1530" class="mw-ref reference" id="cite_ref-CRI_117-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"CRI"},"body":{"id":"mw-reference-text-cite_note-CRI-117"}}'><a href="#cite_note-CRI-117" id="mwDFY"><span class="mw-reflink-text" id="mwDFc"><span class="cite-bracket" id="mwDFg">[</span>95<span class="cite-bracket" id="mwDFk">]</span></span></a></sup> for Portuguese-language documents published in the European Union prescribes three levels of quotation marks, <span class="nounderlines" style="border: 1px solid var(--border-color-muted,#ddd); color: var(--color-base,#202122); background-color: var( --background-color-neutral-subtle, #fdfdfd); padding: 1px 1px;" about="#mwt1527" typeof="mw:Transclusion" id="mwDFo" data-mw='{"parts":[{"template":{"target":{"wt":"char","href":"./Template:Char"},"params":{"1":{"wt":"«...“...‘...’...”...»"}},"i":0}}]}'>«...“...‘...’...”...»</span>:</p>

<span class="mw-empty-elt" about="#mwt1531" typeof="mw:Transclusion" id="mwDFs" data-mw='{"parts":[{"template":{"target":{"wt":"block indent","href":"./Template:Block_indent"},"params":{"1":{"wt":"&apos;&apos;&lt;span style=\"color:black\">E estava escrito &lt;span style=\"color:green\">«Alguém perguntou &lt;span style=\"color:red\">“Quem foi que gritou &lt;span style=\"color:blue\">‘Meu Deus!’&lt;/span>?”&lt;/span>.»&lt;/span> na folha de papel.&lt;/span>&apos;&apos;&lt;br />\n&lt;span style=\"color:black\">And it was written &lt;span style=\"color:green\">“Someone asked &lt;span style=\"color:red\">‘Who shouted &lt;span style=\"color:blue\">“My God!”&lt;/span>?’&lt;/span>.”&lt;/span> on the sheet of paper.&lt;/span>"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r996643573" about="#mwt1532" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Block indent/styles.css"}}'/></span><div class="block-indent " about="#mwt1531" id="mwDFw"><i><span style="color:black">E estava escrito <span style="color:green">«Alguém perguntou <span style="color:red">“Quem foi que gritou <span style="color:blue">‘Meu Deus!’</span>?”</span>.»</span> na folha de papel.</span></i><br/>
<span style="color:black">And it was written <span style="color:green">“Someone asked <span style="color:red">‘Who shouted <span style="color:blue">“My God!”</span>?’</span>.”</span> on the sheet of paper.</span></div>

<ul id="mwDF0"><li id="mwDF4">in <span style="color:black" id="mwDF8">black</span>: main sentence which contains the quotations;</li>
<li id="mwDGA">in <span style="color:green" id="mwDGE">green</span>: 1st level quotation;</li>
<li id="mwDGI">in <span style="color:red" id="mwDGM">red</span>: 2nd level quotation;</li>
<li id="mwDGQ">in <span style="color:blue" id="mwDGU">blue</span>: 3rd level quotation;</li></ul>

<p id="mwDGY">The usage of curved quotation marks (ex. <span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1533" typeof="mw:Transclusion" id="mwDGc" data-mw='{"parts":[{"template":{"target":{"wt":"Not a typo","href":"./Template:Not_a_typo"},"params":{"1":{"wt":"{{serif|“quote”}} and {{serif|‘quote’}}"}},"i":0}}]}'>“quote”</span><span about="#mwt1533"> and </span><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1533" id="mwDGg">‘quote’</span>) is growing in Portugal,<sup about="#mwt1537" class="mw-ref reference" id="cite_ref-altas_118-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"altas"},"body":{"id":"mw-reference-text-cite_note-altas-118"}}'><a href="#cite_note-altas-118" id="mwDGk"><span class="mw-reflink-text" id="mwDGo"><span class="cite-bracket" id="mwDGs">[</span>96<span class="cite-bracket" id="mwDGw">]</span></span></a></sup><link rel="mw:PageProp/Category" href="./Category:All_articles_lacking_reliable_references" about="#mwt1534" typeof="mw:Transclusion" id="mwDG0" data-mw='{"parts":[{"template":{"target":{"wt":"better source needed","href":"./Template:Better_source_needed"},"params":{"date":{"wt":"August 2017"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_lacking_reliable_references_from_August_2017" about="#mwt1534"/><sup class="noprint Inline-Template noprint noexcerpt Template-Fact" style="white-space:nowrap;" about="#mwt1534" id="mwDG4"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Verifiability#Questionable_sources" title="Wikipedia:Verifiability"><span title="This claim needs references to better sources. (August 2017)">better<span typeof="mw:Entity"> </span>source<span typeof="mw:Entity"> </span>needed</span></a></i><span typeof="mw:Entity">]</span></sup> probably due to the omnipresence of the English language and to the corresponding difficulty (or even inability) to enter angular quotation marks on some machines (mobile phones, cash registers, calculators, etc.).</p>

<p id="mwDG8">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Brazil" title="Brazil" id="mwDHA">Brazil</a>, angular quotation marks are rare, and curved quotation marks (<span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1538" typeof="mw:Transclusion" id="mwDHE" data-mw='{"parts":[{"template":{"target":{"wt":"Not a typo","href":"./Template:Not_a_typo"},"params":{"1":{"wt":"{{serif|“quote”}} and {{serif|‘quote’}}"}},"i":0}}]}'>“quote”</span><span about="#mwt1538"> and </span><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt1538" id="mwDHI">‘quote’</span>) are almost always used. An example of this can be seen in the difference between a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_QWERTY_keyboard_language_variants#Portugal" title="List of QWERTY keyboard language variants" id="mwDHM">Portuguese keyboard</a> (which has a key for <span class="nounderlines" style="border: 1px solid var(--border-color-muted,#ddd); color: var(--color-base,#202122); background-color: var( --background-color-neutral-subtle, #fdfdfd); padding: 1px 1px;" about="#mwt1539" typeof="mw:Transclusion" id="mwDHQ" data-mw='{"parts":[{"template":{"target":{"wt":"char","href":"./Template:Char"},"params":{"1":{"wt":"«"}},"i":0}}]}'>«</span> and <span class="nounderlines" style="border: 1px solid var(--border-color-muted,#ddd); color: var(--color-base,#202122); background-color: var( --background-color-neutral-subtle, #fdfdfd); padding: 1px 1px;" about="#mwt1540" typeof="mw:Transclusion" id="mwDHU" data-mw='{"parts":[{"template":{"target":{"wt":"char","href":"./Template:Char"},"params":{"1":{"wt":"»"}},"i":0}}]}'>»</span>) and a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_QWERTY_keyboard_language_variants#Brazil" title="List of QWERTY keyboard language variants" id="mwDHY">Brazilian keyboard</a>.</p>

<p id="mwDHc">The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Portuguese-speaking_African_countries" title="Portuguese-speaking African countries" id="mwDHg">Portuguese-speaking African countries</a> tend to follow Portugal's conventions, not the Brazilian ones.</p>

<p id="mwDHk">Other usages of quotation marks (<span class="nounderlines" style="border: 1px solid var(--border-color-muted,#ddd); color: var(--color-base,#202122); background-color: var( --background-color-neutral-subtle, #fdfdfd); padding: 1px 1px;" about="#mwt1541" typeof="mw:Transclusion" id="mwDHo" data-mw='{"parts":[{"template":{"target":{"wt":"char","href":"./Template:Char"},"params":{"1":{"wt":"“quote„"}},"i":0}}]}'>“quote„</span> for double, <span class="nounderlines" style="border: 1px solid var(--border-color-muted,#ddd); color: var(--color-base,#202122); background-color: var( --background-color-neutral-subtle, #fdfdfd); padding: 1px 1px;" about="#mwt1542" typeof="mw:Transclusion" id="mwDHs" data-mw='{"parts":[{"template":{"target":{"wt":"char","href":"./Template:Char"},"params":{"1":{"wt":"‹quote›"}},"i":0}}]}'>‹quote›</span> for single) are obsolete in Portuguese.<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt1543" typeof="mw:Transclusion" id="mwDHw" data-mw='{"parts":[{"template":{"target":{"wt":"citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"June 2020"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_June_2020" about="#mwt1543"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt1543" id="mwDH0"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed"><span title="This claim needs references to reliable sources. (June 2020)">citation needed</span></a></i><span typeof="mw:Entity">]</span></sup><!--&#x2D;&#x2D;Still looking for on&#x2D;line sources.&#x2D;&#x2D;-->.</p>

</section><section data-mw-section-id="17" id="mwDH4" aria-labelledby="Belarusian,_Russian,_and_Ukrainian"><div class="mw-heading mw-heading3"><h3 id="Belarusian,_Russian,_and_Ukrainian"><span id="Belarusian.2C_Russian.2C_and_Ukrainian" typeof="mw:FallbackId"></span>Belarusian, Russian, and Ukrainian</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Quotation_mark&amp;action=edit&amp;section=17" title="Edit section: Belarusian, Russian, and Ukrainian"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDH8">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Belarusian_language" title="Belarusian language" id="mwDIA">Belarusian</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russian_language" title="Russian language" id="mwDIE">Russian</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ukrainian_language" title="Ukrainian language" id="mwDII">Ukrainian</a>, the angled quotation marks (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Belarusian_language" title="Belarusian language" about="#mwt1544" typeof="mw:Transclusion" id="mwDIM" data-mw='{"parts":[{"template":{"target":{"wt":"langx","href":"./Template:Langx"},"params":{"1":{"wt":"be"},"2":{"wt":"«двукоссе»"}},"i":0}}]}'>Belarusian</a><span about="#mwt1544">: </span><span lang="be" about="#mwt1544">«двукоссе»</span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Belarusian-language_text" about="#mwt1544" id="mwDIQ"/>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Russian_language" title="Russian language" about="#mwt1545" typeof="mw:Transclusion" id="mwDIU" data-mw='{"parts":[{"template":{"target":{"wt":"langx","href":"./Template:Langx"},"params":{"1":{"wt":"ru"},"2":{"wt":"«кавычки»"}},"i":0}}]}'>Russian</a><span about="#mwt1545">: </span><span lang="ru" about="#mwt1545">«кавычки»</span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Russian-language_text" about="#mwt1545" id="mwDIY"/>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ukrainian_language" title="Ukrainian language" about="#mwt1546" typeof="mw:Transclusion" id="mwDIc" data-mw='{"parts":[{"template":{"target":{"wt":"langx","href":"./Template:Langx"},"params":{"1":{"wt":"uk"},"2":{"wt":"«лапки»"}},"i":0}}]}'>Ukrainian</a><span about="#mwt1546">: </span><span lang="uk" about="#mwt1546">«лапки»</span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Ukrainian-language_text" about="#mwt1546" id="mwDIg"/>) are used without spaces. In case of quoted material inside a quotation, rules and most noted style manuals prescribe the use of different kinds of quotation marks.</p>

<p id="mwDIk">Example in Russian:</p>
<blockquote id="mwDIo"><p about="#mwt1547" typeof="mw:Transclusion" id="mwDIs" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"ru"},"2":{"wt":"Пушкин писал Дельвигу: «Жду „Цыганов“ и тотчас тисну»."}},"i":0}}]}'><span title="Russian-language text"><span lang="ru">Пушкин писал Дельвигу: «Жду „Цыганов“ и тотчас тисну».</span></span></p><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Russian-language_text" about="#mwt1547" id="mwDIw"/>
<p id="mwDI0">(<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pushkin" title="Pushkin" class="mw-redirect" id="mwDI4">Pushkin</a> wrote to Delvig: "Waiting for '<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_Gypsies_(poem)" title="The Gypsies (poem)" id="mwDI8">Gypsies</a>', and publish at once.")</p>
</blockquote>

<p id="mwDJA">Example in Ukrainian:</p>
<blockquote id="mwDJE"><p about="#mwt1548" typeof="mw:Transclusion" id="mwDJI" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"uk"},"2":{"wt":"«І, звісно, не обійтись без користування словником. Один мій знайомий поет і літературознавець якось жартуючи сказав: “Я волію читати словники, ніж поеми. У словнику ті самі слова, що і в поемі, але подані в систематизованому порядку”. Це сказано жартома, але “читати словники” — не така вже дивовижна і дивацька річ, як може здатися»."}},"i":0}}]}'><span title="Ukrainian-language text"><span lang="uk">«І, звісно, не обійтись без користування словником. Один мій знайомий поет і літературознавець якось жартуючи сказав: “Я волію читати словники, ніж поеми. У словнику ті самі слова, що і в поемі, але подані в систематизованому порядку”. Це сказано жартома, але “читати словники” — не така вже дивовижна і дивацька річ, як може здатися».</span></span></p><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Ukrainian-language_text" about="#mwt1548" id="mwDJM"/>
<p id="mwDJQ">("And, of course, you can't avoid using a dictionary. One of my acquaintances, a poet and literary critic, once jokingly said: 'I prefer to read dictionaries than poems. The dictionary has the same words as in the poem, but is presented in a systematic way'. It's a joke, but 'reading dictionaries' is not as amazing and bizarre as it may seem.")</p>
</blockquote>

<p id="mwDJU"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ЙЦУКЕН" title="ЙЦУКЕН" class="mw-redirect" id="mwDJY">Russian keyboard layout</a> has no angled quotation marks, but has English quotation marks (" ") that are not even supposed to be used in Russian. For that reason one may often see non-standard use of English quotation marks on the Russian web.</p>

</section><section data-mw-section-id="18" id="mwDJc" aria-labelledby="Spanish"><div class="mw-heading mw-heading3"><h3 id="Spanish">Spanish</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Quotation_mark&amp;action=edit&amp;section=18" title="Edit section: Spanish"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<section data-mw-section-id="19" id="mwDJg" aria-labelledby="Spain"><div class="mw-heading mw-heading4"><h4 id="Spain">Spain</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Quotation_mark&amp;action=edit&amp;section=19" title="Edit section: Spain"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDJk"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Spain" title="Spain" id="mwDJo">Spain</a> uses angled quotation marks (<span title="Spanish-language text" about="#mwt1549" typeof="mw:Transclusion" id="mwDJs" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"es"},"2":{"wt":"comillas españolas"}},"i":0}}]}'><i lang="es">comillas españolas</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Spanish-language_text" about="#mwt1549" id="mwDJw"/>, <span title="Spanish-language text" about="#mwt1550" typeof="mw:Transclusion" id="mwDJ0" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"es"},"2":{"wt":"comillas latinas"}},"i":0}}]}'><i lang="es">comillas latinas</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Spanish-language_text" about="#mwt1550" id="mwDJ4"/> or <span title="Spanish-language text" about="#mwt1551" typeof="mw:Transclusion" id="mwDJ8" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"es"},"2":{"wt":"angulares"}},"i":0}}]}'><i lang="es">angulares</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Spanish-language_text" about="#mwt1551" id="mwDKA"/>), with no space between the quotation mark and the quoted material.</p><span class="mw-empty-elt" about="#mwt1552" typeof="mw:Transclusion" id="mwDKE" data-mw='{"parts":[{"template":{"target":{"wt":"block indent","href":"./Template:Block_indent"},"params":{"1":{"wt":"{{lang|es|«Esto es un ejemplo de cómo se suele hacer una cita literal en español».}}&lt;br />\n\"This is an example of how a literal quotation is usually written in Spanish.\""}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r996643573" about="#mwt1553" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Block indent/styles.css"}}'/></span><div class="block-indent " about="#mwt1552" id="mwDKI"><span title="Spanish-language text"><i lang="es">«Esto es un ejemplo de cómo se suele hacer una cita literal en español».</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Spanish-language_text"/><br/>
"This is an example of how a literal quotation is usually written in Spanish."</div>

<p id="mwDKM">When quotations are nested in more levels than inner and outer quotation, the system is:<sup about="#mwt1555" class="mw-ref reference" id="cite_ref-119" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-119"}}'><a href="#cite_note-119" id="mwDKQ"><span class="mw-reflink-text" id="mwDKU"><span class="cite-bracket" id="mwDKY">[</span>97<span class="cite-bracket" id="mwDKc">]</span></span></a></sup></p>

<span class="mw-empty-elt" about="#mwt1556" typeof="mw:Transclusion" id="mwDKg" data-mw='{"parts":[{"template":{"target":{"wt":"block indent","href":"./Template:Block_indent"},"params":{"1":{"wt":"{{lang|es|«Antonio me dijo: “Vaya ‘cacharro’ que se ha comprado Julián”».}}&lt;br />\n\"Antonio told me, &apos;What a piece of \"junk\" Julián has purchased for himself{{&apos; \"}}."}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r996643573" about="#mwt1557" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Block indent/styles.css"}}'/></span><div class="block-indent " about="#mwt1556" id="mwDKk"><span title="Spanish-language text"><i lang="es">«Antonio me dijo: “Vaya ‘cacharro’ que se ha comprado Julián”».</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Spanish-language_text"/><br/>
"Antonio told me, 'What a piece of "junk" Julián has purchased for himself<span style="padding-right:.15em;">'</span>".</div>

<p id="mwDKo">The use of English quotation marks is increasing in Spanish;<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt1558" typeof="mw:Transclusion" id="mwDKs" data-mw='{"parts":[{"template":{"target":{"wt":"citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"October 2018"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_October_2018" about="#mwt1558"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt1558" id="mwDKw"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed"><span title="This claim needs references to reliable sources. (October 2018)">citation needed</span></a></i><span typeof="mw:Entity">]</span></sup> the <i id="mwDK0"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/El_País" title="El País" id="mwDK4">El País</a></i> style guide, which is widely followed in Spain, recommends them. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hispanic_America" title="Hispanic America" id="mwDK8">Hispanic Americans</a> often use them, owing to influence from the United States.</p>

</section><section data-mw-section-id="20" id="mwDLA" aria-labelledby="Latin_America_and_the_Caribbean"><div class="mw-heading mw-heading4"><h4 id="Latin_America_and_the_Caribbean">Latin America and the Caribbean</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Quotation_mark&amp;action=edit&amp;section=20" title="Edit section: Latin America and the Caribbean"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDLE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Latin_America_and_the_Caribbean" title="Latin America and the Caribbean" id="mwDLI">Latin America and the Caribbean</a> uses the English quotation marks double (“ ”) and single (‘ ’) due to influencing from the United States, despite the RAE recommends of the usage of the angled quotation marks («<span typeof="mw:DisplaySpace" id="mwDLM"> </span>»), angled can be used as alternative.</p><span class="mw-empty-elt" about="#mwt1559" typeof="mw:Transclusion" id="mwDLQ" data-mw='{"parts":[{"template":{"target":{"wt":"block indent","href":"./Template:Block_indent"},"params":{"1":{"wt":"{{lang|es|“Esto es un ejemplo de cómo se suele hacer una cita literal en español latinoamericano.”}}&lt;br />\n\"This is an example of how a literal quotation is usually written in Latin American Spanish.\""}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r996643573" about="#mwt1560" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Block indent/styles.css"}}'/></span><div class="block-indent " about="#mwt1559" id="mwDLU"><span title="Spanish-language text"><i lang="es">“Esto es un ejemplo de cómo se suele hacer una cita literal en español latinoamericano.”</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Spanish-language_text"/><br/>
"This is an example of how a literal quotation is usually written in Latin American Spanish."</div>

<p id="mwDLY">Unlike Spain, Latin America uses a distinct order according to AML (Academia Mexicana de la Lengua).<sup about="#mwt1563" class="mw-ref reference" id="cite_ref-120" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-120"}}'><a href="#cite_note-120" id="mwDLc"><span class="mw-reflink-text" id="mwDLg"><span class="cite-bracket" id="mwDLk">[</span>98<span class="cite-bracket" id="mwDLo">]</span></span></a></sup></p>

<span class="mw-empty-elt" about="#mwt1564" typeof="mw:Transclusion" id="mwDLs" data-mw='{"parts":[{"template":{"target":{"wt":"block indent","href":"./Template:Block_indent"},"params":{"1":{"wt":"{{lang|es|“Juliana ayer me dijo: ‘Que pedazo de «cacharro» que se compró Lautaro’”.}}&lt;br />\n\"Juliana told me yesterday, &apos;What a piece of \"scrap\" Lautaro has purchased for himself{{&apos; \"}}."}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r996643573" about="#mwt1565" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Block indent/styles.css"}}'/></span><div class="block-indent " about="#mwt1564" id="mwDLw"><span title="Spanish-language text"><i lang="es">“Juliana ayer me dijo: ‘Que pedazo de «cacharro» que se compró Lautaro’”.</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Spanish-language_text"/><br/>
"Juliana told me yesterday, 'What a piece of "scrap" Lautaro has purchased for himself<span style="padding-right:.15em;">'</span>".</div>

<p id="mwDL0">Some exceptions that in Caribbean, parts of French uses angled quotation marks, parts of Spanish (e. g. Dominican Republic) uses English ones.</p>
<p id="mwDL4">
<br id="mwDL8"/></p>
</section></section><section data-mw-section-id="21" id="mwDMA" aria-labelledby="Chinese,_Japanese_and_Korean"><div class="mw-heading mw-heading3"><h3 id="Chinese,_Japanese_and_Korean"><span id="Chinese.2C_Japanese_and_Korean" typeof="mw:FallbackId"></span><span class="anchor" id="CJK_quotation_marks"></span><span class="anchor" id="Chinese,_Japanese_and_Korean_quotation_marks"></span>Chinese, Japanese and Korean</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Quotation_mark&amp;action=edit&amp;section=21" title="Edit section: Chinese, Japanese and Korean"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDME">Corner brackets are well-suited for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chinese_language" title="Chinese language" id="mwDMI">Chinese</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japanese_language" title="Japanese language" id="mwDMM">Japanese</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Korean_language" title="Korean language" id="mwDMQ">Korean</a> because they accommodate <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Horizontal_and_vertical_writing_in_East_Asian_scripts" title="Horizontal and vertical writing in East Asian scripts" id="mwDMU">vertical and horizontal writing</a> equally well. China, South Korea, and Japan all use corner brackets when writing vertically. Usage differs when writing horizontally:</p>
<ul id="mwDMY"><li id="mwDMc">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Japan" title="Japan" id="mwDMg">Japan</a>, corner brackets are used.</li>
<li id="mwDMk">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/South_Korea" title="South Korea" id="mwDMo">South Korea</a>, corner brackets and English-style quotes are used.</li>
<li id="mwDMs">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/North_Korea" title="North Korea" id="mwDMw">North Korea</a>, angle quotes are used.<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt1566" typeof="mw:Transclusion" id="mwDM0" data-mw='{"parts":[{"template":{"target":{"wt":"citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"August 2020"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_August_2020" about="#mwt1566"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt1566" id="mwDM4"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed"><span title="This claim needs references to reliable sources. (August 2020)">citation needed</span></a></i><span typeof="mw:Entity">]</span></sup></li>
<li id="mwDM8">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mainland_China" title="Mainland China" id="mwDNA">mainland China</a>, English-style quotes (full width “ ”) are official and prevalent; corner brackets are rare today. The Unicode code points used are the English quotes (rendered as fullwidth by the font), not the fullwidth forms.</li>
<li id="mwDNE">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Taiwan" title="Taiwan" id="mwDNI">Taiwan</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hong_Kong" title="Hong Kong" id="mwDNM">Hong Kong</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Macau" title="Macau" id="mwDNQ">Macau</a>, where <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Traditional_characters" title="Traditional characters" class="mw-redirect" id="mwDNU">traditional characters</a> are used, corner brackets are prevalent, although English-style quotes are also used.</li>
<li id="mwDNY">In the Chinese language, double angle brackets are placed around titles of books, documents, movies, pieces of art or music, magazines, newspapers, laws, etc. When nested, single angle brackets are used inside double angle brackets. With some exceptions, this usage parallels the usage of italics in English:</li></ul>
<dl id="mwDNc"><dd id="mwDNg"><dl id="mwDNk"><dd id="mwDNo">「你看過《三國演義》嗎？」他問我。</dd>
<dd id="mwDNs">"Have you read <i id="mwDNw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Romance_of_the_Three_Kingdoms" title="Romance of the Three Kingdoms" id="mwDN0">Romance of the Three Kingdoms</a></i>?", he asked me.</dd></dl></dd></dl>
<p id="mwDN4">When corner brackets are being used for quotations, quote-within-quote segments are marked with white corner brackets.</p>

<table class="wikitable" id="mwDN8">
<tbody id="mwDOA"><tr id="mwDOE">
<th id="mwDOI">Samples</th><th id="mwDOM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Unicode" title="Unicode" id="mwDOQ">Unicode</a> (decimal)</th><th id="mwDOU">HTML</th><th id="mwDOY">Description</th><th id="mwDOc">Usage</th></tr>
<tr id="mwDOg">
<td id="mwDOk"><span class="nowrap" about="#mwt1567" typeof="mw:Transclusion" id="mwDOo" data-mw='{"parts":[{"template":{"target":{"wt":"nowrap","href":"./Template:Nowrap"},"params":{"1":{"wt":"{{huge|「{{color|silver|文字}}」}}"}},"i":0}}]}'><span style="vertical-align:sub;"><span style="vertical-align:sub;line-height:180%"><span style="font-size:180%; vertical-align:sub;">「<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt1568" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver">文字</span>」</span></span></span></span></td>
<td id="mwDOs"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1367478826" about="#mwt1569" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDOw" data-mw='{"name":"templatestyles","attrs":{"src":"Comma-separated list/styles.css"},"parts":[{"template":{"target":{"wt":"cslist","href":"./Template:Cslist"},"params":{"1":{"wt":"U+300C (12300)"},"2":{"wt":"U+300D (12301)"}},"i":0}}]}'/><ul class="cslist" about="#mwt1569" id="mwDO0"><li>U+300C (12300)</li><li>U+300D (12301)</li></ul></td>
<td id="mwDO4"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1367478826" about="#mwt1571" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDO8" data-mw='{"name":"templatestyles","attrs":{"src":"Comma-separated list/styles.css"},"parts":[{"template":{"target":{"wt":"cslist","href":"./Template:Cslist"},"params":{"1":{"wt":"&amp;amp;#x300C;"},"2":{"wt":"&amp;amp;#x300D;"}},"i":0}}]}'/><ul class="cslist" about="#mwt1571" id="mwDPA"><li><span typeof="mw:Entity">&amp;</span>#x300C;</li><li><span typeof="mw:Entity">&amp;</span>#x300D;</li></ul></td>
<td rowspan="2" id="mwDPE">Corner brackets <span class="mw-empty-elt" about="#mwt1573" typeof="mw:Transclusion" id="mwDPI" data-mw='{"parts":[{"template":{"target":{"wt":"plainlist","href":"./Template:Plainlist"},"params":{"1":{"wt":"\n* [[Chinese language|Chinese]]: {{Interlanguage link|單引號|zh|3=引號}} (&apos;&apos;dān yǐn hào&apos;&apos;)\n* [[Japanese punctuation|Japanese]]: {{Interlanguage link|鉤括弧|ja|3=鉤括弧}} (&apos;&apos;kagikakko&apos;&apos;)\n* {{langx|ko|낫표}} (&apos;&apos;natpyo&apos;&apos;)\n"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1126788409" about="#mwt1574" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"}}'/></span><div class="plainlist " about="#mwt1573" id="mwDPM">
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chinese_language" title="Chinese language">Chinese</a>: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/單引號?action=edit&amp;redlink=1" title="單引號 (page does not exist)" class="new" typeof="mw:LocalizedAttrs" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["單引號"]}}'>單引號</a><span class="noprint" style="font-size:85%; font-style: normal; "><span typeof="mw:Entity"> </span><span typeof="mw:Entity">[</span><a rel="mw:WikiLink/Interwiki" href="https://zh.wikipedia.org/wiki/引號" title="zh:引號" class="extiw">zh</a><span typeof="mw:Entity">]</span></span> (<i>dān yǐn hào</i>)</li>
