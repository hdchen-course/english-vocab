<li about="#cite_note-Decree569-75" id="cite_note-Decree569-75" data-mw-footnote-number="59"><span class="mw-cite-backlink" id="mwE2w"><a href="#cite_ref-Decree569_75-0" rel="mw:referencedBy" id="mwE20"><span class="mw-linkback-text" id="mwE24">↑</span></a></span> <span id="mw-reference-text-cite_note-Decree569-75" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt791" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwE28" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"О переводе алфавита казахского языка с кириллицы на латинскую графику"},"trans-title":{"wt":"On the change of the alphabet of the Kazakh language from the Cyrillic to the Latin script"},"language":{"wt":"ru"},"publisher":{"wt":"[[President of the Republic of Kazakhstan]]"},"url":{"wt":"http://www.akorda.kz/ru/legal_acts/decrees/o-perevode-alfavita-kazahskogo-yazyka-s-kirillicy-na-latinskuyu-grafiku"},"archive-url":{"wt":"https://web.archive.org/web/20171027180526/http://www.akorda.kz/ru/legal_acts/decrees/o-perevode-alfavita-kazahskogo-yazyka-s-kirillicy-na-latinskuyu-grafiku"},"date":{"wt":"26 October 2017"},"access-date":{"wt":"26 October 2017"},"archive-date":{"wt":"27 October 2017"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1 cs1-prop-foreign-lang-source" about="#mwt791" id="mwE3A"><a rel="mw:ExtLink nofollow" href="http://www.akorda.kz/ru/legal_acts/decrees/o-perevode-alfavita-kazahskogo-yazyka-s-kirillicy-na-latinskuyu-grafiku" class="external text" id="mwE3E">"О переводе алфавита казахского языка с кириллицы на латинскую графику"</a> <span typeof="mw:Entity" id="mwE3I">[</span>On the change of the alphabet of the Kazakh language from the Cyrillic to the Latin script<span typeof="mw:Entity" id="mwE3M">]</span> (in Russian). <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/President_of_the_Republic_of_Kazakhstan" title="President of the Republic of Kazakhstan" class="mw-redirect" id="mwE3Q">President of the Republic of Kazakhstan</a>. 26 October 2017. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20171027180526/http://www.akorda.kz/ru/legal_acts/decrees/o-perevode-alfavita-kazahskogo-yazyka-s-kirillicy-na-latinskuyu-grafiku" class="external text" id="mwE3U">Archived</a> from the original on 27 October 2017<span class="reference-accessdate" id="mwE3Y">. Retrieved <span class="nowrap" id="mwE3c">26 October</span> 2017</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=%D0%9E+%D0%BF%D0%B5%D1%80%D0%B5%D0%B2%D0%BE%D0%B4%D0%B5+%D0%B0%D0%BB%D1%84%D0%B0%D0%B2%D0%B8%D1%82%D0%B0+%D0%BA%D0%B0%D0%B7%D0%B0%D1%85%D1%81%D0%BA%D0%BE%D0%B3%D0%BE+%D1%8F%D0%B7%D1%8B%D0%BA%D0%B0+%D1%81+%D0%BA%D0%B8%D1%80%D0%B8%D0%BB%D0%BB%D0%B8%D1%86%D1%8B+%D0%BD%D0%B0+%D0%BB%D0%B0%D1%82%D0%B8%D0%BD%D1%81%D0%BA%D1%83%D1%8E+%D0%B3%D1%80%D0%B0%D1%84%D0%B8%D0%BA%D1%83&amp;rft.pub=President+of+the+Republic+of+Kazakhstan&amp;rft.date=2017-10-26&amp;rft_id=http%3A%2F%2Fwww.akorda.kz%2Fru%2Flegal_acts%2Fdecrees%2Fo-perevode-alfavita-kazahskogo-yazyka-s-kirillicy-na-latinskuyu-grafiku&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AQuotation+mark" class="Z3988" about="#mwt791" id="mwE3g"></span><link rel="mw:PageProp/Category" href="./Category:CS1_Russian-language_sources_(ru)" about="#mwt791" id="mwE3k"/></span></li>
<li about="#cite_note-www.korean.go.kr-77" id="cite_note-www.korean.go.kr-77" data-mw-footnote-number="60"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwE3o"><a href="#cite_ref-www.korean.go.kr_77-0" id="mwE3s"><span class="mw-linkback-text" id="mwE3w">1</span></a> <a href="#cite_ref-www.korean.go.kr_77-1" id="mwE30"><span class="mw-linkback-text" id="mwE34">2</span></a></span> <span id="mw-reference-text-cite_note-www.korean.go.kr-77" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt817" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwE38" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.korean.go.kr/front/page/pageView.do?page_id=P000199&amp;mn_id=30"},"title":{"wt":"한글 맞춤법 - 국립국어원"},"website":{"wt":"Korean.go.kr"},"access-date":{"wt":"25 March 2018"},"archive-date":{"wt":"8 May 2019"},"archive-url":{"wt":"https://web.archive.org/web/20190508005859/https://www.korean.go.kr/front/page/pageView.do?page_id=P000199&amp;mn_id=30"},"url-status":{"wt":"dead"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt817" id="mwE4A"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20190508005859/https://www.korean.go.kr/front/page/pageView.do?page_id=P000199&amp;mn_id=30" class="external text" id="mwE4E">"한글 맞춤법 - 국립국어원"</a>. <i id="mwE4I">Korean.go.kr</i>. Archived from <a rel="mw:ExtLink nofollow" href="https://www.korean.go.kr/front/page/pageView.do?page_id=P000199&amp;mn_id=30" class="external text" id="mwE4M">the original</a> on 8 May 2019<span class="reference-accessdate" id="mwE4Q">. Retrieved <span class="nowrap" id="mwE4U">25 March</span> 2018</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Korean.go.kr&amp;rft.atitle=%ED%95%9C%EA%B8%80+%EB%A7%9E%EC%B6%A4%EB%B2%95+-+%EA%B5%AD%EB%A6%BD%EA%B5%AD%EC%96%B4%EC%9B%90&amp;rft_id=https%3A%2F%2Fwww.korean.go.kr%2Ffront%2Fpage%2FpageView.do%3Fpage_id%3DP000199%26mn_id%3D30&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AQuotation+mark" class="Z3988" about="#mwt817" id="mwE4Y"></span></span></li>
<li about="#cite_note-78" id="cite_note-78" data-mw-footnote-number="61"><span class="mw-cite-backlink" id="mwE4c"><a href="#cite_ref-78" rel="mw:referencedBy" id="mwE4g"><span class="mw-linkback-text" id="mwE4k">↑</span></a></span> <span id="mw-reference-text-cite_note-78" class="mw-reference-text reference-text">
There is no standardized way on how quotation marks used in Latvian, depending on several usages:
<ul id="mwE4o"><li id="mwE4s"><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt854" typeof="mw:Transclusion" id="mwE4w" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"“{{color|silver|...}}”"}},"i":0}}]}'>“<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt855" typeof="mw:Extension/templatestyles" id="mwE40" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver" id="mwE44">...</span>”</span> is preferred as widespread use in Latvian, which is same as English.</li>
<li id="mwE48"><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt856" typeof="mw:Transclusion" id="mwE5A" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"„{{color|silver|...}}”"}},"i":0}}]}'>„<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt857" typeof="mw:Extension/templatestyles" id="mwE5E" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver" id="mwE5I">...</span>”</span> is preferred for use in traditional handwriting and used in the Latvian Language Agency's (LVA) website.</li>
<li id="mwE5M"><span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt858" typeof="mw:Transclusion" id="mwE5Q" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"«{{color|silver|...}}»"}},"i":0}}]}'>«<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt859" typeof="mw:Extension/templatestyles" id="mwE5U" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver" id="mwE5Y">...</span>»</span> is rarely seen in Latvian but can be found in several textbooks. It was also used in widespread usage during the occupation of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Soviet_Union" title="Soviet Union" id="mwE5c">Soviet Union</a>.</li></ul>

Historically, <span class="serif-fonts" style="font-family: 'Georgia Pro', Georgia, 'DejaVu Serif', Times, 'Times New Roman', FreeSerif, 'DejaVu Math TeX', 'URW Bookman L', serif; " about="#mwt860" typeof="mw:Transclusion" id="mwE5g" data-mw='{"parts":[{"template":{"target":{"wt":"serif","href":"./Template:Serif"},"params":{"1":{"wt":"„{{color|silver|...}}“"}},"i":0}}]}'>„<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239334494" about="#mwt861" typeof="mw:Extension/templatestyles" id="mwE5k" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Color/styles.css"}}'/><span class="tmp-color" style="color:silver" id="mwE5o">...</span>“</span> (German-stlye quotes) was used in Latvian in the first half of 20th century.</span></li>
<li about="#cite_note-79" id="cite_note-79" data-mw-footnote-number="62"><span class="mw-cite-backlink" id="mwE5s"><a href="#cite_ref-79" rel="mw:referencedBy" id="mwE5w"><span class="mw-linkback-text" id="mwE50">↑</span></a></span> <span id="mw-reference-text-cite_note-79" class="mw-reference-text reference-text">According to the <a rel="mw:ExtLink nofollow" href="http://download.microsoft.com/download/d/9/b/d9b3b746-78ec-4049-bc43-c0f744199f71/lit-ltu-StyleGuide.pdf" class="external text" id="mwE54"><i id="mwE58">Microsoft Lithuanian Style Guide</i></a> <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20190124205442/http://download.microsoft.com/download/d/9/b/d9b3b746-78ec-4049-bc43-c0f744199f71/lit-ltu-StyleGuide.pdf" about="#mwt867" typeof="mw:Transclusion" class="external text" id="mwE6A" data-mw='{"parts":[{"template":{"target":{"wt":"Webarchive","href":"./Template:Webarchive"},"params":{"url":{"wt":"https://web.archive.org/web/20190124205442/http://download.microsoft.com/download/d/9/b/d9b3b746-78ec-4049-bc43-c0f744199f71/lit-ltu-StyleGuide.pdf"},"date":{"wt":"24 January 2019"}},"i":0}}]}'>Archived</a><span about="#mwt867" id="mwE6E"> 24 January 2019 at the </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wayback_Machine" title="Wayback Machine" about="#mwt867" id="mwE6I">Wayback Machine</a><link rel="mw:PageProp/Category" href="./Category:Webarchive_template_wayback_links" about="#mwt867" id="mwE6M"/>, Lithuanian quotation marks are low-99 high-66 style only.</span></li>
<li about="#cite_note-80" id="cite_note-80" data-mw-footnote-number="63"><span class="mw-cite-backlink" id="mwE6Q"><a href="#cite_ref-80" rel="mw:referencedBy" id="mwE6U"><span class="mw-linkback-text" id="mwE6Y">↑</span></a></span> <span id="mw-reference-text-cite_note-80" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt879" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwE6c" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://lojban.github.io/cll/19/9/"},"title":{"wt":"Putting It All Together: Notes on the Structure of Lojban Texts"},"work":{"wt":"The Lojban Reference Grammar"},"access-date":{"wt":"6 January 2017"},"archive-date":{"wt":"6 December 2016"},"archive-url":{"wt":"https://web.archive.org/web/20161206031102/https://lojban.github.io/cll/19/9/"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt879" id="mwE6g"><a rel="mw:ExtLink nofollow" href="https://lojban.github.io/cll/19/9/" class="external text" id="mwE6k">"Putting It All Together: Notes on the Structure of Lojban Texts"</a>. <i id="mwE6o">The Lojban Reference Grammar</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20161206031102/https://lojban.github.io/cll/19/9/" class="external text" id="mwE6s">Archived</a> from the original on 6 December 2016<span class="reference-accessdate" id="mwE6w">. Retrieved <span class="nowrap" id="mwE60">6 January</span> 2017</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=The+Lojban+Reference+Grammar&amp;rft.atitle=Putting+It+All+Together%3A+Notes+on+the+Structure+of+Lojban+Texts&amp;rft_id=https%3A%2F%2Flojban.github.io%2Fcll%2F19%2F9%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AQuotation+mark" class="Z3988" about="#mwt879" id="mwE64"></span></span></li>
