<script>
var selec = [];
selec[0] = "4Select the correct version:#*If* / =whether= she fails, it will destroy her. "
selec[1] = "4Select the correct version:#I am going to complain =whether= / *whether or not* the referee is right. "
selec[2] = "4Select the correct version:#=If= / *Whether* he plays is irrelevant. "
selec[3] = "4Select the correct version:#I have been wondering =if= / *whether* to build my own house. "
selec[4] = "4Select the correct version:#We need a decision on =if= / *whether* the second answer is also correct. "
selec[5] = "4Select the correct version:#The game will be abandoned *if* / =whether= it snows. "
selec[6] = "4Select the correct version:#Its longevity may depend on =if= / *whether* it starts to lay eggs. "
selec[7] = "4Select the correct version:#=If= / *Whether* to run or hide is a dilemma I face on a daily basis. "
selec[8] = "4Select the correct version:#Go to the party *if* / =whether= you must. "
selec[9] = "4Select the correct version:#We'll be in the pub =whether= / *whether or not* Newcastle win. "
selec[10] = "4Select the correct version:#I need to talk about =if= / *whether* the kids are old enough to travel on their own. "
selec[11] = "4Select the correct version:#*If* / =whether= I go, you'll have to stay. "
selec[12] = "4Select the correct version:#I don't think much about *whether* / =if= fans will remember me. "
selec[13] = "4Select the correct version:#You do realize that *if* / =whether= it's a girl, we're going to be unevenly matched. "
selec[14] = "4Select the correct version:#If you have to think about *whether* / =if= you love someone or not then the answer is no. "
selec[15] = "4Select the correct version:#=If= / *Whether* you are a stay-at-home mum, or on the red carpet, or in Afghanistan, the better you feel, the better you do your job. "
