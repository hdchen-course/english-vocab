<li><a class="mw-selflink selflink">紳士</a>（Esquire，縮寫Esq）</li>
<li><a href="/wiki/%E7%88%B5%E5%A3%AB" title="爵士">爵士</a>或<a href="/wiki/%E5%85%88%E7%94%9F" title="先生">先生</a>（Sir）</li>
<li><a href="/wiki/%E5%8B%B3%E7%88%B5" title="勳爵">勳爵</a>或<a href="/wiki/%E9%98%81%E4%B8%8B" title="閣下">閣下</a>（Lord）</li></ul>
</div></td></tr><tr><th scope="row" class="navbox-group" style="width:1%"><span class="ilh-all" data-orig-title="中性称谓" data-lang-code="en" data-lang-name="英语" data-foreign-title="Gender-neutral title"><span class="ilh-page"><a href="/w/index.php?title=%E4%B8%AD%E6%80%A7%E7%A7%B0%E8%B0%93&amp;action=edit&amp;redlink=1" class="new" title="中性稱謂（頁面不存在）">中性</a></span><span class="noprint ilh-comment"><span class="ilh-paren">（</span><span class="ilh-lang">英語</span><span class="ilh-colon">：</span><span class="ilh-link"><a href="https://en.wikipedia.org/wiki/Gender-neutral_title" class="extiw" title="en:Gender-neutral title"><span lang="en" dir="auto">Gender-neutral title</span></a></span><span class="ilh-paren">）</span></span></span></th><td class="navbox-list-with-group navbox-list navbox-odd hlist" style="width:100%;padding:0px"><div style="padding:0em 0.25em"><span class="ilh-all" data-orig-title="Mx (称谓)" data-lang-code="en" data-lang-name="英语" data-foreign-title="Mx (title)"><span class="ilh-page"><a href="/w/index.php?title=Mx_(%E7%A7%B0%E8%B0%93)&amp;action=edit&amp;redlink=1" class="new" title="Mx (稱謂)（頁面不存在）">Mx</a></span><span class="noprint ilh-comment"><span class="ilh-paren">（</span><span class="ilh-lang">英語</span><span class="ilh-colon">：</span><span class="ilh-link"><a href="https://en.wikipedia.org/wiki/Mx_(title)" class="extiw" title="en:Mx (title)"><span lang="en" dir="auto">Mx (title)</span></a></span><span class="ilh-paren">）</span></span></span></div></td></tr></tbody></table></div>
