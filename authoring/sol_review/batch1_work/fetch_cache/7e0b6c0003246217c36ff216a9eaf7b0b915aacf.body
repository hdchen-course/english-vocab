	/* Translation notes */
	.callout-block {
		position: relative;
		margin-bottom: 24px;
		padding: 10px;
		padding-left: 24px;
	}

	.callout-block::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 10px;
		background: #004976;
	}

	.callout-block.translation-note-simple::before {
		background: #007AAF;
	}

	.eic-microsite .callout-block.translation-note-simple::before {
		background: #991E66;
	}

	.sis-microsite .callout-block.translation-note-simple::before {
		background: #B82B85;
	}

	.fic-microsite .callout-block.translation-note-simple::before {
		background: #ff9e1b;
	}

	.sis-microsite .translation-note-simple {
		background: #fafafa;
	}

	.translation-note-simple h2 {
		font-size: 1.1rem;
		line-height: 1.4rem;
		margin-bottom: 12px;
	}

	.translation-note-simple ul {
		list-style-type: none;
		padding-left: 0;
		margin: 0;
	}

	.translation-note-simple ul li {
		margin-bottom: 0;
	}

	.translation-note-simple ul li+li {
		margin-top: 8px;
		padding-top: 8px;
	}

	.translation-note-simple ul li+li::before {
		content: "";
		height: 1px;
		width: 100px;
		background: #DFDFDF;
		display: flex;
		transform: translateY(-8px);
	}

	.translation-note-simple ul li a {
		display: flex;
		align-items: center;
		width: fit-content;
	}

	.translation-note-simple ul li img {
		width: 40px;
		box-shadow: 0 0 1px #00000012;
		border: 1px solid #e6e6e6;
		border-radius: 3px;
		margin-right: 12px;
	}

	.translation-note-simple.no-flag ul li img {
		display: none;
	}
	
	/* Mobile responsive grid layout styling */
	@media only screen and (max-device-width: 479px) {
		.grid .gridLayout.mb-resp-grid ul li {
			border: 1px solid #dcdcdc;
			border-bottom-width: 2px;
			overflow: hidden;
		}
		
		.grid .gridLayout.mb-resp-grid.full-width-background.image-background ul li,
