				<div id="bodyContent" class="vector-body" aria-labelledby="firstHeading" data-mw-ve-target-container>
					<div class="vector-body-before-content">
							<div class="mw-indicators">
		</div>

						<div id="siteSub" class="noprint">From Wikipedia, the free encyclopedia</div>
						<div id="contentSub"><div id="mw-content-subtitle"></div></div>
						
					</div>
					
					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha27" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Deterioration of rocks and minerals through exposure to the elements"}},"i":0}}]}'>Deterioration of rocks and minerals through exposure to the elements</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"About","href":"./Template:About"},"params":{"1":{"wt":"weathering of rocks and minerals"},"2":{"wt":"weathering of polymers"},"3":{"wt":"Polymer degradation"},"4":{"wt":"and"},"5":{"wt":"Weather testing of polymers"},"6":{"wt":"the public health concept"},"7":{"wt":"Weathering hypothesis"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">This article is about weathering of rocks and minerals. For weathering of polymers, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Polymer_degradation" title="Polymer degradation">Polymer degradation</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Weather_testing_of_polymers" title="Weather testing of polymers">Weather testing of polymers</a>. For the public health concept, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Weathering_hypothesis" title="Weathering hypothesis">Weathering hypothesis</a>.</div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwBQ"><a href="https://en.wikipedia.org/wiki/File:KharazaArch.jpg" class="mw-file-description" id="mwBg"><img resource="https://en.wikipedia.org/wiki/File:KharazaArch.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/13/KharazaArch.jpg/500px-KharazaArch.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/13/KharazaArch.jpg/960px-KharazaArch.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1908" data-file-height="1456" data-file-type="bitmap" height="259" width="340" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1.35" id="mwBw"/></a><figcaption id="mwCA">A <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Natural_arch" title="Natural arch" id="mwCQ">natural arch</a> produced by erosion of differentially weathered rock in Jebel Kharaz (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jordan" title="Jordan" id="mwCg">Jordan</a>)</figcaption></figure>
<span class="mw-empty-elt" about="#mwt4" typeof="mw:Transclusion" id="mwCw" data-mw='{"parts":[{"template":{"target":{"wt":"Geology sidebar","href":"./Template:Geology_sidebar"},"params":{},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1374427404" typeof="mw:Extension/templatestyles" about="#mwt5" data-mw='{"name":"templatestyles","attrs":{"src":"Hlist/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hlist dl,.mw-parser-output .hlist ol,.mw-parser-output .hlist ul{margin:0;padding:0}.mw-parser-output .hlist dd,.mw-parser-output .hlist dt,.mw-parser-output .hlist li{margin:0;display:inline}.mw-parser-output .hlist.inline,.mw-parser-output .hlist.inline dl,.mw-parser-output .hlist.inline ol,.mw-parser-output .hlist.inline ul,.mw-parser-output .hlist dl dl,.mw-parser-output .hlist dl ol,.mw-parser-output .hlist dl ul,.mw-parser-output .hlist ol dl,.mw-parser-output .hlist ol ol,.mw-parser-output .hlist ol ul,.mw-parser-output .hlist ul dl,.mw-parser-output .hlist ul ol,.mw-parser-output .hlist ul ul{display:inline}.mw-parser-output .hlist .mw-empty-li{display:none}.mw-parser-output .hlist dt::after{content:": "}.mw-parser-output .hlist dd::after,.mw-parser-output .hlist li::after{content:"\a0 · ";font-weight:bold}.mw-parser-output .hlist dd:last-child::after,.mw-parser-output .hlist dt:last-child::after,.mw-parser-output .hlist li:last-child::after{content:none}.mw-parser-output .hlist dd dd:first-child::before,.mw-parser-output .hlist dd dt:first-child::before,.mw-parser-output .hlist dd li:first-child::before,.mw-parser-output .hlist dt dd:first-child::before,.mw-parser-output .hlist dt dt:first-child::before,.mw-parser-output .hlist dt li:first-child::before,.mw-parser-output .hlist li dd:first-child::before,.mw-parser-output .hlist li dt:first-child::before,.mw-parser-output .hlist li li:first-child::before{content:" (";font-weight:normal}.mw-parser-output .hlist dd dd:last-child::after,.mw-parser-output .hlist dd dt:last-child::after,.mw-parser-outp