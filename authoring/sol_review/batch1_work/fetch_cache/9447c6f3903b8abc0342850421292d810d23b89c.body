No extra "is-open" class is required. */
}
</style>
<script>
(function () {
// Enhance USWDS accordions with hidden="until-found" + beforematch support
function enhanceUSWDSUntilFound(root = document) {
// Panels we want to be searchable even when collapsed
const panels = root.querySelectorAll('.usa-accordion__content[hidden="until-found"]');
panels.forEach((panel) => {
const id = panel.id;
if (!id) return;
// Find the controlling button via aria-controls
const btn = root.querySelector('.usa-accordion__button[aria-controls="' + id + '"]');
if (!btn) return;
// Keep the DOM state in sync with the button's aria-expanded
const sync = () => {
const expanded = btn.getAttribute('aria-expanded') === 'true';
if (expanded) {
panel.removeAttribute('hidden');     // let USWDS show it
panel.classList.add('is-open');
} else {
// Re-apply our special attribute so Ctrl+F can still find text
panel.setAttribute('hidden', 'until-found');
panel.classList.remove('is-open');
}
};
// 1) When a Find-in-Page match hits hidden content, open its panel
if ('onbeforematch' in document.body) {
panel.addEventListener('beforematch', () => {
// USWDS toggles on click; only click if currently collapsed
if (btn.getAttribute('aria-expanded') === 'false') {
btn.click();
}
});
}
// 2) Observe USWDS state changes (it toggles aria-expanded on the button)
const mo = new MutationObserver(sync);
mo.observe(btn, { attributes: true, attributeFilter: ['aria-expanded'] });
// 3) Initial sync (after USWDS init)
queueMicrotask(sync);
// 4) Also resync on click in case MutationObserver misses anything
btn.addEventListener('click', () => setTimeout(sync, 0));
});
}
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', () => enhanceUSWDSUntilFound());
} else {
enhanceUSWDSUntilFound();
}
})();
</script></div><a id="ATP"></a><a id="CP_JUMP_7481431"></a><div id="cs_control_7481431" class="cs_control CS_Element_Custom"><style>blockquote {border-left: 5px solid #fff;}</style>
<div class="Component ArticleTextGroup TextWrapped clearfix">
<p> </p>
<h2>After the Trip</h2>
</div></div><div id="cs_control_7475447" class="cs_control CS_Element_Custom"><style>blockquote {border-left: 5px solid #fff;}</style>
<div class="Component ArticleTextGroup TextWrapped clearfix">
<figure class="-auto-width">
<picture>
<source type="image/webp" srcset="/subjects/healthandsafety/images/AYT_banner_text.png?maxwidth=1300&autorotate=false&quality=78&format=webp">
<img alt="A graphic of visitors returning home from their trip to a park." src="/subjects/healthandsafety/images/AYT_banner_text.png?maxwidth=1300&autorotate=false" title="After Your Trip Banner"  >
</picture>
</figure><!-- floating-image alignment  -->
<h4>Nice job!</h4>
<p>You've made it back to your car or campsite at the end of your activity, remember to:</p>
</div></div><div id="cs_control_7475450" class="cs_control CS_Element_BulletedList"><div class="Component accordion-list-component">
<div id="accordion7475450" class="usa-accordion usa-accordion--bordered">
<h4 class="usa-accordion__heading" id="heading_7475453_2">
<button class="usa-accordion__button"
type="button"
aria-expanded="false"
aria-controls="body_7475453_2">
Check in with your Trusted Contact
</button>
</h4>
<div id="body_7475453_2"
class="usa-accordion__content usa-prose"
hidden="until-found"
aria-labelledby="heading_7475453_2">
<p>Notify your Trip Plan Trusted Contact when you complete each activity. </p>
</div>
<h4 class="usa-accordion__heading" id="heading_7475454_3">
<button class="usa-accordion__button"
type="button"
aria-expanded="false"
aria-controls="body_7475454_3">
Think about lessons learned
</button>
</h4>
<div id="body_7475454_3"
class="usa-accordion__content usa-prose"
hidden="until-found"
aria-labelledby="heading_7475454_3">
<p>Review how you prepared for the trip, what went well, and what you can improve for your next visit to a park.</p>
</div>
<h4 class="usa-accordion__heading" id="heading_7475456_4">
<button class="usa-accordion__button"
type="button"
aria-expanded="false"
aria-controls="body_7475456_4">
Share Your Experience
</button>
</h4>
<div id="body_7475456_4"
class="usa-accordion__content usa-prose"
hidden="until-found"
aria-labelledby="heading_7475456_4">
<p>Tell others your best outdoor tips and lessons learned to help them prepare for a fun and injury-free adventure. Use #MyParkStory when sharing on social media. </p>
</div>
</div>
</div>
