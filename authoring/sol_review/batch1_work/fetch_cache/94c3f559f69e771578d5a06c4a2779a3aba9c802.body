<th id="mwcQ">Events<sup about="#mwt64" class="mw-ref reference" id="cite_ref-psychology.sunysb_13-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"psychology.sunysb"}}'><a href="#cite_note-psychology.sunysb-13" id="mwcg"><span class="mw-reflink-text" id="mwcw"><span class="cite-bracket" id="mwdA">[</span>13<span class="cite-bracket" id="mwdQ">]</span></span></a></sup></th></tr>
<tr id="mwdg">
<th id="mwdw">Infancy
<p id="mweA">Under 1 year<sup about="#mwt65" class="mw-ref reference" id="cite_ref-:1_12-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"}}'><a href="#cite_note-:1-12" id="mweQ"><span class="mw-reflink-text" id="mweg"><span class="cite-bracket" id="mwew">[</span>12<span class="cite-bracket" id="mwfA">]</span></span></a></sup><sup about="#mwt68" class="mw-ref reference" id="cite_ref-Dunkel_58–76_14-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Dunkel 58–76"},"body":{"id":"mw-reference-text-cite_note-Dunkel_58–76-14"}}'><a href="#cite_note-Dunkel_58–76-14" id="mwfQ"><span class="mw-reflink-text" id="mwfg"><span class="cite-bracket" id="mwfw">[</span>14<span class="cite-bracket" id="mwgA">]</span></span></a></sup></p></th>
<td id="mwgQ">Hope</td><td id="mwgg">Trust vs. mistrust</td><td id="mwgw">Mother</td><td id="mwhA">Can I trust the world?</td><td id="mwhQ">Feeding, abandonment</td></tr>
<tr id="mwhg">
<th id="mwhw">Toddlerhood
<p id="mwiA">1–2 years<sup about="#mwt69" class="mw-ref reference" id="cite_ref-:1_12-5" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"}}'><a href="#cite_note-:1-12" id="mwiQ"><span class="mw-reflink-text" id="mwig"><span class="cite-bracket" id="mwiw">[</span>12<span class="cite-bracket" id="mwjA">]</span></span></a></sup><sup about="#mwt70" class="mw-ref reference" id="cite_ref-Dunkel_58–76_14-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Dunkel 58–76"}}'><a href="#cite_note-Dunkel_58–76-14" id="mwjQ"><span class="mw-reflink-text" id="mwjg"><span class="cite-bracket" id="mwjw">[</span>14<span class="cite-bracket" id="mwkA">]</span></span></a></sup></p></th>
<td id="mwkQ">Will</td><td id="mwkg">Autonomy vs. shame/doubt</td><td id="mwkw">Parents</td><td id="mwlA">Is it okay to be me?</td><td id="mwlQ">Toilet training, clothing themselves</td></tr>
<tr id="mwlg">
<th id="mwlw">Early childhood
<p id="mwmA">3–6 years<sup about="#mwt71" class="mw-ref reference" id="cite_ref-:1_12-6" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"}}'><a href="#cite_note-:1-12" id="mwmQ"><span class="mw-reflink-text" id="mwmg"><span class="cite-bracket" id="mwmw">[</span>12<span class="cite-bracket" id="mwnA">]</span></span></a></sup><sup about="#mwt72" class="mw-ref reference" id="cite_ref-15" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-15"}}'><a href="#cite_note-15" id="mwnQ"><span class="mw-reflink-text" id="mwng"><span class="cite-bracket" id="mwnw">[</span>15<span class="cite-bracket" id="mwoA">]</span></span></a></sup></p></th>
<td id="mwoQ">Purpose</td><td id="mwog">Initiative vs. guilt</td><td id="mwow">Family</td><td id="mwpA">Is it okay for me to do, move, and act?</td><td id="mwpQ">Exploring, using tools or making art</td></tr>
<tr id="mwpg">
<th id="mwpw">Late childhood
<p id="mwqA">7–10 years<sup about="#mwt73" class="mw-ref reference" id="cite_ref-:1_12-7" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"}}'><a href="#cite_note-:1-12" id="mwqQ"><span class="mw-reflink-text" id="mwqg"><span class="cite-bracket" id="mwqw">[</span>12<span class="cite-bracket" id="mwrA">]</span></span></a></sup><sup about="#mwt74" class="mw-ref reference" id="cite_ref-16" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-16"}}'><a href="#cite_note-16" id="mwrQ"><span class="mw-reflink-text" id="mwrg"><span class="cite-bracket" id="mwrw">[</span>16<span class="cite-bracket" id="mwsA">]</span></span></a></sup></p></th>
<td id="mwsQ">Competence</td><td id="mwsg">Industry vs. inferiority</td><td id="mwsw">Neighbors, school</td><td id="mwtA">Can I make it in the world of people and things?</td><td id="mwtQ">School, sports</td></tr>
<tr id="mwtg">
<th id="mwtw">Adolescence
<p id="mwuA">11–19 years<sup about="#mwt75" class="mw-ref reference" id="cite_ref-17" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-17"}}'><a href="#cite_note-17" id="mwuQ"><span class="mw-reflink-text" id="mwug"><span class="cite-bracket" id="mwuw">[</span>17<span class="cite-bracket" id="mwvA">]</span></span></a></sup></p></th>
