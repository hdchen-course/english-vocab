        <style>.block-covid19alert {background-color:#FBEDC8!important; color: #474747!important;} .block-covid19alert .h3:before {content: none; font-family: 'Font Awesome 6 Pro';} .underline {text-decoration:underline;} .block-covid19alert .h3 {display:block; padding-left:1rem; padding-top:1rem; padding-bottom:.5rem; color:#474747!important;}
