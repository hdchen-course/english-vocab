c-7a8053310041","keyImage":{"_key":"JifYzc_UmFevtp-5tps0Z","_type":"cloudinary.asset","_version":1,"access_control":[],"access_mode":"public","bytes":11408387,"context":{"custom":{"alt":"Exploring Topographic Features","caption":"Exploring Topographic Features"}},"created_at":"2025-05-21T15:04:58Z","created_by":{"id":"af4fa6e1d25030d3859b04ae3823cc","type":"user"},"duration":null,"folder":"EducationHub/photos","folder_id":"c05c29c93e064fbea641207d5c99f0558c","format":"jpg","height":4016,"id":"5a548fcffe50df9bdf36b347dda2680c","metadata":{"credits":"Martina/Adobe Stock","license_identifier":"adobe","short_description":"Exploring Topographic Features"},"public_id":"EducationHub/photos/AdobeStock_373475614","resource_type":"image","secure_url":"https://images.nationalgeographic.org/image/upload/v1747839898/EducationHub/photos/AdobeStock_373475614.jpg","source":{"id":"JTdCJTIyZm9ybWF0JTIyJTNBJTIyanBnJTIyJTJDJTIycHVibGljX2lkJTIyJTNBJTIyRWR1Y2F0aW9uSHViJTJGcGhvdG9zJTJGQWRvYmVTdG9ja18zNzM0NzU2MTQlMjIlMkMlMjJyZXNvdXJjZV90eXBlJTIyJTNBJTIyaW1hZ2UlMjIlMkMlMjJ0eXBlJTIyJTNBJTIydXBsb2FkJTIyJTJDJTIycmF3VHJhbnNmb3JtYXRpb24lMjIlM0FudWxsJTdE","name":"cloudinary"},"tags":["esri","mapmaker","topography"],"type":"upload","uploaded_by":{"id":"af4fa6e1d25030d3859b04ae3823cc","type":"user"},"url":"http://images.nationalgeographic.org/image/upload/v1747839898/EducationHub/photos/AdobeStock_373475614.jpg","version":1747839898,"width":6016},"slug":"exploring-topographic-features","title":"Exploring Topographic Features"},{"contentType":"video","description":[{"_key":"7491a77c5264","_type":"block","children":[{"_key":"7491a77c52640","_type":"span","marks":[],"text":"In 1977, after decades of tediously collecting and mapping ocean sonar data, scientists began to see a fairly accurate picture of the seafloor emerge. The Tharp-Heezen map illustrated the geological features that characterize the seafloor and became a crucial factor in the acceptance of the theories of plate tectonics and continental drift. Today, these theories serve as the foundation upon which we understand the geologic processes that shape Earth."}],"markDefs":[],"style":"normal"}],"format":null,"id":"8c538f1e-a07a-4372-af59-bfc41bde27d9","keyImage":{"_type":"cloudinary.asset","_version":1,"access_mode":"public","bytes":451709,"context":{"custom":{"alt":"Volcanic eruptions often occur from the shifting of the planet's tectonic plates.","caption":"Tectonic Plates"}},"format":"jpg","height":540,"metadata":{"credits":""},"name":"edu-alien-deep-tectonic-plates.jpg","resource_type":"image","secure_url":"https://images.nationalgeographic.org/image/upload/v1638886471/EducationHub/photos/edu-alien-deep-tectonic-plates.jpg","source":{"id":"","name":"cloudinary"},"url":"https://images.nationalgeographic.org/image/upload/v1638886471/EducationHub/photos/edu-alien-deep-tectonic-plates.jpg","width":815},"slug":"plate-tectonics-video","title":"Plate Tectonics"},{"contentType":"map","description":[{"_key":"3d5b1296965a","_type":"block","children":[{"_key":"3d5b1296965a0","_type":"span","marks":[],"text":"Explore the boundaries between Earth's tectonic plates with MapMaker, National Geographic's classroom interactive mapping tool."}],"markDefs":[],"style":"normal"}],"format":null,"id":"5d284fa0-7e39-4c83-ae3d-8837e2956b99","keyImage":{"_key":"DEsISC_s9A95EJQAHBPg_","_type":"cloudinary.asset","_version":1,"access_control":[],"access_mode":"public","bytes":600158,"context":{"custom":{"alt":"Earth’s lithosphere is a series of plates shaping its landscape."}},"created_at":"2024-05-31T15:15:02Z","created_by":{"id":"af4fa6e1d25030d3859b04ae3823cc","type":"user"},"duration":null,"folder":"EducationHub/photos","folder_id":"c05c29c93e064fbea641207d5c99f0558c","format":"png","height":1351,"id":"fada5d7272d801c77ba14c680edf8e42","metadata":{"credits":"National Geographic","license_identifier":"xwqc6ci5agiit3aj1lsm"},"public_id":"EducationHub/photos/MapMaker_Plate_Boundaries","resource_type":"image","secure_url":"htt