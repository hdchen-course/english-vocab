                <li class="nav-item"><strong><a style="text-decoration: none;" class="text-white nav-link js-scroll-trigger" href="/english/thewto_e/whatis_e/what_we_do_e.htm">What we do</a></strong></li>
                 <li class="text-white nav-item"><strong><a style="text-decoration: none;" class="text-white nav-link js-scroll-trigger" href="/english/thewto_e/whatis_e/what_stand_for_e.htm">What we stand for</a></strong></li>
               <li class="text-white nav-item"><strong><a style="text-decoration: none;" class="text-white nav-link js-scroll-trigger" href="/english/thewto_e/whatis_e/who_we_are_e.htm">Who we are</a></strong></li>
                <!-- <li class="text-white nav-item"><strong><a style="text-decoration: none;" class="text-white nav-link js-scroll-trigger" href="#trade_negotiations">Trade negotiations</a></strong></li>
