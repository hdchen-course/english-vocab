                <li class="text-white nav-item"><strong><a style="text-decoration: none;" class="text-white nav-link js-scroll-trigger" href="/english/thewto_e/whatis_e/inbrief_e/inbr_e.pdf" target="_blank"><img src="/images/icons/pdf_icon.png" alt="icon" width="20px"> Download</a></strong></li>-->
