</section><section data-mw-section-id="10" id="mwBoA" aria-labelledby="Erhua_transcription"><div class="mw-heading mw-heading3"><h3 id="Erhua_transcription">Erhua transcription</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Bopomofo&amp;action=edit&amp;section=10" title="Edit section: Erhua transcription"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwBoE">Words rhotacized as a result of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Erhua" title="Erhua" id="mwBoI">erhua</a> are spelled with <span title="Chinese-language text" about="#mwt539" typeof="mw:Transclusion" id="mwBoM" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Bopo"},"2":{"wt":"ㄦ"}},"i":0}}]}'><span lang="zh-Bopo">ㄦ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt539" id="mwBoQ"/> attached to the syllable (like <style data-mw-deduplicate="TemplateStyles:r1163242311" typeof="mw:Extension/templatestyles mw:Transclusion" about="#mwt540" id="mwBoU" data-mw='{"name":"templatestyles","attrs":{"src":"Ruby/styles.css"},"parts":[{"template":{"target":{"wt":"ruby-zh-b","href":"./Template:Ruby-zh-b"},"params":{"1":{"wt":"歌兒"},"2":{"wt":"ㄍㄜㄦ"}},"i":0}}]}'>.mw-parser-output .templateruby>rt{font-variant-east-asian:ruby;font-size:85%}.mw-parser-output .templateruby.large{font-size:250%}.mw-parser-output .templateruby.large>rt{font-size:50%}</style><ruby lang="zh-Hant" class="templateruby" about="#mwt540" id="mwBoY">歌兒<rp>（</rp><rt class="bopomofo" lang="zh-Bopo">ㄍㄜㄦ</rt><rp>）</rp></ruby> <span title="Chinese-language text" about="#mwt542" typeof="mw:Transclusion" id="mwBoc" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Latn-pinyin"},"2":{"wt":"gēr"}},"i":0}}]}'><i lang="zh-Latn-pinyin">gēr</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt542" id="mwBog"/>). In case the syllable uses other tones than the 1st tone, the tone mark is attached to the penultimate letter standing for syllable nucleus, but not to <span title="Chinese-language text" about="#mwt543" typeof="mw:Transclusion" id="mwBok" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Bopo"},"2":{"wt":"ㄦ"}},"i":0}}]}'><span lang="zh-Bopo">ㄦ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt543" id="mwBoo"/> (e.g. <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1163242311" about="#mwt544" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBos" data-mw='{"name":"templatestyles","attrs":{"src":"Ruby/styles.css"},"parts":[{"template":{"target":{"wt":"ruby-zh-b","href":"./Template:Ruby-zh-b"},"params":{"1":{"wt":"哪兒"},"2":{"wt":"ㄋㄚˇㄦ"}},"i":0}}]}'/><ruby lang="zh-Hant" class="templateruby" about="#mwt544" id="mwBow">哪兒<rp>（</rp><rt class="bopomofo" lang="zh-Bopo">ㄋㄚˇㄦ</rt><rp>）</rp></ruby> <a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/哪兒" title="wikt:哪兒" class="extiw" id="mwBo0"><span title="Chinese-language text" about="#mwt557" typeof="mw:Transclusion" id="mwBo4" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Latn-pinyin"},"2":{"wt":"nǎr"},"nocat":{"wt":"yes"}},"i":0}}]}'><i lang="zh-Latn-pinyin">nǎr</i></span></a>; <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1163242311" about="#mwt546" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBo8" data-mw='{"name":"templatestyles","attrs":{"src":"Ruby/styles.css"},"parts":[{"template":{"target":{"wt":"ruby-zh-b","href":"./Template:Ruby-zh-b"},"params":{"1":{"wt":"一"},"2":{"wt":"ㄧ"}},"i":0}}]}'/><ruby lang="zh-Hant" class="templateruby" about="#mwt546" id="mwBpA">一<rp>（</rp><rt class="bopomofo" lang="zh-Bopo">ㄧ</rt><rp>）</rp></ruby><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1163242311" about="#mwt548" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBpE" data-mw='{"name":"templatestyles","attrs":{"src":"Ruby/styles.css"},"parts":[{"template":{"target":{"wt":"ruby-zh-b","href":"./Template:Ruby-zh-b"},"params":{"1":{"wt":"點兒"},"2":{"wt":"ㄉㄧㄢˇㄦ"}},"i":0}}]}'/><ruby lang="zh-Hant" class="templateruby" about="#mwt548" id="mwBpI">點兒<rp>（</rp><rt class="bopomofo" lang="zh-Bopo">ㄉㄧㄢˇㄦ</rt><rp>）</rp></ruby> <a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/一點兒" title="wikt:一點兒" class="extiw" id="mwBpM"><span title="Chinese-language text" about="#mwt558" typeof="mw:Transclusion" id="mwBpQ" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Latn-pinyin"},"2":{"wt":"yīdiǎnr"},"nocat":{"wt":"yes"}},"i":0}}]}'><i lang="zh-Latn-pinyin">yīdiǎnr</i></span></a>; <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1163242311" about="#mwt550" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBpU" data-mw='{"name":"templatestyles","attrs":{"src":"Ruby/styles.css"},"parts":[{"template":{"target":{"wt":"ruby-zh-b","href":"./Template:Ruby-zh-b"},"params":{"1":{"wt":"好"},"2":{"wt":"ㄏㄠˇ"}},"i":0}}]}'/><ruby lang="zh-Hant" class="templateruby" about="#mwt550" id="mwBpY">好<rp>（</rp><rt class="bopomofo" lang="zh-Bopo">ㄏㄠˇ</rt><rp>）</rp></ruby><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1163242311" about="#mwt552" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBpc" data-mw='{"name":"templatestyles","attrs":{"src":"Ruby/styles.css"},"parts":[{"template":{"target":{"wt":"ruby-zh-b","href":"./Template:Ruby-zh-b"},"params":{"1":{"wt":"玩兒"},"2":{"wt":"ㄨㄢˊㄦ"}},"i":0}}]}'/><ruby lang="zh-Hant" class="templateruby" about="#mwt552" id="mwBpg">玩兒<rp>（</rp><rt class="bopomofo" lang="zh-Bopo">ㄨㄢˊㄦ</rt><rp>）</rp></ruby> <a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/好玩兒" title="wikt:好玩兒" class="extiw" id="mwBpk"><span title="Chinese-language text" about="#mwt559" typeof="mw:Transclusion" id="mwBpo" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Latn-pinyin"},"2":{"wt":"hǎowánr"},"nocat":{"wt":"yes"}},"i":0}}]}'><i lang="zh-Latn-pinyin">hǎowánr</i></span></a>).<sup about="#mwt556" class="mw-ref reference" id="cite_ref-27" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-27"}}'><a href="#cite_note-27" id="mwBps"><span class="mw-reflink-text" id="mwBpw"><span class="cite-bracket" id="mwBp0">[</span>27<span class="cite-bracket" id="mwBp4">]</span></span></a></sup></p>

</section></section><section data-mw-section-id="11" id="mwBp8" aria-labelledby="Comparison"><div class="mw-heading mw-heading2"><h2 id="Comparison">Comparison</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Bopomofo&amp;action=edit&amp;section=11" title="Edit section: Comparison"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<section data-mw-section-id="12" id="mwBqA" aria-labelledby="Pinyin"><div class="mw-heading mw-heading3"><h3 id="Pinyin">Pinyin</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Bopomofo&amp;action=edit&amp;section=12" title="Edit section: Pinyin"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwBqE">Bopomofo and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pinyin" title="Pinyin" id="mwBqI">pinyin</a> are based on the same Mandarin pronunciations; hence there is a one-to-one correspondence between the two systems:</p>

<table class="wikitable" style="text-align:center;" id="mwBqM">
<caption id="mwBqQ">IPA and pinyin counterparts of Bopomofo finals</caption>
<tbody id="mwBqU"><tr id="mwBqY">
<th rowspan="2" colspan="2" id="mwBqc"></th>
<th colspan="14" id="mwBqg">Rime</th></tr>
<tr lang="zh-Bopo" id="mwBqk">
<th id="mwBqo"></th><th id="mwBqs">ㄚ</th><th id="mwBqw">ㄛ</th><th id="mwBq0">ㄜ</th><th id="mwBq4">ㄝ</th><th id="mwBq8">ㄞ</th><th id="mwBrA">ㄟ</th><th id="mwBrE">ㄠ</th><th id="mwBrI">ㄡ</th><th id="mwBrM">ㄢ</th><th id="mwBrQ">ㄣ</th><th id="mwBrU">ㄤ</th><th id="mwBrY">ㄥ</th><th id="mwBrc">ㄦ</th></tr>
<tr id="mwBrg">
