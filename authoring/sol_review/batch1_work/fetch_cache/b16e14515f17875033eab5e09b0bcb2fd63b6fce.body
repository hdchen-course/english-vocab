<tr id="mwCVo">
<td id="mwCVs"><span title="Chinese-language text" about="#mwt737" typeof="mw:Transclusion" id="mwCVw" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Bopo"},"2":{"wt":"ㆻ"}},"i":0}}]}'><span lang="zh-Bopo">ㆻ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt737" id="mwCV0"/>/<span title="Chinese-language text" about="#mwt738" typeof="mw:Transclusion" id="mwCV4" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Bopo"},"2":{"wt":"ㆶ"}},"i":0}}]}'><span lang="zh-Bopo">ㆶ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt738" id="mwCV8"/></td>
<td id="mwCWA"><span class="IPA" lang="und-Latn-fonipa" about="#mwt739" typeof="mw:Transclusion" id="mwCWE" data-mw='{"parts":[{"template":{"target":{"wt":"IPA link","href":"./Template:IPA_link"},"params":{"1":{"wt":"-k̚"}},"i":0}}]}'><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/No_audible_release" title="No audible release">-k̚</a></span></td>
<td id="mwCWI">-k</td>
