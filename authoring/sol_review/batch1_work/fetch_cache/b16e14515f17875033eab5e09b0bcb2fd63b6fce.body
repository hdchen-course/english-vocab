rts":[{"template":{"target":{"wt":"Transliteration","href":"./Template:Transliteration"},"params":{"1":{"wt":"cmn"},"2":{"wt":"ISO"},"3":{"wt":"tū"}},"i":0}}]}'><i lang="cmn-Latn">tū</i></span> (<span class="skin-invert" typeof="mw:File" id="mwAVY"><a href="https://en.wikipedia.org/wiki/File:Shuowen_Seal_Radical_528.svg" class="mw-file-description" id="mwAVc"><img resource="https://en.wikipedia.org/wiki/File:Shuowen_Seal_Radical_528.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Shuowen_Seal_Radical_528.svg/40px-Shuowen_Seal_Radical_528.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Shuowen_Seal_Radical_528.svg/60px-Shuowen_Seal_Radical_528.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="640" data-file-height="640" data-file-type="drawing" height="22" width="22" class="mw-file-element" id="mwAVg"/></a></span> and <span class="skin-invert" typeof="mw:File" id="mwAVk"><a href="https://en.wikipedia.org/wiki/File:Shuowen_Seal_Radical_525.svg" class="mw-file-description" id="mwAVo"><img resource="https://en.wikipedia.org/wiki/File:Shuowen_Seal_Radical_525.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Shuowen_Seal_Radical_525.svg/40px-Shuowen_Seal_Radical_525.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Shuowen_Seal_Radical_525.svg/60px-Shuowen_Seal_Radical_525.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="640" data-file-height="640" data-file-type="drawing" height="22" width="22" class="mw-file-element" id="mwAVs"/></a></span> in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Seal_script" title="Seal script" id="mwAVw">seal script</a>)<sup about="#mwt147" class="mw-ref reference" id="cite_ref-10" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-10"}}'><a href="#cite_note-10" id="mwAV0"><span class="mw-reflink-text" id="mwAV4"><span class="cite-bracket" id="mwAV8">[</span>10<span class="cite-bracket" id="mwAWA">]</span></span></a></sup><sup about="#mwt149" class="mw-ref reference" id="cite_ref-11" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-11"}}'><a href="#cite_note-11" id="mwAWE"><span class="mw-reflink-text" id="mwAWI"><span class="cite-bracket" id="mwAWM">[</span>11<span class="cite-bracket" id="mwAWQ">]</span></span></a></sup></td>
