<span class="mw-empty-elt" about="#mwt5" typeof="mw:Transclusion" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox writing system\n","href":"./Template:Infobox_writing_system"},"params":{"name":{"wt":"Bopomofo"},"type":{"wt":"[[Semisyllabary]]"},"typedesc":{"wt":"with diacritics for tones"},"fam1":{"wt":"[[Oracle bone script]]"},"fam2":{"wt":"[[Seal script]]"},"fam3":{"wt":"[[Clerical script]]"},"fam4":{"wt":"[[Han script]]"},"children":{"wt":"{{comma separated entries|[[Cantonese bopomofo]]|[[Taiwanese Phonetic Symbols]]|[[Suzhou Phonetic Symbols]]|[[Hmu Phonetic Symbols]]|{{ill|Matsu Fuchounese bopomofo|zh|馬祖閩東（福州）語注音符號}}}}"},"unicode":{"wt":"{{ubli|[https://www.unicode.org/charts/PDF/U3100.pdf U+3100–U+312F] {{nwr|(Bopomofo)}}|[https://www.unicode.org/charts/PDF/U31A0.pdf U+31A0–U+31BF] {{nwr|(Bopomofo Extended)}}}}"},"iso15924":{"wt":"Bopo"},"sample":{"wt":"Zhuyinbaike.svg"},"imagesize":{"wt":"250px"},"caption":{"wt":"The word \"encyclopedia\" (bǎikē quánshū) written in bopomofo (b-ai k-e q-u-an sh-u)"},"creator":{"wt":"* [[Commission on the Unification of Pronunciation]]\n* Introduced by the [[Beiyang government]] of the Republic of China"},"time":{"wt":"* [[Mainland China]] (1918–1958)\n** &apos;&apos;[[Xiandai Hanyu Cidian]]&apos;&apos; ({{nwr|1960–present}}; as a supplement to [[Hanyu Pinyin]])\n* [[Taiwan]] (1945–present)"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt6" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hid