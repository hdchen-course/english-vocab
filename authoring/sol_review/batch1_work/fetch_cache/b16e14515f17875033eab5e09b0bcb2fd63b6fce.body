<td id="mwCUc"><span title="Chinese-language text" about="#mwt731" typeof="mw:Transclusion" id="mwCUg" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Bopo"},"2":{"wt":"ㆴ"}},"i":0}}]}'><span lang="zh-Bopo">ㆴ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt731" id="mwCUk"/></td>
