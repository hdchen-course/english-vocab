<td id="mwCUw">-p</td>
<td id="mwCU0">small <span title="Chinese-language text" about="#mwt733" typeof="mw:Transclusion" id="mwCU4" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Bopo"},"2":{"wt":"ㄅ"}},"i":0}}]}'><span lang="zh-Bopo">ㄅ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt733" id="mwCU8"/></td></tr>
<tr id="mwCVA">
<td id="mwCVE"><span title="Chinese-language text" about="#mwt734" typeof="mw:Transclusion" id="mwCVI" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Bopo"},"2":{"wt":"ㆵ"}},"i":0}}]}'><span lang="zh-Bopo">ㆵ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt734" id="mwCVM"/></td>
