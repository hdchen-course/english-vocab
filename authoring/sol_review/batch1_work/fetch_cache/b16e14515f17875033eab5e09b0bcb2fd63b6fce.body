<tr id="mwCkE">
<td id="mwCkI">1 Yin Ping (Level)</td><td id="mwCkM">ˉ</td><td id="mwCkQ">U+02C9</td><td id="mwCkU">Usually omitted</td></tr>
<tr id="mwCkY">
