<table id="mwBl8">
<tbody id="mwBmA"><tr id="mwBmE"><td style="line-height:1em; font-size:2em" id="mwBmI"><span title="Chinese-language text" about="#mwt531" typeof="mw:Transclusion" id="mwBmM" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"瓶"}},"i":0}}]}'><span lang="zh-Hant">瓶</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt531" id="mwBmQ"/></td><td style="line-height:1em; font-size:0.8em" id="mwBmU"><span title="Chinese-language text" about="#mwt532" typeof="mw:Transclusion" id="mwBmY" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"ㄆ&lt;br />ㄧ&lt;br />ㄥˊ"}},"i":0}}]}'><span lang="zh-Hant">ㄆ<br/>ㄧ<br/>ㄥˊ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt532" id="mwBmc"/></td>
<td style="line-height:1em; font-size:2em" id="mwBmg"><span title="Chinese-language text" about="#mwt533" typeof="mw:Transclusion" id="mwBmk" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"子"}},"i":0}}]}'><span lang="zh-Hant">子</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt533" id="mwBmo"/></td><td style="line-height:1em; font-size:0.8em" id="mwBms"><span title="Chinese-language text" about="#mwt534" typeof="mw:Transclusion" id="mwBmw" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"˙&lt;br />ㄗ"}},"i":0}}]}'><span lang="zh-Hant">˙<br/>ㄗ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt534" id="mwBm0"/></td></tr>
</tbody></table></td>
