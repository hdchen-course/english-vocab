<td style="line-height:1em; font-size:0.8em; text-align:center" id="mwBnM"><span title="Chinese-language text" about="#mwt535" typeof="mw:Transclusion" id="mwBnQ" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"ㄆㄧㄥˊ"}},"i":0}}]}'><span lang="zh-Hant">ㄆㄧㄥˊ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt535" id="mwBnU"/></td><td style="line-height:1em; font-size:0.8em; text-align:center" id="mwBnY"><span title="Chinese-language text" about="#mwt536" typeof="mw:Transclusion" id="mwBnc" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh-Hant"},"2":{"wt":"˙ㄗ"}},"i":0}}]}'><span lang="zh-Hant">˙ㄗ</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt536" id="mwBng"/></td></tr>
