="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=%E6%B1%89%E5%AD%97%E9%83%A8%E9%A6%96%E8%A1%A8&amp;rft.pub=%E4%B8%AD%E5%8D%8E%E4%BA%BA%E6%B0%91%E5%85%B1%E5%92%8C%E5%9B%BD%E6%95%99%E8%82%B2%E9%83%A8&amp;rft.date=2009-01-12&amp;rft_id=http%3A%2F%2Fwww.moe.gov.cn%2Fewebeditor%2Fuploadfile%2F2015%2F01%2F13%2F20150113090108815.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AChinese+character+radicals" class="Z3988" about="#mwt50" id="mwAwE"></span><link rel="mw:PageProp/Category" href="./Category:CS1_uses_Chinese-language_script_(zh)" about="#mwt50" id="mwAwI"/></span></li>
