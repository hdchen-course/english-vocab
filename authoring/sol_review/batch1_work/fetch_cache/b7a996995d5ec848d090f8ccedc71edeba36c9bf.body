<tr id="mwAbM">
<td id="mwAbQ"><span title="Chinese-language text" about="#mwt201" typeof="mw:Transclusion" id="mwAbU" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"黃"}},"i":0}}]}'><span lang="zh">黃</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt201" id="mwAbY"/></td><td id="mwAbc"><span title="Pinyin transliteration" about="#mwt202" typeof="mw:Transclusion" id="mwAbg" data-mw='{"parts":[{"template":{"target":{"wt":"transliteration","href":"./Template:Transliteration"},"params":{"1":{"wt":"zh"},"2":{"wt":"pinyin"},"3":{"wt":"huáng"}},"i":0}}]}'><i lang="zh-Latn">huáng</i></span></td><td id="mwAbk">"yellow"</td><td id="mwAbo"><span title="Chinese-language text" about="#mwt203" typeof="mw:Transclusion" id="mwAbs" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"黌"}},"i":0}}]}'><span lang="zh">黌</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt203" id="mwAbw"/></td><td id="mwAb0"><span title="Pinyin transliteration" about="#mwt204" typeof="mw:Transclusion" id="mwAb4" data-mw='{"parts":[{"template":{"target":{"wt":"transliteration","href":"./Template:Transliteration"},"params":{"1":{"wt":"zh"},"2":{"wt":"pinyin"},"3":{"wt":"hóng"}},"i":0}}]}'><i lang="zh-Latn">hóng</i></span></td><td id="mwAb8">"a school"</td></tr>
