{"1":{"wt":"zh"},"2":{"wt":"pinyin"},"3":{"wt":"kúi"}},"i":0}}]}'><i lang="zh-Latn">kúi</i></span></td><td id="mwAZg">"leader"</td></tr>
<tr id="mwAZk">
<td id="mwAZo"><span title="Chinese-language text" about="#mwt193" typeof="mw:Transclusion" id="mwAZs" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"鹿"}},"i":0}}]}'><span lang="zh">鹿</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt193" id="mwAZw"/></td><td id="mwAZ0"><span title="Pinyin transliteration" about="#mwt194" typeof="mw:Transclusion" id="mwAZ4" data-mw='{"parts":[{"template":{"target":{"wt":"transliteration","href":"./Template:Transliteration"},"params":{"1":{"wt":"zh"},"2":{"wt":"pinyin"},"3":{"wt":"lù"}},"i":0}}]}'><i lang="zh-Latn">lù</i></span></td><td id="mwAZ8">"deer"</td><td id="mwAaA"><span title="Chinese-language text" about="#mwt195" typeof="mw:Transclusion" id="mwAaE" data-mw='{"parts":[{"template":{"target":{"wt":"Lang","href":"./Template:Lang"},"params":{"1":{"wt":"zh"},"2":{"wt":"麓"}},"i":0}}]}'><span lang="zh">麓</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Chinese-language_text" about="#mwt195" id="mwAaI"/></td><td id="mwAaM"><span title="Pinyin transliteration" about="#mwt196" typeof="mw:Transclusion" id="mwAaQ" data-mw='{"parts":[{"template":{"target":{"wt":"transliteration","href":"./Template:Transliteration"},"params":{"1":{"wt":"zh"},"2":{"wt":"pinyin"},"3":{"wt":"lù"}},"i":0}}]}'><i lang="zh-Latn">lù</i></span></td><td id="mwAaU">foothills</td></tr>
