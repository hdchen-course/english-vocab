<th id="mwBnA">Example</th></tr>
<tr id="mwBnE">
<td id="mwBnI"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Phosphine" title="Phosphine" id="mwBnM">Phosphine</a><br id="mwBnQ"/>(<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Phosphane" title="Phosphane" class="mw-redirect" id="mwBnU">Phosphane</a>)</td><td id="mwBnY">Phosphino</td>
<td id="mwBnc">R<sub id="mwBng">3</sub>P</td>
