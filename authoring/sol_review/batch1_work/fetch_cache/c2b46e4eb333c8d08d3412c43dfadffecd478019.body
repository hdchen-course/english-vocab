</section><section data-mw-section-id="8" id="mwBt8" aria-labelledby="Groups_containing_boron"><div class="mw-heading mw-heading3"><h3 id="Groups_containing_boron">Groups containing boron</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Functional_group&amp;action=edit&amp;section=8" title="Edit section: Groups containing boron"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwBuA">Compounds containing boron exhibit unique chemistry due to their having partially filled octets and therefore acting as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Lewis_acid" title="Lewis acid" class="mw-redirect" id="mwBuE">Lewis acids</a>.</p>

<table class="wikitable skin-invert-image" id="mwBuI">
<tbody id="mwBuM"><tr id="mwBuQ">
<th id="mwBuU"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chemical_class" title="Chemical class" class="mw-redirect" id="mwBuY">Chemical class</a></th><th id="mwBuc">Group</th><th id="mwBug">Formula</th><th id="mwBuk">Structural formula</th><th id="mwBuo">Prefix</th><th id="mwBus">Suffix</th><th id="mwBuw">Example</th></tr>
<tr id="mwBu0">
<td id="mwBu4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Boronic_acid" title="Boronic acid" id="mwBu8">Boronic acid</a></td><td id="mwBvA">Borono</td><td id="mwBvE">RB(OH)<sub id="mwBvI">2</sub></td><td id="mwBvM"><figure class="mw-halign-center" typeof="mw:File" id="mwBvQ"><a href="https://en.wikipedia.org/wiki/File:Boronic-acid-2D.svg" class="mw-file-description" id="mwBvU"><img resource="https://en.wikipedia.org/wiki/File:Boronic-acid-2D.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Boronic-acid-2D.svg/120px-Boronic-acid-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Boronic-acid-2D.svg/250px-Boronic-acid-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="400" data-file-type="drawing" height="55" width="70" class="mw-file-element" id="mwBvY"/></a><figcaption id="mwBvc"></figcaption></figure></td><td id="mwBvg">Borono-</td><td id="mwBvk"><i id="mwBvo">substituent</i><br id="mwBvs"/><b id="mwBvw">boronic acid</b></td><td id="mwBv0"><div class="center" about="#mwt44" typeof="mw:Transclusion" id="mwBv4" data-mw='{"parts":[{"template":{"target":{"wt":"center","href":"./Template:Center"},"params":{"1":{"wt":"[[File:Phenylboronic acid.png|70px|Phenylboronic acid]]&lt;br>[[Phenylboronic acid]]"}},"i":0}}]}'><span typeof="mw:File" data-mw='{"caption":"Phenylboronic acid"}'><a href="https://en.wikipedia.org/wiki/File:Phenylboronic_acid.png" class="mw-file-description" title="Phenylboronic acid"><img resource="https://en.wikipedia.org/wiki/File:Phenylboronic_acid.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/3/3b/Phenylboronic_acid.png/120px-Phenylboronic_acid.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/3/3b/Phenylboronic_acid.png/250px-Phenylboronic_acid.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Phenylboronic acid" data-file-width="885" data-file-height="1085" data-file-type="bitmap" height="86" width="70" class="mw-file-element"/></a></span><br/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Phenylboronic_acid" title="Phenylboronic acid">Phenylboronic acid</a></div></td></tr>
<tr id="mwBv8">
<td id="mwBwA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Boronic_acid#Boronic_esters_(also_named_boronate_esters)" title="Boronic acid" id="mwBwE">Boronic ester</a></td><td id="mwBwI">Boronate</td><td id="mwBwM">RB(OR)<sub id="mwBwQ">2</sub></td><td id="mwBwU"><figure class="mw-halign-center" typeof="mw:File" id="mwBwY"><a href="https://en.wikipedia.org/wiki/File:Boronate-ester-2D.svg" class="mw-file-description" id="mwBwc"><img resource="https://en.wikipedia.org/wiki/File:Boronate-ester-2D.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/Boronate-ester-2D.svg/120px-Boronate-ester-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/Boronate-ester-2D.svg/250px-Boronate-ester-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="365" data-file-type="drawing" height="53" width="75" class="mw-file-element" id="mwBwg"/></a><figcaption id="mwBwk"></figcaption></figure></td><td id="mwBwo">O-[bis(alkoxy)alkylboronyl]-</td><td id="mwBws"><i id="mwBww">substituent</i><br id="mwBw0"/><b id="mwBw4">boronic acid</b><br id="mwBw8"/>di(<i id="mwBxA">substituent</i>) <b id="mwBxE">ester</b></td><td id="mwBxI"></td></tr>
<tr id="mwBxM">
<td id="mwBxQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Borinic_acid" title="Borinic acid" id="mwBxU">Borinic acid</a></td><td id="mwBxY">Borino</td><td id="mwBxc">R<sub id="mwBxg">2</sub>BOH</td><td id="mwBxk"><figure class="mw-halign-center" typeof="mw:File" id="mwBxo"><a href="https://en.wikipedia.org/wiki/File:Borinic-acid-2D.svg" class="mw-file-description" id="mwBxs"><img resource="https://en.wikipedia.org/wiki/File:Borinic-acid-2D.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f1/Borinic-acid-2D.svg/120px-Borinic-acid-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f1/Borinic-acid-2D.svg/250px-Borinic-acid-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="398" data-file-type="drawing" height="54" width="70" class="mw-file-element" id="mwBxw"/></a><figcaption id="mwBx0"></figcaption></figure></td><td id="mwBx4">Hydroxyborino-</td><td id="mwBx8">di(<i id="mwByA">substituent</i>)<br id="mwByE"/><b id="mwByI">borinic acid</b></td><td id="mwByM"></td></tr>
<tr id="mwByQ">
<td id="mwByU"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Boronic_acid#Borinic_acids_and_esters" title="Boronic acid" id="mwByY">Borinic ester</a></td><td id="mwByc">Borinate</td><td id="mwByg">R<sub id="mwByk">2</sub>BOR</td><td id="mwByo"><figure class="mw-halign-center" typeof="mw:File" id="mwBys"><a href="https://en.wikipedia.org/wiki/File:Borinate-ester-2D.svg" class="mw-file-description" id="mwByw"><img resource="https://en.wikipedia.org/wiki/File:Borinate-ester-2D.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Borinate-ester-2D.svg/120px-Borinate-ester-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Borinate-ester-2D.svg/250px-Borinate-ester-2D.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="363" data-file-type="drawing" height="53" width="75" class="mw-file-element" id="mwBy0"/></a><figcaption id="mwBy4"></figcaption></figure></td><td id="mwBy8">O-[alkoxydialkylboronyl]-</td><td id="mwBzA">di(<i id="mwBzE">substituent</i>)<br id="mwBzI"/><b id="mwBzM">borinic acid</b><br id="mwBzQ"/><i id="mwBzU">substituent</i> <b id="mwBzY">ester</b></td><td id="mwBzc"><div class="center" about="#mwt45" typeof="mw:Transclusion" id="mwBzg" data-mw='{"parts":[{"template":{"target":{"wt":"center","href":"./Template:Center"},"params":{"1":{"wt":"[[File:2-APB.png|140px|2-Aminoethoxydiphenyl borate]]&lt;br>&lt;small>Diphenylborinic acid 2-aminoethyl ester&lt;/small>&lt;br>([[2-Aminoethoxydiphenyl borate]])"}},"i":0}}]}'><span typeof="mw:File" data-mw='{"caption":"2-Aminoethoxydiphenyl borate"}'><a href="https://en.wikipedia.org/wiki/File:2-APB.png" class="mw-file-description" title="2-Aminoethoxydiphenyl borate"><img resource="https://en.wikipedia.org/wiki/File:2-APB.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/2-APB.png/250px-2-APB.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/2-APB.png/330px-2-APB.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="2-Aminoethoxydiphenyl borate" data-file-width="523" data-file-height="377" data-file-type="bitmap" height="101" width="140" class="mw-file-element"/></a></span><br/><small>Diphenylborinic acid 2-aminoethyl ester</small><br/>(<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2-Aminoethoxydiphenyl_borate" title="2-Aminoethoxydiphenyl borate">2-Aminoethoxydiphenyl borate</a>)</div></td></tr>
</tbody></table>

