<div class="folder-menu collapse" id="folderlist">
    <p>Select Folders：</p>
    <ul>
    
        <li>
            <div class="input-group">
                <input type="text" id="txtNewFolder" class="form-control" placeholder="Enter folder name" maxlength="32" title="Enter folder name">
