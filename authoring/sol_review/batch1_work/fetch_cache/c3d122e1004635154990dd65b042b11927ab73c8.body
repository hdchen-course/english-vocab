		<script nonce="5g3AZoK7eUWhuazuPqjo/w=="  src="/ENG/js/bootstrap.bundle.min.js" type="text/javascript"></script>
        <script nonce="5g3AZoK7eUWhuazuPqjo/w=="  src="/ENG/js/jquery.cookie.js" type="text/javascript"></script>
        <script nonce="5g3AZoK7eUWhuazuPqjo/w=="  src="/ENG/js/app.js" type="text/javascript"></script>
        <script nonce="5g3AZoK7eUWhuazuPqjo/w==" >
            $(function () {
                var b = 'ONEBAR';
                $("#btnSubscribe,#btnUnsubscribe").on("click", function (event) {
                    //var email = $.trim($("#txtEMail").val());
                    //if (email == "") {
                    //    event.preventDefault();
                    //    alert('Please enter your email address.');
                    //    $("#txtEMail").focus();
                    //}
                    //else if (false == IsEMail(email)) {
                    //    event.preventDefault();
                    //    alert('Please enter a currect email address.');
                    //    $("#txtEMail").focus();
                    //}
                    var email = $.trim($("#txtEMail").val());
                    if (!validateEmail(email)) {
                        alert('Please enter a currect email address.');
                        return false;
                    }

                });
                $('#btnQall').on("click", function () {
                    if ($.trim($("#keyword").val()) == "") {
                        alert("Input KeyWord"); return false;
                    } return true;
                });
                $('#btnMsQall').on("click", function () {
                    if ($.trim($("#msKeyword").val()) == "") {
                        alert("Input KeyWord"); return false;
                    } return true;
                });

                // HELP 按鈕綁定 (取代原本的 OnClientClick)
                $('#btnHelp').on('click', function (e) {
                    e.preventDefault(); // 阻止按鈕產生 Postback
                    // 呼叫開啟說明的函數 (若 app.js 無此函數，則使用 TINY.box)
                    if (typeof OpenKeyWordHelp === 'function') {
                        OpenKeyWordHelp();
                    } else {
                        var a = "/Service/KeyWordHelp.aspx";
                        TINY.box.show({ iframe: a, width: 650, height: 270 });
                    }
                    return false;
                });
                // 網頁版搜尋框：攔截 Enter 鍵 (取代 DefaultButton)
                $('#keyword').on('keypress', function (e) {
                    if (e.which === 13) {
                        e.preventDefault();
                        $('#btnQall').click();
                    }
                });

                // 行動版搜尋框：攔截 Enter 鍵 (取代 DefaultButton)
                $('#msKeyword').on('keypress', function (e) {
                    if (e.which === 13) {
                        e.preventDefault();
                        $('#btnMsQall').click();
                    }
                });

                $('#dropdownMenu').attr('data-bs-toggle', 'dropdown');
                $('#unitlist').on("click", "a", function (e) {
                    e.preventDefault();
                    var $this = $(this).parent();
                    var a = $(this).html() + '<span class="caret"></span>';
                    b = $this.data("value");
                    $this.addClass("select").siblings().removeClass("select");
                    $("#dropdownMenu").html(a);
                    $('#hidVal').val(b);
                });
                $('#keyword').on('input propertychange paste', function () {
                    BindAutocomplete('#keyword', b);
                });
            });
            function validateEmail(email) {
                if (email.includes("%")) {
                    return false;
                }
                return true;
            }
        </script>
        

    </form>
</body>
