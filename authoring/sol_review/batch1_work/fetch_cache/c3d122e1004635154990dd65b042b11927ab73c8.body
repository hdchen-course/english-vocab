    <div class="folder-menu-buttons">
        <a href="javascript:void(0);" id="hlSaveToFolder" class="btn btn-sm btn-block btn-default" data-bs-toggle="collapse">Save</a>
        <a id="hlNewFolder" class="btn btn-sm btn-block btn-default" href="javascript:void(0);">Add New Folder</a>
