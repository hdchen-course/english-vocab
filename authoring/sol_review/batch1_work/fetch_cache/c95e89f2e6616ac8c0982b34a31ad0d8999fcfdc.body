    <script async>
      const samlData = sessionStorage.getItem("samlData");
    
      if (samlData) {
        const { next, time, saml_provider } = JSON.parse(samlData);
        const expirationTime = 600000; // 10 min
        const currentTime = new Date().getTime();
        const isLoggedIn = false;
    
        if (currentTime - time < expirationTime && isLoggedIn) {
          if (saml_provider) {
            window._paq = window._paq || [];
            _paq.push(['trackEvent', 'Login', `Login with SAML - ${saml_provider}`]);

            if (typeof matomoDataLayerTrackEvent === "function") {
              matomoDataLayerTrackEvent("login-saml");
            }
          }
    
          if (next) {
            window.location.href = next;
          }
        }
    
        sessionStorage.removeItem("samlData");
      }
    </script>


    





