<li about="#cite_note-30" id="cite_note-30" data-mw-footnote-number="30"><span class="mw-cite-backlink" id="mwA2o"><a href="#cite_ref-30" rel="mw:referencedBy" id="mwA2s"><span class="mw-linkback-text" id="mwA2w">↑</span></a></span> <span id="mw-reference-text-cite_note-30" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt122" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwA20" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Martin"},"first":{"wt":"Samuel D."},"url":{"wt":"https://books.google.com/books?id=iRbRVsvOiFAC"},"title":{"wt":"How to Achieve Total Enlightenment: A Practical Guide to the Meaning of Life"},"date":{"wt":"1 January 2009"},"publisher":{"wt":"Andrews McMeel Publishing"},"isbn":{"wt":"978-0-7407-8680-8"},"publication-place":{"wt":"Kansas City"},"page":{"wt":"44"},"chapter":{"wt":"Self-Help or Personal Development Groups"},"quote":{"wt":"Similar to Gurdjieff&apos;s philosophy, the Landmark Forum teaches that we must break out of our traditional habits in order to see and act differently [...]. [Seminars] are highly controlled and teachers seek to break students down emotionally and then build them back up."},"access-date":{"wt":"15 June 2023"},"orig-date":{"wt":"2005"}},"i":0}}]}'/><cite id="CITEREFMartin2009" class="citation book cs1" about="#mwt122">Martin, Samuel D. (1 January 2009) [2005]. "Self-Help or Personal Development Groups". <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=iRbRVsvOiFAC" class="external text" id="mwA24"><i id="mwA28">How to Achieve Total Enlightenment: A Practical Guide to the Meaning of Life</i></a>. Kansas City: Andrews McMeel Publishing. p.<span typeof="mw:Entity" id="mwA3A"> </span>44. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/I