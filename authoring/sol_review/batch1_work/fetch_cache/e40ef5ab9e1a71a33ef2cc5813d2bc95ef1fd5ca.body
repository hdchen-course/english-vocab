<b><a href="/wiki/%E8%87%BA%E7%81%A3%E6%97%A5%E6%B2%BB%E6%99%82%E6%9C%9F%E5%B9%B4%E8%A1%A8" title="臺灣日治時期年表">日治臺灣歷史年表</a></b><br />  
<b><a href="/wiki/%E6%88%B0%E5%BE%8C%E8%87%BA%E7%81%A3%E6%AD%B7%E5%8F%B2%E5%B9%B4%E8%A1%A8" title="戰後臺灣歷史年表">戰後臺灣歷史年表</a></b><br /> 
<b><a href="/wiki/%E4%B8%AD%E8%8F%AF%E6%B0%91%E5%9C%8B%E7%B8%BD%E7%B5%B1%E7%9B%B4%E9%81%B8%E5%88%97%E8%A1%A8" class="mw-redirect" title="中華民國總統直選列表">中華民國總統直選列表</a></b>
