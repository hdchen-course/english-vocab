ntpref-os .mw-parser-output .sidebar:not(.notheme) .sidebar-title-with-pretitle a{color:var(--color-progressive)!important}}@media print{body.ns-0 .mw-parser-output .sidebar{display:none!important}}</style></span><table class="sidebar nomobile nowraplinks hlist" role="navigation" about="#mwt18"><tbody><tr><th class="sidebar-title">Foreign exchange</th></tr><tr><td class="sidebar-content">
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Currency" title="Currency">Currency</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Currency_pair" title="Currency pair">Currency pair</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Exchange_rate" title="Exchange rate">Exchange rate</a></li></ul></td>
</tr><tr><th class="sidebar-heading">
Policies</th></tr><tr><td class="sidebar-content">
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Currency_substitution" title="Currency substitution">Currency substitution</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Exchange_rate_regime" class="mw-selflink selflink">Exchange rate regime</a>
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Crawling_peg" title="Crawling peg">Crawling peg</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Currency_band" title="Currency band">Currency band</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Currency_intervention" title="Currency intervention">Currency intervention</a></li>
