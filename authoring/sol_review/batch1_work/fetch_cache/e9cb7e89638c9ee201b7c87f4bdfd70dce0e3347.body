<td colspan="14" style="text-align:center;font-size:95%;">Source: Central Weather Bureau<sup about="#mwt210" class="mw-ref reference" id="cite_ref-39" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-39"}}'><a href="#cite_note-39" id="mwyw"><span class="mw-reflink-text" id="mwzA"><span class="cite-bracket" id="mwzQ">[</span>39<span class="cite-bracket" id="mwzg">]</span></span></a></sup><sup about="#mwt215" class="mw-ref reference" id="cite_ref-40" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-40"}}'><a href="#cite_note-40" id="mwzw"><span class="mw-reflink-text" id="mw0A"><span class="cite-bracket" id="mw0Q">[</span>40<span class="cite-bracket" id="mw0g">]</span></span></a></sup><sup about="#mwt220" class="mw-ref reference" id="cite_ref-41" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-41"}}'><a href="#cite_note-41" id="mw0w"><span class="mw-reflink-text" id="mw1A"><span class="cite-bracket" id="mw1Q">[</span>41<span class="cite-bracket" id="mw1g">]</span></span></a></sup><sup about="#mwt225" class="mw-ref reference" id="cite_ref-42" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-42"}}'><a href="#cite_note-42" id="mw1w"><span class="mw-reflink-text" id="mw2A"><span class="cite-bracket" id="mw2Q">[</span>42<span class="cite-bracket" id="mw2g">]</span></span></a></sup><sup about="#mwt230" class="mw-ref reference" id="cite_ref-43" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-43"}}'><a href="#cite_note-43" id="mw2w"><span class="mw-reflink-text" id="mw3A"><span class="cite-bracket" id="mw3Q">[</span>43<span class="cite-bracket" id="mw3g">]</span></span></a></sup></td></tr>
</tbody></table>
</div>

<p id="mw3w"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Typhoon" title="Typhoon" id="mw4A">Typhoons</a> are most likely to strike between July and October, with on average about four direct hits per year. Intensive rain from typhoons often leads to disastrous mudslides.<sup about="#mwt233" class="mw-ref reference" id="cite_ref-FOOTNOTEExec._Yuan201445_1-2" rel="dc:references" typeof="mw:Transclusion mw:Extension/ref" data-mw='{"name":"ref","attrs":{"group":"","name":"FOOTNOTEExec. Yuan201445"},"body":{"id":"mw-reference-text-cite_note-FOOTNOTEExec._Yuan201445-1"},"parts":[{"template":{"target":{"wt":"sfnp","href":"./Template:Sfnp"},"params":{"1":{"wt":"Exec. Yuan"},"2":{"wt":"2014"},"p":{"wt":"45"}},"i":0}}]}'><a href="#cite_note-FOOTNOTEExec._Yuan201445-1" id="mw4Q"><span class="mw-reflink-text" id="mw4g"><span class="cite-bracket" id="mw4w">[</span>1<span class="cite-bracket" id="mw5A">]</span></span></a></sup></p>

</section><section data-mw-section-id="2" id="mw5Q" aria-labelledby="Records"><div class="mw-heading mw-heading2"><h2 id="Records">Records</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Climate_of_Taiwan&amp;action=edit&amp;section=2" title="Edit section: Records"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

