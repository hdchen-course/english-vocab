</section><section data-mw-section-id="34" id="mwA0o" aria-labelledby="References"><div class="mw-heading mw-heading2"><h2 id="References">References</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Honorific&amp;action=edit&amp;section=34" title="Edit section: References"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
