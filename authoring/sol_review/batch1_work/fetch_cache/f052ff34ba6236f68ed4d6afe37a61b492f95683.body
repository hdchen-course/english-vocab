<script nonce="kJZ/ISG2lkCeowNGDDNVUw==" >
   $(function () {
        $(".share-bar").css("display", "inline-block");
        $(".share-bar a").on("click keypress ", function (event) {
            if (event.keyCode == 13 || event.button == 0) {
            event.preventDefault();
