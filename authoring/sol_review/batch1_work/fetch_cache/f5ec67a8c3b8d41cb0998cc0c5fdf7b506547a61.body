 were PrOVGE (Berlin: Heymanns. <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt21" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwASQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"OCLC","href":"./Template:OCLC"},"params":{"1":{"wt":"1366431715"}},"i":0}}]}'/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/OCLC_(identifier)" title="OCLC (identifier)" about="#mwt21" class="mw-redirect" id="mwASU">OCLC</a><span typeof="mw:Entity" about="#mwt21" id="mwASY"> </span><a rel="mw:ExtLink nofollow" href="https://www.worldcat.org/oclc/1366431715" about="#mwt21" class="external text" id="mwASc">1366431715</a>) 13 (1887), <a rel="mw:ExtLink nofollow" href="https://www.digitale-sammlungen.de/view/bsb11585196?page=448%2C449" class="external text" id="mwASg">426</a> (at p. 427–428); E 38 (1901), 421 (at p. 421 and pp. 426–427); E 51 (1908), 284 (at p. 288).</span></li>
<li about="#cite_note-4" id="cite_note-4" data-mw-footnote-number="4"><span class="mw-cite-backlink" id="mwASk"><a href="#cite_ref-4" rel="mw:referencedBy" id="mwASo"><span class="mw-linkback-text" id="mwASs">↑</span></a></span> <span id="mw-reference-text-cite_note-4" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFGrimm2007" about="#mwt24" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwASw" data-mw='{"parts":[{"template":{"target":{"wt":"harvnb","href":"./Template:Harvnb"},"params":{"1":{"wt":"Grimm"},"2":{"wt":"2007"},"p":{"wt":"385"}},"i":0}}]}'>Grimm 2007</a><span about="#mwt24" id="mwAS0">, p.</span><span typeof="mw:Entity" about="#mwt24" id="mwAS4"> </span><span about="#mwt24" id="mwAS8">385</span>, referring to <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/German_Federal_Constitutional_Court" title="German Federal Constitutional Court" class="mw-redirect" id="mwATA">German Federal Constitutional Court</a> (1954) <a rel="mw:WikiLink/Interwiki" href="https://de.wikipedia.org/wiki/Entscheidungen%20des%20Bundesverfassungsgerichts" title="de:Entscheidungen des Bundesverfassungsgerichts" class="extiw" id="mwATE">E</a> 3, 383, at p. 399 – <a rel="mw:ExtLink nofollow" href="https://www.servat.unibe.ch/dfr/bv003383.html#Rn055" class="external text" id="mwATI">available</a> via <span title="German-language text" about="#mwt25" typeof="mw:Transclusion" id="mwATM" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"de"},"2":{"wt":"Das{{nbs}}Fallrecht"}},"i":0}}]}'><i lang="de" id="mwATQ">Das<span class="nowrap" id="mwATU"><span typeof="mw:Entity" id="mwATY"> </span></span>Fallrecht</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_German-language_text" about="#mwt25" id="mwATc"/>/<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/University_of_Berne" title="University of Berne" class="mw-redirect" id="mwATg">University of Berne</a>.</span></li>
<li about="#cite_note-5" id="cite_note-5" data-mw-footnote-number="5"><span class="mw-cite-backlink" id="mwATk"><a href="#cite_ref-5" rel="mw:referencedBy" id="mwATo"><span class="mw-linkback-text" id="mwATs">↑</span></a></span> <span id="mw-reference-text-cite_note-5" class="mw-reference-text reference-text">P. Craig and G. de Burca, <i id="mwATw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/EU_Law" title="EU Law" class="mw-redirect" id="mwAT0">EU Law</a></i> (5th edn OUP 2011) 526.</span></li>
