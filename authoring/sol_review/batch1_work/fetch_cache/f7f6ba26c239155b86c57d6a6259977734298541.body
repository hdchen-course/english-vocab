<li about="#cite_note-5" id="cite_note-5" data-mw-footnote-number="5"><span class="mw-cite-backlink" id="mwATI"><a href="#cite_ref-5" rel="mw:referencedBy" id="mwATM"><span class="mw-linkback-text" id="mwATQ">↑</span></a></span> <span id="mw-reference-text-cite_note-5" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Margaret_L._Anderson" title="Margaret L. Anderson" id="mwATU">Andersen, Margaret L</a>., and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Howard_F._Taylor" title="Howard F. Taylor" id="mwATY">Howard F. Taylor</a>. 2010. <i id="mwATc">Sociology: The Essentials</i>. p.129. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Cengage" title="Cengage" class="mw-redirect" id="mwATg">Cengage Learning</a>.</span></li>
<li about="#cite_note-6" id="cite_note-6" data-mw-footnote-number="6"><span class="mw-cite-backlink" id="mwATk"><a href="#cite_ref-6" rel="mw:referencedBy" id="mwATo"><span class="mw-linkback-text" id="mwATs">↑</span></a></span> <span id="mw-reference-text-cite_note-6" class="mw-reference-text reference-text">
<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt34" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwATw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book\n ","href":"./Template:Cite_book"},"params":{"last1":{"wt":"Lawson"},"first1":{"wt":"Tony"},"last2":{"wt":"Garrod"},"first2":{"wt":"Joan"},"date":{"wt":"12 November 2012"},"orig-date":{"wt":"1996"},"chapter":{"wt":"collectivities"},"title":{"wt":"Dictionary of Sociology"},"url":{"wt":"https://books.google.com/books?id=ibzZZxWC_vEC"},"publication-place":{"wt":"London"},"publisher":{"wt":"Routledge"},"page":{"wt":"37"},"isbn":{"wt":"9781136598456"},"access-date":{"wt":"11 June 2024"},"quote":{"wt":"&apos;&apos;&apos;collectivities:&apos;&apos;&apos; a general term to cover any grouping wider than the individual. They may range from friendship groupings to the membership of the Rotary Club. The advantage of the term is that it implies that groups are built up from individuals collected together and do not have an existence independent of the individuals."}},"i":0}}]}'/><cite id="CITEREFLawsonGarrod2012" class="citation book cs1" about="#mwt34">Lawson, Tony; Garrod, Joan (12 November 2012) [1996]. "collectivities". <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=ibzZZxWC_vEC" class="external text" id="mwAT0"><i id="mwAT4">Dictionary of Sociology</i></a>. London: Routledge. p.<span typeof="mw:Entity" id="mwAT8"> </span>37. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwAUA">ISBN</a><span typeof="mw:Entity" id="mwAUE"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9781136598456" title="Special:BookSources/9781136598456" id="mwAUI"><bdi id="mwAUM">9781136598456</bdi></a><span class="reference-accessdate" id="mwAUQ">. Retrieved <span class="nowrap" id="mwAUU">11 June</span> 2024</span>. <q id="mwAUY"><b id="mwAUc">collectivities:</b> a general term to cover any grouping wider than the individual. They may range from friendship groupings to the membership of the Rotary Club. The advantage of the term is that it implies that groups are built up from individuals collected together and do not have an existence independent of the individuals.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=collectivities&amp;rft.btitle=Dictionary+of+Sociology&amp;rft.place=London&amp;rft.pages=37&amp;rft.pub=Routledge&amp;rft.date=2012-11-12&amp;rft.isbn=9781136598456&amp;rft.aulast=Lawson&amp;rft.aufirst=Tony&amp;rft.au=Garrod%2C+Joan&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3DibzZZxWC_vEC&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ATypes+of+social+groups" class="Z3988" about="#mwt34" id="mwAUg"></span> 
</span></li>
