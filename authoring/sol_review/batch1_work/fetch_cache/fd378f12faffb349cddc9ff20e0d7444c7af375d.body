	}
	
	.fatbtn {
		display: block; padding: 10px
	}
	
	.fat_content {
		overflow: hidden; max-height: 0; opacity: 0; transition: max-height 0.5s ease, opacity 0.5s ease;
	}
	
	.fat_content.open {
