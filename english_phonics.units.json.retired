  {
   "unit_id": "eng.t_base.phonics.silent-e",
   "title_zh": "魔法 e（silent e：a_e／i_e／o_e／u_e）",
   "can_do": "我能認出字尾不發音的「魔法 e」，知道它會讓前面的母音從短音變成「字母名字的音」，讀出 cape、kite、hope、cube 這種字，也能和 cap、kit、hop、cub 分辨。",
   "situation_group": "自然發音：魔法 e（長母音）",
   "subject": "eng",
   "strand": "phonics",
   "est_minutes": 10,
   "knowledge_point_ids": [
    "eng.t_base.phonics.silent-e"
   ],
   "prerequisites": ["eng.t_base.phonics.cvc-blending"],
   "reuse_pages": [],

   "claims": [
    {"claim_id": "c-silente-rule", "text": "In many words with the pattern vowel-consonant-e (like cape, kite, hope, cube), the final 'e' is silent and makes the earlier vowel say its own letter name (its 'long' sound): a = /eɪ/, i = /aɪ/, o = /oʊ/, u = /juː/.",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "許多「母音＋子音＋e」型（cape／kite／hope／cube）字尾 e 不發音，讓前面母音發「字母名字的音」（長音）：a /eɪ/、i /aɪ/、o /oʊ/、u /juː/；採美式／KK（台灣慣用）；cube／cute 的 u 為 /juː/＝字母名，tube／rude 等字部分美式唸 /uː/ 屬方言差異，故本單元用 cube／cute 教字母名音；Cambridge Dictionary 讀音可查；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-silente-contrast", "text": "Adding a silent 'e' changes a short-vowel CVC word into a long-vowel word: cap /kæp/ becomes cape /keɪp/, kit /kɪt/ becomes kite /kaɪt/, hop /hɑp/ becomes hope /hoʊp/, cub /kʌb/ becomes cube /kjuːb/. The vowel sound changes from short to the letter name.",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "加上不發音的 e 把短母音 CVC 字變成長母音字：cap /kæp/→cape /keɪp/、kit /kɪt/→kite /kaɪt/、hop /hɑp/→hope /hoʊp/、cub /kʌb/→cube /kjuːb/；母音由短音變成字母名音；Cambridge Dictionary 讀音可查；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-silente-exceptions", "text": "The silent-e rule is a strong pattern but not a law: some common words are spelled vowel-consonant-e yet do NOT say the long vowel, for example 'have' /hæv/, 'give' /gɪv/, 'come' /kʌm/, 'love' /lʌv/. These are learned as sight words.",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "魔法 e 是很強的規律但非絕對：have /hæv/、give /gɪv/、come /kʌm/、love /lʌv/ 等常見字雖是母音-子音-e 拼法卻不發長母音，當作常見字（sight word）記；誠實標出例外、避免教成「無例外規則」；Cambridge Dictionary 讀音可查；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"}
   ],

   "teach": [
    {"kind": "text", "kp_ids": ["eng.t_base.phonics.silent-e"],
     "body": "Some words end with an 'e' that you do not say out loud. This is the magic e (also called silent e). Its job is to change the vowel before it: instead of the short sound, the vowel now says its own letter name. So a says /eɪ/, i says /aɪ/, o says /oʊ/, and u says /juː/. The pattern is vowel + consonant + e.",
     "zh_hint": "有些字結尾的 e 不唸出來，這叫「魔法 e」（silent e／不發音的 e）。它的工作是改變前面的母音：母音不再發短音，而是發出「自己名字的音」。所以 a 唸 /eɪ/、i 唸 /aɪ/、o 唸 /oʊ/、u 唸 /juː/。排列是「母音＋子音＋e」。"},
    {"kind": "example", "kp_ids": ["eng.t_base.phonics.silent-e"], "audio": "ph_sile_ex1",
     "body": "cap, cape. kit, kite.",
     "zh_hint": "比較短音和加了魔法 e 的長音：cap→cape（a 由 /æ/ 變 /eɪ/）、kit→kite（i 由 /ɪ/ 變 /aɪ/）。"},
    {"kind": "example", "kp_ids": ["eng.t_base.phonics.silent-e"], "audio": "ph_sile_ex2",
     "body": "hop, hope. cub, cube.",
     "zh_hint": "再比較：hop→hope（o 由 /ɑ/ 變 /oʊ/）、cub→cube（u 由 /ʌ/ 變 /juː/）。"},
    {"kind": "text", "kp_ids": ["eng.t_base.phonics.silent-e"],
     "body": "The magic e is a very strong pattern, but a few common words break it: 'have', 'give', 'come', and 'love' all end in e but keep a short vowel. Just learn these few as special words you know by sight.",
     "zh_hint": "魔法 e 是很好用的規律，但有幾個常見字是例外：have、give、come、love 雖然結尾有 e，母音卻還是短音。這幾個字就當作「看到就認得的特別字」記起來。"}
   ],

   "practice": [
    {"question_id": "P1-sile-vowel-sound", "type": "mcq", "validation_method": "expert",
     "stem": "cap 加上一個魔法 e 變成 cape。cape 裡的 a 發哪個音？", "answer": "/eɪ/",
     "kp_ids": ["eng.t_base.phonics.silent-e"], "required_kp_ids": ["eng.t_base.phonics.silent-e"],
     "options": ["/eɪ/", "/æ/", "/aɪ/", "/ɑ/"],
     "distractor_rationales": {
      "/æ/": "那是 cap（沒有魔法 e）裡 a 的短音；加了 e 後要發字母名音。",
      "/aɪ/": "/aɪ/ 是字母 i 的名音（像 kite），不是 a 的名音。",
      "/ɑ/": "/ɑ/ 像 hot 裡 o 的短音，不是 cape 的 a。"},
     "answer_evidence": ["c-silente-contrast"],
     "feedback": "有了魔法 e，cape 的 a 發字母名音 /eɪ/（不是短音 /æ/）。"},

    {"question_id": "P2-sile-which-long", "type": "mcq", "validation_method": "expert",
     "stem": "下面哪一個字，因為字尾有魔法 e，中間的母音要發「字母名字的音」（長音）？", "answer": "kite",
     "kp_ids": ["eng.t_base.phonics.silent-e"], "required_kp_ids": ["eng.t_base.phonics.silent-e"],
     "options": ["kite", "kit", "pin", "map"],
     "distractor_rationales": {
      "kit": "kit 沒有魔法 e，i 發短音 /ɪ/。",
      "pin": "pin 是 CVC 短母音字，沒有魔法 e。",
      "map": "map 是 CVC 短母音字，沒有魔法 e。"},
     "answer_evidence": ["c-silente-rule"],
     "feedback": "kite 字尾有魔法 e，i 發字母名音 /aɪ/；kit／pin／map 都沒有魔法 e。"},

    {"question_id": "P3-sile-add-e", "type": "mcq", "validation_method": "expert",
     "stem": "hop 的 o 是短音 /ɑ/。幫 hop 加上魔法 e 讓 o 發長音 /oʊ/，會拼成哪個字？", "answer": "hope",
     "kp_ids": ["eng.t_base.phonics.silent-e"], "required_kp_ids": ["eng.t_base.phonics.silent-e"],
     "options": ["hope", "hop", "hat", "hut"],
     "distractor_rationales": {
      "hop": "hop 沒有魔法 e，o 還是短音 /ɑ/。",
      "hat": "hat 是 CVC 短母音字（a /æ/），不是 hop 加魔法 e。",
      "hut": "hut 是 CVC 短母音字（u /ʌ/），不是 hop 加魔法 e。"},
     "answer_evidence": ["c-silente-contrast"],
     "feedback": "hop 加魔法 e 變 hope，o 發長音 /oʊ/。"},

    {"question_id": "P4-sile-dictation", "type": "dictation", "validation_method": "expert",
     "stem": "聽音檔，把你聽到的字寫下來（小心有沒有魔法 e）。", "answer": "cube",
     "audio": "ph_sile_dict01",
     "kp_ids": ["eng.t_base.phonics.silent-e"], "required_kp_ids": ["eng.t_base.phonics.silent-e"],
     "feedback": "對照答案自評：聽到的是長音 /kjuːb/（u 發字母名音），所以要寫 cube（c-u-b-e，結尾有不發音的魔法 e），不是 cub。寫對了嗎？"}
   ],

   "selfeval": ["還不熟", "快會了", "會了"],
   "selfeval_note": "翻看答案自己判斷（不自動判讀）；選完進入 SRS 間隔複習。",

   "shadowing": {
    "note": "跟著讀＋語調模仿：播音檔→跟著讀→自評（不自動判發音）。先唸短音的 CVC 字，再唸加了魔法 e 的長音字，感覺母音從短音變成「字母名字的音」。",
