  {
   "unit_id": "eng.t_base.phonics.encoding",
   "title_zh": "聽音拼字（encoding）",
   "can_do": "我能聽到一個 CVC 單字，把它拆成一個一個的音，再為每個音寫出對的字母，拼出整個單字（像聽到 cat 就寫出 c-a-t）。",
   "situation_group": "自然發音：聽音拼字",
   "subject": "eng",
   "strand": "phonics",
   "est_minutes": 10,
   "knowledge_point_ids": [
    "eng.t_base.phonics.encoding"
   ],
   "prerequisites": ["eng.t_base.phonics.cvc-blending"],
   "reuse_pages": [],

   "claims": [
    {"claim_id": "c-encoding-segment", "text": "Encoding (spelling) a CVC word means breaking it into its separate sounds and writing one letter for each sound; it is the reverse of decoding. For 'cat', hear /k/-/æ/-/t/ and write c, a, t.",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "聽音拼字（encoding）＝把 CVC 單字拆成一個個音、每個音寫一個字母，是 decoding 的反向；cat 聽到 /k/-/æ/-/t/ 寫 c、a、t；phonics 通行教法、單字讀音 Cambridge Dictionary 可查；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-encoding-letter-map", "text": "In simple CVC words, each sound maps to one letter: /m/ to m (map), /p/ to p (pin), /d/ to d (dog), /n/ to n (net); the short vowel maps to its vowel letter: /æ/ to a, /ɪ/ to i, /ɑ/ to o, /ʌ/ to u, /ɛ/ to e.",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "簡單 CVC 單字裡每個音對一個字母：/m/→m（map）、/p/→p（pin）、/d/→d（dog）、/n/→n（net）；短母音對母音字母 /æ/→a、/ɪ/→i、/ɑ/→o、/ʌ/→u、/ɛ/→e；以常見預設拼法為準（註：/k/ 音可拼 c 或 k，如 cat／kit，本單元聚焦教過的子音字母，不以 /k/ 當拼字題開頭音以免拼法歧義）；Cambridge Dictionary 讀音可查；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"}
   ],

   "teach": [
    {"kind": "text", "kp_ids": ["eng.t_base.phonics.encoding"],
     "body": "Encoding means spelling a word by its sounds. Say the word slowly, break it into separate sounds, and write one letter for each sound. It is the opposite of decoding: in decoding you blend letters into a word; in encoding you split a word into letters. For example, the word 'cat' has three sounds, /k/-/æ/-/t/, so you write c, a, t.",
     "zh_hint": "聽音拼字就是「照著音把字拼出來」。把單字慢慢唸、拆成一個一個的音，每個音寫一個字母。它和看字讀音剛好相反：看字讀音是把字母連成字，聽音拼字是把字拆成字母。例如 cat 有三個音 /k/-/æ/-/t/，就寫 c、a、t。"},
    {"kind": "example", "kp_ids": ["eng.t_base.phonics.encoding"], "audio": "ph_enc_ex1",
     "body": "Listen and spell: cat, pin, dog.",
     "zh_hint": "聽整個字，再把它拆成三個音拼出來：cat（c-a-t）、pin（p-i-n）、dog（d-o-g）。"},
    {"kind": "text", "kp_ids": ["eng.t_base.phonics.encoding"],
     "body": "Three steps: 1) say the whole word, 2) tap out each sound from left to right, 3) write the letter for each sound. For a CVC word you write three letters: first the beginning consonant, then the short vowel, then the ending consonant. 'sun' = /s/-/ʌ/-/n/ = s, u, n.",
     "zh_hint": "三個步驟：1) 先把整個字唸出來，2) 由左到右一個一個音拍出來，3) 每個音寫下對的字母。CVC 單字會寫三個字母：先開頭子音、再中間短母音、最後結尾子音。sun＝/s/-/ʌ/-/n/＝s、u、n。"},
    {"kind": "example", "kp_ids": ["eng.t_base.phonics.encoding"], "audio": "ph_enc_ex2",
     "body": "Spell these: sun, net, map.",
     "zh_hint": "聽並拼：sun（s-u-n）、net（n-e-t）、map（m-a-p）。"}
   ],

   "practice": [
    {"question_id": "P1-enc-onset-letter", "type": "mcq", "validation_method": "expert",
     "stem": "你聽到單字 map（/m/-/æ/-/p/）。拼這個字時，第一個字母要寫哪一個？", "answer": "m",
     "kp_ids": ["eng.t_base.phonics.encoding"], "required_kp_ids": ["eng.t_base.phonics.encoding"],
     "options": ["m", "n", "p", "b"],
     "distractor_rationales": {
      "n": "n 發 /n/，map 不是用 /n/ 開頭。",
      "p": "p 是 map 結尾 /p/ 的字母，不是開頭。",
      "b": "b 發 /b/，不是 map 開頭的 /m/。"},
     "answer_evidence": ["c-encoding-letter-map"],
     "feedback": "map 開頭的音是 /m/，寫成字母 m。"},

    {"question_id": "P2-enc-vowel-letter", "type": "mcq", "validation_method": "expert",
     "stem": "你聽到單字 sun（/s/-/ʌ/-/n/）。中間那個短母音 /ʌ/ 要寫哪個母音字母？", "answer": "u",
     "kp_ids": ["eng.t_base.phonics.encoding"], "required_kp_ids": ["eng.t_base.phonics.encoding"],
     "options": ["u", "a", "o", "e"],
     "distractor_rationales": {
      "a": "a 是 /æ/ 的字母（像 map 中間），不是 sun 的 /ʌ/。",
      "o": "o 是 /ɑ/ 的字母（像 hot 中間），不是 /ʌ/。",
      "e": "e 是 /ɛ/ 的字母（像 net 中間），不是 /ʌ/。"},
     "answer_evidence": ["c-encoding-letter-map"],
     "feedback": "sun 中間的短母音 /ʌ/ 寫成字母 u。"},

    {"question_id": "P3-enc-full-spell", "type": "mcq", "validation_method": "expert",
     "stem": "你聽到 /p/-/ɪ/-/n/ 這三個音連成的單字。把每個音寫成字母，拼出來是哪個？", "answer": "pin",
     "kp_ids": ["eng.t_base.phonics.encoding"], "required_kp_ids": ["eng.t_base.phonics.encoding"],
     "options": ["pin", "pen", "pan", "bin"],
     "distractor_rationales": {
      "pen": "pen 中間是 /ɛ/（字母 e），不是 /ɪ/。",
      "pan": "pan 中間是 /æ/（字母 a），不是 /ɪ/。",
