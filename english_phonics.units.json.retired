   "claims": [
    {"claim_id": "c-consonant-sound", "text": "Many single consonant letters map to one clear sound: m = /m/ (map), s = /s/ (sun), t = /t/ (ten), p = /p/ (pen), n = /n/ (net).",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "單子音對應音：m /m/（map）、s /s/（sun）、t /t/（ten）、p /p/（pen）、n /n/（net）；Cambridge Dictionary 讀音可查；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-short-vowels", "text": "The five short vowel sounds, anchored to CVC words: a = /æ/ (map), e = /ɛ/ (bed), i = /ɪ/ (sit), o = /ɑ/ (hot), u = /ʌ/ (sun). (US / KK-style symbols; short o is /ɑ/ in US and /ɒ/ in UK.)",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "短母音：a /æ/ map、e /ɛ/ bed、i /ɪ/ sit、o /ɑ/ hot、u /ʌ/ sun；採美式／KK 符號（台灣慣用），短 o 美式 /ɑ/、英式 /ɒ/；以例字錨定避免符號爭議；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-decoding", "text": "Decoding a CVC word means blending its three sounds from left to right: /m/-/æ/-/p/ makes 'map'; /s/-/ɪ/-/t/ makes 'sit'.",
     "kind": "language-usage", "source_refs": ["Cambridge Dictionary"],
     "verification_ref": "CVC 拼讀＝把三個音由左到右連起來：/m/-/æ/-/p/→map、/s/-/ɪ/-/t/→sit；phonics 通行拼讀法，單字讀音 Cambridge 可查；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"}
   ],

   "teach": [
    {"kind": "text", "kp_ids": ["eng.t_base.phonics.single-consonants"],
     "body": "Many consonant letters make one clear sound. For example: m makes /m/, s makes /s/, t makes /t/, p makes /p/, n makes /n/. Keep each sound short and crisp, not with an extra \"uh\" at the end.",
     "zh_hint": "很多子音字母只發一個清楚的音。例如：m 發 /m/、s 發 /s/、t 發 /t/、p 發 /p/、n 發 /n/。每個音要短而乾脆，不要在後面多拖一個「呃」的音。"},
    {"kind": "example", "kp_ids": ["eng.t_base.phonics.single-consonants"], "audio": "ph_cvc_ex1",
     "body": "Hear each starting sound inside its word: map, sun, ten, net.",
     "zh_hint": "從每個字的開頭聽那個子音的音：map（m）、sun（s）、ten（t）、net（n）。"},
    {"kind": "text", "kp_ids": ["eng.t_base.phonics.short-vowels"],
     "body": "The five vowels a, e, i, o, u each have a short sound. Hear them in these words: a = /æ/ in map, e = /ɛ/ in bed, i = /ɪ/ in sit, o = /ɑ/ in hot, u = /ʌ/ in sun. The word tells you the sound.",
     "zh_hint": "五個母音 a、e、i、o、u 各有一個短短的音。從這些字裡聽：a＝map 裡的 /æ/、e＝bed 裡的 /ɛ/、i＝sit 裡的 /ɪ/、o＝hot 裡的 /ɑ/、u＝sun 裡的 /ʌ/。用例字記這個音最準。"},
    {"kind": "example", "kp_ids": ["eng.t_base.phonics.short-vowels"], "audio": "ph_cvc_ex2",
     "body": "map, bed, sit, hot, sun.",
     "zh_hint": "聽每個字中間的短母音：map、bed、sit、hot、sun。"},
    {"kind": "text", "kp_ids": ["eng.t_base.phonics.decoding"],
     "body": "To read a short word, blend its sounds from left to right. Say each sound, then join them fast: /m/-/æ/-/p/ becomes map; /s/-/ɪ/-/t/ becomes sit. This is called decoding.",
     "zh_hint": "要讀一個短單字，就把它的音由左到右連起來。先一個一個發，再快快地接在一起：/m/-/æ/-/p/ 連成 map；/s/-/ɪ/-/t/ 連成 sit。這就叫「看字讀音」（decoding）。"}
   ],

