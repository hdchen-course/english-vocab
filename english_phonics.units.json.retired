      "/ɪd/（多一個音節）": "/ɪd/ 只在 /t/、/d/ 音後出現（wanted）；walk 結尾是 /k/，不加音節。",
      "/ɛd/": "-ed 不會唸成有短母音 /ɛ/ 的 /ɛd/。"},
     "answer_evidence": ["c-ed-criterion"],
     "feedback": "walk 結尾是清音 /k/，所以 -ed 唸 /t/（walked＝/wɔkt/）。"},

    {"question_id": "P2-ed-wanted", "type": "mcq", "validation_method": "expert",
     "stem": "wanted 字尾的 -ed 發哪個音？", "answer": "/ɪd/（多一個音節）",
     "kp_ids": ["eng.t_base.phonics.ed-sound"], "required_kp_ids": ["eng.t_base.phonics.ed-sound"],
     "options": ["/ɪd/（多一個音節）", "/t/", "/d/", "不發音"],
     "distractor_rationales": {
