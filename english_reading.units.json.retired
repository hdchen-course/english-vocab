  {
   "unit_id": "eng.t_mid.reading.word-reference",
   "title_zh": "由上下文猜字義與代名詞指涉（guess word & reference）",
   "can_do": "我能用上下文的線索猜出一個生字大概的意思，也能看出文中的 he／they／it 這些代名詞指的是前面哪個人或東西。",
   "situation_group": "閱讀：猜字義與指涉",
   "subject": "eng",
   "strand": "reading",
   "est_minutes": 10,
   "knowledge_point_ids": [
    "eng.t_mid.reading.guess-word",
    "eng.t_mid.reading.reference"
   ],
   "prerequisites": ["eng.t_mid.reading.main-detail"],
   "reuse_pages": [],

   "claims": [
    {"claim_id": "c-guess-from-context", "text": "When you meet a new word, you can often guess its meaning from the context — the other words around it, the examples given, and what is happening in the passage. You do not always need a dictionary.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "遇到生字時，常可由上下文線索（周圍的字、所舉的例子、文中正在發生的事）猜出大概意思，不一定要查字典；屬英語閱讀教學通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-reference-pronoun", "text": "Pronouns such as 'he', 'she', 'it', and 'they', and words like 'this' and 'that', point back to a noun already mentioned. To find what a pronoun means, look for the nearest earlier noun that fits in meaning and number.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "he／she／it／they 等代名詞，以及 this／that，會回指前面已提過的名詞；找代名詞指誰＝往前找最靠近、在意義與單複數上都合得來的名詞；屬英語語法／閱讀通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"}
   ],

   "teach": [
    {"kind": "text", "kp_ids": ["eng.t_mid.reading.guess-word"],
     "body": "You will often meet a word you do not know. Before you reach for a dictionary, use the context: read the words around it, look at any examples, and think about what is happening. These clues often show you what the new word means.",
     "zh_hint": "你常會遇到不認識的字。先別急著查字典，用上下文：讀讀它周圍的字、看看有沒有舉例、想想文中正在發生什麼。這些線索常常就能告訴你這個生字的意思。"},
    {"kind": "text", "kp_ids": ["eng.t_mid.reading.reference"],
     "body": "Small words like 'he', 'she', 'it', 'they', 'this', and 'that' stand for a noun that was already named. When you see one, look back for the nearest earlier noun that makes sense — the right person, animal, or thing, and the right number (one or many).",
     "zh_hint": "he、she、it、they、this、that 這些小字，代表前面已經提過的名詞。看到它時，往前找最靠近、意思又說得通的那個名詞——對的人、動物或東西，而且單複數要對（一個還是很多個）。"},
    {"kind": "passage", "kp_ids": ["eng.t_mid.reading.guess-word", "eng.t_mid.reading.reference"],
     "body": "Tom's dog, Rocky, was very timid. When visitors came to the house, he would hide under the bed and stay there until they left. One day, a loud storm came. Rocky was so scared that he shook. Tom sat with him and spoke softly. Slowly, the dog felt safe again.",
     "zh_hint": "導讀：這段在講 Tom 的狗 Rocky。注意生字 timid，可以從『看到客人就躲起來、打雷時嚇得發抖』這些線索猜出意思；也注意文中的 he、they、him 分別指的是誰。"},
    {"kind": "example", "kp_ids": ["eng.t_mid.reading.guess-word", "eng.t_mid.reading.reference"],
     "body": "Guess the word: 'timid' is new, but Rocky hides from visitors and shakes in a storm, so 'timid' must mean shy and easily scared. Reference: in 'he would hide under the bed', 'he' points back to the dog Rocky, the shy one just mentioned — not Tom and not the visitors.",
     "zh_hint": "猜字：timid 是生字，但 Rocky 看到客人會躲、打雷會發抖，所以 timid 一定是『膽小、容易害怕』。指涉：'he would hide under the bed' 裡的 he，回指剛提到的那隻膽小的狗 Rocky，不是 Tom、也不是客人。"}
   ],

   "practice": [
    {"question_id": "R2-guess-timid", "type": "mcq", "validation_method": "expert",
     "stem": "根據上下文，文中的 timid 最可能是什麼意思？", "answer": "膽小、容易害怕的",
     "kp_ids": ["eng.t_mid.reading.guess-word"], "required_kp_ids": ["eng.t_mid.reading.guess-word"],
     "options": ["膽小、容易害怕的", "很兇、會咬人的", "跑得很快的", "體型很大的"],
     "distractor_rationales": {
      "很兇、會咬人的": "文中說 Rocky 看到客人就躲起來、打雷時嚇得發抖，是『害怕』而不是兇。",
      "跑得很快的": "文中沒有提到 Rocky 跑得快不快，線索講的是牠會害怕、會躲。",
      "體型很大的": "文中沒有提到 Rocky 的大小，線索講的是牠膽小的個性。"},
     "answer_evidence": ["c-guess-from-context"],
     "feedback": "線索：牠看到客人會躲到床底下、打雷時嚇得發抖——這些都指向 timid＝膽小、容易害怕。"},

    {"question_id": "R2-ref-he", "type": "mcq", "validation_method": "expert",
     "stem": "文中 'he would hide under the bed'（他會躲到床底下）裡的 he 指的是誰？", "answer": "Rocky（Tom 的狗）",
     "kp_ids": ["eng.t_mid.reading.reference"], "required_kp_ids": ["eng.t_mid.reading.reference"],
     "options": ["Rocky（Tom 的狗）", "Tom", "來訪的客人", "Tom 的爸爸"],
     "distractor_rationales": {
      "Tom": "躲到床底下的是那隻膽小的狗 Rocky；Tom 是主人，後面才出現安撫牠。",
      "來訪的客人": "客人是進到屋子裡的人（visitors came），躲起來的是怕生的狗。",
      "Tom 的爸爸": "文中沒有提到 Tom 的爸爸。"},
     "answer_evidence": ["c-reference-pronoun"],
     "feedback": "前一句說 Rocky（狗）很膽小，所以『看到客人會躲到床底下的 he』就是指 Rocky。"},

    {"question_id": "R2-ref-they", "type": "mcq", "validation_method": "expert",
     "stem": "文中 'stay there until they left'（待在那裡直到他們離開）裡的 they 指的是誰？", "answer": "來訪的客人",
     "kp_ids": ["eng.t_mid.reading.reference"], "required_kp_ids": ["eng.t_mid.reading.reference"],
     "options": ["來訪的客人", "Tom 和 Rocky", "床底下的其他狗", "打雷的聲音"],
     "distractor_rationales": {
      "Tom 和 Rocky": "they 是會『離開』房子的人；離開的是來訪的客人，不是住在家裡的 Tom。",
      "床底下的其他狗": "文中只有 Rocky 一隻狗，沒有提到其他狗。",
      "打雷的聲音": "they 指的是人（複數），而且打雷是後面才發生的事。"},
     "answer_evidence": ["c-reference-pronoun"],
     "feedback": "they 是會離開的那群人——就是前面提到來訪的 visitors（客人）。"}
   ],

   "selfeval": ["還不熟", "快會了", "會了"],
   "selfeval_note": "翻看答案自己判斷（不自動判讀）；選完進入 SRS 間隔複習。",

   "shadowing": {
    "note": "朗讀練習（不產音檔、不自動判讀）：出聲讀這兩句；讀到代名詞 he／they 時，心裡想一下『這是指誰』，幫助把指涉關係記牢。",
    "lines": [
     {"text": "Tom's dog, Rocky, was very timid."},
     {"text": "When visitors came to the house, he would hide under the bed and stay there until they left."}
    ]
   }
