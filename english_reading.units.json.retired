  {
   "unit_id": "eng.t_adv.reading.title-purpose",
   "title_zh": "選最適合的標題與看出作者的寫作目的（best title & author's purpose）",
   "can_do": "我能幫一段英文短文選出最適合、最能涵蓋全文的標題，也能看出作者寫這段話是要說明、說服、娛樂還是指示。",
   "situation_group": "閱讀：標題與寫作目的",
   "subject": "eng",
   "strand": "reading",
   "est_minutes": 9,
   "knowledge_point_ids": [
    "eng.t_adv.reading.best-title",
    "eng.t_adv.reading.purpose"
   ],
   "prerequisites": ["eng.t_mid.reading.main-detail"],
   "reuse_pages": [],

   "claims": [
    {"claim_id": "c-best-title-covers-all", "text": "The best title names what the whole passage is about, not just one small part. A good title is not too wide and not too narrow: it fits every main point in the text.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "最適合的標題要點出整段短文在講什麼，而不是只講到其中一小部分；好標題不會太大也不會太小，要能涵蓋文中每個重點；屬英語閱讀教學通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-author-purpose", "text": "Writers write for a purpose: to inform (explain facts), to persuade (make you agree or act), to entertain (give enjoyment, like a story), or to instruct (tell you step by step how to do something). Words like 'you should' and 'please' often signal persuasion.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "作者寫作有目的：說明（解釋事實）、說服（讓你同意或行動）、娛樂（給樂趣，如故事）、指示（一步步教你怎麼做）；should、please 這類字常是『說服』的訊號；屬英語閱讀教學通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"}
   ],

   "teach": [
    {"kind": "text", "kp_ids": ["eng.t_adv.reading.best-title"],
     "body": "A title is a very short name for a whole text. The best title covers everything the passage is mostly about — not just one line. If a title is too wide, it promises more than the text gives. If it is too narrow, it only fits one small part. Pick the one that matches the main point of the whole passage.",
     "zh_hint": "標題是整篇文章的簡短名字。最好的標題要涵蓋全文主要在講的事——不是只對到其中一句。標題太大，就承諾了文章沒給的內容；太小，就只對到一小部分。要挑那個對得上全文重點的。"},
    {"kind": "text", "kp_ids": ["eng.t_adv.reading.purpose"],
     "body": "Every writer has a purpose. To inform means to explain facts. To persuade means to make readers agree or do something. To entertain means to give enjoyment, like a funny story. To instruct means to tell readers step by step how to do a task. Watch for clue words: 'you should' and 'please' often mean the writer wants to persuade you.",
     "zh_hint": "每個作者都有目的。說明＝解釋事實；說服＝讓讀者同意或去做某件事；娛樂＝給人樂趣，像有趣的故事；指示＝一步步教讀者怎麼完成一件事。注意線索字：you should、please 常代表作者想『說服』你。"},
    {"kind": "passage", "kp_ids": ["eng.t_adv.reading.best-title", "eng.t_adv.reading.purpose"],
     "body": "Every day, people throw away a lot of paper. This is a waste. Used paper is not rubbish — it can still be useful. We should all try to use paper more than once. When we reuse paper, we save trees and protect our forests. So next time, please do not throw paper away too quickly.",
     "zh_hint": "導讀：這段在談『重複使用紙張』。先想想：整段主要在講什麼，適合當標題？再注意作者的語氣——他是在單純說明，還是想說服你改變做法（看看 we should、please 這些字）。"},
    {"kind": "example", "kp_ids": ["eng.t_adv.reading.best-title", "eng.t_adv.reading.purpose"],
     "body": "Best title: almost every sentence is about reusing paper and why it helps, so a good title is 'Reuse Paper to Save Trees'. 'How Paper Is Made' would be too narrow and off-topic. Purpose: the writer says 'We should all try...' and 'please do not throw paper away', so the purpose is to persuade readers to reuse paper, not just to explain facts.",
     "zh_hint": "標題：幾乎每句都在講重複用紙和它的好處，所以『Reuse Paper to Save Trees（重複用紙，救救樹木）』是好標題；『How Paper Is Made（紙怎麼做）』太窄又離題。目的：作者說 We should all try…、please do not throw paper away，所以目的是『說服』讀者重複用紙，而不只是說明事實。"}
   ],

   "practice": [
    {"question_id": "R4-best-title", "type": "mcq", "validation_method": "expert",
     "stem": "下列哪一個標題最適合這段短文？", "answer": "Reuse Paper to Save Trees（重複用紙，救救樹木）",
     "kp_ids": ["eng.t_adv.reading.best-title"], "required_kp_ids": ["eng.t_adv.reading.best-title"],
     "options": ["Reuse Paper to Save Trees（重複用紙，救救樹木）", "How Paper Is Made in a Factory（工廠怎麼造紙）", "Different Kinds of Paper（紙的各種種類）", "Why Trees Grow So Tall（樹為什麼長得這麼高）"],
     "distractor_rationales": {
      "How Paper Is Made in a Factory（工廠怎麼造紙）": "短文沒有講紙是怎麼製造的，只講要重複使用；這標題離題。",
      "Different Kinds of Paper（紙的各種種類）": "短文沒有介紹紙有哪些種類，這標題對不上全文重點。",
      "Why Trees Grow So Tall（樹為什麼長得這麼高）": "短文提到樹只是因為『重複用紙能救樹』；主題不是樹怎麼長高，這標題太偏。"},
     "answer_evidence": ["c-best-title-covers-all"],
     "feedback": "整段幾乎每句都在講『重複使用紙張』和它的好處（救樹、保護森林），所以最能涵蓋全文的標題是 Reuse Paper to Save Trees。"},

    {"question_id": "R4-purpose", "type": "mcq", "validation_method": "expert",
     "stem": "作者寫這段話，主要的目的是什麼？", "answer": "說服大家重複使用紙張",
     "kp_ids": ["eng.t_adv.reading.purpose"], "required_kp_ids": ["eng.t_adv.reading.purpose"],
     "options": ["說服大家重複使用紙張", "說明紙張的製造過程", "講一個好笑的故事讓人開心", "一步步教你怎麼回收紙張"],
     "distractor_rationales": {
      "說明紙張的製造過程": "短文沒有在解釋紙怎麼做；它是在勸讀者改變做法，不是單純說明事實。",
      "講一個好笑的故事讓人開心": "短文不是故事，也不好笑，目的不是娛樂。",
      "一步步教你怎麼回收紙張": "短文沒有列出一步一步的做法，不是指示型。"},
     "answer_evidence": ["c-author-purpose"],
     "feedback": "作者用 'We should all try...' 和 'please do not throw paper away'，是在勸讀者同意並改變做法，所以目的是『說服』。"},

    {"question_id": "R4-purpose-action", "type": "mcq", "validation_method": "expert",
     "stem": "讀完這段話，作者最希望讀者接下來怎麼做？", "answer": "以後重複使用紙張，不要太快把紙丟掉",
     "kp_ids": ["eng.t_adv.reading.purpose"], "required_kp_ids": ["eng.t_adv.reading.purpose"],
     "options": ["以後重複使用紙張，不要太快把紙丟掉", "學會自己動手造紙", "去買更多全新的紙", "到山上多種一些樹"],
     "distractor_rationales": {
      "學會自己動手造紙": "短文沒有要讀者學造紙，而是要重複使用已有的紙。",
      "去買更多全新的紙": "這和作者的意思相反——他要的是少浪費、重複使用，不是多買新紙。",
      "到山上多種一些樹": "作者是說重複用紙能『救樹』，但他要讀者做的是重複用紙，不是去種樹。"},
     "answer_evidence": ["c-author-purpose"],
     "feedback": "最後一句 'please do not throw paper away too quickly' 加上 'use paper more than once'，說明作者希望讀者重複用紙、別太快丟掉。"}
   ],

   "selfeval": ["還不熟", "快會了", "會了"],
   "selfeval_note": "翻看答案自己判斷（不自動判讀）；選完進入 SRS 間隔複習。",

   "shadowing": {
    "note": "朗讀練習（不產音檔、不自動判讀）：出聲把這兩句讀清楚，一邊讀一邊想『整段適合的標題是什麼』『作者想說服我做什麼』。",
    "lines": [
     {"text": "We should all try to use paper more than once."},
     {"text": "So next time, please do not throw paper away too quickly."}
    ]
   }
