  {
   "unit_id": "eng.t_mid.reading.functional-skim",
   "title_zh": "讀實用文本＋略讀尋讀（functional text / skim & scan）",
   "can_do": "我能讀告示、菜單、時刻表、邀請卡這類實用文本，先略讀抓住它大概在說什麼，再掃讀找出我要的那個時間、價格或規定。",
   "situation_group": "閱讀：實用文本與略讀尋讀",
   "subject": "eng",
   "strand": "reading",
   "est_minutes": 9,
   "knowledge_point_ids": [
    "eng.t_mid.reading.functional-text",
    "eng.t_mid.reading.skim-scan"
   ],
   "prerequisites": ["eng.t_mid.reading.main-detail"],
   "reuse_pages": [],

   "claims": [
    {"claim_id": "c-functional-text", "text": "Functional texts — notices, menus, timetables, and invitations — are read to find a specific piece of information you need, such as a time, a price, or a rule. You do not read them word by word like a story.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "實用文本（告示／菜單／時刻表／邀請卡）是為了找出你需要的某個具體資訊（時間、價格、規定）而讀，不像讀故事那樣逐字讀完；屬英語閱讀教學通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-skim-gist", "text": "Skimming means reading quickly over a text to get its general idea — what it is mostly about — without stopping on every word.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "略讀（skimming）＝快速看過全文抓大意（它主要在講什麼），不在每個字上停留；屬英語閱讀策略通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-functional-scan", "text": "Scanning means moving your eyes quickly over a text to find one specific fact — a number, a time, a name, or a price — without reading everything.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "尋讀／掃讀（scanning）＝讓眼睛快速掃過文本，找出某個特定資訊（數字、時間、名字、價格），不必全部讀；屬英語閱讀策略通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"}
   ],

   "teach": [
    {"kind": "text", "kp_ids": ["eng.t_mid.reading.functional-text"],
     "body": "Functional texts are the things you read in real life: notices, menus, timetables, and invitations. You read them to find something you need — a time, a price, or a rule — not to enjoy a story. So you look for the exact line that answers your question.",
     "zh_hint": "實用文本是你日常生活中會讀的東西：告示、菜單、時刻表、邀請卡。你讀它們是為了找到你需要的東西——某個時間、價格或規定——不是為了欣賞故事。所以要去找出回答你問題的那一行。"},
    {"kind": "text", "kp_ids": ["eng.t_mid.reading.skim-scan"],
     "body": "Two useful reading moves: skim and scan. Skimming is reading quickly to get the general idea — what the text is about. Scanning is sliding your eyes over the text to find one specific thing, like a number or a day, without reading every word.",
     "zh_hint": "兩個好用的閱讀動作：略讀和尋讀。略讀（skim）是快速看過抓大意——這段大概在講什麼。尋讀（scan）是讓眼睛滑過文本，去找某個特定的東西，例如一個數字或一個星期幾，不必每個字都讀。"},
    {"kind": "passage", "kp_ids": ["eng.t_mid.reading.functional-text", "eng.t_mid.reading.skim-scan"],
     "body": "CITY LIBRARY - OPENING HOURS. Monday to Friday: 9:00 a.m. to 6:00 p.m. Saturday: 10:00 a.m. to 4:00 p.m. Sunday: Closed. You can borrow up to 5 books for 2 weeks. A late return costs 2 dollars per book.",
     "zh_hint": "導讀：這是一張圖書館告示。先略讀，看出它主要在講開放時間和借書規定；需要某個資訊時（例如星期六幾點關門、逾期罰多少）再用尋讀，直接找那一行。"},
    {"kind": "example", "kp_ids": ["eng.t_mid.reading.functional-text", "eng.t_mid.reading.skim-scan"],
     "body": "Skim first: the notice is about opening hours and borrowing rules. Now scan for one fact: to find when the library closes on Saturday, jump to the 'Saturday' line — '10:00 a.m. to 4:00 p.m.' — so it closes at 4:00 p.m. You did not need to read every line.",
     "zh_hint": "先略讀：這張告示在講開放時間和借書規定。再尋讀找一個資訊：想知道星期六幾點關門，就跳到 Saturday 那一行——'10:00 a.m. to 4:00 p.m.'——所以是下午四點關門。你不必每一行都讀完。"}
   ],

   "practice": [
    {"question_id": "R3-skim-purpose", "type": "mcq", "validation_method": "expert",
     "stem": "快速看過這張告示，它主要是在告訴你什麼？", "answer": "圖書館的開放時間和借書規定",
     "kp_ids": ["eng.t_mid.reading.skim-scan"], "required_kp_ids": ["eng.t_mid.reading.skim-scan"],
     "options": ["圖書館的開放時間和借書規定", "圖書館有哪些新書", "怎麼辦一張圖書證", "圖書館的樓層位置"],
     "distractor_rationales": {
      "圖書館有哪些新書": "告示列的是開放時間和借書規定，沒有列出任何書名。",
      "怎麼辦一張圖書證": "告示沒有說明辦圖書證的步驟。",
      "圖書館的樓層位置": "告示沒有提到樓層或位置。"},
     "answer_evidence": ["c-skim-gist"],
     "feedback": "略讀整張告示可看出它在講開放時間（星期幾、幾點到幾點）和借書規定（借幾本、幾週、逾期罰款），所以主旨是開放時間和借書規定。"},

    {"question_id": "R3-scan-saturday", "type": "mcq", "validation_method": "expert",
     "stem": "根據這張告示，星期六圖書館幾點關門？", "answer": "下午四點（4:00 p.m.）",
     "kp_ids": ["eng.t_mid.reading.functional-text"], "required_kp_ids": ["eng.t_mid.reading.functional-text"],
     "options": ["下午四點（4:00 p.m.）", "下午六點（6:00 p.m.）", "上午十點（10:00 a.m.）", "星期六沒有開"],
     "distractor_rationales": {
      "下午六點（6:00 p.m.）": "下午六點關門是星期一到星期五，不是星期六。",
      "上午十點（10:00 a.m.）": "上午十點是星期六的『開門』時間，不是關門時間。",
      "星期六沒有開": "星期日才沒有開（Sunday: Closed）；星期六有開，10:00 到 16:00。"},
     "answer_evidence": ["c-functional-scan", "c-functional-text"],
     "feedback": "告示寫 'Saturday: 10:00 a.m. to 4:00 p.m.'，所以星期六是下午四點關門。"},

    {"question_id": "R3-scan-latefee", "type": "mcq", "validation_method": "expert",
     "stem": "根據這張告示，一本書逾期還，要付多少罰款？", "answer": "每本 2 元",
     "kp_ids": ["eng.t_mid.reading.functional-text", "eng.t_mid.reading.skim-scan"], "required_kp_ids": ["eng.t_mid.reading.functional-text", "eng.t_mid.reading.skim-scan"],
     "options": ["每本 2 元", "每本 5 元", "每星期 2 元", "不用付錢"],
     "distractor_rationales": {
      "每本 5 元": "告示寫的罰款是每本 2 元；5 是『最多可借的本數』（up to 5 books），不是罰款金額。",
      "每星期 2 元": "告示寫的是 'per book'（每一本），不是『每星期』。",
      "不用付錢": "告示明確寫逾期要付罰款（A late return costs 2 dollars per book）。"},
     "answer_evidence": ["c-functional-scan", "c-functional-text"],
     "feedback": "告示寫 'A late return costs 2 dollars per book.'（逾期每本 2 元），所以一本是 2 元。"}
   ],

   "selfeval": ["還不熟", "快會了", "會了"],
   "selfeval_note": "翻看答案自己判斷（不自動判讀）；選完進入 SRS 間隔複習。",

   "shadowing": {
    "note": "朗讀練習（不產音檔、不自動判讀）：出聲把告示的時間那幾行讀清楚，一邊讀一邊練習『尋讀』——眼睛直接跳到你要找的那一行。",
    "lines": [
     {"text": "Monday to Friday: 9:00 a.m. to 6:00 p.m."},
     {"text": "You can borrow up to 5 books for 2 weeks."}
    ]
   }
