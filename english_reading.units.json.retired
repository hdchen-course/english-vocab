  {
   "unit_id": "eng.t_adv.reading.tone-inference",
   "title_zh": "看出作者的態度語氣與做合理推論（attitude/tone & inference）",
   "can_do": "我能從用字看出作者對一件事是正面、中立還是批評，也能根據文中線索推論出作者沒有明說、但合理成立的事。",
   "situation_group": "閱讀：態度語氣與推論",
   "subject": "eng",
   "strand": "reading",
   "est_minutes": 10,
   "knowledge_point_ids": [
    "eng.t_adv.reading.attitude-tone",
    "eng.t_adv.reading.inference"
   ],
   "prerequisites": ["eng.t_mid.reading.main-detail", "eng.t_adv.reading.title-purpose"],
   "reuse_pages": [],

   "claims": [
    {"claim_id": "c-attitude-from-words", "text": "A writer's attitude or tone is how the writer feels about the topic — positive (likes it), neutral (just reports), or critical (dislikes it). You find the tone from the writer's word choices, such as 'I did not want to leave' for a positive tone.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "作者的態度／語氣＝作者對主題的感受：正面（喜歡）、中立（只是陳述）、批評（不喜歡）；要從作者的用字看出來，例如 'I did not want to leave' 顯示正面態度；屬英語閱讀教學通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"},
    {"claim_id": "c-inference-from-clues", "text": "An inference is a reasonable conclusion the text does not state directly, but that the clues clearly support. A good inference must be backed by the text, not just by your own guess.",
     "kind": "language-usage", "source_refs": ["Cambridge English"],
     "verification_ref": "推論＝文本沒有直接說、但線索清楚支持的合理結論；好的推論必須有文本依據，不是憑自己隨意猜；屬英語閱讀教學通則；待英語母語 reviewer 複核", "risk_class": "normal", "status": "provisional"}
   ],

   "teach": [
    {"kind": "text", "kp_ids": ["eng.t_adv.reading.attitude-tone"],
     "body": "A writer's attitude, or tone, is how the writer feels about the topic. It can be positive (the writer likes it), neutral (the writer only reports facts, with no strong feeling), or critical (the writer dislikes it or finds a problem). You cannot see feelings directly, so look at the word choices. Warm words like 'wonderful' or 'I did not want to leave' show a positive tone.",
     "zh_hint": "作者的態度（語氣）是作者對主題的感受：正面（喜歡）、中立（只陳述事實、沒有強烈感受）、批評（不喜歡或點出問題）。感受看不到，所以要看用字。像 wonderful、I did not want to leave 這種帶暖意的字，顯示正面語氣。"},
    {"kind": "text", "kp_ids": ["eng.t_adv.reading.inference"],
     "body": "Sometimes a text does not tell you something straight out, but the clues make it clear. Drawing that reasonable conclusion is called making an inference. The key rule: your inference must be supported by the text. If the passage gives no clue for it, it is just a guess, not an inference.",
     "zh_hint": "有時文本沒有直接告訴你某件事，但線索讓它變得很清楚；把這個合理的結論推出來，就叫『推論』。關鍵原則：推論一定要有文本支持。如果文中沒有任何線索，那只是亂猜，不是推論。"},
    {"kind": "passage", "kp_ids": ["eng.t_adv.reading.attitude-tone", "eng.t_adv.reading.inference"],
     "body": "Last Saturday I visited the new city park for the first time. The paths were clean, and tall trees stood everywhere. Children laughed as they ran across the wide green grass. I sat on a bench and watched the birds for almost an hour. I did not want to leave. I will surely come back next weekend.",
     "zh_hint": "導讀：這段是作者第一次去新公園後的描述。一邊讀一邊感覺作者『喜不喜歡這個地方』（看用字）；再想想：文中沒直接說、但由線索可以合理推論出來的是什麼。"},
    {"kind": "example", "kp_ids": ["eng.t_adv.reading.attitude-tone", "eng.t_adv.reading.inference"],
     "body": "Attitude: the writer says the paths were clean, watched birds for almost an hour, and 'did not want to leave'. These warm words show a positive attitude. Inference: the writer sat quietly for almost an hour and did not want to leave, so we can reasonably infer the park felt calm and relaxing — even though the text never uses the word 'relaxing'.",
     "zh_hint": "態度：作者說小徑乾淨、看鳥看了快一小時、而且 'did not want to leave'，這些暖意的字顯示正面態度。推論：作者安靜坐了快一小時又捨不得走，所以可以合理推論這座公園讓他覺得很平靜放鬆——即使文中從沒出現 relaxing 這個字。"}
   ],

   "practice": [
    {"question_id": "R5-tone", "type": "mcq", "validation_method": "expert",
     "stem": "作者對這座新公園的態度（語氣）是什麼？", "answer": "正面、很喜歡",
     "kp_ids": ["eng.t_adv.reading.attitude-tone"], "required_kp_ids": ["eng.t_adv.reading.attitude-tone"],
     "options": ["正面、很喜歡", "批評、不滿意", "中立、沒有特別感覺", "害怕、覺得不安全"],
     "distractor_rationales": {
      "批評、不滿意": "作者沒有抱怨任何問題，反而說小徑乾淨、捨不得走，不是批評。",
      "中立、沒有特別感覺": "作者用了很多帶感情的話（捨不得走、一定會再來），不是只平淡陳述。",
      "害怕、覺得不安全": "文中沒有任何害怕或危險的線索，孩子還開心地奔跑。"},
     "answer_evidence": ["c-attitude-from-words"],
     "feedback": "'did not want to leave'、'I will surely come back'、小徑乾淨、看鳥看很久——這些暖意用字都顯示作者態度是正面、喜歡。"},

    {"question_id": "R5-tone-evidence", "type": "mcq", "validation_method": "expert",
     "stem": "下列哪一句最能看出作者對公園的喜愛？", "answer": "I did not want to leave.（我捨不得離開）",
     "kp_ids": ["eng.t_adv.reading.attitude-tone"], "required_kp_ids": ["eng.t_adv.reading.attitude-tone"],
     "options": ["I did not want to leave.（我捨不得離開）", "The paths were clean.（小徑很乾淨）", "Children ran across the grass.（孩子在草地上奔跑）", "I visited the park on Saturday.（我星期六去公園）"],
     "distractor_rationales": {
      "The paths were clean.（小徑很乾淨）": "這是對環境的描述，是正面訊號之一，但不像『捨不得離開』那樣直接表達作者的喜愛。",
      "Children ran across the grass.（孩子在草地上奔跑）": "這只是在描述現場景象，沒有直接說出作者自己的感受。",
      "I visited the park on Saturday.（我星期六去公園）": "這只是交代時間的事實，看不出作者的感受。"},
     "answer_evidence": ["c-attitude-from-words"],
     "feedback": "最直接表達喜愛的是 'I did not want to leave.'——捨不得走，正是喜歡的強烈訊號。"},

    {"question_id": "R5-inference", "type": "mcq", "validation_method": "expert",
     "stem": "根據文中的線索，下列哪一項是合理的推論（文中沒有直接說）？", "answer": "作者在公園裡覺得很平靜、很放鬆",
     "kp_ids": ["eng.t_adv.reading.inference"], "required_kp_ids": ["eng.t_adv.reading.inference"],
     "options": ["作者在公園裡覺得很平靜、很放鬆", "作者就住在這座公園隔壁", "這座公園假日總是很擁擠", "作者比較喜歡去海邊玩"],
     "distractor_rationales": {
      "作者就住在這座公園隔壁": "文中完全沒有提到作者住哪裡，這無法從線索推出，只是猜。",
      "這座公園假日總是很擁擠": "文中只說有孩子在玩，沒有說『總是很擁擠』，而且是作者第一次來，無從得知平常如何。",
      "作者比較喜歡去海邊玩": "文中沒有提到海邊，也沒有做任何比較，這個推論沒有依據。"},
     "answer_evidence": ["c-inference-from-clues"],
     "feedback": "作者安靜坐著看鳥快一小時、又捨不得離開——雖然沒出現『放鬆』二字，但這些線索合理支持『他覺得平靜、放鬆』。"}
   ],

   "selfeval": ["還不熟", "快會了", "會了"],
   "selfeval_note": "翻看答案自己判斷（不自動判讀）；選完進入 SRS 間隔複習。",

   "shadowing": {
    "note": "朗讀練習（不產音檔、不自動判讀）：出聲讀這兩句，讀的時候體會作者的語氣，並想一下『由這些話我可以合理推論出什麼』。",
    "lines": [
     {"text": "I sat on a bench and watched the birds for almost an hour."},
     {"text": "I did not want to leave."}
    ]
   }
